local Polish = require("../src/shared/BakeryPolish")
local Contracts = require("../src/shared/BakeryContracts")
local Life = require("../src/shared/BakeryLife")
local Progression = require("../src/shared/Progression")
local Permissions = require("../src/server/AdminPermissions")
local Catalog = require("../src/shared/ChallengeCatalog")
return function(test, equal, near, harness, fakeStore)
	test("new bakeries buy a free first line and expansions charge exactly once", function()
		local p = Progression.newData()
		equal(p.life.belt, 0)
		assert(Polish.buyBelt(p))
		equal(p.life.belt, 1)
		assert(not Polish.buyBelt(p))
		p.cash = 260000
		assert(Polish.buyBelt(p)); equal(p.cash, 250000)
		assert(Polish.buyBelt(p)); equal(p.cash, 0)
		assert(not Polish.buyBelt(p)); equal(p.life.belt, 3)
	end)
	test("old built bakeries retain conveyors while new state and decorations round-trip", function()
		local old = Progression.newData()
		old.life.belt = nil
		equal(Progression.normalize(old).life.belt, 3)
		local p = Progression.newData()
		p.cash = 100000
		for key, item in pairs(Polish.Decorations) do
			local before = p.cash
			assert(Polish.buyDecoration(p, key)); equal(p.cash, before - item.Cost)
			assert(not Polish.buyDecoration(p, key)); equal(p.cash, before - item.Cost)
			assert(Progression.normalize(p).life.decorations[key])
		end
		equal(Progression.normalize(p).life.belt, 0)
		assert(not Polish.buyDecoration(p, "forged"))
	end)
	test("packaging processes threshold crossings, skipped frames, and each bonus only once", function()
		local cookie = Life.cookie({ id = "fast", recipe = 1 })
		local machines = { Packager = true, Boxer = true }
		assert(not Life.process(cookie, machines, Polish.WrapZ - 0.01))
		assert(Life.process(cookie, machines, Polish.WrapZ))
		assert(cookie.wrapped and not cookie.boxed)
		assert(not Life.process(cookie, machines, Polish.WrapZ + 0.1))
		assert(Life.process(cookie, machines, 127))
		assert(cookie.boxed)
		local value = Life.value(cookie)
		assert(not Life.process(cookie, machines, 200)); equal(Life.value(cookie), value)
		local plain = Life.cookie({ id = "plain", recipe = 1 })
		assert(not Life.process(plain, {}, 127)); assert(not plain.wrapped and not plain.boxed)
		assert(Polish.WrapZ < Polish.BoxZ and Polish.BoxZ < 126)
	end)
	test("all thirty recipes have distinct buffs and expired effects stop completely", function()
		local seen, signatures = {}, {}
		for recipe = 1, 30 do
			local b = Polish.buff(recipe)
			assert(not seen[b.Name]); seen[b.Name] = true
			local key = table.concat({ b.Speed, b.Jump, b.Mine, b.Income, b.Sell, b.Regen }, ":")
			assert(not signatures[key]); signatures[key] = true
			local life = Life.normalize({ buff = { recipe = recipe, expires = 200, seed = 1 } })
			equal(Polish.active(life, 199).Name, b.Name)
			local expired = Polish.active(life, 200)
			for _, field in ipairs({ "Speed", "Jump", "Mine", "Income", "Sell", "Regen" }) do equal(expired[field], 0) end
		end
	end)
	test("food income stacks during its own timer and does not alter a stored cookie", function()
		local p = Progression.newData()
		local cookie = Life.cookie({ id = "gold", recipe = 30 })
		local value = Life.value(cookie)
		p.life.buff = { recipe = 30, expires = 200, seed = 1 }
		near(Life.production(p.life, 199), 1.4)
		near(Life.production(p.life, 200), 1)
		equal(Life.value(cookie), value)
	end)
	test("customer rolls vary traits and prices, favorite cookies matter, and budget caps apply", function()
		local frugal, foodie = Polish.customer(0.2, 0, 0), Polish.customer(0, 0.9, 1)
		assert(frugal.Style ~= foodie.Style and frugal.Patience ~= foodie.Patience)
		local a = Polish.offer(100, frugal.Favorite, frugal, 0)
		local b = Polish.offer(100, frugal.Favorite, frugal, 1)
		assert(b > a)
		assert(a > Polish.offer(100, 30, frugal, 0))
		local price, budget = Polish.offer(100, foodie.Favorite, foodie, 0.5)
		local accepted, nextPrice = Polish.negotiate(price, budget, 0, foodie, 0.99, 0.5)
		assert(accepted and nextPrice > price and nextPrice <= budget)
		assert(not Polish.negotiate(price, budget, foodie.Patience, foodie, 0.99, 1))
		assert(not Polish.negotiate(price, budget, 0, foodie, 0, 1))
		assert(not Polish.negotiate(budget, budget, 0, foodie, 1, 1))
	end)
	test("random job selection includes seven activities and avoids the previous kind", function()
		for index, kind in ipairs(Contracts.Kinds) do
			local p = Progression.newData()
			assert(Contracts.assign(p, 100, (index - 0.5) / #Contracts.Kinds, 0.5, 0.2))
			equal(p.life.contract.kind, kind)
			p.life.contract.lastKind = kind
			Contracts.assign(p, 200, (index - 0.5) / #Contracts.Kinds, 0.5, 0.2)
			assert(p.life.contract.kind ~= kind)
		end
	end)
	test("only the matching server activity advances a job and its reward pays once", function()
		local p = Progression.newData()
		Contracts.assign(p, 100, 0, 0, 0)
		assert(not Contracts.record(p, "Sell", 20))
		assert(not Contracts.interact(p, 101, 0, 0, 0))
		assert(Contracts.record(p, "Mine", 1)); equal(p.life.contract.progress, 1)
		assert(Contracts.record(p, "Mine", 99)); equal(p.life.contract.progress, p.life.contract.target)
		local reward = p.life.contract.reward
		assert(Contracts.interact(p, 110, 0, 0, 0)); equal(p.cash, reward)
		assert(Contracts.interact(p, 111, 0.5, 0.5, 0.5)); equal(p.cash, reward)
		equal(p.life.contract.cycle, 1)
	end)
	test("random searches select distinct real items and cannot count the same item twice", function()
		local p = Progression.newData()
		Contracts.assign(p, 100, 0.99, 0.5, 0.4)
		local c = p.life.contract
		equal(c.kind, "Find"); equal(#c.items, 2)
		assert(c.items[1] ~= c.items[2])
		for _, id in ipairs(c.items) do assert(Catalog.Items[id]); assert(Contracts.record(p, "Find", 1, id)); assert(not Contracts.record(p, "Find", 1, id)) end
		assert(not Contracts.record(p, "Find", 1, "fake"))
		equal(c.progress, 2)
		equal(Progression.normalize(p).life.contract.progress, 2)
	end)
	test("job swaps wait sixty seconds and persisted progress survives receipts and rejoin", function()
		local manager = harness(fakeStore())
		local profile = assert(manager:Load(8010, "first"))
		Contracts.assign(profile.data, 100, 0, 0, 0)
		assert(not Contracts.interact(profile.data, 159, 0.5, 0, 0, true))
		assert(Contracts.interact(profile.data, 160, 0.5, 0, 0, true))
		local kind = profile.data.life.contract.kind
		Contracts.record(profile.data, kind, 1)
		assert(manager:GrantReceipt(profile, "persist-job", 123, function(data) data.cash += 10; return true end))
		assert(manager:Save(profile, true))
		profile = assert(manager:Load(8010, "second"))
		equal(profile.data.life.contract.kind, kind)
		equal(profile.data.life.contract.progress, 1)
		equal(profile.data.cash, 10)
	end)
	test("admin flight requires a resolved admin identity and only changes that admin", function()
		assert(Permissions.authorize({ [11] = true }, 11, "SetFlying", 11))
		assert(not Permissions.authorize({ [11] = true }, 11, "SetFlying", 12))
		assert(not Permissions.authorize({ [11] = true }, 12, "SetFlying", 12))
	end)
end
