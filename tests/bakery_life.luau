local Life = require("../src/shared/BakeryLife")
local Progression = require("../src/shared/Progression")
local Crafting = require("../src/shared/CookieCrafting")
local Recipes = require("../src/shared/Recipes")
local Trades = require("../src/server/CookieTrades")
local ProfileStore = require("../src/server/ProfileStore")
local function cookie(id, recipe) return { id = id, recipe = recipe or 1, mask = 0 } end
return function(test, equal, near, harness, fakeStore)
	test("new inventory defaults are idempotent and old version-5 saves migrate losslessly", function()
		local p = Progression.newData()
		local normalized = Progression.normalize(p)
		equal(normalized.life.buff.recipe, p.life.buff.recipe)
		equal(normalized.life.pendingTrade, "")
		local store = fakeStore()
		p.cash, p.life, p.audio.music = 1234, nil, false
		store.records.Player_1010 = { Version = 5, Data = p, Receipts = { old = 12345 } }
		local profile = assert(harness(store):Load(1010, "valley"))
		equal(profile.data.cash, 1234)
		equal(profile.data.audio.music, false)
		equal(#profile.data.life.inventory, 0)
		equal(profile.receipts.old, 12345)
		equal(store.records.Player_1010.Version, ProfileStore.CURRENT_VERSION)
	end)
	test("inventory normalization rejects malformed cookies, deduplicates IDs, and caps storage", function()
		local raw = { inventory = { cookie("same"), cookie("same"), cookie("bad", 31), { id = "bad" }, cookie("ok", 30) }, dough = math.huge, pin = 99 }
		local normalized = Life.normalize(raw)
		equal(#normalized.inventory, 2)
		equal(normalized.dough, 0)
		equal(normalized.pin, 13)
		raw.inventory[1].recipe = 9
		equal(normalized.inventory[1].recipe, 1)
		for i = 1, 60 do table.insert(raw.inventory, cookie("item" .. i)) end
		equal(#Life.normalize(raw).inventory, 40)
	end)
	test("cookie value includes rarity, toppings, quality, packaging, boxing, and one finishing", function()
		local item = Life.cookie({ id = "deluxe", recipe = 30, mask = 31, quality = 10, wrapped = true, boxed = true, baked = true })
		equal(Life.value(item), math.floor(Recipes[30].Value * 6 * 1.75 * 3 * 1.25 * 1.5 * 3))
	end)
	test("bag capacity cannot be bypassed and oven cookies cannot be eaten or traded", function()
		local p = Progression.newData()
		for i = 1, 20 do assert(Life.add(p.life, cookie(tostring(i)))) end
		assert(not Life.add(p.life, cookie("overflow")))
		p.life.machines.FinishingOven = true
		assert(Life.startOven(p, "1", 100))
		assert(not Life.eat(p.life, "1", 101, 1))
		assert(not Life.available(p.life, "1"))
		assert(not Life.startOven(p, "2", 101))
		equal(#p.life.inventory, 20)
	end)
	test("eating consumes exactly one cookie and expires its speed boost after ninety seconds", function()
		local life = Life.normalize(nil)
		assert(Life.add(life, cookie("snack", 12)))
		assert(Life.eat(life, "snack", 100, 44))
		equal(#life.inventory, 0)
		equal(life.buff.recipe, 12)
		equal(life.buff.seed, 44)
		equal(Life.speed(life, 189), 14)
		equal(Life.speed(life, 190), 0)
		assert(not Life.eat(life, "snack", 191, 45))
	end)
	test("finishing waits twenty seconds, triples once, and restores its queue after rejoin", function()
		local p = Progression.newData()
		Life.add(p.life, cookie("oven", 5))
		assert(not Life.startOven(p, "oven", 100))
		p.life.machines.FinishingOven = true
		assert(Life.startOven(p, "oven", 100))
		local base = Life.value(p.life.inventory[1])
		assert(not Life.finishOven(p.life, 119))
		local restored = Progression.normalize(p)
		assert(Life.finishOven(restored.life, 120))
		equal(Life.value(restored.life.inventory[1]), base * 3)
		assert(not Life.finishOven(restored.life, 121))
		assert(not Life.startOven(restored, "oven", 121))
	end)
	test("machine, recipe mastery, pin, and dough purchases charge the correct balance once", function()
		local p = Progression.newData()
		p.cash, p.life.dough, p.life.belt = 1e8, 10000, 1
		local before = p.cash
		assert(Life.buyMachine(p, "Packager"))
		equal(p.cash, before - 25000)
		assert(not Life.buyMachine(p, "Packager"))
		assert(Life.upgradeRecipe(p, 1))
		equal(p.life.recipeLevels["1"], 1)
		assert(not Life.upgradeRecipe(p, 2))
		assert(Life.upgradePin(p))
		equal(p.life.pin, 2)
		assert(Life.upgradeDough(p, "Mixing"))
		equal(p.life.dough, 9975)
		near(Progression.multiplier(p), 1.25 * 1.1)
	end)
	test("every cookie has strictly increasing topping and mastery prices", function()
		for _, key in ipairs({ "Glaze", "Sprinkles" }) do
			for i = 2, #Recipes do assert(Crafting.cost(Recipes[i], key) > Crafting.cost(Recipes[i-1], key)) end
		end
		for i = 2, #Recipes do assert(Life.recipeCost(i, 0) > Life.recipeCost(i-1, 0)) end
		for level = 1, 9 do assert(Life.recipeCost(1, level) > Life.recipeCost(1, level-1)) end
	end)
	test("rebirth clears cookies, machines and mine upgrades while retaining unspent dough", function()
		local p = Progression.newData()
		Life.add(p.life, cookie("kept", 30))
		p.life.dough, p.life.pin, p.life.upgrades.Flow, p.life.machines.Boxer = 100, 3, 4, true
		p.life.recipeLevels["1"], p.cash, p.unlocked = 3, 1e8, 30
		assert(Progression.rebirth(p))
		equal(#p.life.inventory, 0)
		equal(p.life.dough, 100)
		equal(p.life.pin, 1)
		equal(p.life.upgrades.Flow, 0)
		equal(p.life.machines.Boxer, false)
		equal(p.life.recipeLevels["1"], 0)
	end)
	test("bargaining increases offers but repeated pitches eventually lose the customer", function()
		local accepted, price = Life.pitch(100, 0, 0.9)
		assert(accepted)
		equal(price, 140)
		accepted, price = Life.pitch(100, 2, 0.9)
		assert(accepted)
		equal(price, 180)
		assert(not Life.pitch(100, 0, 0.1))
		assert(not Life.pitch(100, 3, 1))
	end)

	local function setup()
		local store, journal = fakeStore(), fakeStore()
		local manager = harness(store)
		local a, b = assert(manager:Load(1101, "a")), assert(manager:Load(1102, "b"))
		Life.add(a.data.life, cookie("alpha", 5))
		Life.add(b.data.life, cookie("beta", 8))
		assert(manager:Save(a))
		assert(manager:Save(b))
		return store, journal, manager, a, b, Trades.new(journal, manager, function() end)
	end
	test("trade confirmation detects altered recipe, toppings, quality, or finishing", function()
		local offered = Life.cookie(cookie("offered", 5))
		assert(Life.sameCookie(offered, offered))
		for key, value in pairs({ recipe = 6, mask = 1, quality = 1, baked = true, wrapped = true, boxed = true, id = "different" }) do
			local changed = Life.cookie(offered)
			changed[key] = value
			assert(not Life.sameCookie(offered, changed), key)
		end
		assert(not Life.sameCookie(offered, nil))
	end)
	test("a reused journal ID with different offers cannot prepare either profile", function()
		local _, journal, _, a, b, trades = setup()
		journal.records.Trade_collision = { id = "collision", state = "Prepared", a = 1101, b = 1102, giveA = cookie("different"), giveB = cookie("beta", 8) }
		assert(not trades:Exchange("collision", a, 1101, "alpha", b, 1102, "beta"))
		equal(a.activityLock, nil)
		equal(b.activityLock, nil)
		equal(a.data.life.pendingTrade, "")
		assert(Life.find(a.data.life, "alpha"))
	end)
	test("confirmed cookie exchanges persist both ownership changes and deduplicate recovery", function()
		local _, journal, manager, a, b, trades = setup()
		assert(trades:Exchange("trade1", a, 1101, "alpha", b, 1102, "beta"))
		equal(journal.records.Trade_trade1.state, "Committed")
		equal(a.data.life.inventory[1].id, "beta")
		equal(b.data.life.inventory[1].id, "alpha")
		assert(trades:Recover(a, 1101, "trade1"))
		equal(#a.data.life.inventory, 1)
		assert(manager:Save(a, true))
		a = assert(manager:Load(1101, "rejoin"))
		equal(a.data.life.inventory[1].id, "beta")
	end)
	test("a confirmed cookie gift transfers one item without requiring a return cookie", function()
		local _, _, _, a, b, trades = setup()
		assert(trades:Exchange("gift", a, 1101, "alpha", b, 1102, nil))
		equal(#a.data.life.inventory, 0)
		equal(#b.data.life.inventory, 2)
		assert(Life.find(b.data.life, "alpha"))
	end)
	test("full bags, busy saves, missing cookies, and self trades cannot remove offers", function()
		local _, _, _, a, b, trades = setup()
		for i = 1, 19 do Life.add(b.data.life, cookie("full" .. i)) end
		assert(not trades:Exchange("full", a, 1101, "alpha", b, 1102))
		a.saving = true
		assert(not trades:Exchange("busy", a, 1101, "alpha", b, 1102, "beta"))
		a.saving = false
		assert(not trades:Exchange("self", a, 1101, "alpha", a, 1101, "alpha"))
		assert(not trades:Exchange("missing", a, 1101, "absent", b, 1102, "beta"))
		assert(Life.find(a.data.life, "alpha"))
	end)
	test("an activity lock blocks ordinary saves and paid receipts until the exchange settles", function()
		local _, _, manager, a = setup()
		a.activityLock = "protected"
		assert(not manager:Save(a))
		local ok, reason = manager:GrantReceipt(a, "paid", 12345, function(data) data.cash += 100; return true end)
		equal(ok, false)
		equal(reason, "busy")
		equal(a.data.cash, 0)
	end)
	test("uncommitted prepared trades abort on rejoin and retain the original cookies", function()
		local _, journal, manager, a, b, trades = setup()
		journal.records.Trade_crash = { id = "crash", state = "Prepared", a = 1101, b = 1102, giveA = cookie("alpha", 5), giveB = cookie("beta", 8) }
		a.data.life.pendingTrade, b.data.life.pendingTrade = "crash", "crash"
		assert(manager:Save(a, true))
		assert(manager:Save(b, true))
		a, b = assert(manager:Load(1101, "a2")), assert(manager:Load(1102, "b2"))
		assert(trades:Recover(a, 1101))
		assert(trades:Recover(b, 1102))
		equal(journal.records.Trade_crash.state, "Aborted")
		equal(a.data.life.inventory[1].id, "alpha")
		equal(b.data.life.inventory[1].id, "beta")
	end)
	test("a committed exchange recovers after one side saved and the server crashed", function()
		local _, journal, manager, a, b, trades = setup()
		local record = { id = "half", state = "Committed", a = 1101, b = 1102, giveA = cookie("alpha", 5), giveB = cookie("beta", 8) }
		journal.records.Trade_half = record
		a.data.life.pendingTrade, b.data.life.pendingTrade = "half", "half"
		assert(manager:Save(a))
		assert(manager:Save(b, true))
		assert(trades:Recover(a, 1101))
		assert(manager:Save(a, true))
		a, b = assert(manager:Load(1101, "a2")), assert(manager:Load(1102, "b2"))
		assert(trades:Recover(b, 1102))
		assert(trades:Recover(a, 1101, "half"))
		equal(#a.data.life.inventory, 1)
		equal(#b.data.life.inventory, 1)
		equal(a.data.life.inventory[1].id, "beta")
		equal(b.data.life.inventory[1].id, "alpha")
	end)
	test("lost profile-write responses reconcile cookie exchanges without duplication", function()
		local store, _, _, a, b, trades = setup()
		store.commitErrorsRemaining = 3
		assert(trades:Exchange("lost", a, 1101, "alpha", b, 1102, "beta"))
		equal(#a.data.life.inventory, 1)
		equal(#b.data.life.inventory, 1)
		equal(a.data.life.inventory[1].id, "beta")
	end)
	test("an unavailable trade journal leaves recovery references and inventory frozen", function()
		local _, journal, _, a, _, trades = setup()
		a.data.life.pendingTrade = "unknown"
		journal.errorsRemaining = 3
		assert(not trades:Recover(a, 1101))
		equal(a.data.life.pendingTrade, "unknown")
		equal(a.activityLock, "unknown")
		assert(Life.find(a.data.life, "alpha"))
	end)
end
