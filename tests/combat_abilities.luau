local P=require("../src/shared/Progression")
local Abilities=require("../src/shared/CombatAbilities")
local Obby=require("../src/shared/ObbyProgress")
local Claims=require("../src/shared/ObbyClaims")
local Courses=require("../src/shared/ObbyCatalog")
local Rewards=require("../src/shared/ObbyRewards")
return function(test,equal,near,harness,fakeStore)
 test("six combat moves buy once with dough and equip only their own slot",function()
  local p=P.newData(); p.life.dough=10000
  for _,id in ipairs(Abilities.Order) do
   local move=Abilities.Moves[id]; local before=p.life.dough
   assert(Abilities.purchase(p.life,id)); equal(p.life.dough,before-move.Cost)
   equal(p.life.abilities[move.Slot],id)
   assert(Abilities.purchase(p.life,id)); equal(p.life.dough,before-move.Cost)
  end
  assert(not Abilities.purchase(p.life,{})); assert(not Abilities.purchase(p.life,"Flying"))
  local empty=P.newData(); assert(not Abilities.purchase(empty.life,"Dodge")); equal(empty.life.abilities.E,"")
 end)
 test("ability normalization rejects forged ownership and mismatched slots",function()
  local a=Abilities.normalize({owned={Dodge=true,Spin="true",JumpAttack=true,Cheat=true},E="JumpAttack",Q="Dodge"})
  equal(a.E,""); equal(a.Q,""); equal(a.owned.Spin,nil); equal(a.owned.Cheat,nil)
  a=Abilities.normalize({owned={Dodge=true,JumpAttack=true},E="Dodge",Q="JumpAttack"})
  equal(a.E,"Dodge"); equal(a.Q,"JumpAttack")
 end)
 test("server cooldowns and active casts block spam, slot swaps and overlapping abilities",function()
  local p=P.newData(); p.life.dough=5000
  Abilities.purchase(p.life,"Dodge"); Abilities.purchase(p.life,"JumpAttack")
  local runtime={}
  equal(Abilities.cast(p.life.abilities,"E",runtime,100),"Dodge")
  equal(Abilities.cast(p.life.abilities,"E",runtime,100.1),nil)
  equal(Abilities.cast(p.life.abilities,"Q",runtime,100.1),nil)
  equal(Abilities.cast(p.life.abilities,"Q",runtime,101),"JumpAttack")
  Abilities.purchase(p.life,"Spin")
  equal(Abilities.cast(p.life.abilities,"E",runtime,105),nil)
  equal(Abilities.cast(p.life.abilities,"E",runtime,106),"Spin")
  equal(Abilities.cast(p.life.abilities,{},runtime,200),nil)
 end)
 test("defense effects expire precisely and move hit regions exclude distant or behind targets",function()
  equal(Abilities.protection(100,101,105),0)
  equal(Abilities.protection(101,101,105),.55)
  equal(Abilities.protection(105,101,105),1)
  assert(Abilities.inRange(3,2,4,5,1,true))
  assert(not Abilities.inRange(3,2,4,5,-1,true))
  assert(Abilities.inRange(3,2,4,5,-1,false))
  assert(not Abilities.inRange(3,11,4,5,1,false))
  assert(not Abilities.inRange(6,0,0,5,1,false))
 end)
 test("ability ownership persists through saves and receipts but resets with mine upgrades",function()
  local manager=harness(fakeStore()); local p=assert(manager:Load(804,"abilities"))
  p.data.life.dough=1000; Abilities.purchase(p.data.life,"Dodge"); Abilities.purchase(p.data.life,"JumpAttack")
  assert(manager:GrantReceipt(p,"other-reward",1,function(data) data.life.dough+=10; return true end))
  assert(manager:Save(p,true)); p=assert(manager:Load(804,"abilities-rejoin"))
  equal(p.data.life.abilities.E,"Dodge"); equal(p.data.life.abilities.Q,"JumpAttack")
  p.data.cash=P.rebirthRequirement(p.data).Cash; p.data.unlocked=30
  assert(P.rebirth(p.data)); equal(p.data.life.abilities.E,""); equal(next(p.data.life.abilities.owned),nil)
  equal(p.data.life.dough,760)
 end)
 test("all procedural combat poses stay finite and spin makes one full revolution",function()
  for _,id in ipairs(Abilities.Order) do for i=0,100 do
   for _,angle in pairs(Abilities.pose(id,i/100)) do assert(angle==angle and math.abs(angle)<=2*math.pi) end
  end end
  near(Abilities.pose("Spin",1).yaw,2*math.pi)
  near(Abilities.pose("Dodge",0).pitch,0); near(Abilities.pose("Dodge",1).pitch,0)
 end)
 test("short obby landings count while duplicate contacts, skips and premature prizes cannot",function()
  local course=Courses[1]; local run=Obby.start(course,100)
  assert(not Obby.advance(run,course,2,100.01))
  for stage=1,course.Count do
   assert(Obby.advance(run,course,stage,100+stage*.05))
   assert(not Obby.advance(run,course,stage,100+stage*.05+.01))
  end
  assert(not Obby.canFinish(run,course,true,101))
  assert(not Obby.canFinish(run,course,false,120))
  assert(Obby.canFinish(run,course,true,120))
 end)
 test("validated obby prizes retry after a busy save without requiring another landing",function()
  local queue=Claims.new(); local course=Courses[2]; local run=Obby.start(course,100)
  for stage=1,course.Count do Obby.advance(run,course,stage,100+stage) end
  assert(queue:Validate(1,run,course,true,130))
  local awards=0
  equal(queue:Attempt(1,course.Id,function() return false end),false)
  equal(queue:Attempt(1,Courses[3].Id,function() error("wrong course") end),nil)
  -- A respawn discards the running course; its validated claim stays queued.
  equal(queue:Validate(1,nil,course,false,140),false)
  local p=P.newData()
  assert(queue:Attempt(1,course.Id,function()
   awards+=1; return Rewards.complete(p,course.Id,1000,false)
  end))
  equal(awards,1); equal(p.boosts.obbyBonus,.3); equal(p.life.cards.crumbs,35)
  equal(queue:Attempt(1,course.Id,function() awards+=1; return true end),nil); equal(awards,1)
 end)
 test("obby claim exceptions remain retryable and reentrant callbacks cannot pay twice",function()
  local queue=Claims.new(); local course=Courses[1]; local run=Obby.start(course,0)
  for stage=1,course.Count do Obby.advance(run,course,stage,stage) end
  assert(queue:Validate(1,run,course,true,20))
  equal(queue:Attempt(1,course.Id,function() error("temporary failure") end),false)
  assert(queue:Attempt(1,course.Id,function()
   equal(queue:Attempt(1,course.Id,function() error("duplicate") end),nil)
   return true
  end))
 end)
end
