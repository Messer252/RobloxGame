          <string name="Name">AssetTextures</string>
          <string name="Source"><![CDATA[-- Optional: upload assets/textures/*.png using Studio's Asset Manager, then paste
-- each image's numeric asset ID (as a string) into the matching entry below.
-- Empty entries use the model's built-in Roblox materials and colors.
return {
