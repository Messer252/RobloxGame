      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CommerceServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("CookieTycoon")
local Catalog = require(shared.ShopCatalog)
local Rewards = require(shared.PurchaseRewards)
local Progression = require(shared.Progression)
local Commerce = {}
Commerce.__index = Commerce
local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local PENDING = Enum.ProductPurchaseDecision.NotProcessedYet

function Commerce:_state(player)
	local state = self.context.GetState(player)
	if not state or state.closing or state.profile.closed or state.profile.closing or state.profile.lost then return nil end
	if not state.profile.sessionOnly and os.time() >= state.profile.expiresAt then return nil end
	return state
end

function Commerce:_syncPerks(player, state)
	if self.context.GetState(player) ~= state or state.closing then return end
	player:SetAttribute("DoubleIncomeOwned", state.perks.DoubleIncome == true)
	player:SetAttribute("DoubleSpeedOwned", state.perks.DoubleSpeed == true)
	player:SetAttribute("PassesReady", state.passesReady == true)
	state.nextBake = math.min(state.nextBake, os.clock() + Progression.interval(state.data, state.perks))
	self.context.Refresh(player, state)
end

function Commerce:RefreshPasses(player)
	local state = self:_state(player)
	if not state or state.checkingPasses then return end
	state.checkingPasses = true
	local allChecked = true
	-- Keep honoring owned passes even if their buttons are hidden from PassOrder.
	for key, configured in pairs(Catalog.Passes) do
		local offer = Catalog.resolve("Pass", configured.Id)
		if offer then
			local ok, owned
			for attempt = 1, 3 do
				ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
				if ok then break end
				if attempt < 3 then task.wait(attempt) end
				if self:_state(player) ~= state then break end
			end
			if self:_state(player) ~= state then
				state.checkingPasses = false
				return
			end
			if ok then
				-- Preserve a confirmed purchase if a cached ownership read is stale.
				state.perks[key] = state.perks[key] == true or owned == true
			else
				allChecked = false
				warn("Cookie Corner: could not check pass ownership for " .. player.UserId .. " (" .. key .. ").")
			end
		end
	end
	state.checkingPasses = false
	state.passesReady = allChecked
	self:_syncPerks(player, state)
	if not allChecked then
		task.delay(30, function() if self:_state(player) == state then self:RefreshPasses(player) end end)
	end
end

function Commerce:StartPlayer(player)
	local state = self:_state(player)
	if not state then return end
	player:SetAttribute("CommerceReady", not state.profile.sessionOnly)
	player:SetAttribute("PurchasePending", false)
	player:SetAttribute("ShopPromptOpen", false)
	task.spawn(function() self:RefreshPasses(player) end)
end

function Commerce:Prompt(player, kind, key)
	if (kind ~= "Pass" and kind ~= "Product") or type(key) ~= "string" then return end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly or state.profile.transacting or (state.receiptWorkers or 0) > 0 then return end
	if state.shopPrompt or os.clock() - (state.lastShopPrompt or -math.huge) < 3 then return end
	local offer = Catalog.offer(kind, key)
	if not offer then
		self.context.Notify(player, "This item is not available yet.")
		return
	end
	state.lastShopPrompt = os.clock()
	-- Set this before any yielding ownership request, preventing overlapping prompts.
	local prompt = { Kind = kind, Id = offer.Id }
	state.shopPrompt = prompt
	player:SetAttribute("ShopPromptOpen", true)
	local function cancel(message)
		if state.shopPrompt == prompt then state.shopPrompt = nil end
		player:SetAttribute("ShopPromptOpen", false)
		if message then self.context.Notify(player, message) end
	end
	if kind == "Pass" then
		local ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
		if self:_state(player) ~= state then
			cancel()
			return
		end
		if not ok then
			cancel("Ownership could not be checked. Please try again shortly.")
			return
		end
		if owned or state.perks[key] then
			state.perks[key] = true
			self:_syncPerks(player, state)
			cancel("You already own " .. offer.Name .. ".")
			return
		end
	else
		if not Rewards.canFitCash(state.data, offer.Cash, Progression.MAX_CASH) then
			cancel("Spend some cookie cash before buying another bundle.")
			return
		end
		local receiptCount = 0
		for _ in pairs(state.profile.receipts) do receiptCount += 1 end
		if receiptCount >= Catalog.MaxPromptedReceipts then
			cancel("Cash bundles are unavailable for this bakery. Please contact the creator.")
			return
		end
	end
	if self:_state(player) ~= state or state.profile.transacting or (state.receiptWorkers or 0) > 0 then
		cancel()
		return
	end
	local ok = pcall(function()
		if kind == "Pass" then MarketplaceService:PromptGamePassPurchase(player, offer.Id)
		else MarketplaceService:PromptProductPurchase(player, offer.Id) end
	end)
	if not ok then cancel("Roblox could not open the purchase window. Please try again.") end
end

function Commerce:_fulfill(player, state, receipt, product)
	local attempt = 0
	while player.Parent == Players and not self.context.IsClosing() do
		if self:_state(player) ~= state or state.profile.sessionOnly then return PENDING end
		local ok, reason, detail = self.context.Profiles:GrantReceipt(state.profile, receipt.PurchaseId, receipt.ProductId, function(data)
			return Rewards.cash(data, product.Cash, Progression.MAX_CASH)
		end)
		if ok then
			if self.context.GetState(player) == state and not state.closing then
				state.nextSave = os.clock() + self.context.AutosaveSeconds
				self.context.Refresh(player, state)
				if reason ~= "duplicate" then
					self.context.Notify(player, "$" .. Progression.format(product.Cash) .. " cookie cash purchased and saved! Cash resets on rebirth.")
				end
			end
			return GRANTED -- The cash AND receipt ID are now durable in the same record.
		end
		if reason == "busy" then
			task.wait(0.2)
		elseif reason == "unavailable" then
			attempt += 1
			warn("Cookie Corner: purchase save pending for " .. player.UserId .. ": " .. tostring(detail or reason))
			if attempt == 1 then self.context.Notify(player, "Your purchase is waiting for saving to reconnect. Please wait.") end
			task.wait(math.min(10, attempt * 2))
		else
			warn("Cookie Corner: purchase not acknowledged for " .. player.UserId .. ": " .. tostring(reason))
			if reason == "lost" then
				player:Kick("Your purchase is pending on a newer bakery session. Rejoin to load it safely.")
			elseif reason == "capacity" then
				self.context.Notify(player, "Your cash bundle is pending. Spend some cash and rejoin to receive it.")
			end
			return PENDING
		end
	end
	return PENDING
end

function Commerce:ProcessReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then return PENDING end
	-- Roblox does not periodically retry NotProcessedYet. Wait for this join's
	-- profile load and retry transient save failures inside the callback itself.
	while self.context.IsLoading(player) and player.Parent == Players and not self.context.IsClosing() do task.wait(0.1) end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly then return PENDING end
	-- An already durable receipt remains acknowledgeable even after an offer is
	-- retired. New/ungranted receipts still need their original product mapping.
	if state.profile.receipts[receipt.PurchaseId] == receipt.ProductId then return GRANTED end
	local product = Catalog.resolve("Product", receipt.ProductId)
	if not product or not Catalog.validId(product.Cash) or product.Cash > Progression.MAX_CASH then
		warn("Cookie Corner: unconfigured product receipt " .. tostring(receipt.ProductId) .. "; it remains pending.")
		return PENDING
	end
	state.receiptWorkers = (state.receiptWorkers or 0) + 1
	player:SetAttribute("PurchasePending", true)
	player:SetAttribute("DataStatus", "PurchasePending")
	local ok, decision = pcall(function() return self:_fulfill(player, state, receipt, product) end)
	state.receiptWorkers -= 1
	if self.context.GetState(player) == state and not state.closing then
		local pending = state.profile.transacting or state.receiptWorkers > 0
		player:SetAttribute("PurchasePending", pending)
		player:SetAttribute("DataStatus", pending and "PurchasePending" or ok and "Saved" or "SaveFailed")
	end
	if not ok then
		warn("Cookie Corner receipt handler failed: " .. tostring(decision))
		return PENDING
	end
	return decision
end

function Commerce.start(context, requestPurchase, refreshPasses)
	local self = setmetatable({ context = context }, Commerce)
	-- This is the experience's only ProcessReceipt owner. Never grant products
	-- from PromptProductPurchaseFinished or a client-supplied success message.
	MarketplaceService.ProcessReceipt = function(receipt) return self:ProcessReceipt(receipt) end
	requestPurchase.OnServerEvent:Connect(function(player, kind, key) self:Prompt(player, kind, key) end)
	refreshPasses.OnServerEvent:Connect(function(player)
		local state = self:_state(player)
		if not state or os.clock() - (state.lastPassRefresh or -math.huge) < 10 then return end
		state.lastPassRefresh = os.clock()
		task.spawn(function() self:RefreshPasses(player) end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, wasPurchased)
		local state = self:_state(player)
		if not state then return end
		if state.shopPrompt and state.shopPrompt.Kind == "Pass" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
		local pass, key = Catalog.resolve("Pass", id)
		if wasPurchased and pass then
			-- This event is server-side: Roblox supplies the confirmed final outcome.
			state.perks[key] = true
			self:_syncPerks(player, state)
			context.Notify(player, pass.Name .. " unlocked! It stays through every rebirth.")
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, id)
		local player = Players:GetPlayerByUserId(userId)
		local state = player and self:_state(player)
		if state and state.shopPrompt and state.shopPrompt.Kind == "Product" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
	end)
	return self
end

return Commerce
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Presentation = {}

local cream = Color3.fromRGB(255, 239, 210)
local cocoa = Color3.fromRGB(89, 58, 48)
local gold = Color3.fromRGB(255, 211, 129)
local themes = {
	Color3.fromRGB(126, 192, 171), Color3.fromRGB(225, 146, 157),
	Color3.fromRGB(171, 157, 211), Color3.fromRGB(228, 186, 116),
}

local function part(parent, name, size, frame, tint, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = frame
	object.Color = tint
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function light(target, brightness, range)
	local object = Instance.new("PointLight")
	object.Color = Color3.fromRGB(255, 218, 157)
	object.Brightness = brightness
	object.Range = range
	object.Shadows = false
	object.Parent = target
	return object
end

function Presentation.lighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4
	Lighting.Ambient = Color3.fromRGB(130, 112, 112)
	Lighting.OutdoorAmbient = Color3.fromRGB(162, 151, 135)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 239, 217)
	Lighting.EnvironmentDiffuseScale = 0.65
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ExposureCompensation = 0.05
	-- LightingStyle replaced the older, restricted Technology property.
	pcall(function() Lighting.LightingStyle = Enum.LightingStyle.Soft end)
	for _, name in ipairs({ "CookieAtmosphere", "CookieBloom", "CookieColor", "CookieSun" }) do
		local previous = Lighting:FindFirstChild(name)
		if previous then previous:Destroy() end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CookieAtmosphere"
	atmosphere.Density = 0.2
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 239, 220)
	atmosphere.Decay = Color3.fromRGB(194, 174, 159)
	atmosphere.Haze = 1.1
	atmosphere.Glare = 0.08
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CookieBloom"
	bloom.Intensity = 0.16
	bloom.Size = 24
	bloom.Threshold = 1.65
	bloom.Parent = Lighting
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "CookieColor"
	correction.Brightness = 0.015
	correction.Contrast = 0.08
	correction.Saturation = 0.1
	correction.TintColor = Color3.fromRGB(255, 249, 240)
	correction.Parent = Lighting
	local sun = Instance.new("SunRaysEffect")
	sun.Name = "CookieSun"
	sun.Intensity = 0.025
	sun.Spread = 0.8
	sun.Parent = Lighting
end

function Presentation.world(world)
	for _, object in ipairs(world:GetDescendants()) do
		if object:IsA("BasePart") and object.Name == "Lamp" then light(object, 0.6, 20) end
	end
	for _, x in ipairs({ -14.6, 14.6 }) do
		part(world, "Cream Path Border", Vector3.new(0.7, 0.25, 520), CFrame.new(x, 0.15, 0), cream, Enum.Material.Concrete)
	end
	for _, x in ipairs({ -235, 235 }) do
		for index = -2, 2 do
			local hill = part(world, "Pastel Meadow Hill", Vector3.new(105, 70, 118), CFrame.new(x, -19, index * 145),
				Color3.fromRGB(139 + (index % 2) * 9, 177, 132), Enum.Material.Grass)
			hill.Shape = Enum.PartType.Ball
		end
	end
	for _, x in ipairs({ -34, 34 }) do
		local seat = part(world, "Plaza Bench", Vector3.new(12, 0.6, 4), CFrame.new(x, 2.1, 0), cocoa, Enum.Material.WoodPlanks)
		seat.CanCollide = true
		for _, offset in ipairs({ -4, 4 }) do
			part(world, "Bench Leg", Vector3.new(0.6, 2, 3), CFrame.new(x + offset, 1, 0), cocoa, Enum.Material.Metal)
		end
		part(world, "Bench Back", Vector3.new(12, 2.7, 0.5), CFrame.new(x, 3.5, 1.8), cream, Enum.Material.WoodPlanks)
	end
	local base = part(world, "Cookie Monument Plinth", Vector3.new(0.7, 10, 10),
		CFrame.new(0, 0.7, 19) * CFrame.Angles(0, 0, math.pi / 2), cream, Enum.Material.Marble)
	base.Shape = Enum.PartType.Cylinder
	part(world, "Monument Pedestal", Vector3.new(5, 3.4, 5), CFrame.new(0, 2.6, 19), cocoa, Enum.Material.Wood)
end

function Presentation.plot(plot, slot)
	local theme = themes[slot]
	plot.theme = theme
	for _, object in ipairs(plot.model:GetDescendants()) do
		if not object:IsA("BasePart") then continue end
		if object.Name == "Texture_WallTile" then object.Color = cream:Lerp(theme, 0.16) end
		if object.Name == "Canopy Stripe" and object.Color.R < 0.85 then object.Color = theme end
		if object.Name == "Texture_BakeryFloor" then
			object.Color = Color3.fromRGB(240, 221, 195)
			object.Material = Enum.Material.SmoothPlastic
		end
	end
	local function frame(x, y, z)
		return CFrame.new(plot.origin + Vector3.new(x, y, z * plot.direction))
			* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
	end
	for column = 0, 3 do
		for row = 0, 5 do
			if (column + row) % 2 == 0 then
				part(plot.model, "Vanilla Floor Tile", Vector3.new(39.8, 0.035, 39.8), frame(-60 + column * 40, 0.525, -100 + row * 40),
					Color3.fromRGB(255, 243, 223))
			end
		end
	end
	part(plot.model, "Center Aisle", Vector3.new(5, 0.035, 232), frame(0, 0.565, 0), theme:Lerp(cream, 0.55))
	for _, x in ipairs({ -60, -30, 0, 30, 60 }) do
		part(plot.model, "Window Frame", Vector3.new(22, 7.6, 0.28), frame(x, 7.1, -119.9), cocoa)
		local window = part(plot.model, "Pastel Window", Vector3.new(20.7, 6.3, 0.3), frame(x, 7.1, -119.65),
			Color3.fromRGB(190, 220, 219), Enum.Material.Glass)
		window.Transparency = 0.15
		part(plot.model, "Window Mullion", Vector3.new(0.3, 6.5, 0.35), frame(x, 7.1, -119.4), cream)
	end
	for _, z in ipairs({ -80, 40, 112 }) do
		for _, x in ipairs({ -77, 77 }) do
			part(plot.model, "String Light Post", Vector3.new(0.5, 16, 0.5), frame(x, 8, z), cocoa, Enum.Material.Wood)
		end
		local previous
		for index = 0, 10 do
			local x = -77 + index * 15.4
			local y = 16 - math.sin(index / 10 * math.pi) * 1.8
			local anchor = frame(x, y, z).Position
			if previous then
				local length = (anchor - previous).Magnitude
				part(plot.model, "Light Cable", Vector3.new(0.07, 0.07, length),
					CFrame.lookAt((anchor + previous) / 2, anchor), cocoa)
			end
			previous = anchor
			if index == 0 or index == 10 then continue end
			local bulb = part(plot.model, "Warm String Bulb", Vector3.new(0.65, 0.85, 0.65), frame(x, y - 0.35, z), gold, Enum.Material.Neon)
			bulb.Shape = Enum.PartType.Ball
			bulb.CastShadow = false
			if index == 3 or index == 7 then light(bulb, 0.3, 27) end
		end
	end
end

function Presentation.oven(oven)
	local chimney = oven:FindFirstChild("Chimney")
	if not chimney then return nil end
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, chimney.Size.Y / 2, 0)
	attachment.Parent = chimney
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Bakery Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(Color3.fromRGB(255, 247, 228))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1.9) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.82), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(1.5, 2)
	steam.Speed = NumberRange.new(1.2, 1.7)
	steam.Rate = 0.7
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Acceleration = Vector3.new(0.25, 0.5, 0)
	steam.Enabled = false
	steam.Parent = attachment
	return steam
end

return Presentation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[-- DataStore adapter with no engine dependencies, allowing failure/concurrency tests.
-- All writes check the session token inside UpdateAsync; stale servers cannot overwrite.
local ProfileStore = {}
ProfileStore.__index = ProfileStore

local function validRecord(current)
	if type(current) ~= "table" or (current.Version ~= 1 and current.Version ~= 2 and current.Version ~= 3) or type(current.Data) ~= "table" then return false end
	if current.Receipts ~= nil and type(current.Receipts) ~= "table" then return false end
	if current.Version >= 2 and current.Receipts == nil then return false end
	for id, productId in pairs(current.Receipts or {}) do
		if type(id) ~= "string" or #id == 0 or #id > 200 or type(productId) ~= "number"
			or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then return false end
	end
	return true
end

local function receiptsCopy(receipts)
	local result = {}
	for id, productId in pairs(receipts or {}) do result[id] = productId end
	return result
end

function ProfileStore.new(store, options)
	return setmetatable({
		store = store,
		clock = options.clock,
		wait = options.wait,
		copy = options.copy,
		lease = options.lease or 180,
	}, ProfileStore)
end

function ProfileStore:_update(key, transform)
	local lastError
	for attempt = 1, 3 do
		local success, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
		if success then return true, result end
		lastError = result
		if attempt < 3 then self.wait(attempt) end
	end
	return false, lastError
end

function ProfileStore:Load(userId, token)
	local key = "Player_" .. tostring(userId)
	local reason
	local ok, result = self:_update(key, function(current)
		reason = nil
		if current ~= nil then
			if not validRecord(current) then
				reason = "unsupported"
				return nil
			end
			local session = current.Session
			if session ~= nil then
				if type(session) ~= "table" or type(session.Id) ~= "string" or type(session.ExpiresAt) ~= "number" then
					reason = "unsupported"
					return nil
				end
				if session.Id ~= token and session.ExpiresAt > self.clock() then
					reason = "locked"
					return nil
				end
			end
		end
		return {
			Version = 3,
			Data = self.copy(current and current.Data),
			Receipts = receiptsCopy(current and current.Receipts),
			Session = { Id = token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	if not ok then return nil, "unavailable", result end
	if not result or reason then return nil, reason or "unavailable" end
	return {
		key = key, token = token, data = self.copy(result.Data),
		receipts = receiptsCopy(result.Receipts), transacting = false,
		expiresAt = result.Session.ExpiresAt, saving = false, closing = false, closed = false, lost = false,
	}
end

function ProfileStore:Save(profile, release)
	if profile.closed or profile.lost then return false, "lost" end
	if release then
		profile.closing = true
		while profile.saving do self.wait(0.1) end
		if profile.closed or profile.lost then return false, "lost" end
	elseif profile.saving or profile.closing then
		return false, "busy"
	end
	-- An ambiguous receipt write may already have committed. Never overwrite its
	-- reward with the old local snapshot, including during departure/shutdown.
	if profile.transacting then return false, "receipt_pending" end
	profile.saving = true
	-- Snapshot after waiting, so a final release includes the newest gameplay state.
	local snapshot = self.copy(profile.data)
	local ok, result = self:_update(profile.key, function(current)
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			return nil
		end
		return {
			Version = 3, Data = snapshot, Receipts = receiptsCopy(current.Receipts),
			Session = if release then nil else { Id = profile.token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then return false, "unavailable", result end
	if not result then
		profile.lost = true
		return false, "lost"
	end
	if release then profile.closed = true else profile.expiresAt = result.Session.ExpiresAt end
	return true
end

function ProfileStore:GrantReceipt(profile, receiptId, productId, grant)
	if type(receiptId) ~= "string" or #receiptId == 0 or #receiptId > 200
		or type(productId) ~= "number" or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then
		return false, "invalid"
	end
	if profile.receipts and profile.receipts[receiptId] then
		return profile.receipts[receiptId] == productId, "duplicate"
	end
	if profile.closed or profile.closing or profile.lost or profile.sessionOnly then return false, "unavailable_profile" end
	if profile.saving then return false, "busy" end
	if profile.pendingReceipt and (profile.pendingReceipt.Id ~= receiptId or profile.pendingReceipt.ProductId ~= productId) then
		return false, "busy"
	end
	if not profile.pendingReceipt then
		profile.pendingReceipt = { Id = receiptId, ProductId = productId, Snapshot = self.copy(profile.data) }
	end
	profile.transacting = true
	profile.saving = true
	local reason
	local ok, result = self:_update(profile.key, function(current)
		reason = nil
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			reason = "lost"
			return nil
		end
		local ledger = receiptsCopy(current.Receipts)
		local data
		if ledger[receiptId] then
			if ledger[receiptId] ~= productId then
				reason = "conflict"
				return nil
			end
			data = current.Data -- A prior attempt may have committed despite a network error.
		else
			-- UpdateAsync can call this transform multiple times. Always start from
			-- the same frozen snapshot, never from a previously rewarded copy.
			data = self.copy(profile.pendingReceipt.Snapshot)
			local granted, failure = grant(data)
			if not granted then
				reason = failure or "invalid_reward"
				return nil
			end
			ledger[receiptId] = productId
		end
		return {
			Version = 3, Data = data, Receipts = ledger,
			Session = { Id = profile.token, ExpiresAt = self.clock() + self.lease }, UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then
		-- Keep the economy frozen until retry/rejoin reconciles the uncertain write.
		return false, "unavailable", result
	end
	if not result then
		profile.pendingReceipt = nil
		profile.transacting = false
		if reason == "lost" then profile.lost = true end
		return false, reason or "unavailable"
	end
	-- Preserve the table identity used by the running tycoon state.
	table.clear(profile.data)
	for key, value in pairs(self.copy(result.Data)) do profile.data[key] = value end
	profile.receipts = receiptsCopy(result.Receipts)
	profile.expiresAt = result.Session.ExpiresAt
	profile.pendingReceipt = nil
	profile.transacting = false
	return true, "granted"
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[return {
	-- Use a separate published test experience for persistence testing.
	DataStoreName = "CookieCorner_PlayerData_v1",
	AutosaveSeconds = 45,
	SessionLeaseSeconds = 180,
	-- Explicit opt-in for offline Studio play only. Always ignored on live servers.
	-- Session-only play never reads/writes a fallback profile to the real DataStore.
	AllowStudioSessionOnly = false,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")
local Recipes = require(ReplicatedStorage.CookieTycoon.Recipes)
local Progression = require(ReplicatedStorage.CookieTycoon.Progression)
local Crafting = require(ReplicatedStorage.CookieTycoon.CookieCrafting)
local Assets = require(script.Parent.AssetLibrary)
local Presentation = require(script.Parent.Presentation)
local World = {}

local function color(rgb) return Color3.fromRGB(rgb[1], rgb[2], rgb[3]) end

local function part(name, size, position, tint, parent)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Color = tint
	object.Anchored = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function label(target, text, distance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(200, 58)
	gui.StudsOffset = Vector3.new(0, 4, 0)
	gui.MaxDistance = distance or 48
	gui.LightInfluence = 0
	gui.Parent = target
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundColor3 = Color3.fromRGB(64, 44, 39)
	textLabel.BackgroundTransparency = 0.12
	textLabel.Text = text
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 1
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = textLabel
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 7)
	padding.PaddingRight = UDim.new(0, 7)
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = textLabel
	return textLabel
end

local function prompt(target, action, callback, objectText)
	local interaction = Instance.new("ProximityPrompt")
	interaction.ActionText = action
	interaction.ObjectText = objectText or target.Name
	interaction.HoldDuration = 0.2
	interaction.MaxActivationDistance = 12
	interaction.RequiresLineOfSight = false
	interaction.Parent = target
	interaction.Triggered:Connect(function(player)
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		if root and (root.Position - target.Position).Magnitude <= 16 then callback(player) end
	end)
	return interaction
end

local function position(plot, x, y, z)
	return plot.origin + Vector3.new(x, y, z * plot.direction)
end

local function prop(plot, name, x, z, y)
	local pivot = CFrame.new(position(plot, x, y or 0.5, z))
		* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
	return Assets.prop(name, plot.model, pivot)
end

function World.updateBank(plot, data)
	plot.bankText.Text = "Collect earnings\n$" .. Progression.format(data and data.bank or 0)
end

function World.refresh(plot, data, perks)
	plot.sign.Text = plot.owner and (plot.owner.DisplayName .. "'s Bakery") or "Unclaimed Bakery"
	plot.claimPrompt.Enabled = plot.owner == nil
	plot.claimSurface.Color = plot.owner and plot.theme or Color3.fromRGB(129, 219, 175)
	plot.claimSurface.Material = plot.owner and Enum.Material.SmoothPlastic or Enum.Material.Neon
	World.updateBank(plot, data)
	plot.upgradePrompt.Enabled = data ~= nil and data.level < Progression.MAX_OVEN_LEVEL
	plot.upgradeText.Text = not data and "Upgrade ovens" or data.level == Progression.MAX_OVEN_LEVEL and "Ovens MAXED!"
		or "Oven level " .. data.level .. "\n$" .. Progression.format(Progression.ovenCost(data))
	plot.shopPrompt.Enabled = data ~= nil
	plot.workshopPrompt.Enabled = data ~= nil
	local nextStation = data and plot.stations[data.unlocked + 1]
	plot.nextMarker.Adornee = nextStation and nextStation.purchaseModel or nil
	plot.nextMarker.Enabled = nextStation ~= nil
	for index, station in ipairs(plot.stations) do
		local unlocked = data ~= nil and index <= data.unlocked
		local rarity = Crafting.rarity(Recipes[index])
		local nextRecipe = data ~= nil and index == data.unlocked + 1
		station.purchase.Enabled = nextRecipe
		station.pad.Color = unlocked and plot.theme or nextRecipe and Color3.fromRGB(255, 214, 139) or Color3.fromRGB(132, 125, 120)
		station.pad.Material = nextRecipe and Enum.Material.Neon or Enum.Material.SmoothPlastic
		if station.steam then station.steam.Enabled = unlocked end
		station.text.Text = (nextRecipe and "NEXT • " or index .. ". ") .. Recipes[index].Name .. "\n" .. rarity.Name .. " x" .. rarity.Multiplier
			.. (unlocked and " • $" .. Progression.format(Progression.recipeValue(data, index, perks)) .. " / cookie" or "\nUnlock $" .. Progression.format(Recipes[index].Cost))
		station.text.TextColor3 = unlocked and color(rarity.Color) or Color3.fromRGB(210, 210, 210)
		station.oven.Color = unlocked and color(rarity.Color) or Color3.fromRGB(90, 96, 107)
		station.window.Color = unlocked and Color3.fromRGB(246, 151, 61) or Color3.fromRGB(48, 59, 66)
		station.window.Material = unlocked and Enum.Material.Neon or Enum.Material.Glass
	end
end

function World.create(onClaim, onAction, onShop, onWorkshop)
	Presentation.lighting()
	local world = Instance.new("Folder")
	world.Name = "CookieTycoonWorld"
	world.Parent = workspace
	local plots = {}
	local meadow = part("Meadow", Vector3.new(410, 1, 590), Vector3.new(0, -1, 0), Color3.fromRGB(111, 166, 111), world)
	meadow.Material = Enum.Material.Grass
	Assets.texture(meadow, "MeadowGrass")
	for segment = -6, 6 do
		Assets.prop("PathSegment", world, CFrame.new(0, 0, segment * 40))
	end
	Assets.prop("SpawnPlaza", world, CFrame.new(0, 0.2, 0))
	for _, x in ipairs({ -191, 191 }) do
		for _, z in ipairs({ -225, -85, 85, 225 }) do
			Assets.prop("CookieTree", world, CFrame.new(x, 0, z))
		end
	end
	for _, x in ipairs({ -10, 10 }) do
		for _, z in ipairs({ -220, -70, 70, 220 }) do
			Assets.prop("Lamppost", world, CFrame.new(x, 0.15, z))
		end
	end
	Presentation.world(world)
	local sculpture = Assets.cookie(1, world, CFrame.new(0, 7.6, 19) * CFrame.Angles(math.rad(75), 0, 0))
	sculpture.Name = "Cookie Corner Monument"
	sculpture:ScaleTo(2.9)
	local spawn = Instance.new("SpawnLocation")
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = world
	label(spawn, "COOKIE CORNER\nClaim a bakery! Your progress follows you.", 95)
	for slot = 1, 4 do
		local model = Instance.new("Model")
		model.Name = "Bakery" .. slot
		model.Parent = world
		local plot = {
			model = model, stations = {}, owner = nil, visualCursor = 0,
			origin = Vector3.new(slot % 2 == 0 and 98 or -98, 0, slot <= 2 and -144 or 144),
			direction = slot <= 2 and 1 or -1,
		}
		local marker = Instance.new("Highlight")
		marker.Name = "Next Recipe"
		marker.DepthMode = Enum.HighlightDepthMode.Occluded
		marker.FillColor = Color3.fromRGB(255, 211, 129)
		marker.FillTransparency = 0.85
		marker.OutlineColor = Color3.fromRGB(255, 228, 168)
		marker.Enabled = false
		marker.Parent = model
		plot.nextMarker = marker
		table.insert(plots, plot)
		prop(plot, "BakeryFloor", 0, 0, 0)
		prop(plot, "BakeryShell", 0, 0, 0)
		prop(plot, "BakeryAwning", 0, 113)
		local counter = prop(plot, "PrepCounter", 0, -116)
		local worktop = counter:FindFirstChild("Texture_CounterMarble")
		label(worktop, "Cookie Workshop\nRarities & toppings", 65)
		plot.workshopPrompt = prompt(worktop, "Open workshop", function(player) onWorkshop(player, plot) end, "Cookie Workshop")
		prop(plot, "IngredientBins", -24, -116)
		prop(plot, "DoughMixer", 14, -116)
		prop(plot, "CoolingRack", 28, -116)
		prop(plot, "Planter", -75, 102)
		prop(plot, "Planter", 75, 102)
		prop(plot, "WoodenFence", -64, 120)
		prop(plot, "WoodenFence", 64, 120)
		local sign = prop(plot, "BakerySign", 0, 120)
		plot.sign = label(Assets.anchor(sign), "Unclaimed Bakery", 100)
		local claim = prop(plot, "ClaimPad", -63, 109)
		plot.claimSurface = claim:FindFirstChild("Claim Surface")
		plot.claimPrompt = prompt(Assets.anchor(claim), "Claim free bakery", function(player) onClaim(player, plot) end, "Cookie Bakery")
		label(Assets.anchor(claim), "Claim bakery", 65)
		local collect = prop(plot, "CollectionRegister", -21, 109)
		plot.bankText = label(Assets.anchor(collect), "Collect earnings\n$0", 65)
		prompt(Assets.anchor(collect), "Collect cash", function(player) onAction(player, "Collect", nil, plot) end, "Bakery Register")
		local upgrade = prop(plot, "UpgradeConsole", 21, 109)
		plot.upgradeText = label(Assets.anchor(upgrade), "Upgrade ovens", 65)
		plot.upgradePrompt = prompt(Assets.anchor(upgrade), "Upgrade speed", function(player) onAction(player, "UpgradeOven", nil, plot) end, "Oven Upgrades")
		local shop = prop(plot, "RebirthPedestal", 63, 109)
		label(Assets.anchor(shop), "Golden Chips\nRebirth & permanent upgrades", 65)
		plot.shopPrompt = prompt(Assets.anchor(shop), "Open bakery menu", function(player) onShop(player, plot) end, "Golden Chip Shop")
		for index, recipe in ipairs(Recipes) do
			local column = (index - 1) % 6
			local row = math.floor((index - 1) / 6)
			local x, z = -60 + column * 24, -100 + row * 40
			local ovenModel = prop(plot, "Oven", x, z)
			local oven = ovenModel:FindFirstChild("RecipeBadge")
			prop(plot, "Conveyor", x, z + 19)
			local buyModel = prop(plot, "ClaimPad", x, z + 29, 1.4)
			buyModel.Name = "Unlock " .. recipe.Name
			buyModel:ScaleTo(0.7)
			local buy = buyModel:FindFirstChild("Claim Surface")
			buy.Color = color(recipe.Color)
			local station = {
				oven = oven, window = ovenModel:FindFirstChild("Window"), x = x, z = z,
				text = label(oven, recipe.Name), pad = buy, purchaseModel = buyModel, steam = Presentation.oven(ovenModel),
			}
			station.purchase = prompt(buy, "Unlock recipe", function(player) onAction(player, "BuyRecipe", index, plot) end, recipe.Name)
			table.insert(plot.stations, station)
		end
		Presentation.plot(plot, slot)
		World.refresh(plot, nil)
	end
	return plots
end

function World.animate(plot, data, perks)
	-- Show at most four detailed cookies per visual batch. Income includes every oven.
	-- Keeping animations independent of oven speed bounds replicated part creation.
	for _ = 1, math.min(4, data.unlocked) do
		plot.visualCursor = plot.visualCursor % data.unlocked + 1
		local index = plot.visualCursor
		local station = plot.stations[index]
		local start = position(plot, station.x, 2.1, station.z + 9)
		local flags = data.modifiers[tostring(index)]
		local model = Assets.cookie(index, plot.model, CFrame.new(start), flags)
		local rarity = Crafting.rarity(Recipes[index])
		local value = Progression.recipeValue(data, index, perks)
		model:SetAttribute("CashValue", value)
		local toppingCount = 0
		for _, key in ipairs(Crafting.ModifierOrder) do if flags and flags[key] then toppingCount += 1 end end
		local badge = label(model.PrimaryPart, rarity.Name .. " • $" .. Progression.format(value)
			.. "\n" .. (toppingCount > 0 and toppingCount .. " topping upgrades" or Recipes[index].Name), 28)
		badge.TextColor3 = color(rarity.Color)
		badge.Parent.Size = UDim2.fromOffset(165, 44)
		badge.Parent.StudsOffset = Vector3.new(0, 1.7, 0)
		for _, object in ipairs(model:GetDescendants()) do
			if not object:IsA("BasePart") then continue end
			object.CanCollide = false
			object.CanTouch = false
			object.CanQuery = false
			TweenService:Create(object, TweenInfo.new(1.3, Enum.EasingStyle.Linear), {
				Position = object.Position + Vector3.new(0, 0, 17 * plot.direction),
			}):Play()
		end
		Debris:AddItem(model, 1.4)
	end
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
