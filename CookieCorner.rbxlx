local feedbackConnection = feedback.OnClientEvent:Connect(function(cue)
	audio:PlayCue(cue)
	if cue == "Error" or cue == "Click" then return end
	hudStroke.Color = gold
	hudStroke.Transparency = 0.05
	hudStroke.Thickness = 2
	TweenService:Create(hudStroke, TweenInfo.new(0.65), { Transparency = 0.65, Thickness = 1 }):Play()
	toastStroke.Color = cue == "Rebirth" and gold or Color3.fromRGB(151, 218, 182)
	local count = cue == "Rebirth" and 20 or cue == "BuyRecipe" and 12 or 7
	for index = 1, count do
		local spark = Instance.new("Frame")
		spark.AnchorPoint = Vector2.new(0.5, 0.5)
		spark.Size = UDim2.fromOffset(index % 2 == 0 and 7 or 4, 7)
		spark.Position = UDim2.fromScale(0.5, 0.42)
		spark.BackgroundColor3 = index % 3 == 0 and Color3.fromRGB(159, 222, 197) or gold
		spark.BorderSizePixel = 0
		spark.ZIndex = 12
		spark.Rotation = index * 47
		spark.Parent = gui
		round(spark, 2)
		local angle = index / count * math.pi * 2
		local radius = cue == "Rebirth" and 150 or 75
		TweenService:Create(spark, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
			Position = UDim2.new(0.5, math.cos(angle) * radius, 0.42, math.sin(angle) * radius + 25),
			BackgroundTransparency = 1, Rotation = spark.Rotation + 80,
		}):Play()
		Debris:AddItem(spark, 0.75)
	end
end)
gui.Destroying:Connect(function()
	feedbackConnection:Disconnect()
	audio:Destroy()
end)

local cash = player:WaitForChild("leaderstats"):WaitForChild("Cash")
local function currentData()
	local data = {
		cash = cash.Value, bank = player:GetAttribute("Bank") or 0,
		unlocked = player:GetAttribute("RecipeCount") or 1, level = player:GetAttribute("OvenLevel") or 1,
		rebirths = player:GetAttribute("Rebirths") or 0, chips = player:GetAttribute("GoldenChips") or 0,
		permanent = {
			Yield = player:GetAttribute("YieldLevel") or 0,
			Speed = player:GetAttribute("SpeedLevel") or 0,
			Starter = player:GetAttribute("StarterLevel") or 0,
		},
		perks = {
			DoubleIncome = player:GetAttribute("DoubleIncomeOwned") == true,
			DoubleSpeed = player:GetAttribute("DoubleSpeedOwned") == true,
			ThirdCardSlot = player:GetAttribute("ThirdCardSlotOwned") == true,
			Now = math.floor(workspace:GetServerTimeNow()),
		},
		boosts = {
			paidTier = player:GetAttribute("PaidBoostTier") or 0,
			obbyBonus = player:GetAttribute("ObbyBonus") or 0,
			obbyExpires = player:GetAttribute("ObbyExpires") or 0,
		},
		modifiers = {},
	}
	for index = 1, #Recipes do
		local flags = Crafting.decode(player:GetAttribute("RecipeModifiers_" .. index) or 0)
		if next(flags) then data.modifiers[tostring(index)] = flags end
	end
	local ok, raw = pcall(function() return HttpService:JSONDecode(player:GetAttribute("LifeProgress") or "{}") end)
	data.life = Life.normalize(ok and raw or nil)
	return data
end
local function enable(target, enabled)
	target.Active = enabled
	target.Interactable = enabled
	target.Selectable = enabled
	target.AutoButtonColor = enabled
	target.TextTransparency = enabled and 0 or 0.4
end

local function renderChallenges(ready, purchasePending)
	if player:GetAttribute("ChallengeActive") ~= true then
		local c = currentContract()
		local near = player:GetAttribute("NearChallengeNPC") == true
		local verbs = { Mine = "Break dough ore in the cave", Sell = "Sell cookies to walking customers", Eat = "Eat cookies from your bag", Gift = "Give another player a free cookie", Bake = "Produce batches in your bakery", Obby = "Finish any obby and earn its boost", Find = "Find Biscuit's lost supplies" }
		challengeName.Text = Contracts.Titles[c.kind] or "Biscuit's job board"
		challengeHint.Text = verbs[c.kind] or "Biscuit offers different jobs: mining, baking, tasting, selling, gifting, obbys, and occasional searches."
		challengeProgress.Text = c.kind == "" and "Ask for a random task" or (c.progress .. "/" .. c.target .. " • $" .. Progression.format(c.reward) .. " reward")
		for index, row in ipairs(challengeItems) do
			local id = c.items[index]
			row.Visible = c.kind == "Find" and id ~= nil
			if id then row.Text = (c.found[id] and "✓ " or "○ ") .. Challenges.Items[id].Name .. "\n" .. Challenges.Items[id].Hint end
		end
		challengeButton.Text = not near and "Visit Baker Biscuit" or (c.kind == "" and "Ask for a task" or (c.progress >= c.target and "Claim reward" or "Ask for another task (after 60s)"))
		enable(challengeButton, ready and not purchasePending and near)
		challengeStatus.Text = "No item waypoints. Use the task description and clues. Tasks and progress save."
		return
	end
	local index = player:GetAttribute("ChallengeIndex") or 1
	local challenge = Challenges.Challenges[index]
	local active = player:GetAttribute("ChallengeActive") == true
	local mask = player:GetAttribute("ChallengeFound") or 0
	local nearNPC = player:GetAttribute("NearChallengeNPC") == true
	if player:GetAttribute("ChallengeComplete") == true or not challenge then
		challengeName.Text = "Excellent detective!"
		challengeHint.Text = "You found all of Baker Biscuit's hidden treasures."
		challengeProgress.Text = "All quests complete"
		for _, row in ipairs(challengeItems) do row.Visible = false end
		challengeButton.Text = "All done!"
		challengeStatus.Text = "Completed quests stay complete after rebirth."
		enable(challengeButton, false)
		return
	end
	challengeName.Text = challenge.Name
	challengeHint.Text = challenge.Hint
	local found = 0
	for itemIndex, row in ipairs(challengeItems) do
		local item = Challenges.Items[challenge.Items[itemIndex]]
		row.Visible = active and item ~= nil
		if item then
			local collected = bit32.band(mask, bit32.lshift(1, itemIndex - 1)) ~= 0
			if collected then found += 1 end
			row.Text = (collected and "✓ " or "○ ") .. item.Name .. (collected and "" or "\n" .. item.Hint)
			row.TextColor3 = collected and Color3.fromRGB(151, 218, 182) or cream
		end
	end
	challengeProgress.Text = "$" .. Progression.format(challenge.Reward) .. " reward"
		.. (active and "  •  " .. found .. "/" .. #challenge.Items .. " found" or "")
	local canClaim = active and found == #challenge.Items
	if not ready then challengeButton.Text = "Loading..."
	elseif not nearNPC then challengeButton.Text = "Visit Baker Biscuit"
	elseif not active then challengeButton.Text = "Start quest"
	elseif canClaim then challengeButton.Text = "Claim $" .. Progression.format(challenge.Reward)
	else challengeButton.Text = "Find " .. (#challenge.Items - found) .. " more" end
	enable(challengeButton, ready and not purchasePending and nearNPC and (not active or canClaim))
	challengeStatus.Text = active and (canClaim and "Return to Baker Biscuit in the plaza." or "Find each hidden item and interact with it.")
		or "Visit Baker Biscuit in the plaza to begin."
end

-- Quest props are shared world instances; hide collected and inactive items
-- locally so every player can finish their own hunt without affecting others.
local function refreshChallengeItems()
	local world = workspace:FindFirstChild("CookieTycoonWorld")
	local questWorld = world and world:FindFirstChild("Challenges")
	local hidden = questWorld and questWorld:FindFirstChild("HiddenItems")
	if not hidden then return end
	local current = player:GetAttribute("ChallengeIndex") or 1
	local active = player:GetAttribute("ChallengeActive") == true
	local mask = player:GetAttribute("ChallengeFound") or 0
	for _, model in ipairs(hidden:GetChildren()) do
		local questIndex = model:GetAttribute("ChallengeQuestIndex")
		local definition = Challenges.Challenges[questIndex]
		local itemIndex = definition and table.find(definition.Items, model:GetAttribute("ChallengeItemId"))
		local visible = active and questIndex == current and itemIndex ~= nil
			and bit32.band(mask, bit32.lshift(1, itemIndex - 1)) == 0
		if not active then
			local c, id = currentContract(), model:GetAttribute("ChallengeItemId")
			visible = c.kind == "Find" and table.find(c.items, id) ~= nil and not c.found[id]
		end
		for _, descendant in ipairs(model:GetDescendants()) do
			if descendant:IsA("BasePart") then descendant.LocalTransparencyModifier = visible and 0 or 1
			elseif descendant:IsA("ProximityPrompt") or descendant:IsA("BillboardGui") or descendant:IsA("PointLight") then descendant.Enabled = visible end
		end
	end
end

local saveMessages = {
	Loading = "Loading...",
	Saved = "Saved",
	Saving = "Saving...",
	SaveFailed = "Save delayed • retrying",
	SessionOnly = "Preview • not saved",
	PurchasePending = "Saving purchase...",
}
local function render()
	local data = currentData()
	local ready = player:GetAttribute("DataReady") == true
	local ownsBakery = ready and player:GetAttribute("HasBakery") == true
	local purchasePending = player:GetAttribute("PurchasePending") == true
	local canManage = ownsBakery and not purchasePending and player:GetAttribute("CookieTradeBusy") ~= true
	local format = Progression.format
	local remaining = math.max(0, data.boosts.obbyExpires - data.perks.Now)
	boostStatus.Text = "Permanent income x" .. Boosts.paidMultiplier(data.boosts)
		.. (remaining > 0 and string.format(" • Obby +%d%% %d:%02d", math.floor(data.boosts.obbyBonus * 100), math.floor(remaining / 60), remaining % 60)
			or " • Obbys in the east meadow")
	if lastWorkshopRebirth ~= data.rebirths then
		selectedRecipe = math.min(selectedRecipe, data.unlocked)
		lastWorkshopRebirth = data.rebirths
	end
	wallet.Text = "Cash $" .. format(data.cash) .. "  |  Ready $" .. format(data.bank)
	progress.Text = data.unlocked .. "/" .. #Recipes .. " cookies  •  " .. data.chips .. " Golden Chips"
	menuWallet.Text = "$" .. format(data.cash) .. "  •  " .. data.chips .. " Golden Chips"
	local status = player:GetAttribute("DataStatus") or "Loading"
	saveStatus.Text = saveMessages[status] or status
	saveStatus.TextColor3 = (status == "SaveFailed" or status == "SessionOnly") and gold or cream
	if not ready then
		bakeryInfo.Text = "Loading your bakery..."
	elseif purchasePending then
		bakeryInfo.Text = "Saving purchase..."
	elseif not ownsBakery then
		bakeryInfo.Text = "Claim a free bakery at a green pad."
	else
		bakeryInfo.Text = string.format("$%s per batch  •  Every %.2fs",
			format(Progression.batchValue(data, data.perks)), Progression.interval(data, data.perks))
	end
	collectButton.Text = "Collect $" .. format(data.bank) .. " at your register"
	enable(collectButton, false)
	local nextRecipe = Recipes[data.unlocked + 1]
	recipeButton.Text = nextRecipe and (nextRecipe.Name .. "  •  $" .. format(nextRecipe.Cost) .. "\nUnlock next cookie") or "All 30 cookies unlocked!"
	enable(recipeButton, canManage and nextRecipe ~= nil and data.cash >= (nextRecipe and nextRecipe.Cost or 0))
	local ovenMax = data.level >= Progression.MAX_OVEN_LEVEL
	ovenButton.Text = ovenMax and "Conveyor speed maxed!" or ("Faster conveyor  •  $" .. format(Progression.ovenCost(data)) .. "\nSpeed level " .. data.level .. " → " .. (data.level + 1))
	enable(ovenButton, canManage and not ovenMax and data.cash >= Progression.ovenCost(data))
	local requirement = Progression.rebirthRequirement(data)
	local rebirthMax = data.rebirths >= Progression.MAX_REBIRTHS
	local canRebirth = canManage and not rebirthMax and data.unlocked >= requirement.Recipes and data.cash + data.bank >= requirement.Cash
	rebirthInfo.Text = rebirthMax and "All 50 rebirths completed!"
		or string.format("Rebirth #%d  •  +%d Golden Chips\n%d/%d cookies  •  $%s/$%s cash + ready",
			data.rebirths + 1, requirement.Reward, data.unlocked, requirement.Recipes, format(data.cash + data.bank), format(requirement.Cash))
	rebirthButton.Text = rebirthMax and "Rebirths complete" or "Review rebirth"
	enable(rebirthButton, canRebirth)
	if confirmation.Visible then
		if data.rebirths ~= confirmCount or not ownsBakery then confirmation.Visible = false end
		confirmationText.Text = "Start over for " .. requirement.Reward .. " Golden Chips and +15% income?\nReset: cash, ready earnings, cookies, conveyor levels and toppings.\nKeep: Golden Chips, permanent upgrades, quests and passes."
		enable(confirmButton, canRebirth)
	end
	for key, upgradeButton in pairs(permanentButtons) do
		local upgrade = Progression.Permanent[key]
		local cost = Progression.permanentCost(data, key)
		local effect = key == "Yield" and "+25% income" or key == "Speed" and "+8% baking speed"
			or "$" .. format(500 * math.min(upgrade.Max, data.permanent[key] + 1) ^ 2) .. " after rebirth"
		upgradeButton.Text = upgrade.Name .. "  " .. data.permanent[key] .. "/" .. upgrade.Max .. "\n"
			.. (cost and cost .. " chips • " .. effect or "MAXED")
		enable(upgradeButton, canManage and cost ~= nil and data.chips >= (cost or math.huge))
	end
	local selected = Recipes[selectedRecipe]
	local rarity = Crafting.rarity(selected)
	local flags = data.modifiers[tostring(selectedRecipe)]
	local unlocked = selectedRecipe <= data.unlocked
	recipeTitle.Text = selectedRecipe .. "/" .. #Recipes .. " • " .. selected.Name
	recipeTitle.TextColor3 = Color3.fromRGB(table.unpack(rarity.Color))
	workshopDetails.Text = rarity.Name .. "  •  " .. (unlocked and "$" .. format(Progression.recipeValue(data, selectedRecipe, data.perks)) .. " / cookie"
		or "Unlock for $" .. format(selected.Cost))
	toppingSummary.Text = "Toppings: " .. Crafting.summary(flags, selectedRecipe)
	local mastery = data.life.recipeLevels[tostring(selectedRecipe)] or 0
	local masteryCost = Life.recipeCost(selectedRecipe, mastery)
	masteryButton.Text = mastery == 10 and "Cookie mastery MAX" or ("Cookie mastery " .. mastery .. "/10 • $" .. format(masteryCost) .. "\n+20% value for this recipe")
	enable(masteryButton, canManage and unlocked and mastery < 10 and data.cash >= masteryCost)
	enable(previousCookie, selectedRecipe > 1)
	enable(nextCookie, selectedRecipe < #Recipes)
	for key, addButton in pairs(modifierButtons) do
		local definition = Crafting.option(selectedRecipe, key)
		addButton.Visible = definition ~= nil
		if not definition then continue end
		local cost = Crafting.cost(selected, key)
		local applied = flags and flags[key] == true
		addButton.Text = definition.Name .. "  +" .. math.floor(definition.Bonus * 100 + 0.5) .. "%\n"
			.. (applied and "✓ Added" or "$" .. format(cost) .. (unlocked and "" or " • Recipe locked"))
		enable(addButton, canManage and unlocked and not applied and data.cash >= cost)
	end
	local commerceReady = ready and player:GetAttribute("CommerceReady") == true
	local promptOpen = player:GetAttribute("ShopPromptOpen") == true
	local configured = false
	for _, row in ipairs(shopRows) do
		local offer = Catalog.offer(row.Kind, row.Key)
		configured = configured or offer ~= nil
		local metadata = priceMetadata[row.Kind .. ":" .. row.Key]
		local tier = row.Entry.BoostTier
		row.Button.Visible = not tier or tier == data.boosts.paidTier + 1 or (data.boosts.paidTier == Boosts.MaxPaidTier and tier == Boosts.MaxPaidTier)
		local owned = row.Kind == "Pass" and player:GetAttribute(row.Key .. "Owned") == true
			or tier ~= nil and data.boosts.paidTier >= tier
		local priceLine
		if owned then priceLine = "Owned • Permanent"
		elseif not offer then priceLine = "Coming soon"
		elseif not metadata or metadata.State == "Loading" then priceLine = "Checking price..."
		elseif metadata.State ~= "Ready" then priceLine = "Currently unavailable"
		else priceLine = "R$ " .. metadata.Price .. (tier and " • Permanent" or row.Kind == "Pass" and " • Buy once" or " • Repeatable") end
		if row.Kind == "Pass" or tier then
			row.Button.Text = row.Entry.Name .. "\n" .. priceLine
		else
			row.Button.Text = "$" .. format(row.Entry.Cash) .. " Cookie Cash\n" .. priceLine
		end
		local ownershipReady = row.Kind ~= "Pass" or player:GetAttribute("PassesReady") == true
		enable(row.Button, commerceReady and not purchasePending and not promptOpen and not owned and offer ~= nil
			and ownershipReady and metadata ~= nil and metadata.State == "Ready")
	end
	if purchasePending then shopStatus.Text = "Saving purchase..."
	elseif not configured then shopStatus.Text = "Coming soon • Keep baking for free!"
	elseif not ready then shopStatus.Text = "Loading your bakery..."
	elseif not commerceReady then shopStatus.Text = "Purchases unavailable this session."
	elseif promptOpen then shopStatus.Text = "Finish the Roblox purchase window."
	else
		shopStatus.Text = "Active: " .. (data.perks.DoubleIncome and "2x income" or "standard income")
			.. " • " .. (data.perks.DoubleSpeed and "2x speed" or "standard speed")
	end
	enable(refreshShopButton, not pricesLoading and not purchasePending and not promptOpen)
	renderChallenges(ready, purchasePending)
	refreshChallengeItems()
end

local lastPriceRefresh = -math.huge
local function refreshPrices()
	if pricesLoading or os.clock() - lastPriceRefresh < 5 then return end
	lastPriceRefresh = os.clock()
	pricesLoading = true
	refreshPasses:FireServer()
	for _, row in ipairs(shopRows) do priceMetadata[row.Kind .. ":" .. row.Key] = { State = "Loading" } end
	render()
	task.spawn(function()
		for _, row in ipairs(shopRows) do
			local offer = Catalog.offer(row.Kind, row.Key)
			local metadata = { State = "Unavailable" }
			if offer then
				-- Fetch on this client so Roblox's current personalized/regional
				-- PriceInRobux is shown. The native prompt remains the final price.
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfoAsync(offer.Id, row.Kind == "Pass" and Enum.InfoType.GamePass or Enum.InfoType.Product)
				end)
				if ok and info.IsForSale == true and type(info.PriceInRobux) == "number" and info.PriceInRobux >= 0 and info.PriceInRobux < 2 ^ 53 then
					metadata = { State = "Ready", Price = math.floor(info.PriceInRobux) }
				end
			end
			priceMetadata[row.Kind .. ":" .. row.Key] = metadata
			render()
		end
		pricesLoading = false
		render()
	end)
end
refreshShopButton.Activated:Connect(refreshPrices)

collectButton.Activated:Connect(function() requestAction:FireServer("Collect") end)
recipeButton.Activated:Connect(function() requestAction:FireServer("BuyRecipe") end)
ovenButton.Activated:Connect(function() requestAction:FireServer("UpgradeOven") end)
rebirthButton.Activated:Connect(function()
	confirmCount = currentData().rebirths
	confirmation.Visible = true
	render()
end)
confirmButton.Activated:Connect(function()
	if confirmCount ~= nil then requestAction:FireServer("Rebirth", confirmCount) end
	confirmation.Visible = false
end)
cancelButton.Activated:Connect(function() confirmation.Visible = false end)
previousCookie.Activated:Connect(function()
	selectedRecipe = math.max(1, selectedRecipe - 1)
	render()
end)
nextCookie.Activated:Connect(function()
	selectedRecipe = math.min(#Recipes, selectedRecipe + 1)
	render()
end)
openShop.OnClientEvent:Connect(function(tabName)
	if tabName == "Workshop" or tabName == "Bakery" or tabName == "Challenges" or tabName == "Robux" then showTab(tabName) end
	menu.Visible = true
end)

local noticeVersion = 0
local function showNotice()
	local message = player:GetAttribute("Notice")
	if not message then return end
	noticeVersion += 1
	local version = noticeVersion
	toast.Text = message
	toast.Visible = true
	toast.Position = UDim2.new(0.5, 0, 1, 4)
	TweenService:Create(toast, TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
		Position = UDim2.new(0.5, 0, 1, -12),
	}):Play()
	task.delay(6, function() if noticeVersion == version then toast.Visible = false end end)
end

local queued = false
local function scheduleRender()
	if queued then return end
	queued = true
	task.defer(function()
		queued = false
		render()
	end)
end
cash.Changed:Connect(scheduleRender)
player.AttributeChanged:Connect(scheduleRender)
player:GetAttributeChangedSignal("NoticeId"):Connect(showNotice)
task.spawn(function()
	while gui.Parent do
		task.wait(1)
		scheduleRender()
	end
end)
workspace.DescendantAdded:Connect(function(descendant)
	if descendant:GetAttribute("ChallengeItemId") ~= nil or descendant:FindFirstAncestor("HiddenItems") then scheduleRender() end
end)
render()
showNotice()
refreshPrices()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="760">
          <Properties>
            <string name="Name">AdminFlightClient</string>
            <string name="Source"><![CDATA[local Input, Run = game:GetService("UserInputService"), game:GetService("RunService")
local Flight = {}
function Flight.start(player, remotes, gui)
	local remote = remotes:WaitForChild("AdminFlightInput")
	local up, down, elapsed = false, false, 0
	local buttons = {}
	for i, title in ipairs({ "FLY UP", "FLY DOWN" }) do
		local b = Instance.new("TextButton")
		b.Text, b.Size, b.Position, b.BackgroundColor3, b.TextColor3, b.ZIndex, b.Parent = title, UDim2.fromOffset(110, 42), UDim2.new(1, -130, 1, -190 - i * 50), Color3.fromRGB(58, 96, 94), Color3.new(1, 1, 1), 15, gui
		b.Visible = false
		b.InputBegan:Connect(function(event) if event.UserInputType == Enum.UserInputType.Touch or event.UserInputType == Enum.UserInputType.MouseButton1 or event.KeyCode == Enum.KeyCode.ButtonA then if i == 1 then up = true else down = true end end end)
		b.InputEnded:Connect(function(event) if event.UserInputType == Enum.UserInputType.Touch or event.UserInputType == Enum.UserInputType.MouseButton1 or event.KeyCode == Enum.KeyCode.ButtonA then if i == 1 then up = false else down = false end end end)
		table.insert(buttons, b)
	end
	local connection = Run.Heartbeat:Connect(function(dt)
		local flying = player:GetAttribute("AdminFlying") == true
		for _, b in ipairs(buttons) do b.Visible = flying end
		if not flying then up, down = false, false; return end
		elapsed += dt
		if elapsed < 0.05 then return end
		elapsed = 0
		local camera, char = workspace.CurrentCamera, player.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if not camera or not hum then return end
		local direction = hum.MoveDirection
		if not Input:GetFocusedTextBox() then
			local x = (Input:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (Input:IsKeyDown(Enum.KeyCode.A) and 1 or 0)
			local z = (Input:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (Input:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
			if x ~= 0 or z ~= 0 then direction = camera.CFrame.RightVector * x + camera.CFrame.LookVector * z end
		end
		local vertical = (up and 1 or 0) - (down and 1 or 0)
		if not Input:GetFocusedTextBox() then vertical += (Input:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - ((Input:IsKeyDown(Enum.KeyCode.LeftControl) or Input:IsKeyDown(Enum.KeyCode.Q)) and 1 or 0) end
		direction += Vector3.yAxis * vertical
		remote:FireServer(direction.Magnitude > 1 and direction.Unit or direction)
	end)
	gui.Destroying:Connect(function() connection:Disconnect() end)
end
return Flight
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="761">
          <Properties>
            <string name="Name">AdminPanel</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Panel = {}

function Panel.start(player, remotes, gui, openButton)
	local actionRemote = remotes:WaitForChild("AdminAction")
	local resultRemote = remotes:WaitForChild("AdminResult")
	local connections, selected, confirmKick = {}, nil, nil
	local backdrop = Instance.new("TextButton")
	backdrop.Size, backdrop.Text, backdrop.BackgroundTransparency = UDim2.fromScale(1, 1), "", 0.35
	backdrop.BackgroundColor3, backdrop.ZIndex, backdrop.Visible, backdrop.Parent = Color3.new(0, 0, 0), 20, false, gui
	local frame = Instance.new("Frame")
	frame.AnchorPoint, frame.Position, frame.Size = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.92, 0.85)
	frame.BackgroundColor3, frame.ZIndex, frame.Visible, frame.Parent = Color3.fromRGB(53, 36, 32), 21, false, gui
	local limit = Instance.new("UISizeConstraint")
	limit.MaxSize, limit.Parent = Vector2.new(460, 530), frame
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0, 14), frame
	local function label(parent, text)
		local object = Instance.new("TextLabel")
		object.Size, object.AutomaticSize = UDim2.new(1, -4, 0, 0), Enum.AutomaticSize.Y
		object.BackgroundTransparency, object.Text, object.TextSize = 1, text, 15
		object.Font, object.TextColor3, object.TextWrapped = Enum.Font.GothamBold, Color3.fromRGB(255, 236, 209), true
		object.TextXAlignment, object.ZIndex, object.Parent = Enum.TextXAlignment.Left, 22, parent
		return object
	end
	local function button(parent, text)
		local object = Instance.new("TextButton")
		object.Size, object.Text = UDim2.new(1, -4, 0, 40), text
		object.BackgroundColor3, object.TextColor3 = Color3.fromRGB(75, 112, 99), Color3.fromRGB(255, 236, 209)
		object.Font, object.TextSize, object.TextWrapped = Enum.Font.GothamBold, 14, true
		object.BorderSizePixel, object.ZIndex, object.Parent = 0, 22, parent
		local rounding = Instance.new("UICorner")
		rounding.CornerRadius, rounding.Parent = UDim.new(0, 8), object
		return object
	end
	local title = label(frame, "ADMIN TOOLS")
	title.Position, title.Size = UDim2.fromOffset(14, 16), UDim2.new(1, -74, 0, 26)
	local close = button(frame, "X")
	close.Size, close.Position = UDim2.fromOffset(32, 32), UDim2.new(1, -46, 0, 12)
	local content = Instance.new("ScrollingFrame")
	content.Position, content.Size = UDim2.fromOffset(14, 108), UDim2.new(1, -28, 1, -122)
	content.BackgroundTransparency, content.BorderSizePixel, content.ScrollBarThickness = 1, 0, 4
	content.CanvasSize, content.AutomaticCanvasSize, content.ZIndex, content.Parent = UDim2.new(), Enum.AutomaticSize.Y, 22, frame
	local layout = Instance.new("UIListLayout")
	layout.Padding, layout.SortOrder, layout.Parent = UDim.new(0, 10), Enum.SortOrder.LayoutOrder, content
	local info = label(content, "Choose an account in this server.")
	info.LayoutOrder = 1
	local selectedLabel = label(content, "No player selected")
	selectedLabel.LayoutOrder = 2
	local playerList = Instance.new("ScrollingFrame")
	playerList.LayoutOrder, playerList.Size, playerList.BackgroundTransparency = 3, UDim2.new(1, -4, 0, 150), 1
	playerList.CanvasSize, playerList.AutomaticCanvasSize, playerList.ScrollBarThickness = UDim2.new(), Enum.AutomaticSize.Y, 4
	playerList.BorderSizePixel, playerList.ZIndex, playerList.Parent = 0, 22, content
	local playerLayout = Instance.new("UIListLayout")
	playerLayout.Padding, playerLayout.SortOrder, playerLayout.Parent = UDim.new(0, 5), Enum.SortOrder.Name, playerList
	local returnButton = button(content, "Return player to spawn")
	returnButton.LayoutOrder = 4
	local kickButton = button(content, "Kick player")
	kickButton.LayoutOrder, kickButton.BackgroundColor3 = 5, Color3.fromRGB(151, 74, 57)
	local goButton = button(content, "Teleport to player")
	goButton.LayoutOrder = 6
	local bringButton = button(content, "Bring player to me")
	bringButton.LayoutOrder = 7
	local amount = Instance.new("TextBox")
	amount.LayoutOrder, amount.Size, amount.Text = 8, UDim2.new(1, -4, 0, 40), "10000"
	amount.PlaceholderText, amount.ClearTextOnFocus, amount.TextSize = "Whole cash amount", false, 16
	amount.TextColor3, amount.BackgroundColor3 = Color3.fromRGB(255, 236, 209), Color3.fromRGB(89, 69, 60)
	amount.Font, amount.ZIndex, amount.Parent = Enum.Font.GothamBold, 22, content
	local walletButton = button(content, "Add amount to wallet")
	walletButton.LayoutOrder = 9
	local bankButton = button(content, "Add amount to ready earnings")
	bankButton.LayoutOrder = 10
	local invisibilityButton = button(content, "My invisibility: OFF")
	invisibilityButton.LayoutOrder = 11
	local flyButton = button(content, "My flight: OFF")
	flyButton.LayoutOrder = 12
	require(script.Parent.AdminFlightClient).start(player, remotes, gui)
	local status = label(frame, "Admin actions apply to this server.")
	status.Position, status.Size, status.AutomaticSize = UDim2.fromOffset(14, 48), UDim2.new(1, -28, 0, 46), Enum.AutomaticSize.None
	status.TextSize = 13
	local lastSent = -math.huge
	local function resetConfirmation()
		confirmKick = nil
		kickButton.Text = "Kick player"
	end
	local function rebuild()
		if selected and not Players:GetPlayerByUserId(selected) then selected = nil end
		for _, child in ipairs(playerList:GetChildren()) do if child:IsA("TextButton") then child:Destroy() end end
		for _, target in ipairs(Players:GetPlayers()) do
			local choice = button(playerList, "@" .. target.Name .. (target == player and " (you)" or ""))
			choice.Name = target.Name
			choice.Size = UDim2.new(1, -8, 0, 34)
			choice.BackgroundColor3 = selected == target.UserId and Color3.fromRGB(137, 104, 46) or Color3.fromRGB(89, 69, 60)
			choice.Activated:Connect(function()
				selected = target.UserId
				resetConfirmation()
				rebuild()
			end)
		end
		local target = selected and Players:GetPlayerByUserId(selected)
		selectedLabel.Text = target and ("Selected: @" .. target.Name) or "No player selected"
		returnButton.Interactable, kickButton.Interactable = target ~= nil, target ~= nil
		goButton.Interactable, bringButton.Interactable = target ~= nil, target ~= nil
		walletButton.Interactable, bankButton.Interactable = target ~= nil, target ~= nil
	end
	local function visible(value)
		frame.Visible = value and player:GetAttribute("IsAdmin") == true
		backdrop.Visible = frame.Visible
		resetConfirmation()
		if frame.Visible then rebuild() end
	end
	local function send(action, argument)
		local targetId = (action == "SetInvisible" or action == "SetFlying") and player.UserId or selected
		if not targetId or player:GetAttribute("IsAdmin") ~= true then return end
		if os.clock() - lastSent < 1 then
			status.Text = "Wait a moment between actions."
			return
		end
		lastSent = os.clock()
		status.Text = "Sending..."
		actionRemote:FireServer(action, targetId, argument)
	end
	openButton.Activated:Connect(function() visible(true) end)
	close.Activated:Connect(function() visible(false) end)
	backdrop.Activated:Connect(function() visible(false) end)
	returnButton.Activated:Connect(function()
		resetConfirmation()
		send("ReturnToSpawn")
	end)
	goButton.Activated:Connect(function()
		resetConfirmation()
		send("GoToPlayer")
	end)
	bringButton.Activated:Connect(function()
		resetConfirmation()
		send("BringPlayer")
	end)
	walletButton.Activated:Connect(function()
		resetConfirmation()
		send("GiveWalletCash", tonumber(amount.Text:sub(1, 32)))
	end)
	bankButton.Activated:Connect(function()
		resetConfirmation()
		send("GiveBankCash", tonumber(amount.Text:sub(1, 32)))
	end)
	invisibilityButton.Activated:Connect(function()
		resetConfirmation()
		send("SetInvisible", player:GetAttribute("AdminInvisible") ~= true)
	end)
	flyButton.Activated:Connect(function() send("SetFlying", player:GetAttribute("AdminFlying") ~= true) end)
	table.insert(connections, player:GetAttributeChangedSignal("AdminFlying"):Connect(function() flyButton.Text = player:GetAttribute("AdminFlying") and "My flight: ON" or "My flight: OFF" end))
	kickButton.Activated:Connect(function()
		local target = selected and Players:GetPlayerByUserId(selected)
		if not target then return end
		if confirmKick ~= selected then
			confirmKick = selected
			kickButton.Text = "Confirm kick @" .. target.Name
			status.Text = "Click again to remove this player."
		else
			resetConfirmation()
			send("Kick")
		end
	end)
	table.insert(connections, resultRemote.OnClientEvent:Connect(function(success, message)
		status.Text = message
		status.TextColor3 = success and Color3.fromRGB(157, 221, 184) or Color3.fromRGB(255, 182, 155)
	end))
	local function refreshAccess()
		openButton.Visible = player:GetAttribute("IsAdmin") == true
		if not openButton.Visible then visible(false) end
	end
	table.insert(connections, player:GetAttributeChangedSignal("IsAdmin"):Connect(refreshAccess))
	local function refreshInvisible()
		invisibilityButton.Text = player:GetAttribute("AdminInvisible") == true and "My invisibility: ON" or "My invisibility: OFF"
	end
	table.insert(connections, player:GetAttributeChangedSignal("AdminInvisible"):Connect(refreshInvisible))
	table.insert(connections, Players.PlayerAdded:Connect(function() if frame.Visible then rebuild() end end))
	table.insert(connections, Players.PlayerRemoving:Connect(function(leaving)
		if selected == leaving.UserId then
			selected = nil
			resetConfirmation()
		end
		task.defer(function() if frame.Parent and frame.Visible then rebuild() end end)
	end))
	gui.Destroying:Connect(function() for _, connection in ipairs(connections) do connection:Disconnect() end end)
	refreshAccess()
	refreshInvisible()
end

return Panel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="762">
          <Properties>
            <string name="Name">AudioController</string>
            <string name="Source"><![CDATA[local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.CookieTycoon.AudioConfig)
local Score = require(ReplicatedStorage.CookieTycoon.MusicScore)
local Preferences = require(ReplicatedStorage.CookieTycoon.AudioPreferences)
local AudioController = {}
AudioController.__index = AudioController

local function assetId(value)
	if type(value) ~= "number" or value <= 0 or value % 1 ~= 0 or value >= 2 ^ 53 then return nil end
	return "rbxassetid://" .. value
end

local function group(name, parent)
	local object = Instance.new("SoundGroup")
	object.Name = name
	object.Volume = 0
	object.Parent = parent
	return object
end

local function sound(name, id, soundGroup, parent)
	local object = Instance.new("Sound")
	object.Name = name
	object.SoundId = id
	object.SoundGroup = soundGroup
	object.Volume = 0
	object.Parent = parent
	return object
end

function AudioController.start(player, requestAction)
	local self = setmetatable({
		player = player, requestAction = requestAction, music = true, effects = true,
		musicVolume = Preferences.DefaultMusicVolume, effectsVolume = Preferences.DefaultEffectsVolume,
		musicStatus = Config.FallbackMusicEnabled and "Ready" or "Unconfigured",
		ready = false, dirty = false, alive = true, revision = 0,
		musicCursor = 0, effectCursor = 0, noteIndex = 1, epoch = os.clock(),
		lastCues = {}, connections = {}, voices = {}, samples = {}, ovenVoices = {}, effectEpoch = 0,
	}, AudioController)
	self.folder = Instance.new("Folder")
	self.folder.Name = "CookieCornerAudio"
	self.folder.Parent = SoundService
	self.Changed = Instance.new("BindableEvent")
	self.Changed.Parent = self.folder
	self.musicGroup = group("Music", self.folder)
	self.effectsGroup = group("Effects", self.folder)
	local equalizer = Instance.new("EqualizerSoundEffect")
	equalizer.Name = "WarmSampler"
	equalizer.HighGain = -40
	equalizer.MidGain = -18
	equalizer.LowGain = -2
	-- Filter only the local sampler; the optional original recording is already mixed.
	for index = 1, 20 do
		local isMusic = index <= 12
		local voiceSound = sound("Chime" .. index, Config.BundledChime, isMusic and self.musicGroup or self.effectsGroup, self.folder)
		if isMusic then equalizer:Clone().Parent = voiceSound end
		self.voices[index] = {
			sound = voiceSound,
			generation = 0,
		}
	end
	equalizer:Destroy()
	for name, id in pairs(Config.Effects) do
		local uri = assetId(id)
		if uri then self.samples[name] = sound(name, uri, self.effectsGroup, self.folder) end
	end
	for index, id in ipairs(Config.OvenPurchaseVoices or {}) do
		local uri = assetId(id)
		if uri then table.insert(self.ovenVoices, sound("BubbyCookieCookie" .. index, uri, self.effectsGroup, self.folder)) end
	end
	local musicUri = assetId(Config.MusicAssetId)
	if musicUri then
		self.musicStatus = "Loading"
		self.track = sound(Config.MusicName, musicUri, self.musicGroup, self.folder)
		self.track.Looped = true
		self.track.Volume = 1
		table.insert(self.connections, self.track.Loaded:Connect(function()
			if not self.alive then return end
			self.musicStatus = "Ready"
			self.Changed:Fire()
			self:_stopVoices(true)
			if self.ready and self.music then self.track:Play() end
		end))
	end

	local function loadPreferences()
		if self.ready or not player:GetAttribute("DataReady") then return end
		self.ready = true
		if not self.musicTouched then self.music = player:GetAttribute("MusicEnabled") ~= false end
		if not self.effectsTouched then self.effects = player:GetAttribute("EffectsEnabled") ~= false end
		local saved = Preferences.normalize({ musicVolume = player:GetAttribute("MusicVolume"), effectsVolume = player:GetAttribute("EffectsVolume") })
		if not self.musicVolumeTouched then self.musicVolume = saved.musicVolume end
		if not self.effectsVolumeTouched then self.effectsVolume = saved.effectsVolume end
		self.epoch = os.clock()
		self:_apply()
		if self.dirty then self:_queueSave() end
	end
	table.insert(self.connections, player:GetAttributeChangedSignal("DataReady"):Connect(loadPreferences))
	loadPreferences()
	table.insert(self.connections, RunService.Heartbeat:Connect(function()
		if not Config.FallbackMusicEnabled or not self.ready or not self.music or self.musicVolume == 0 or (self.track and self.track.IsLoaded) then return end
		local secondsPerBeat = 60 / Score.BPM
		local elapsed = (os.clock() - self.epoch) / secondsPerBeat
		if elapsed >= Score.Beats then
			self.epoch += math.floor(elapsed / Score.Beats) * Score.Beats * secondsPerBeat
			elapsed %= Score.Beats
			self.noteIndex = 1
		end
		while self.noteIndex <= #Score.Notes and Score.Notes[self.noteIndex][1] <= elapsed do
			local note = Score.Notes[self.noteIndex]
			-- Skip stale notes after a stalled frame instead of playing a burst.
			if (elapsed - note[1]) * secondsPerBeat < 0.12 then
				self:_tone(note[2], note[3] * secondsPerBeat, note[4], true)
			end
			self.noteIndex += 1
		end
	end))
	task.spawn(function()
		local preload = { self.voices[1].sound }
		if self.track then table.insert(preload, self.track) end
		for _, sample in pairs(self.samples) do table.insert(preload, sample) end
		for _, voice in ipairs(self.ovenVoices) do table.insert(preload, voice) end
		pcall(function() ContentProvider:PreloadAsync(preload) end)
		if self.alive and #self.ovenVoices > 0 then
			local loaded = false
			for _, voice in ipairs(self.ovenVoices) do if voice.IsLoaded then loaded = true end end
			if not loaded then warn("Cookie Corner: Bubby's oven voices could not load. Check audio IDs, moderation and experience permissions; the normal purchase cue remains available. See AUDIO.md.") end
		end
		if self.alive and not self.voices[1].sound.IsLoaded then
			warn("Cookie Corner: bundled chime unavailable. Upload the included WAVs and configure AudioConfig for this experience.")
		end
		if self.alive and (not self.track or not self.track.IsLoaded) and not Config.FallbackMusicEnabled then
			if self.track then self.musicStatus = "Unavailable" end
			self.Changed:Fire()
			warn("Cookie Corner: optional full-mix music needs its Roblox audio ID and experience permission. See AUDIO.md.")
		end
	end)
	return self
end

function AudioController:_stopVoices(music)
	for index = music and 1 or 13, music and 12 or 20 do
		local voice = self.voices[index]
		voice.generation += 1
		if voice.attack then voice.attack:Cancel() end
		if voice.fade then voice.fade:Cancel() end
		voice.sound:Stop()
	end
end

function AudioController:_tone(midi, duration, volume, music)
	if not self.alive or (music and not self.music) or (not music and not self.effects) then return end
	local cursor
	if music then
		self.musicCursor = self.musicCursor % 12 + 1
		cursor = self.musicCursor
	else
		self.effectCursor = self.effectCursor % 8 + 1
		cursor = self.effectCursor + 12
	end
	local voice = self.voices[cursor]
	voice.generation += 1
	local generation = voice.generation
	if voice.attack then voice.attack:Cancel() end
	if voice.fade then voice.fade:Cancel() end
	voice.sound:Stop()
	voice.sound.PlaybackSpeed = 2 ^ ((midi - Config.ChimeMidi) / 12)
	voice.sound.Volume = music and 0 or volume
	voice.sound.TimePosition = 0
	voice.sound:Play()
	if music then
		-- Remove the ping's sharp onset and let the low notes bloom quietly.
		voice.attack = TweenService:Create(voice.sound, TweenInfo.new(Config.MusicAttackSeconds), { Volume = volume })
		voice.attack:Play()
	end
	local release = music and Config.MusicReleaseSeconds or 0.06
	task.delay(math.max(0.03, duration - release), function()
		if not self.alive or voice.generation ~= generation then return end
		if voice.attack then voice.attack:Cancel() end
		voice.fade = TweenService:Create(voice.sound, TweenInfo.new(release), { Volume = 0 })
		voice.fade:Play()
		task.delay(release + 0.01, function()
			if self.alive and voice.generation == generation then voice.sound:Stop() end
		end)
	end)
end

function AudioController:_apply()
	if self.musicFade then self.musicFade:Cancel() end
	if self.effectsFade then self.effectsFade:Cancel() end
	self.musicFade = TweenService:Create(self.musicGroup, TweenInfo.new(0.08), { Volume = self.ready and self.music and self.musicVolume or 0 })
	self.effectsFade = TweenService:Create(self.effectsGroup, TweenInfo.new(0.08), { Volume = self.ready and self.effects and self.effectsVolume or 0 })
	self.musicFade:Play()
	self.effectsFade:Play()
	if not self.music then
		self:_stopVoices(true)
		if self.track then self.track:Pause() end
	elseif self.ready and self.track and self.track.IsLoaded then
		self.track:Resume()
		if not self.track.IsPlaying then self.track:Play() end
	end
	if not self.effects then
		self:_stopVoices(false)
		for _, sample in pairs(self.samples) do sample:Stop() end
		for _, voice in ipairs(self.ovenVoices) do voice:Stop() end
	end
	self.Changed:Fire()
end

function AudioController:_queueSave()
	self.revision += 1
	local revision = self.revision
	local function send()
		if not self.alive or revision ~= self.revision or not self.dirty then return end
		if not self.ready or self.player:GetAttribute("PurchasePending") == true then
			task.delay(1, send)
			return
		end
		self.requestAction:FireServer("SetAudioPreferences", {
			music = self.music, effects = self.effects, musicVolume = self.musicVolume, effectsVolume = self.effectsVolume,
		})
		self.dirty = false
	end
	task.delay(0.4, send)
end

function AudioController:SetMusicEnabled(enabled)
	self.musicTouched = true
	self.music = enabled == true
	self.dirty = true
	self:_apply()
	self:_queueSave()
end

function AudioController:SetEffectsEnabled(enabled)
	self.effectsTouched = true
	self.effects = enabled == true
	if not self.effects then self.effectEpoch += 1 end
	self.dirty = true
	self:_apply()
	self:_queueSave()
end

function AudioController:SetVolume(channel, value)
	if (channel ~= "music" and channel ~= "effects") or not Preferences.validVolume(value) then return end
	self[channel .. "VolumeTouched"] = true
	self[channel .. "Volume"] = math.floor(math.clamp(value, 0, 1) * 100 + 0.5) / 100
	self.dirty = true
	self:_apply()
	self:_queueSave()
end

function AudioController:_playOvenVoice()
	local loaded, fresh = {}, {}
	for _, voice in ipairs(self.ovenVoices) do
		if voice.IsLoaded then
			table.insert(loaded, voice)
			if voice.SoundId ~= self.lastOvenVoice then table.insert(fresh, voice) end
		end
	end
	-- Avoid an immediate repeat when another recording is ready. Unavailable
	-- recordings never delay a purchase or suppress the normal fallback cue.
	local choices = #fresh > 0 and fresh or loaded
	if #choices == 0 then return false end
	local chosen = choices[math.random(#choices)]
	for _, voice in ipairs(self.ovenVoices) do voice:Stop() end
	self.lastOvenVoice = chosen.SoundId
	chosen.Volume, chosen.PlaybackSpeed, chosen.TimePosition = .8, 1, 0
	chosen:Play()
	return true
end

function AudioController:PlayCue(name)
	local cue = Score.Cues[name]
	if not self.alive or not self.ready or not self.effects or self.effectsVolume == 0 or not cue then return end
	local now = os.clock()
	if now - (self.lastCues[name] or -math.huge) < (name == "Click" and 0.06 or 0.18) then return end
	self.lastCues[name] = now
	if name == "BuyRecipe" and self:_playOvenVoice() then return end
	local sample = self.samples[name]
	if sample and sample.IsLoaded then
		sample.Volume = name == "Click" and 0.35 or 0.8
		sample:Stop()
		sample:Play()
		return
	end
	local epoch = self.effectEpoch
	for _, note in ipairs(cue) do
		task.delay(note[1], function()
			if self.alive and self.effectEpoch == epoch then self:_tone(note[2], note[3], note[4], false) end
		end)
	end
end

function AudioController:Destroy()
	self.alive = false
	for _, connection in ipairs(self.connections) do connection:Disconnect() end
	self.folder:Destroy()
end

return AudioController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="763">
          <Properties>
            <string name="Name">BakeryLifeClient</string>
            <string name="Source"><![CDATA[local Players, Lighting, RunService = game:GetService("Players"), game:GetService("Lighting"), game:GetService("RunService")
local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Life, Recipes, Progression, Polish = require(Shared.BakeryLife), require(Shared.Recipes), require(Shared.Progression), require(Shared.BakeryPolish)
local CardUI = require(script.Parent.CardPacksClient)
local CollectionService = game:GetService("CollectionService")
local Client = {}
function Client.start(player, remotes, gui, hud, openButton, audio)
	local action, stateRemote, open = remotes:WaitForChild("LifeAction"), remotes:WaitForChild("LifeState"), remotes:WaitForChild("OpenLife")
	local snapshot, tab, renameDraft = { life = Life.normalize(nil) }, "Bag", ""
	local connections, pendingRender = {}, false
	local announcement = Instance.new("Frame")
	announcement.Name, announcement.AnchorPoint = "MeteorAnnouncement", Vector2.new(.5, 0)
	announcement.Size, announcement.Position = UDim2.new(.9, 0, 0, 84), UDim2.new(.5, 0, 0, 22)
	announcement.BackgroundColor3, announcement.BorderSizePixel = Color3.fromRGB(55, 35, 30), 0
	announcement.Visible, announcement.ZIndex, announcement.Parent = false, 80, gui
	local announcementLimit = Instance.new("UISizeConstraint")
	announcementLimit.MaxSize, announcementLimit.Parent = Vector2.new(590, 84), announcement
	local announcementCorner = Instance.new("UICorner")
	announcementCorner.CornerRadius, announcementCorner.Parent = UDim.new(0, 14), announcement
	local announcementStroke = Instance.new("UIStroke")
	announcementStroke.Color, announcementStroke.Thickness, announcementStroke.Parent = Color3.fromRGB(255, 184, 87), 2, announcement
	local headline, detail
	for index = 1, 2 do
		local text = Instance.new("TextLabel")
		text.BackgroundTransparency, text.TextWrapped, text.TextScaled = 1, true, true
		text.Position, text.Size = UDim2.fromOffset(12, index == 1 and 8 or 39), UDim2.new(1, -24, 0, index == 1 and 27 or 36)
		text.Font, text.TextColor3, text.ZIndex, text.Parent = Enum.Font.GothamBold, Color3.fromRGB(255, 229, 184), 81, announcement
		local size = Instance.new("UITextSizeConstraint")
		size.MinTextSize, size.MaxTextSize, size.Parent = 11, index == 1 and 22 or 14, text
		if index == 1 then headline = text else detail = text end
	end
	local announcementVersion = 0
	table.insert(connections, remotes:WaitForChild("WorldAnnouncement").OnClientEvent:Connect(function(kind)
		if kind ~= "Incoming" and kind ~= "Impact" then return end
		announcementVersion += 1
		local version = announcementVersion
		local camera = workspace.CurrentCamera
		local compact = not camera or camera.ViewportSize.X < 1100
		announcement.AnchorPoint = Vector2.new(compact and .5 or 1, 0)
		announcement.Position = compact and UDim2.new(.5, 0, 0, 280) or UDim2.new(1, -20, 0, 22)
		headline.Text = kind == "Incoming" and "COOKIE METEOR INCOMING!" or "COOKIE METEOR LANDED!"
		detail.Text = kind == "Incoming" and "Watch the sky! A Star Crumb meteor is falling." or "Follow the fire. Land 3 rolling-pin hits to earn Star Crumbs."
		announcement.Visible = true
		audio:PlayCue(kind == "Incoming" and "MeteorIncoming" or "MeteorCrash")
		task.delay(kind == "Incoming" and 6 or 9, function()
			if announcement.Parent and version == announcementVersion then announcement.Visible = false end
		end)
	end))
	CardUI.start(remotes, gui)
	local shade = Instance.new("TextButton")
	shade.Size, shade.Text, shade.BackgroundTransparency, shade.BackgroundColor3, shade.ZIndex, shade.Visible, shade.Parent = UDim2.fromScale(1, 1), "", 0.35, Color3.new(), 25, false, gui
	local panel = Instance.new("Frame")
	panel.AnchorPoint, panel.Position, panel.Size, panel.BackgroundColor3, panel.ZIndex, panel.Visible, panel.Parent = Vector2.new(0.5, 0.5), UDim2.fromScale(0.5, 0.5), UDim2.fromScale(0.94, 0.88), Color3.fromRGB(54, 39, 33), 26, false, gui
	local size = Instance.new("UISizeConstraint")
	size.MaxSize, size.Parent = Vector2.new(520, 650), panel
	local function label(parent, text)
		local t = Instance.new("TextLabel")
		t.Size, t.AutomaticSize, t.BackgroundTransparency, t.Text = UDim2.new(1, -8, 0, 0), Enum.AutomaticSize.Y, 1, text
		t.TextSize, t.Font, t.TextColor3, t.TextWrapped, t.ZIndex, t.Parent = 15, Enum.Font.GothamBold, Color3.fromRGB(255, 236, 209), true, 28, parent
		return t
	end
	local function button(parent, text, callback)
		local b = Instance.new("TextButton")
		b.Size, b.Text, b.TextWrapped, b.TextSize, b.Font = UDim2.new(1, -8, 0, 48), text, true, 14, Enum.Font.GothamBold
		b.BackgroundColor3, b.TextColor3, b.BorderSizePixel, b.ZIndex, b.Parent = Color3.fromRGB(75, 119, 103), Color3.fromRGB(255, 236, 209), 0, 28, parent
		local c = Instance.new("UICorner")
		c.CornerRadius, c.Parent = UDim.new(0, 9), b
		b.Activated:Connect(callback)
		return b
	end
	local header = label(panel, "COOKIE BAG")
	header.Position, header.Size = UDim2.fromOffset(14, 12), UDim2.new(1, -70, 0, 28)
	local close = button(panel, "X", function() panel.Visible, shade.Visible = false, false end)
	close.Position, close.Size = UDim2.new(1, -48, 0, 10), UDim2.fromOffset(34, 34)
	shade.Activated:Connect(function() panel.Visible, shade.Visible = false, false end)
	local scroll = Instance.new("ScrollingFrame")
	scroll.Position, scroll.Size, scroll.BackgroundTransparency, scroll.BorderSizePixel = UDim2.fromOffset(14, 100), UDim2.new(1, -28, 1, -114), 1, 0
	scroll.CanvasSize, scroll.AutomaticCanvasSize, scroll.ScrollBarThickness, scroll.ZIndex, scroll.Parent = UDim2.new(), Enum.AutomaticSize.Y, 4, 27, panel
	local layout = Instance.new("UIListLayout")
	layout.Padding, layout.SortOrder, layout.Parent = UDim.new(0, 9), Enum.SortOrder.LayoutOrder, scroll
	local function send(name, argument) action:FireServer(name, argument) end
	local render
	for index, name in ipairs({ "Bag", "Mine", "Machines", "People", "Cards" }) do
		local b = button(panel, name, function() tab = name ; render() end)
		b.Position, b.Size = UDim2.new((index - 1) * 0.2, 4, 0, 53), UDim2.new(0.2, -8, 0, 34)
	end
	render = function()
		for _, child in ipairs(scroll:GetChildren()) do if child ~= layout then child:Destroy() end end
		header.Text = ({ Bag = "COOKIE BAG", Mine = "DOUGH MINE", Machines = "BAKERY MACHINES", People = "COOKIES & COMPANY", Cards = "COOKIE ANIMAL CARDS" })[tab]
		local count = 0
		local function row(text, callback)
			count += 1
			local element = callback and button(scroll, text, callback) or label(scroll, text)
			element.LayoutOrder = count
			if callback then element.Interactable = not snapshot.busy end
			return element
		end
		local data = snapshot.life
		if snapshot.busy then row("Saving cookie exchange. Please wait...") end
		if tab == "Cards" then
			CardUI.render(player, data.cards, row, send, panel)
		elseif tab == "Bag" then
			row(#data.inventory .. "/" .. Life.capacity(data) .. " cookies • Hold a conveyor cookie's pickup prompt to store it.")
			if snapshot.held then row("Eat held cookie • recipe buff + cookie skin", function() send("Eat", snapshot.held) end) end
			if data.oven.id then row("Finishing oven: " .. math.max(0, data.oven.ready - os.time()) .. "s remaining") end
			for _, cookie in ipairs(data.inventory) do
				local item = cookie
				local held = snapshot.held == item.id
				local buff = Polish.buff(item.recipe)
				local entry = row(Recipes[item.recipe].Name .. " • $" .. Progression.format(Life.value(item)) .. (item.baked and " • Finished" or "") .. "\n" .. buff.Name .. ": " .. Polish.describe(item.recipe) .. "\n" .. (data.oven.id == item.id and "In finishing oven" or held and "Holding • click/tap tool to eat" or "Tap to hold"), function() send("Equip", item.id) end)
				entry.Size = UDim2.new(1, -8, 0, 76)
			end
		elseif tab == "Mine" then
			row("Dough: " .. data.dough .. " • " .. Life.PinNames[data.pin] .. " rolling pin (" .. data.pin .. "/5)")
			row("West of the plaza: enter the cave, equip your rolling pin, then left-click near ore to swing. Visit the mine workshop to buy upgrades.")
			local cost = Life.PinCosts[data.pin + 1]
			row(cost and (Life.PinNames[data.pin + 1] .. " rolling pin • $" .. Progression.format(cost)) or "Best rolling pin owned", function() send("Pin") end)
			for _, key in ipairs({ "Mixing", "Flow", "Pockets" }) do
				local level, definition = data.upgrades[key], Life.DoughUpgrades[key]
				local bonus = ({ Mixing = "+10% cookie income", Flow = "+5% baking speed", Pockets = "+4 cookie slots" })[key]
				row(key .. " " .. level .. "/" .. definition.Max .. " • " .. bonus .. "\n" .. (level == definition.Max and "MAX" or definition.Cost * 2^level .. " dough"), function() send("Dough", key) end)
			end
		elseif tab == "Machines" then
			row("Visit the pads beside your own conveyor to build, decorate, or install machines.")
			local name = Instance.new("TextBox")
			name.Size, name.PlaceholderText, name.Text, name.ClearTextOnFocus, name.LayoutOrder, name.TextSize, name.ZIndex, name.Parent = UDim2.new(1,-8,0,40), "New bakery name (3–40 characters)", renameDraft, false, 1, 14, 28, scroll
			name:GetPropertyChangedSignal("Text"):Connect(function() renameDraft = name.Text end)
			name.FocusLost:Connect(function()
				task.delay(.2, function() if pendingRender and panel.Visible then pendingRender = false; render() end end)
			end)
			count += 1
			row("Rename cookie shop • $20 million", function() send("RenameShop", name.Text) end)
			local beltCost = Polish.BeltCosts[data.belt + 1]
			row(beltCost and ("Build conveyor line " .. (data.belt + 1) .. " • " .. (beltCost == 0 and "FREE" or "$" .. Progression.format(beltCost))) or "All three conveyor lines built", function() send("BuildBelt") end)
			for _, key in ipairs(Polish.DecorationOrder) do
				local definition = Polish.Decorations[key]
				row(definition.Name .. " • " .. (data.decorations[key] and "Owned" or "$" .. Progression.format(definition.Cost)), function() send("Decoration", key) end)
			end
			for _, key in ipairs({ "Packager", "Boxer", "FinishingOven" }) do
				local owned = data.machines[key]
				row(key .. " • " .. (owned and "Owned" or "$" .. Progression.format(Life.Machines[key].Cost)) .. "\n" .. ({ Packager = "+25% production and picked-cookie value", Boxer = "+50% production and picked-cookie value", FinishingOven = "20 seconds • finish one inventory cookie for 3x value" })[key], function() send("Machine", key) end)
			end
			if data.machines.FinishingOven then row("Finish held cookie (at your oven pad)", function() send("Bake") end) end
		else
			local trade, bargain = snapshot.trade, snapshot.bargain
			if trade then
				row("FREE COOKIE GIFT\n@" .. trade.from .. " → @" .. trade.to .. "\n" .. trade.giveA .. "\nNo cash or return cookie is required.")
				row(trade.confirmed and "You confirmed • waiting for the other player" or (player.Name == trade.from and "Confirm sending gift" or "Accept free cookie"), function() send("ConfirmTrade", trade.id) end)
				row("Decline / cancel", function() send("CancelTrade") end)
			elseif bargain then
				row(bargain.name .. " • " .. bargain.personality .. "\nFavorite: " .. bargain.favorite .. "\nOffers $" .. Progression.format(bargain.price) .. " • " .. bargain.attempts .. " pitches")
				row("Sell for $" .. Progression.format(bargain.price), function() send("Sell") end)
				row("Pitch a higher price • risk annoying them", function() send("Pitch") end)
				row("Walk away", function() send("WalkAway") end)
			else row("Hold a cookie and approach a roaming customer to bargain. Too many pitches make them walk away.\n\nHold E on another player to ask 'Want a cookie?'. Both confirm the free gift. The recipient pays nothing and keeps their own cookies.") end
		end
	end
	openButton.Activated:Connect(function() tab, panel.Visible, shade.Visible = "Bag", true, true ; render() end)
	table.insert(connections, stateRemote.OnClientEvent:Connect(function(data)
		snapshot = data
		if panel.Visible then
			local focused = game:GetService("UserInputService"):GetFocusedTextBox()
			if focused and focused:IsDescendantOf(panel) then pendingRender = true else render() end
		end
	end))
	table.insert(connections, open.OnClientEvent:Connect(function(name) tab = name == "Bag" and "Bag" or (name == "Mine" and "Mine" or "People"); if name == "Gift" then pcall(function() game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Cookie gift", Text = "Someone wants to give you a cookie. Accept or decline here.", Duration = 8 }) end) end; panel.Visible, shade.Visible = true, true ; render() end))
	table.insert(connections, player:GetAttributeChangedSignal("DataReady"):Connect(function() if player:GetAttribute("DataReady") then send("Snapshot") end end))
	send("Snapshot")
	local status = label(hud, "Star Crumbs")
	status.Position, status.Size, status.AutomaticSize, status.TextSize, status.ZIndex = UDim2.fromOffset(14, 236), UDim2.new(1, -28, 0, 22), Enum.AutomaticSize.None, 11, 2
	status.TextScaled = true
	local statusSize = Instance.new("UITextSizeConstraint")
	statusSize.MinTextSize, statusSize.MaxTextSize, statusSize.Parent = 9, 12, status
	local skyFolder = Instance.new("Folder")
	skyFolder.Name, skyFolder.Parent = "Local Cookie Sun", workspace
	local sun = Instance.new("Model")
	sun.Name, sun.Parent = "Cookie Sun", skyFolder
	local function sunPart(name, size, offset, color)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, CFrame.new(offset), color
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow, p.Material, p.Parent = true, false, false, false, false, Enum.Material.Neon, sun
		return p
	end
	local disk = sunPart("Cookie Sun Disk", Vector3.new(4, 100, 100), Vector3.zero, Color3.fromRGB(246, 189, 105))
	disk.Shape, sun.PrimaryPart = Enum.PartType.Cylinder, disk
	for i = 1, 12 do
		local chip = sunPart("Sun Chocolate Chip", Vector3.new(5, 10, 9), Vector3.new(3, math.sin(i * 2.4) * 34, math.cos(i * 2.4) * 34), Color3.fromRGB(98, 57, 31))
		chip.Shape = Enum.PartType.Ball
	end
	local moon = Instance.new("Model")
	moon.Name, moon.Parent = "Chocolate Chip Cookie Moon", skyFolder
	local function moonPiece(name, size, offset, color, shape)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color, p.Shape = name, size, CFrame.new(offset), color, shape or Enum.PartType.Ball
		p.Anchored, p.CanCollide, p.CanTouch, p.CanQuery, p.CastShadow, p.Material, p.Parent = true,false,false,false,false,Enum.Material.Neon,moon
		return p
	end
	local crust = moonPiece("Golden Baked Edge", Vector3.new(7,94,94),Vector3.zero,Color3.fromRGB(158,101,51),Enum.PartType.Cylinder)
	moon.PrimaryPart=crust
	moonPiece("Warm Cookie Face",Vector3.new(8,88,88),Vector3.new(1,0,0),Color3.fromRGB(225,182,118),Enum.PartType.Cylinder)
	for i=1,23 do
		local angle=i*2.399963
		local radius=math.sqrt(i/24)*36
		moonPiece("Chocolate Chunk",Vector3.new(2.5,5+(i%3),4+(i%4)),Vector3.new(5,math.sin(angle)*radius,math.cos(angle)*radius),Color3.fromRGB(69,42,28))
	end
	for i=1,32 do
		local angle=i*2.399963
		local radius=math.sqrt(i/33)*40
		moonPiece("Baked Sugar Pore",Vector3.new(.4,1.1,1.2),Vector3.new(5.1,math.cos(angle)*radius,math.sin(angle)*radius),Color3.fromRGB(183,137,78))
	end
	local elapsed, sunVisible, lastGuide, moonVisible = 0, nil, nil, nil
	table.insert(connections, RunService.RenderStepped:Connect(function(dt)
		local camera = workspace.CurrentCamera
		if camera then
			local direction = Lighting:GetSunDirection()
			local visible = direction.Y > -0.02
			if visible ~= sunVisible then
				sunVisible = visible
				for _, part in ipairs(sun:GetChildren()) do if part:IsA("BasePart") then part.Transparency = visible and 0 or 1 end end
			end
			local position = camera.CFrame.Position + direction * 1500
			sun:PivotTo(CFrame.lookAt(position, camera.CFrame.Position) * CFrame.Angles(0, math.pi / 2, 0))
			local moonDirection = -direction
			local showMoon = moonDirection.Y > .02
			if showMoon ~= moonVisible then
				moonVisible = showMoon
				for _, part in ipairs(moon:GetChildren()) do part.Transparency = showMoon and 0 or 1 end
			end
			local moonPosition = camera.CFrame.Position + moonDirection * 1400
			moon:PivotTo(CFrame.lookAt(moonPosition, camera.CFrame.Position) * CFrame.Angles(0,math.pi/2,0))
		end
		elapsed += dt
		if elapsed < 0.2 then return end
		elapsed = 0
		for _, other in ipairs(Players:GetPlayers()) do
			local body = other.Character and other.Character:FindFirstChild("HumanoidRootPart")
			local prompt = body and body:FindFirstChild("CookieTradePrompt")
			if prompt then prompt.Enabled = other ~= player and player:GetAttribute("HeldCookieId") ~= nil end
		end
		local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
		for _, sign in ipairs(CollectionService:GetTagged("BakeryOwnerSign")) do
			local anchor = sign.Parent
			local range = sign:GetAttribute("OwnerUserId") == player.UserId and 180 or 55
			sign.Enabled = root ~= nil and anchor and anchor:IsA("BasePart") and (root.Position - anchor.Position).Magnitude <= range or false
		end
		if not root or not camera then return end
		local buff = player:GetAttribute("CookieBuffName") or ""
		status.Text = snapshot.life.cards.crumbs .. " Star Crumbs" .. (player:GetAttribute("InCookiePVP") and " • PVP ON" or buff ~= "" and (" • " .. buff) or "")
		if panel.Visible and tab == "Bag" and snapshot.life.oven.id then
			local second = os.time()
			if second ~= lastGuide then lastGuide = second ; render() end
		end
	end))
	table.insert(connections, workspace.DescendantAdded:Connect(function(object)
		if object:IsA("ProximityPrompt") and object.Name == "CookieTradePrompt" and object:GetAttribute("TargetUserId") == player.UserId then object.Enabled = false end
	end))
	for _, object in ipairs(workspace:GetDescendants()) do if object:IsA("ProximityPrompt") and object.Name == "CookieTradePrompt" and object:GetAttribute("TargetUserId") == player.UserId then object.Enabled = false end end
	gui.Destroying:Connect(function()
		for _, connection in ipairs(connections) do connection:Disconnect() end
		skyFolder:Destroy()
	end)
end
return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="764">
          <Properties>
            <string name="Name">CardArt</string>
            <string name="Source"><![CDATA[local Catalog = if script then require(game:GetService("ReplicatedStorage").CookieTycoon.CardCatalog) else require("../shared/CardCatalog")
local Art = {}

-- Position the complete sheet behind a clipping frame. Relative coordinates
-- stay correct if Roblox serves a smaller texture or the UI uses UIScale.
function Art.layout(sheet, index, width, height)
	if width <= 0 or height <= 0 then return nil end
	local col, row = index % sheet.Columns, math.floor(index / sheet.Columns)
	local cellW, cellH = sheet.Width / sheet.Columns, sheet.Height / sheet.Rows
	local left, top = math.floor(col * cellW) + 2, math.floor(row * cellH) + 2
	local cropW = math.floor((col + 1) * cellW) - 2 - left
	local cropH = math.floor((row + 1) * cellH) - 2 - top
	local scale = math.max(width / cropW, height / cropH)
	return {
		Width = sheet.Width * scale / width, Height = sheet.Height * scale / height,
		X = .5 - (left + cropW / 2) * scale / width,
		Y = .5 - (top + cropH / 2) * scale / height,
	}
end

function Art.mount(parent, card, size)
	local sheet, index = Catalog.art(card.Id)
	if sheet and type(sheet.Id) == "number" and sheet.Id > 0 and sheet.Width > 0 and sheet.Height > 0 then
		local window = Instance.new("Frame")
		window.Name, window.Size, window.BackgroundTransparency = "CardIllustration", size, 1
		window.BorderSizePixel, window.ClipsDescendants, window.Parent = 0, true, parent
		local image = Instance.new("ImageLabel")
		image.Name, image.BackgroundTransparency, image.BorderSizePixel = "FullResolutionSheet", 1, 0
		image.ScaleType, image.ResampleMode = Enum.ScaleType.Stretch, Enum.ResamplerMode.Default
		image.Image, image.Visible, image.Parent = "rbxassetid://" .. sheet.Id, false, window
		local function layout()
			local transform = Art.layout(sheet, index, window.AbsoluteSize.X, window.AbsoluteSize.Y)
			if not transform then image.Visible = false; return end
			image.Size = UDim2.fromScale(transform.Width, transform.Height)
			image.Position = UDim2.fromScale(transform.X, transform.Y)
			image.ZIndex, image.Visible = window.ZIndex, true
		end
		local resize = window:GetPropertyChangedSignal("AbsoluteSize"):Connect(layout)
		local layer = window:GetPropertyChangedSignal("ZIndex"):Connect(function() image.ZIndex = window.ZIndex end)
		window.Destroying:Connect(function() resize:Disconnect(); layer:Disconnect() end)
		layout()
		-- Request the original asset directly; thumbnails and the static Preview
		-- image are never used for an in-game card illustration.
		task.spawn(function() pcall(function() game:GetService("ContentProvider"):PreloadAsync({ image }) end) end)
		return window
	end
	-- Original 3D cookie-animal fallback works before the generated atlas is uploaded.
	local view, scene, camera = Instance.new("ViewportFrame"), Instance.new("WorldModel"), Instance.new("Camera")
	view.Size, view.BackgroundColor3, view.Ambient, view.LightColor = size, Color3.fromRGB(230, 218, 193), Color3.fromRGB(190, 183, 167), Color3.fromRGB(255, 236, 198)
	view.LightDirection, view.Parent, scene.Parent, camera.Parent, view.CurrentCamera = Vector3.new(-1, -1, -2), parent, view, view, camera
	local palette = { Color3.fromRGB(198, 145, 87), Color3.fromRGB(175, 119, 76), Color3.fromRGB(237, 211, 157), Color3.fromRGB(99, 60, 42), Color3.fromRGB(230, 175, 154), Color3.fromRGB(148, 200, 160) }
	local base = palette[(card.Id - 1) % #palette + 1]
	if card.Id == 33 then base = Color3.fromRGB(140, 205, 165) end
	local function p(name, position, shapeSize, color, shape)
		local part = Instance.new("Part")
		part.Name, part.Anchored, part.Size, part.Position, part.Color, part.Shape, part.Parent = name, true, shapeSize, position, color, shape or Enum.PartType.Ball, scene
		return part
	end
	p("Cookie body", Vector3.new(0, 0, 0), Vector3.new(2, 2.1, 1.25), base)
	p("Cookie head", Vector3.new(0, 1.1, -.2), Vector3.new(2.15, 1.8, 1.4), base)
	p("Cream muzzle", Vector3.new(0, .8, -1), Vector3.new(1.1, .65, .28), Color3.fromRGB(244, 224, 185))
	local bunny = card.Animal == "Bunny"
	for _, side in ipairs({ -1, 1 }) do
		p("Ear", Vector3.new(side*.8, bunny and 2.4 or 1.8, -.2), Vector3.new(.55, bunny and 1.6 or .6, .4), base)
		p("Eye", Vector3.new(side*.43, 1.25, -.9), Vector3.new(.28, .34, .12), Color3.fromRGB(48, 35, 31))
		p("Eye shine", Vector3.new(side*.43-.04, 1.32, -.97), Vector3.new(.07, .09, .04), Color3.new(1,1,1))
		p("Paw", Vector3.new(side*.7, -.85, -.3), Vector3.new(.8, .55, .8), base)
	end
	p("Nose", Vector3.new(0, .95, -1.19), Vector3.new(.2, .15, .1), Color3.fromRGB(72, 45, 32))
	for i = 1, 9 do p("Chocolate chip", Vector3.new(math.sin(i*2.4)*.8, -.55+(i%4)*.35, -.67), Vector3.new(.19,.16,.1), Color3.fromRGB(86,53,34)) end
	if card.Id >= 26 then
		for _, side in ipairs({ -1, 1 }) do
			p("Sugar horn", Vector3.new(side*.6, 2.1, -.1), Vector3.new(.25,.7,.25), Color3.fromRGB(246,215,139))
			if card.Id >= 31 then
				local wing = Instance.new("WedgePart")
				wing.Size, wing.CFrame, wing.Color, wing.Anchored, wing.Parent = Vector3.new(.25, 1.8, 2.6), CFrame.new(side*1.5,.6,.4)*CFrame.Angles(0,0,side*.7), base:Lerp(Color3.new(1,1,1), .2), true, scene
			end
		end
	end
	camera.CFrame = CFrame.lookAt(Vector3.new(3,2.3,-7.5), Vector3.new(0,.8,0))
	return view
end
return Art
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="765">
          <Properties>
            <string name="Name">CardPacksClient</string>
            <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Catalog = require(Shared.CardCatalog)
local FrameDesign, Tween = require(script.Parent.TradingCardFrame), game:GetService("TweenService")
local Client = {}
function Client.describe(card)
	local parts = {}
	for _, stat in ipairs({ "Cash", "Speed", "Sales", "Crumbs", "Mine" }) do
		local amount = card.Effects[stat]
		if amount then table.insert(parts, "+" .. (stat == "Mine" and amount or math.floor(amount*100+.5).."%") .. " " .. ({Cash="income",Speed="production",Sales="sales",Crumbs="Star Crumbs",Mine="mining damage"})[stat]) end
	end
	return table.concat(parts, " • ")
end
function Client.render(player, data, row, send, panel)
	local third = player:GetAttribute("ThirdCardSlotOwned") == true
	row(data.crumbs .. " STAR CRUMBS • " .. #data.equipped .. "/" .. (third and 3 or 2) .. " cards equipped")
	row("Earn crumbs through quests, ore, bakery milestones, meteors, and the PvP hill. Cards and crumbs survive rebirth.")
	row("Next meteor: about " .. math.ceil((player:GetAttribute("NextMeteorSeconds") or 300)/60) .. " minutes • Hill: west meadow")
	local buy = row(third and "Third slot owned" or "Optional third slot • configured as a 150 Robux pass", function() Shared.Remotes.RequestPurchase:FireServer("Pass", "ThirdCardSlot") end)
	buy.Interactable = not third and require(Shared.ShopCatalog).offer("Pass", "ThirdCardSlot") ~= nil
	for id, pack in ipairs(Catalog.Packs) do
		local odds = {}
		for i, weight in ipairs(pack.Weights) do table.insert(odds, Catalog.Rarities[i] .. " " .. string.format("%g%%", weight/100)) end
		row(pack.Name .. " • " .. pack.Cost .. " crumbs\n" .. table.concat(odds, " / "))
		local button = row("Rip " .. pack.Name, function() send("OpenPack", id) end)
		button.Interactable = button.Interactable and data.crumbs >= pack.Cost
	end
	row("Each animal within a rarity is equally likely. Duplicates are kept, but the same card cannot fill multiple slots.")
	for id, card in ipairs(Catalog.Cards) do
		local count = data.owned[tostring(id)]
		if not count then continue end
		local equipped = table.find(data.equipped, id)
		local button = row((equipped and "✓ " or "") .. card.Name .. " • " .. card.Rarity .. " ×" .. count .. "\n" .. Client.describe(card), function() send("EquipCard", id) end)
		button.Size = UDim2.new(1,-8,0,65)
		button.BackgroundColor3 = Color3.fromRGB(table.unpack(Catalog.Colors[card.Rarity])):Lerp(Color3.fromRGB(40,40,35),.55)
		local artButton = row("View " .. card.Animal .. " card", function() Client.reveal(panel.Parent, id, false) end)
		artButton.Size = UDim2.new(1,-8,0,30)
	end
end
function Client.reveal(gui, cardId, ripping)
	local old = gui:FindFirstChild("CardReveal")
	if old then old:Destroy() end
	local card = Catalog.Cards[cardId]
	if not card then return end
	local shade = Instance.new("TextButton")
	shade.Name, shade.Size, shade.Text, shade.BackgroundColor3, shade.BackgroundTransparency, shade.ZIndex, shade.Parent = "CardReveal", UDim2.fromScale(1,1), "", Color3.new(), .2, 50, gui
	local frame = FrameDesign.create(shade, card, Client.describe(card))
	frame.Position, frame.AnchorPoint = UDim2.fromScale(.5,.5),Vector2.new(.5,.5)
	local scale = Instance.new("UIScale")
	local viewport = workspace.CurrentCamera and workspace.CurrentCamera.ViewportSize or Vector2.new(800,600)
	scale.Scale, scale.Parent = math.min(1, viewport.Y / 590, viewport.X / 390),frame
	local close = Instance.new("TextButton")
	close.Text,close.Position,close.Size,close.BackgroundColor3,close.TextColor3,close.Font,close.TextSize,close.ZIndex,close.Parent = "CLOSE",UDim2.new(1,-35,0,-15),UDim2.fromOffset(50,30),Color3.fromRGB(30,34,41),Color3.new(1,1,1),Enum.Font.GothamBold,11,60,frame
	close.Activated:Connect(function() shade:Destroy() end)
	if ripping then
		for side=0,1 do
			local flap=Instance.new("Frame")
			flap.Size,flap.Position,flap.BackgroundColor3,flap.ZIndex,flap.Parent=UDim2.fromScale(.5,1),UDim2.fromScale(side*.5,0),Color3.fromRGB(112,167,142),58,frame
			local label=Instance.new("TextLabel")
			label.Text,label.Size,label.BackgroundTransparency,label.TextColor3,label.TextSize,label.ZIndex,label.Parent = side==0 and "COOKIE" or "FRIENDS",UDim2.fromScale(1,1),1,Color3.fromRGB(255,238,197),19,59,flap
			Tween:Create(flap,TweenInfo.new(.65,Enum.EasingStyle.Back,Enum.EasingDirection.In),{Position=UDim2.fromScale(side==0 and -.8 or 1.3,0),Rotation=side==0 and -12 or 12}):Play()
			game:GetService("Debris"):AddItem(flap,.8)
		end
	end
	shade.Activated:Connect(function() shade:Destroy() end)
end
function Client.start(remotes, gui)
	remotes:WaitForChild("PackResult").OnClientEvent:Connect(function(cardId) Client.reveal(gui,cardId,true) end)
end
return Client
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="766">
          <Properties>
            <string name="Name">TradingCardFrame</string>
            <string name="Source"><![CDATA[-- Original TCG frame: game text stays readable and independent of illustration assets.
local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Catalog, Art = require(Shared.CardCatalog), require(script.Parent.CardArt)
local Tween = game:GetService("TweenService")
local CardFrame = {}
function CardFrame.create(parent, card, description)
	local rarity = Color3.fromRGB(table.unpack(Catalog.Colors[card.Rarity]))
	local rank = table.find(Catalog.Rarities, card.Rarity) or 1
	local frame = Instance.new("Frame")
	frame.Name, frame.Size, frame.BackgroundColor3, frame.BorderSizePixel, frame.ZIndex, frame.Parent = "TradingCard", UDim2.fromOffset(352, 520), Color3.fromRGB(29, 32, 39), 0, 51, parent
	local function panel(name, x, y, w, h, color, z)
		local p = Instance.new("Frame")
		p.Name, p.Position, p.Size, p.BackgroundColor3, p.BorderSizePixel, p.ZIndex, p.Parent = name, UDim2.fromOffset(x,y), UDim2.fromOffset(w,h), color, 0, z or 52, frame
		return p
	end
	local function corner(object, radius)
		local c = Instance.new("UICorner"); c.CornerRadius, c.Parent = UDim.new(0,radius), object
	end
	local function stroke(object, color, width)
		local s = Instance.new("UIStroke"); s.Color, s.Thickness, s.Parent = color, width, object
	end
	local function text(value, x, y, w, h, size, color, font)
		local t = Instance.new("TextLabel")
		t.Position, t.Size, t.Text, t.TextSize, t.TextColor3 = UDim2.fromOffset(x,y), UDim2.fromOffset(w,h), value, size, color
		t.BackgroundTransparency, t.TextWrapped, t.Font, t.TextXAlignment, t.ZIndex, t.Parent = 1, true, font or Enum.Font.GothamBold, Enum.TextXAlignment.Left, 56, frame
		return t
	end
	local ink, cream = Color3.fromRGB(37,34,32), Color3.fromRGB(245,235,209)
	corner(frame, 14); stroke(frame, Color3.fromRGB(14,16,20), 3)
	local rim = panel("Foil Rim", 6,6,340,508,rarity)
	corner(rim,10)
	local field = panel("Card Stock",12,12,328,496,Color3.fromRGB(222,203,165),53)
	corner(field,7)
	local wash = Instance.new("UIGradient")
	wash.Color, wash.Rotation, wash.Parent = ColorSequence.new(Color3.fromRGB(247,237,209),Color3.fromRGB(190,168,127)),90,field
	panel("Nameplate",19,20,314,45,Color3.fromRGB(39,45,53),54)
	local name = text(card.Name,27,23,273,39,20,Color3.fromRGB(255,244,216))
	name.TextScaled = true
	local nameSize = Instance.new("UITextSizeConstraint")
	nameSize.MinTextSize, nameSize.MaxTextSize, nameSize.Parent = 12,21,name
	local emblem = panel("Rarity Emblem",310,35,12,12,rarity,56)
	emblem.Rotation = 45
	text(string.upper(card.Animal) .. " / BAKERY COMPANION",23,67,240,20,10,ink)
	local stars = text(string.rep("◆",rank),260,67,68,20,10,ink)
	stars.TextXAlignment = Enum.TextXAlignment.Right
	local artBorder = panel("Illustration Keyline",19,91,314,252,Color3.fromRGB(42,43,44),54)
	stroke(artBorder,Color3.fromRGB(151,127,87),1)
	local art = Art.mount(frame,card,UDim2.fromOffset(308,246))
	art.Position, art.ZIndex = UDim2.fromOffset(22,94),55
	panel("Rarity Ribbon",20,347,312,23,rarity,54)
	text(string.upper(card.Rarity) .. "  •  COOKIE CORNER",27,348,298,21,11,ink)
	local rules = panel("Ability Box",20,377,312,69,cream,54)
	stroke(rules,Color3.fromRGB(153,130,95),1)
	text("BAKERY AURA",28,382,292,17,11,Color3.fromRGB(102,74,38))
	text(description,28,402,294,36,15,ink)
	panel("Flavor Rule",22,453,308,1,Color3.fromRGB(159,137,103),54)
	text('“' .. card.Quip .. '”',25,459,302,31,15,Color3.fromRGB(80,66,49),Enum.Font.Garamond)
	text("CRUMBKIN  /  FIRST BATCH",23,493,230,15,9,ink)
	local number = text(string.format("%03d / 040",card.Id),258,493,70,15,10,ink)
	number.TextXAlignment = Enum.TextXAlignment.Right
	if rank >= 4 then
		local foil = Instance.new("UIGradient")
		foil.Color = ColorSequence.new({ColorSequenceKeypoint.new(0,Color3.fromRGB(245,205,105)),ColorSequenceKeypoint.new(.25,Color3.fromRGB(146,228,237)),ColorSequenceKeypoint.new(.5,Color3.fromRGB(222,154,237)),ColorSequenceKeypoint.new(.75,Color3.fromRGB(244,234,173)),ColorSequenceKeypoint.new(1,Color3.fromRGB(245,205,105))})
		foil.Parent = rim
		local animation = Tween:Create(foil,TweenInfo.new(5,Enum.EasingStyle.Linear,Enum.EasingDirection.InOut,-1),{Rotation=360})
		animation:Play()
		frame.Destroying:Connect(function() animation:Cancel() end)
	elseif rank == 3 then
		local shine = Instance.new("UIGradient")
		shine.Color,shine.Rotation,shine.Parent = ColorSequence.new(rarity,Color3.fromRGB(217,239,255)),35,rim
	end
	return frame
end
return CardFrame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="767">
          <Properties>
            <string name="Name">VolumeSlider</string>
            <string name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")
local GuiService = game:GetService("GuiService")
local Slider = {}

function Slider.create(parent, name, y, read, write)
	local row = Instance.new("Frame")
	row.Name, row.BackgroundTransparency = name .. "Volume", 1
	row.Position, row.Size, row.Parent = UDim2.fromOffset(14, y), UDim2.new(1, -28, 0, 30), parent
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency = UDim2.fromOffset(70, 30), 1
	label.TextColor3, label.Font, label.TextSize = Color3.fromRGB(255, 236, 209), Enum.Font.GothamBold, 11
	label.TextXAlignment, label.Parent = Enum.TextXAlignment.Left, row
	local function control(text, position, size)
		local button = Instance.new("TextButton")
		button.Text, button.Position, button.Size = text, position, size
		button.BackgroundColor3, button.TextColor3 = Color3.fromRGB(96, 76, 66), Color3.fromRGB(255, 236, 209)
		button.BorderSizePixel, button.TextSize, button.Parent = 0, 18, row
		local corner = Instance.new("UICorner")
		corner.CornerRadius, corner.Parent = UDim.new(0, 6), button
		return button
	end
	local minus = control("−", UDim2.fromOffset(72, 1), UDim2.fromOffset(28, 28))
	local plus = control("+", UDim2.new(1, -28, 0, 1), UDim2.fromOffset(28, 28))
	local track = control("", UDim2.fromOffset(108, 1), UDim2.new(1, -144, 0, 28))
	track.Name, track.BackgroundTransparency, track.AutoButtonColor = name .. "Slider", 1, false
	local bar = Instance.new("Frame")
	bar.Size, bar.Position = UDim2.new(1, 0, 0, 6), UDim2.fromOffset(0, 11)
	bar.BackgroundColor3, bar.BorderSizePixel, bar.Parent = Color3.fromRGB(103, 83, 74), 0, track
	local fill = Instance.new("Frame")
	fill.BorderSizePixel, fill.BackgroundColor3, fill.Parent = 0, Color3.fromRGB(133, 199, 173), bar
	local thumb = Instance.new("Frame")
	thumb.AnchorPoint, thumb.Size = Vector2.new(0.5, 0.5), UDim2.fromOffset(14, 20)
	thumb.BackgroundColor3, thumb.BorderSizePixel, thumb.Parent = Color3.fromRGB(255, 208, 92), 0, track
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0, 6), thumb
	local dragging
	local connections = {}
	local function at(x)
		if track.AbsoluteSize.X > 0 then write(math.clamp((x - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)) end
	end
	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			dragging = input
			at(input.Position.X)
		end
	end)
	table.insert(connections, UserInputService.InputChanged:Connect(function(input)
		if dragging and (input == dragging or (dragging.UserInputType == Enum.UserInputType.MouseButton1 and input.UserInputType == Enum.UserInputType.MouseMovement)) then
			at(input.Position.X)
		end
	end))
	table.insert(connections, UserInputService.InputEnded:Connect(function(input)
		if input == dragging then dragging = nil end
	end))
	minus.Activated:Connect(function() write(read() - 0.05) end)
	plus.Activated:Connect(function() write(read() + 0.05) end)
	table.insert(connections, UserInputService.InputBegan:Connect(function(input)
		if GuiService.SelectedObject ~= track then return end
		if input.KeyCode == Enum.KeyCode.Left or input.KeyCode == Enum.KeyCode.DPadLeft then write(read() - 0.05)
		elseif input.KeyCode == Enum.KeyCode.Right or input.KeyCode == Enum.KeyCode.DPadRight then write(read() + 0.05) end
	end))
	track.SelectionGained:Connect(function() bar.BackgroundColor3 = Color3.fromRGB(213, 175, 118) end)
	track.SelectionLost:Connect(function() bar.BackgroundColor3 = Color3.fromRGB(103, 83, 74) end)
	row.Destroying:Connect(function()
		for _, connection in ipairs(connections) do connection:Disconnect() end
	end)
	return function()
		local value = read()
		label.Text = name .. " " .. math.floor(value * 100 + 0.5) .. "%"
		fill.Size = UDim2.fromScale(value, 1)
		thumb.Position = UDim2.new(value, 0, 0.5, 0)
	end
end

return Slider
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
