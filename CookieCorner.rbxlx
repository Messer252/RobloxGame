      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">AudioPreferences</string>
          <string name="Source"><![CDATA[-- Serializable per-player settings, shared by saves, requests, and playback.
local Preferences = { DefaultMusicVolume = 0.24, DefaultEffectsVolume = 0.55 }

function Preferences.validVolume(value)
	return type(value) == "number" and value == value and math.abs(value) < math.huge
end

function Preferences.normalize(raw)
	raw = type(raw) == "table" and raw or {}
	return {
		music = type(raw.music) ~= "boolean" or raw.music,
		effects = type(raw.effects) ~= "boolean" or raw.effects,
		musicVolume = Preferences.validVolume(raw.musicVolume) and math.clamp(raw.musicVolume, 0, 1) or Preferences.DefaultMusicVolume,
		effectsVolume = Preferences.validVolume(raw.effectsVolume) and math.clamp(raw.effectsVolume, 0, 1) or Preferences.DefaultEffectsVolume,
	}
end

function Preferences.update(current, request)
	if type(request) ~= "table" or type(request.music) ~= "boolean" or type(request.effects) ~= "boolean" then return nil end
	local result = Preferences.normalize(current)
	for _, key in ipairs({ "musicVolume", "effectsVolume" }) do
		if request[key] ~= nil then
			if not Preferences.validVolume(request[key]) then return nil end
			result[key] = math.clamp(request[key], 0, 1)
		end
	end
	result.music, result.effects = request.music, request.effects
	return result
end

return Preferences
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">BakeryContracts</string>
          <string name="Source"><![CDATA[local Catalog = if script then require(script.Parent.ChallengeCatalog) else require("./ChallengeCatalog")
local Contracts = {}
Contracts.Kinds = { "Mine", "Sell", "Eat", "Gift", "Bake", "Obby", "Find" }
Contracts.Titles = { Mine = "Dough for the bakery", Sell = "Customer service", Eat = "Taste tester", Gift = "Share something sweet", Bake = "Production shift", Obby = "Baker's agility", Find = "Lost supplies" }
local function integer(v, fallback, maximum)
	return type(v) == "number" and v == v and math.abs(v) < math.huge and math.clamp(math.floor(v), 0, maximum) or fallback
end
function Contracts.normalize(raw)
	raw = type(raw) == "table" and raw or {}
	local state = { cycle = integer(raw.cycle, 0, 1e9), kind = table.find(Contracts.Kinds, raw.kind) and raw.kind or "",
		target = integer(raw.target, 0, 100), progress = integer(raw.progress, 0, 100), reward = integer(raw.reward, 0, 2000000),
		items = {}, found = {}, assigned = integer(raw.assigned, 0, 4102444800), lastKind = table.find(Contracts.Kinds, raw.lastKind) and raw.lastKind or "" }
	if type(raw.items) == "table" then
		for _, id in ipairs(raw.items) do
			if Catalog.Items[id] and not table.find(state.items, id) and #state.items < 3 then table.insert(state.items, id) end
		end
	end
	if type(raw.found) == "table" then for _, id in ipairs(state.items) do if raw.found[id] == true then state.found[id] = true end end end
	if state.kind == "Find" then
		state.target, state.progress = #state.items, 0
		for _ in pairs(state.found) do state.progress += 1 end
	end
	state.progress = math.min(state.target, state.progress)
	return state
end
function Contracts.assign(data, now, kindRoll, targetRoll, itemRoll)
	local old = Contracts.normalize(data.life.contract)
	local index = math.clamp(math.floor(kindRoll * #Contracts.Kinds) + 1, 1, #Contracts.Kinds)
	if Contracts.Kinds[index] == old.lastKind then index = index % #Contracts.Kinds + 1 end
	local state = Contracts.normalize({ kind = Contracts.Kinds[index], lastKind = old.lastKind, cycle = old.cycle, assigned = now })
	local targets = { Mine = 2 + math.floor(targetRoll * 5), Sell = 1 + math.floor(targetRoll * 3), Eat = 1 + math.floor(targetRoll * 3), Gift = 1, Bake = 15 + math.floor(targetRoll * 45), Obby = 1, Find = 2 }
	state.target = targets[state.kind]
	state.reward = math.min(2000000, math.floor((800 + data.unlocked * 150) * (0.8 + targetRoll * 0.8)))
	if state.kind == "Find" then
		local ids = {}
		for id in pairs(Catalog.Items) do table.insert(ids, id) end
		table.sort(ids)
		local start = math.clamp(math.floor(itemRoll * #ids) + 1, 1, #ids)
		state.items = { ids[start], ids[(start + 4) % #ids + 1] }
	end
	data.life.contract = state
	return true, "New task: " .. Contracts.Titles[state.kind] .. ". Check Quests for details.", 0
end
function Contracts.record(data, kind, amount, item)
	local state = data.life.contract
	if not state or state.kind ~= kind or state.progress >= state.target then return false end
	if kind == "Find" then
		if not table.find(state.items, item) or state.found[item] then return false end
		state.found[item] = true
	end
	state.progress = math.min(state.target, state.progress + math.clamp(math.floor(amount or 1), 0, 100))
	return true
end
function Contracts.interact(data, now, kindRoll, targetRoll, itemRoll, skip)
	local state = data.life.contract
	if state.kind == "" then return Contracts.assign(data, now, kindRoll, targetRoll, itemRoll) end
	if state.progress < state.target then
		if skip then
			if now - state.assigned < 60 then return false, "Try this task for a minute before asking for a different one." end
			state.lastKind = state.kind
			return Contracts.assign(data, now, kindRoll, targetRoll, itemRoll)
		end
		return false, "Task progress: " .. state.progress .. "/" .. state.target .. ". Check Quests for details."
	end
	local room = math.max(0, 1e15 - data.cash)
	if room + math.max(0, 1e15 - data.bank) < state.reward then return false, "Make room for the reward first." end
	local reward = state.reward
	data.cash += math.min(room, reward)
	data.bank += math.max(0, reward - room)
	data.life.contract = Contracts.normalize({ cycle = state.cycle + 1, lastKind = state.kind })
	return true, "Task complete! +$" .. reward, reward
end
return Contracts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">BakeryLife</string>
          <string name="Source"><![CDATA[local Recipes = if script then require(script.Parent.Recipes) else require("./Recipes")
local Crafting = if script then require(script.Parent.CookieCrafting) else require("./CookieCrafting")
local Polish = if script then require(script.Parent.BakeryPolish) else require("./BakeryPolish")
local Contracts = if script then require(script.Parent.BakeryContracts) else require("./BakeryContracts")
local Cards = if script then require(script.Parent.CardEconomy) else require("./CardEconomy")
local Life = { MaxCurrency = 1e15, MaxInventory = 40, OvenSeconds = 20 }
Life.Machines = { Packager = { Cost = 25000, Bonus = 0.25 }, Boxer = { Cost = 250000, Bonus = 0.5 }, FinishingOven = { Cost = 2500000, Bonus = 0 } }
Life.PinCosts = { 0, 5000, 50000, 500000, 5000000 }
Life.PinPower = { 1, 3, 7, 15, 30 }
Life.PinNames = { "Maple", "Copper", "Steel", "Gilded", "Starforged" }
Life.DoughUpgrades = { Mixing = { Max = 10, Cost = 25 }, Flow = { Max = 10, Cost = 30 }, Pockets = { Max = 5, Cost = 20 } }
local function integer(v, default, minimum, maximum)
	return type(v) == "number" and v == v and math.abs(v) < math.huge and math.clamp(math.floor(v), minimum, maximum) or default
end
function Life.cookie(raw)
	if type(raw) ~= "table" or type(raw.id) ~= "string" or #raw.id < 1 or #raw.id > 80 then return nil end
	if type(raw.recipe) ~= "number" or raw.recipe % 1 ~= 0 or not Recipes[raw.recipe] then return nil end
	return { id = raw.id, recipe = raw.recipe, mask = integer(raw.mask, 0, 0, 31),
		quality = integer(raw.quality, 0, 0, 10), baked = raw.baked == true, wrapped = raw.wrapped == true, boxed = raw.boxed == true }
end
function Life.sameCookie(a, b)
	a, b = Life.cookie(a), Life.cookie(b)
	if not a or not b then return false end
	for key, value in pairs(a) do if b[key] ~= value then return false end end
	return true
end
function Life.normalize(raw)
	raw = type(raw) == "table" and raw or {}
	local data = { inventory = {}, dough = integer(raw.dough, 0, 0, 1e9), pin = integer(raw.pin, 1, 1, 5),
		upgrades = {}, machines = {}, recipeLevels = {}, oven = {}, buff = { recipe = 1, expires = 0, seed = 1 }, pendingTrade = "", belt = integer(raw.belt, 0, 0, 3), decorations = {}, contract = Contracts.normalize(raw.contract), cards = Cards.normalize(raw.cards), shopName = type(raw.shopName) == "string" and string.sub(raw.shopName, 1, 60) or "" }
	for key in pairs(Polish.Decorations) do data.decorations[key] = type(raw.decorations) == "table" and raw.decorations[key] == true or false end
	local seen = {}
	if type(raw.inventory) == "table" then
		for _, v in ipairs(raw.inventory) do
			local cookie = Life.cookie(v)
			if cookie and not seen[cookie.id] and #data.inventory < Life.MaxInventory then
				seen[cookie.id] = true
				table.insert(data.inventory, cookie)
			end
		end
	end
	for key, definition in pairs(Life.DoughUpgrades) do data.upgrades[key] = integer(type(raw.upgrades) == "table" and raw.upgrades[key], 0, 0, definition.Max) end
	for key in pairs(Life.Machines) do data.machines[key] = type(raw.machines) == "table" and raw.machines[key] == true or false end
	for i = 1, #Recipes do data.recipeLevels[tostring(i)] = integer(type(raw.recipeLevels) == "table" and raw.recipeLevels[tostring(i)], 0, 0, 10) end
	if type(raw.oven) == "table" and seen[raw.oven.id] then data.oven = { id = raw.oven.id, ready = integer(raw.oven.ready, 0, 0, 4102444800) } end
	if type(raw.buff) == "table" then data.buff = { recipe = integer(raw.buff.recipe, 1, 1, #Recipes), expires = integer(raw.buff.expires, 0, 0, 4102444800), seed = integer(raw.buff.seed, 1, 1, 1000000) } end
	if type(raw.pendingTrade) == "string" and #raw.pendingTrade <= 80 then data.pendingTrade = raw.pendingTrade end
	return data
end
function Life.capacity(data) return 20 + data.upgrades.Pockets * 4 end
function Life.find(data, id)
	for i, cookie in ipairs(data.inventory) do if cookie.id == id then return cookie, i end end
	return nil
end
function Life.available(data, id)
	return data.pendingTrade == "" and data.oven.id ~= id and Life.find(data, id) ~= nil
end
function Life.value(cookie)
	local recipe = Recipes[cookie.recipe]
	return math.floor(recipe.Value * Crafting.rarity(recipe).Multiplier * Crafting.multiplier(Crafting.decode(cookie.mask), cookie.recipe)
		* (1 + (cookie.quality or 0) * 0.2) * (cookie.wrapped and 1.25 or 1) * (cookie.boxed and 1.5 or 1) * (cookie.baked and 3 or 1))
end
function Life.add(data, cookie)
	local valid = Life.cookie(cookie)
	if not valid or Life.find(data, valid.id) or #data.inventory >= Life.capacity(data) then return false, "Your cookie bag is full or this cookie is already stored." end
	table.insert(data.inventory, valid)
	return true
end
function Life.remove(data, id)
	local cookie, index = Life.find(data, id)
	if not cookie then return nil end
	table.remove(data.inventory, index)
	return cookie
end
function Life.eat(data, id, now, seed)
	if not Life.available(data, id) then return false, "That cookie is busy or missing." end
	local cookie = Life.remove(data, id)
	data.buff = { recipe = cookie.recipe, expires = now + 90, seed = seed }
	return true, "Yum! Cookie look and speed boost for 90 seconds."
end
function Life.speed(data, now)
	return Polish.active(data, now).Speed
end
function Life.production(data, now)
	return (1 + Polish.active(data, now or os.time()).Income / 100) * (1 + data.upgrades.Mixing * 0.1) * (data.machines.Packager and 1.25 or 1) * (data.machines.Boxer and 1.5 or 1)
end
function Life.process(cookie, machines, z)
	local changed = false
	if machines.Packager and z >= Polish.WrapZ and not cookie.wrapped then cookie.wrapped, changed = true, true end
	if machines.Boxer and z >= Polish.BoxZ and not cookie.boxed then cookie.boxed, changed = true, true end
	return changed
end
function Life.buyMachine(profile, key)
	local definition = Life.Machines[key]
	if not definition or profile.life.machines[key] then return false, "Machine unavailable or already owned." end
	if profile.cash < definition.Cost then return false, "Collect more wallet cash for this machine." end
	profile.cash -= definition.Cost
	profile.life.machines[key] = true
	return true, key .. " installed!"
end
function Life.upgradeRecipe(profile, index)
	if type(index) ~= "number" or index % 1 ~= 0 or not Recipes[index] or index > profile.unlocked then return false, "Unlock that recipe first." end
	local key = tostring(index)
	local level = profile.life.recipeLevels[key]
	if level >= 10 then return false, "Recipe mastered!" end
	local cost = Life.recipeCost(index, level)
	if profile.cash < cost then return false, "You need more wallet cash for this recipe upgrade." end
	profile.cash -= cost
	profile.life.recipeLevels[key] += 1
	return true, Recipes[index].Name .. " upgraded! +20% recipe income."
end
function Life.recipeCost(index, level) return math.floor((100 + Recipes[index].Cost * 0.35) * 1.7 ^ level) end
function Life.upgradeDough(profile, key)
	local definition = Life.DoughUpgrades[key]
	if not definition then return false, "Unknown dough upgrade." end
	local level = profile.life.upgrades[key]
	if level >= definition.Max then return false, "Dough upgrade maxed." end
	local cost = definition.Cost * 2 ^ level
	if profile.life.dough < cost then return false, "Mine more dough ore first." end
	profile.life.dough -= cost
	profile.life.upgrades[key] += 1
	return true, key .. " upgraded permanently!"
end
function Life.upgradePin(profile)
	local cost = Life.PinCosts[profile.life.pin + 1]
	if not cost then return false, "Best rolling pin owned!" end
	if profile.cash < cost then return false, "Collect more cash for a better rolling pin." end
	profile.cash -= cost
	profile.life.pin += 1
	return true, Life.PinNames[profile.life.pin] .. " rolling pin unlocked!"
end
function Life.startOven(profile, id, now)
	local data = profile.life
	if not data.machines.FinishingOven then return false, "Buy your $2.5M finishing oven first." end
	if data.oven.id then return false, "The finishing oven is busy." end
	if not Life.available(data, id) then return false, "Hold an available cookie first." end
	if Life.find(data, id).baked then return false, "This cookie has already been finished." end
	data.oven = { id = id, ready = now + Life.OvenSeconds }
	return true, "Finishing cookie: 20 seconds, then 3x inventory value."
end
function Life.finishOven(data, now)
	if not data.oven.id or now < data.oven.ready then return false end
	local cookie = Life.find(data, data.oven.id)
	if cookie then cookie.baked = true end
	data.oven = {}
	return cookie ~= nil
end
function Life.pitch(base, attempt, roll)
	if attempt >= 3 or roll < 0.15 + attempt * 0.2 then return false end
	return true, math.floor(base * (1.2 + (attempt + 1) * 0.2))
end
return Life
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">BakeryPolish</string>
          <string name="Source"><![CDATA[-- Pure balance rules for the workshop update. All rolls originate on the server.
local Polish = {}
Polish.WrapZ, Polish.BoxZ = 118.5, 122
Polish.BeltCosts = { 0, 10000, 250000 }
Polish.Decorations = {
	Walls = { Cost = 2500, Name = "Brick walls" }, Windows = { Cost = 6000, Name = "Fitted windows", Requires = "Walls" },
	Door = { Cost = 4000, Name = "Hinged glass door", Requires = "Walls" }, Plants = { Cost = 750, Name = "Potted plants" },
	Trees = { Cost = 1500, Name = "Cookie garden" },
	Roof = { Cost = 25000, Name = "Skylight roof", Requires = "Walls" }, Lights = { Cost = 12000, Name = "Warm pendant lights", Requires = "Roof" },
	Floor = { Cost = 8000, Name = "Herringbone floor" }, Signs = { Cost = 15000, Name = "Bakery lettering" },
	Benches = { Cost = 9000, Name = "Cafe seating" }, Fountain = { Cost = 150000, Name = "Cookie fountain" },
	Display = { Cost = 50000, Name = "Cookie display case" }, FlowerBeds = { Cost = 5000, Name = "Flower borders" },
	Fence = { Cost = 18000, Name = "Garden fencing" },
}
Polish.DecorationOrder = { "Walls", "Windows", "Door", "Roof", "Lights", "Plants", "Trees", "Floor", "Signs", "Benches", "Fountain", "Display", "FlowerBeds", "Fence" }
-- Name, run speed, jump height, mining damage, income %, sale %, regeneration/sec.
local buffs = {
	{ "Chip dash", 8, 0, 0, 0, 0, 0 }, { "Hearty harvest", 2, 0, 2, 0, 0, 1 },
	{ "Sugar hop", 0, 4, 0, 0, 0, 0 }, { "Cocoa strength", 0, 0, 4, 0, 0, 0 },
	{ "Rainbow bounce", 4, 3, 0, 0, 0, 0 }, { "Peanut power", 1, 0, 6, 0, 0, 0 },
	{ "Cinnamon sprint", 10, 1, 0, 0, 0, 0 }, { "Macadamia charm", 0, 0, 0, 0, 25, 0 },
	{ "Ginger grit", 3, 0, 3, 0, 0, 1 }, { "Lemon leap", 3, 6, 0, 0, 0, 0 },
	{ "Velvet recovery", 0, 1, 0, 0, 0, 3 }, { "Mint rush", 14, 0, 0, 0, 0, 0 },
	{ "Caramel closer", 2, 0, 0, 0, 40, 0 }, { "Coconut cloud", 0, 8, 0, 0, 0, 0 },
	{ "Strawberry comfort", 4, 0, 0, 0, 0, 3 }, { "Campfire crafter", 0, 0, 8, 10, 0, 0 },
	{ "Creamy profit", 0, 0, 0, 25, 0, 0 }, { "Matcha focus", 3, 2, 4, 0, 0, 1 },
	{ "Blueberry bound", 5, 7, 0, 0, 0, 0 }, { "Espresso express", 18, 0, 0, 0, 0, 0 },
	{ "Pumpkin prospector", 2, 0, 12, 0, 0, 0 }, { "Rose persuasion", 0, 0, 0, 10, 50, 0 },
	{ "Birthday celebration", 6, 4, 0, 10, 10, 1 }, { "Churro charge", 12, 3, 0, 0, 0, 0 },
	{ "Truffle trader", 4, 0, 0, 0, 65, 0 }, { "Maple miner", 4, 1, 15, 0, 0, 0 },
	{ "Galaxy gravity", 6, 10, 0, 0, 0, 0 }, { "Marshmallow mend", 2, 3, 0, 0, 0, 5 },
	{ "Diamond precision", 0, 0, 20, 15, 0, 0 }, { "Golden baker", 5, 2, 5, 40, 25, 2 },
}
function Polish.buff(recipe)
	local b = buffs[recipe] or buffs[1]
	return { Name = b[1], Speed = b[2], Jump = b[3], Mine = b[4], Income = b[5], Sell = b[6], Regen = b[7], Damage = ({ [4] = 6, [6] = 8, [9] = 4, [16] = 10, [20] = 5, [21] = 8, [26] = 12, [30] = 14 })[recipe] or 0, Defense = ({ [2] = .1, [8] = .12, [11] = .2, [14] = .15, [17] = .2, [22] = .15, [28] = .25, [29] = .3, [30] = .2 })[recipe] or 0, Seconds = 90 }
end
function Polish.describe(recipe)
	local b, parts = Polish.buff(recipe), {}
	for _, entry in ipairs({ { "Speed", " speed" }, { "Jump", " jump" }, { "Mine", " mining" }, { "Income", "% income" }, { "Sell", "% sales" }, { "Regen", " HP/s" }, { "Damage", " pin damage" } }) do
		if b[entry[1]] > 0 then table.insert(parts, "+" .. b[entry[1]] .. entry[2]) end
	end
	if b.Defense > 0 then table.insert(parts, "+" .. math.floor(b.Defense*100) .. "% defense") end
	return table.concat(parts, " • ") .. " • 90s"
end
function Polish.active(life, now)
	return life.buff.expires > now and Polish.buff(life.buff.recipe) or { Speed = 0, Jump = 0, Mine = 0, Income = 0, Sell = 0, Regen = 0, Damage = 0, Defense = 0 }
end
function Polish.buyBelt(data)
	local nextTier = data.life.belt + 1
	local cost = Polish.BeltCosts[nextTier]
	if not cost then return false, "All three conveyor lines are built." end
	if data.cash < cost then return false, "Collect more cash to expand your conveyor." end
	data.cash -= cost
	data.life.belt = nextTier
	return true, "Conveyor line " .. nextTier .. " built!"
end
function Polish.buyDecoration(data, key)
	local item = Polish.Decorations[key]
	if not item or data.life.decorations[key] then return false, "Decoration unavailable or already owned." end
	if item.Requires and not data.life.decorations[item.Requires] then return false, "Buy " .. Polish.Decorations[item.Requires].Name .. " first." end
	if data.cash < item.Cost then return false, "Collect more cash for this decoration." end
	data.cash -= item.Cost
	data.life.decorations[key] = true
	return true, item.Name .. " installed!"
end
local styles = {
	{ Name = "Foodie", Appetite = 1.4, Patience = 4 }, { Name = "Bargain hunter", Appetite = 0.85, Patience = 2 },
	{ Name = "Tourist", Appetite = 1.2, Patience = 3 }, { Name = "Collector", Appetite = 1.65, Patience = 3 },
	{ Name = "Hungry local", Appetite = 1.1, Patience = 5 }, { Name = "Busy commuter", Appetite = 1.3, Patience = 1 },
}
function Polish.customer(styleRoll, recipeRoll, moodRoll)
	local style = styles[math.clamp(math.floor(styleRoll * #styles) + 1, 1, #styles)]
	return { Style = style.Name, Favorite = math.clamp(math.floor(recipeRoll * 30) + 1, 1, 30),
		Appetite = style.Appetite, Patience = style.Patience, Mood = 0.85 + moodRoll * 0.4 }
end
function Polish.offer(base, recipe, traits, roll)
	local interest = recipe == traits.Favorite and 1.6 or 1
	local amount = math.max(1, math.floor(base * traits.Appetite * traits.Mood * interest * (0.9 + roll * 0.3)))
	return amount, math.floor(amount * (1.3 + traits.Patience * 0.2))
end
function Polish.negotiate(price, budget, attempts, traits, roll, gainRoll)
	local risk = math.clamp(0.08 + attempts * 0.16 + (3 - traits.Patience) * 0.08, 0.04, 0.95)
	if attempts >= traits.Patience or roll < risk or price >= budget then return false end
	return true, math.min(budget, math.max(price + 1, math.floor(price * (1.06 + gainRoll * 0.24))))
end
return Polish
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Boosts</string>
          <string name="Source"><![CDATA[-- Pure income bonuses. Timed obby rewards use wall-clock seconds; paid tiers
-- are permanent. Neither multiplier applies to purchased cash or quest prizes.
local Boosts = { Duration = 300, MaxPaidTier = 12 }
Boosts.ObbyBonuses = { Easy = 0.1, Medium = 0.3, Hard = 0.5 }

function Boosts.normalize(raw)
	local result = { paidTier = 0, obbyBonus = 0, obbyExpires = 0 }
	if type(raw) ~= "table" then return result end
	if type(raw.paidTier) == "number" and raw.paidTier == raw.paidTier and math.abs(raw.paidTier) < math.huge then
		result.paidTier = math.clamp(math.floor(raw.paidTier), 0, Boosts.MaxPaidTier)
	end
	if raw.obbyBonus == 0.1 or raw.obbyBonus == 0.3 or raw.obbyBonus == 0.5 then
		result.obbyBonus = raw.obbyBonus
	end
	if type(raw.obbyExpires) == "number" and raw.obbyExpires == raw.obbyExpires and math.abs(raw.obbyExpires) < math.huge then
		result.obbyExpires = math.clamp(math.floor(raw.obbyExpires), 0, 4102444800)
	end
	return result
end

function Boosts.paidMultiplier(state) return 2 ^ (state and state.paidTier or 0) end

function Boosts.obbyMultiplier(state, now)
	return state and state.obbyExpires > now and 1 + state.obbyBonus or 1
end

function Boosts.multiplier(state, now)
	return Boosts.paidMultiplier(state) * Boosts.obbyMultiplier(state, now)
end

function Boosts.awardObby(data, difficulty, now)
	local bonus = Boosts.ObbyBonuses[difficulty]
	if not bonus then return false, "Unknown course." end
	local state = Boosts.normalize(data.boosts)
	if state.obbyExpires > now and state.obbyBonus > bonus then
		return false, "Your stronger obby boost is still active."
	end
	state.obbyBonus, state.obbyExpires = bonus, now + Boosts.Duration
	data.boosts = state
	return true, "+" .. math.floor(bonus * 100) .. "% cookie income for 5 minutes!"
end

function Boosts.grantPaid(data, tier)
	if type(tier) ~= "number" or tier % 1 ~= 0 or tier < 1 or tier > Boosts.MaxPaidTier then return false, "invalid_reward" end
	local state = Boosts.normalize(data.boosts)
	-- Older/delayed receipts cannot downgrade an entitlement already delivered.
	state.paidTier = math.max(state.paidTier, tier)
	data.boosts = state
	return true
end

return Boosts
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">CardCatalog</string>
          <string name="Source"><![CDATA[local Catalog = {
	Rarities = { "Common", "Uncommon", "Rare", "Legendary", "Mythical" },
	Colors = { Common = { 193, 193, 180 }, Uncommon = { 106, 204, 142 }, Rare = { 100, 171, 244 }, Legendary = { 247, 197, 91 }, Mythical = { 217, 140, 239 } },
	-- Exact odds in hundredths of a percent. Packs use earned currency only.
	Packs = {
		{ Name = "Bakery Friends", Cost = 100, Weights = { 7800, 1900, 270, 25, 5 } },
		{ Name = "Woodland Treats", Cost = 350, Weights = { 5000, 3600, 1200, 170, 30 } },
		{ Name = "Safari Sweets", Cost = 900, Weights = { 2000, 4300, 3000, 600, 100 } },
		{ Name = "Dragon's Oven", Cost = 2200, Weights = { 500, 2200, 4700, 2200, 400 } },
		{ Name = "Celestial Bakery", Cost = 6000, Weights = { 0, 800, 3700, 4000, 1500 } },
	},
	Cards = {},
	-- Upload the four CookieTCG sheets as Roblox images and enter their IDs.
	ArtSheets = {
		{ Id = 0, File = "CookieTCG_01.png", Width = 1983, Height = 793, Columns = 5, Rows = 2, First = 1, Last = 10 },
		{ Id = 0, File = "CookieTCG_02.png", Width = 1983, Height = 793, Columns = 5, Rows = 2, First = 11, Last = 20 },
		{ Id = 0, File = "CookieTCG_03.png", Width = 1983, Height = 793, Columns = 5, Rows = 2, First = 21, Last = 30 },
		{ Id = 0, File = "CookieTCG_04.png", Width = 1983, Height = 793, Columns = 5, Rows = 2, First = 31, Last = 40 },
	},
}
local entries = {
	{ "Chocolate Chip Monkey", "Monkey", "Swings by for the freshest batch.", "Cash", 0.05 },
	{ "Oatmeal Raisin Otter", "Otter", "Keeps the river and the register flowing.", "Speed", 0.04 },
	{ "Sugar Cookie Bunny", "Bunny", "One hop ahead of the morning rush.", "Cash", 0.04, "Speed", 0.01 },
	{ "Double Chocolate Bear", "Bear", "A big soft spot for small cookies.", "Mine", 1 },
	{ "Rainbow Sprinkle Mouse", "Mouse", "Tiny paws. Tremendous presentation.", "Sales", 0.07 },
	{ "Peanut Butter Puppy", "Dog", "A loyal helper with sticky paws.", "Cash", 0.03, "Mine", 1 },
	{ "Snickerdoodle Fox", "Fox", "Knows a shortcut to the cooling rack.", "Speed", 0.03, "Sales", 0.03 },
	{ "Macadamia Koala", "Koala", "Naps between very important taste tests.", "Cash", 0.06 },
	{ "Gingerbread Squirrel", "Squirrel", "Stocks the pantry for a rainy day.", "Crumbs", 0.05 },
	{ "Lemon Crinkle Duck", "Duck", "A little zest makes a big splash.", "Speed", 0.05 },
	{ "Red Velvet Panda", "Panda", "Every batch deserves a gentle hug.", "Cash", 0.03, "Sales", 0.04 },
	{ "Mint Chocolate Kitten", "Cat", "Purrfectly cool under pressure.", "Crumbs", 0.04, "Speed", 0.01 },
	{ "Caramel Raccoon", "Raccoon", "The lid was already open. Probably.", "Sales", 0.08 },
	{ "Coconut Hedgehog", "Hedgehog", "Soft heart. Extra crunchy coat.", "Mine", 2 },
	{ "Strawberry Hamster", "Hamster", "Cheeks full of tomorrow's specials.", "Cash", 0.02, "Crumbs", 0.03 },
	{ "S'mores Owl", "Owl", "The night shift smells wonderful.", "Cash", 0.10 },
	{ "Cookies & Cream Penguin", "Penguin", "Slides into every order on time.", "Speed", 0.08 },
	{ "Matcha Deer", "Deer", "Brings a little calm to the kitchen.", "Cash", 0.06, "Speed", 0.04 },
	{ "Blueberry Seal", "Seal", "Applauds every fresh tray.", "Sales", 0.15 },
	{ "Espresso Sloth", "Sloth", "Finally, a reason to hurry.", "Speed", 0.10 },
	{ "Pumpkin Red Panda", "Panda", "Autumn is a flavor, not a season.", "Crumbs", 0.10 },
	{ "Pistachio Peacock", "Peacock", "Dresses every cookie for the occasion.", "Cash", 0.08, "Sales", 0.08 },
	{ "Birthday Llama", "Llama", "Every day is somebody's birthday.", "Mine", 4 },
	{ "Churro Capybara", "Capybara", "No rush. Just a very efficient bakery.", "Speed", 0.06, "Crumbs", 0.05 },
	{ "Raspberry Bat", "Bat", "Delivers truffles after sunset.", "Cash", 0.07, "Crumbs", 0.06 },
	{ "Snickerdoodle Hippo", "Hippo", "A cinnamon smile as wide as the river.", "Cash", 0.20 },
	{ "Chocolate Chip Tiger", "Tiger", "Stripes, chips, and impeccable timing.", "Speed", 0.15 },
	{ "Lemon Lynx", "Cat", "Spots a sweet deal from a mile away.", "Sales", 0.30 },
	{ "Caramel Stag", "Deer", "Golden antlers. Golden opportunities.", "Cash", 0.12, "Crumbs", 0.10 },
	{ "Coconut Snow Leopard", "Cat", "Silent paws keep the ovens humming.", "Speed", 0.10, "Mine", 5 },
	{ "Blueberry Griffin", "Griffin", "Guards the last slice with great dignity.", "Crumbs", 0.18 },
	{ "Espresso Raven", "Raven", "Forecast: another record batch.", "Cash", 0.12, "Speed", 0.08 },
	{ "Mint Chocolate Dragon", "Dragon", "Breathes cool mint. Bakes hot profits.", "Cash", 0.45, "Speed", 0.15 },
	{ "Golden Chip Lion", "Lion", "The mane attraction at every bake sale.", "Crumbs", 0.30, "Sales", 0.25 },
	{ "Red Velvet Phoenix", "Phoenix", "Every fresh start rises beautifully.", "Cash", 0.30, "Mine", 10 },
	{ "Galaxy Brownie Kirin", "Kirin", "A constellation in every crumb.", "Cash", 0.65, "Crumbs", 0.20 },
	{ "Diamond Vanilla Wolf", "Wolf", "Howls softly so the dough can rest.", "Speed", 0.30, "Mine", 15 },
	{ "Marshmallow Pegasus", "Pegasus", "Cloud-soft wings. Sky-high standards.", "Cash", 0.45, "Speed", 0.20 },
	{ "Pistachio Rose Hydra", "Hydra", "Five heads. One very organized kitchen.", "Sales", 0.75, "Crumbs", 0.25 },
	{ "Maple Celestial Turtle", "Turtle", "Carries a whole bakery of possibilities.", "Cash", 0.40, "Crumbs", 0.35 },
}
for id, e in ipairs(entries) do
	local rarity = id <= 15 and "Common" or id <= 25 and "Uncommon" or id <= 32 and "Rare" or id <= 35 and "Legendary" or "Mythical"
	local effects = { [e[4]] = e[5] }
	if e[6] then effects[e[6]] = e[7] end
	Catalog.Cards[id] = { Id = id, Name = e[1], Animal = e[2], Quip = e[3], Rarity = rarity, Effects = effects }
end
function Catalog.art(cardId)
	if type(cardId) ~= "number" or cardId % 1 ~= 0 then return nil end
	for _, sheet in ipairs(Catalog.ArtSheets) do
		if cardId >= sheet.First and cardId <= sheet.Last then return sheet, cardId - sheet.First end
	end
	return nil
end
return Catalog
]]></string>
        </Properties>
