            </Properties>
          </Item>
          <Item class="Part" referent="24">
            <Properties>
              <string name="Name">Texture_Cookie01</string>
              <bool name="Anchored">true</bool>
              <token name="BottomSurface">0</token>
              <CoordinateFrame name="CFrame">
                <X>0</X>
                <Y>0.2</Y>
                <Z>0</Z>
                <R00>0</R00>
                <R01>-1</R01>
                <R02>0</R02>
                <R10>1</R10>
                <R11>0</R11>
