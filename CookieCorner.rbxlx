      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">CardEconomy</string>
          <string name="Source"><![CDATA[local Catalog = if script then require(script.Parent.CardCatalog) else require("./CardCatalog")
local Cards = { MaxCrumbs = 1e9 }
local function integer(n, fallback, cap)
	return type(n) == "number" and n == n and math.abs(n) < math.huge and math.clamp(math.floor(n), 0, cap) or fallback
end
function Cards.normalize(raw)
	raw = type(raw) == "table" and raw or {}
	local result = { crumbs = integer(raw.crumbs, 0, Cards.MaxCrumbs), owned = {}, equipped = {}, milestone = integer(raw.milestone, 0, 1e9), daily = integer(raw.daily, 0, 4102444800), dailyEarned = integer(raw.dailyEarned, 0, 300), lastCard = integer(raw.lastCard, 0, #Catalog.Cards) }
	for id = 1, #Catalog.Cards do
		local n = integer(type(raw.owned) == "table" and raw.owned[tostring(id)], 0, 999)
		if n > 0 then result.owned[tostring(id)] = n end
	end
	if type(raw.equipped) == "table" then for _, id in ipairs(raw.equipped) do
		if Catalog.Cards[id] and result.owned[tostring(id)] and not table.find(result.equipped, id) and #result.equipped < 3 then table.insert(result.equipped, id) end
	end end
	return result
end
function Cards.bonuses(data, third)
	local bonus = { Cash = 1, Speed = 1, Sales = 1, Crumbs = 1, Mine = 0 }
	for slot, id in ipairs(data.equipped) do
		if slot <= (third and 3 or 2) and data.owned[tostring(id)] then
			for stat, amount in pairs(Catalog.Cards[id].Effects) do bonus[stat] += amount end
		end
	end
	return bonus
end
function Cards.equip(data, id, third)
	if type(id) ~= "number" or not Catalog.Cards[id] or not data.owned[tostring(id)] then return false, "You do not own that card." end
	local index = table.find(data.equipped, id)
	if index then table.remove(data.equipped, index); return true, "Card unequipped." end
	if #data.equipped >= (third and 3 or 2) then return false, "Unequip a card first. Two slots are free." end
	table.insert(data.equipped, id)
	return true, "Card equipped! Bonuses apply to your claimed bakery."
end
function Cards.roll(packId, rarityRoll, cardRoll)
	local pack = Catalog.Packs[packId]
	if not pack or type(rarityRoll) ~= "number" or rarityRoll ~= rarityRoll or rarityRoll < 0 or rarityRoll >= 1 or type(cardRoll) ~= "number" or cardRoll ~= cardRoll or cardRoll < 0 or cardRoll >= 1 then return nil end
	local running, rarity = 0, nil
	for index, weight in ipairs(pack.Weights) do running += weight; if rarityRoll * 10000 < running then rarity = Catalog.Rarities[index]; break end end
	local pool = {}
	for id, card in ipairs(Catalog.Cards) do if card.Rarity == rarity then table.insert(pool, id) end end
	return pool[math.floor(cardRoll * #pool) + 1]
end
function Cards.open(data, packId, cardId)
	local pack, card = Catalog.Packs[packId], Catalog.Cards[cardId]
	if not pack or not card then return false, "Unknown pack." end
	local rarity = table.find(Catalog.Rarities, card.Rarity)
	if not rarity or pack.Weights[rarity] <= 0 then return false, "That card is not in this pack." end
	if data.crumbs < pack.Cost then return false, "Earn more Star Crumbs first." end
	local count = data.owned[tostring(cardId)] or 0
	if count >= 999 then return false, "Card storage limit reached; no crumbs spent." end
	data.crumbs -= pack.Cost
	data.owned[tostring(cardId)], data.lastCard = count + 1, cardId
	return true, card.Name .. " • " .. card.Rarity
end
function Cards.award(data, amount, third)
	local gain = math.max(0, math.floor(amount * Cards.bonuses(data, third).Crumbs))
	local actual = math.min(Cards.MaxCrumbs - data.crumbs, gain)
	data.crumbs += actual
	return actual
end
-- Only active bakery production calls this. Cap this source at 300 crumbs/day;
-- meteors, jobs and contested hill rewards remain independent.
function Cards.production(data, now, third)
	local day = math.floor(now / 86400)
	if data.daily ~= day then data.daily, data.dailyEarned = day, 0 end
	data.milestone += 1
	if data.milestone % 120 ~= 0 or data.dailyEarned >= 300 then return 0 end
	local reward = math.min(10, 300 - data.dailyEarned)
	data.dailyEarned += reward
	return Cards.award(data, reward, third)
end
return Cards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">ChallengeCatalog</string>
          <string name="Source"><![CDATA[-- Original, finite scavenger hunts. Positions stay in public areas so another
-- player's bakery ownership never prevents a discovery.
return {
	NPCName = "Baker Biscuit",
	NPCPosition = { 9, 0, -15 },
	Challenges = {
		{
			Id = "PlazaPeek", Name = "Plaza Peek", Reward = 500,
			Hint = "I misplaced three baking tools near the plaza. Can you spot them?",
			Items = { "GoldenSpoon", "SugarCube", "PinkWhisk" },
		},
		{
			Id = "BakersTrail", Name = "Baker's Trail", Reward = 2500,
			Hint = "Follow the path and peek around a cookie tree.",
			Items = { "RollingPin", "BlueCookieTin", "StarCutter" },
		},
		{
			Id = "SweetDetour", Name = "Sweet Detour", Reward = 15000,
			Hint = "A few sweet supplies escaped to the edges of the meadow.",
			Items = { "SprinkleJar", "CaramelBottle", "LostMitten" },
		},
		{
			Id = "BiscuitTreasure", Name = "Biscuit's Treasure", Reward = 75000,
			Hint = "One last search! My favorite treasures are hiding in plain sight.",
			Items = { "MeasuringCup", "RecipeBook", "GoldenCookieChip" },
		},
	},
	Items = {
		GoldenSpoon = { Name = "Golden Spoon", Kind = "Spoon", Hint = "Look underneath the left plaza bench.", Position = { -34, 0.9, -1 }, Color = { 240, 190, 77 } },
		SugarCube = { Name = "Sugar Cube", Kind = "Cube", Hint = "A lamp on the left path, toward the north.", Position = { -11.5, 0.8, -65 }, Color = { 255, 246, 224 } },
		PinkWhisk = { Name = "Pink Whisk", Kind = "Whisk", Hint = "Peek behind the right plaza bench.", Position = { 34, 1.0, 3 }, Color = { 244, 157, 178 } },
		RollingPin = { Name = "Rolling Pin", Kind = "RollingPin", Hint = "Beside the cookie tree on the right, south of the plaza.", Position = { 188, 1.0, 81 }, Color = { 191, 139, 88 } },
		BlueCookieTin = { Name = "Blue Cookie Tin", Kind = "Tin", Hint = "Follow the main path south; check its right edge.", Position = { 12, 1.0, 106 }, Color = { 126, 181, 200 } },
		StarCutter = { Name = "Star Cutter", Kind = "Star", Hint = "Farther north, near the left edge of the main path.", Position = { -12, 1.0, -136 }, Color = { 238, 193, 106 } },
		SprinkleJar = { Name = "Sprinkle Jar", Kind = "Jar", Hint = "The far northwest cookie tree has a colorful secret.", Position = { -188, 1.0, -222 }, Color = { 223, 161, 192 } },
		CaramelBottle = { Name = "Caramel Bottle", Kind = "Bottle", Hint = "Check the left edge of the main path, far to the south.", Position = { -12, 1.0, 181 }, Color = { 219, 157, 77 } },
		LostMitten = { Name = "Lost Oven Mitt", Kind = "Mitten", Hint = "Try the cookie tree in the far southeast corner.", Position = { 188, 1.0, 222 }, Color = { 156, 196, 153 } },
		MeasuringCup = { Name = "Measuring Cup", Kind = "Cup", Hint = "A cookie tree on the left, just north of the plaza.", Position = { -188, 1.0, -83 }, Color = { 168, 207, 215 } },
		RecipeBook = { Name = "Secret Recipe Book", Kind = "Book", Hint = "Head all the way north along the main path.", Position = { 10, 0.7, -247 }, Color = { 182, 130, 151 } },
		GoldenCookieChip = { Name = "Golden Cookie Chip", Kind = "Chip", Hint = "Look behind the cookie monument in the plaza.", Position = { 0, 1.0, 27 }, Color = { 247, 200, 85 } },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Challenges</string>
          <string name="Source"><![CDATA[local Catalog = if script then require(script.Parent.ChallengeCatalog) else require("./ChallengeCatalog")
local Challenges = {}

-- Only the current hunt's known item flags are saved. There is no client
-- supplied count or reward, and older/inactive flags cannot skip a later hunt.
function Challenges.normalize(raw)
	local state = { index = 1, active = false, found = {} }
	if type(raw) ~= "table" then return state end
	local index = raw.index
	if type(index) == "number" and index == index and math.abs(index) ~= math.huge then
		state.index = math.clamp(math.floor(index), 1, #Catalog.Challenges + 1)
	end
	local quest = Catalog.Challenges[state.index]
	state.active = quest ~= nil and raw.active == true
	if state.active and type(raw.found) == "table" then
		for _, itemId in ipairs(quest.Items) do
			if raw.found[itemId] == true then state.found[itemId] = true end
		end
	end
	return state
end

function Challenges.current(state)
	return Catalog.Challenges[state and state.index or 1]
end

function Challenges.count(state)
	local quest = Challenges.current(state)
	if not quest or not state or not state.active then return 0 end
	local count = 0
	for _, itemId in ipairs(quest.Items) do
		if state.found and state.found[itemId] == true then count += 1 end
	end
	return count
end

function Challenges.encode(state)
	local quest = Challenges.current(state)
	if not quest or not state or not state.active then return 0 end
	local mask = 0
	for index, itemId in ipairs(quest.Items) do
		if state.found and state.found[itemId] == true then mask += 2 ^ (index - 1) end
	end
	return mask
end

function Challenges.isComplete(state)
	return state ~= nil and state.index == #Catalog.Challenges + 1
end

function Challenges.ready(state)
	local quest = Challenges.current(state)
	return quest ~= nil and state.active == true and Challenges.count(state) == #quest.Items
end

function Challenges.find(data, itemId)
	local state = Challenges.normalize(data.challenges)
	local quest = Challenges.current(state)
	if not quest or not state.active then return false, "Talk to Baker Biscuit to start a hunt." end
	local wanted = false
	for _, targetId in ipairs(quest.Items) do
		if itemId == targetId then
			wanted = true
			break
		end
	end
	if not wanted then return false, "That item belongs to a different hunt." end
	if state.found[itemId] then return false, "You already found this item." end
	state.found[itemId] = true
	data.challenges = state
	local message = "Found " .. Catalog.Items[itemId].Name .. "! " .. Challenges.count(state) .. "/" .. #quest.Items
	if Challenges.ready(state) then message ..= " • Return to Baker Biscuit!" end
	return true, message
end

function Challenges.interact(data, maxCash)
	local state = Challenges.normalize(data.challenges)
	local quest = Challenges.current(state)
	if not quest then return false, "You found every treasure! Thanks for helping, baker." end
	if not state.active then
		state.active = true
		data.challenges = state
		return true, "Hunt started: " .. quest.Name .. ". Check your quest clues!", 0
	end
	if not Challenges.ready(state) then
		return false, "Found " .. Challenges.count(state) .. "/" .. #quest.Items .. ". Follow the clues to find the rest!"
	end
	local limit = maxCash or 1e15
	-- Preserve the entire reward. Overflow goes to the register; if both balances
	-- are full, leave the completed hunt untouched so the player can claim later.
	local walletRoom = math.max(0, limit - data.cash)
	local bankRoom = math.max(0, limit - data.bank)
	if walletRoom + bankRoom < quest.Reward then
		return false, "Spend some cash to make room for your reward. Your hunt is complete!"
	end
	local walletReward = math.min(quest.Reward, walletRoom)
	data.cash += walletReward
	data.bank += quest.Reward - walletReward
	data.challenges = { index = state.index + 1, active = false, found = {} }
	return true, quest.Name .. " complete! +$" .. quest.Reward, quest.Reward
end

return Challenges
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">ConveyorLayout</string>
          <string name="Source"><![CDATA[-- Plain geometry and entry state shared by the world builder and engine-free tests.
local Layout = {
	StationCount = 30,
	StationSpacing = 7,
	FirstStationZ = 74,
	OvenX = 44.8,
	OvenScale = 0.45,
	PadX = 53.5,
	SpawnX = 64,
	SpawnZ = 78,
	BeltWidth = 9,
	BeltFrontZ = 78,
	BeltBackZ = -8,
	RailHeight = 1.8,
	RailThickness = 0.65,
	CookieRadius = 1.725,
	MainStartZ = 118,
	MainEndZ = 126,
	BoxZ = 134,
	BeltTop = 4.4,
	LaneXs = { 36, 0, -36 },
	CookieY = 4.78,
	CookieSpeed = 12,
	MaxVisualCookies = 10,
	StepDwell = 0.28,
	StepCooldown = 0.8,
}

function Layout.station(index)
	if type(index) ~= "number" or index % 1 ~= 0 or index < 1 or index > Layout.StationCount then return nil end
	local lane = math.floor((index - 1) / 10) + 1
	local laneX = Layout.LaneXs[lane]
	return { x = laneX + 8.8, z = Layout.FirstStationZ - ((index - 1) % 10) * Layout.StationSpacing,
		padX = laneX + 17.5, scale = Layout.OvenScale, lane = lane, laneX = laneX }
end

function Layout.speed(interval)
	return math.clamp(Layout.CookieSpeed * 3 / math.max(0.2, interval or 3), 12, 22)
end

function Layout.segments()
	-- Logical connections; ConveyorRouting expands these into connected curves.
	local result = {}
	for _, x in ipairs(Layout.LaneXs) do
		table.insert(result, { ax = x, az = Layout.BeltBackZ, bx = x, bz = Layout.BeltFrontZ })
		table.insert(result, { ax = x, az = Layout.BeltFrontZ, bx = 0, bz = Layout.MainStartZ })
	end
	table.insert(result, { ax = 0, az = Layout.MainStartZ, bx = 0, bz = Layout.MainEndZ })
	return result
end

function Layout.belt()
	return { x = 0, z = (Layout.BeltFrontZ + Layout.BeltBackZ) / 2,
		width = Layout.BeltWidth, length = Layout.BeltFrontZ - Layout.BeltBackZ }
end

function Layout.travelDuration(z, interval)
	local cadence = type(interval) == "number" and interval > 0 and interval < math.huge and interval or 3
	local distance = math.max(0, Layout.BeltFrontZ - z)
	return math.clamp(distance / Layout.speed(cadence), 0.65, 9.5)
end

-- The point is the character's feet, expressed in the pad's own coordinate frame.
-- A small vertical tolerance accommodates decorative pads just above the floor.
function Layout.insidePad(x, y, z, width, depth)
	return math.abs(x) <= width / 2 and math.abs(z) <= depth / 2 and math.abs(y) <= 1.35
end

-- An attempted entry is latched until its server action is resolved below.
-- Successful purchases require leaving the pad before another purchase.
function Layout.step(previous, now, inside, available)
	if not inside then return nil, false end
	if not previous then return { enteredAt = now, fired = false }, false end
	if not previous.fired and available and now - previous.enteredAt >= Layout.StepDwell then
		return { enteredAt = previous.enteredAt, fired = true }, true
	end
	return previous, false
end

function Layout.resolveStep(previous, accepted)
	if not previous or accepted == true then return previous end
	-- A throttle or busy save may reject a valid attempt. Preserve its dwell time
	-- and permit a retry after the controller's cooldown without another entry.
	return { enteredAt = previous.enteredAt, fired = false }
end

return Layout
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">ConveyorRouting</string>
          <string name="Source"><![CDATA[-- Engine-free centerlines, exposed boundary rails, and physical-cookie guidance.
local Layout = if script then require(script.Parent.ConveyorLayout) else require("./ConveyorLayout")
local Routing = {}

local function length(x, z) return math.sqrt(x * x + z * z) end
local function append(path, x, z)
	local previous = path[#path]
	table.insert(path, { x = x, z = z, s = previous and previous.s + length(x - previous.x, z - previous.z) or 0 })
end

function Routing.paths()
	local paths = {}
	for _, x in ipairs(Layout.LaneXs) do
		local path = {}
		append(path, x, Layout.BeltBackZ)
		append(path, x, Layout.BeltFrontZ)
		-- Smoothstep has a forward tangent at both ends: no square elbow.
		for index = 1, 24 do
			local t = index / 24
			append(path, x * (1 - 3 * t * t + 2 * t * t * t), Layout.BeltFrontZ + (Layout.MainStartZ - Layout.BeltFrontZ) * t)
		end
		append(path, 0, Layout.MainEndZ)
		table.insert(paths, path)
	end
	return paths
end

function Routing.pointAt(path, distance)
	distance = math.clamp(distance, 0, path[#path].s)
	for index = 2, #path do
		local a, b = path[index - 1], path[index]
		if distance <= b.s or index == #path then
			local span = b.s - a.s
			local t = (distance - a.s) / span
			return { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t,
				dx = (b.x - a.x) / span, dz = (b.z - a.z) / span }
		end
	end
	return nil
end

function Routing.project(path, x, z)
	local nearest = { distance = math.huge, s = 0 }
	for index = 2, #path do
		local a, b = path[index - 1], path[index]
		local dx, dz = b.x - a.x, b.z - a.z
		local t = math.clamp(((x - a.x) * dx + (z - a.z) * dz) / (dx * dx + dz * dz), 0, 1)
		local distance = length(x - a.x - dx * t, z - a.z - dz * t)
		if distance < nearest.distance then nearest = { distance = distance, s = a.s + (b.s - a.s) * t } end
	end
	return nearest
end

function Routing.surfaces(paths)
	local surfaces, seen = {}, {}
	for _, path in ipairs(paths) do
		for index = 2, #path do
			local a, b = path[index - 1], path[index]
			local span = b.s - a.s
			local dx, dz = (b.x - a.x) / span, (b.z - a.z) / span
			local key = string.format("%.3f/%.3f/%.3f/%.3f", a.x, a.z, b.x, b.z)
			if not seen[key] then
				seen[key] = true
				table.insert(surfaces, { x = (a.x + b.x) / 2, z = (a.z + b.z) / 2,
					dx = dx, dz = dz, width = Layout.BeltWidth, length = span + 0.12 })
			end
			if index < #path then
				local joinKey = string.format("join/%.3f/%.3f", b.x, b.z)
				if not seen[joinKey] then
					seen[joinKey] = true
					local c = path[index + 1]
					local nextSpan = c.s - b.s
					local vx, vz = dx + (c.x - b.x) / nextSpan, dz + (c.z - b.z) / nextSpan
					local magnitude = length(vx, vz)
					table.insert(surfaces, { x = b.x, z = b.z, dx = vx / magnitude, dz = vz / magnitude,
						width = Layout.BeltWidth, round = true })
				end
			end
		end
	end
	return surfaces
end

function Routing.drive(path, x, z, previous, speed)
	local nearest = Routing.project(path, x, z)
	-- Once off the belt or beyond the lip, physics takes over. Never teleport.
	if nearest.distance > Layout.BeltWidth / 2 or z >= Layout.MainEndZ - 0.25 then return nil end
	local progress = math.max(previous or 0, nearest.s)
	local target = Routing.pointAt(path, progress + math.clamp(speed * 0.2, 2, 4))
	local dx, dz = target.x - x, target.z - z
	local magnitude = length(dx, dz)
	if magnitude < 0.01 then return nil end
	return { vx = dx / magnitude * speed, vz = dz / magnitude * speed, s = progress }
end

local function boundary(path, sign)
	local points = {}
	local offset = Layout.BeltWidth / 2 + Layout.RailThickness / 2 + 0.15
	for index, p in ipairs(path) do
		local a, b = path[math.max(1, index - 1)], path[math.min(#path, index + 1)]
		local before = length(p.x - a.x, p.z - a.z)
		local after = length(b.x - p.x, b.z - p.z)
		local ax, az = before > 0 and (p.x - a.x) / before or 0, before > 0 and (p.z - a.z) / before or 0
		local bx, bz = after > 0 and (b.x - p.x) / after or ax, after > 0 and (b.z - p.z) / after or az
		if before == 0 then ax, az = bx, bz end
		local dx, dz = ax + bx, az + bz
		local span = length(dx, dz)
		dx, dz = dx / span, dz / span
		local miter = offset / math.max(0.9, dx * bx + dz * bz)
		table.insert(points, { x = p.x - dz * miter * sign, z = p.z + dx * miter * sign })
	end
	return points
end

function Routing.rails(paths)
	local rails, seen = {}, {}
	local function clear(lane, x, z)
		for otherLane, path in ipairs(paths) do
			if otherLane ~= lane and Routing.project(path, x, z).distance < Layout.BeltWidth / 2 + Layout.RailThickness / 2 + 0.125 then return false end
		end
		return true
	end
	for lane, path in ipairs(paths) do
		for _, sign in ipairs({ -1, 1 }) do
			local edge = boundary(path, sign)
			for index = 2, #edge do
				local a, b = edge[index - 1], edge[index]
				local steps = math.ceil(length(b.x - a.x, b.z - a.z) / 0.25)
				local first
				local function emit(last)
					if not first or last <= first then return end
					local function at(t) return { x = a.x + (b.x - a.x) * t, z = a.z + (b.z - a.z) * t } end
					local start, finish = at(first), at(last)
					local key = string.format("%.2f/%.2f/%.2f/%.2f", start.x, start.z, finish.x, finish.z)
					if not seen[key] then
						seen[key] = true
						table.insert(rails, { a = start, b = finish })
					end
				end
				for step = 0, steps do
					local t = step / steps
					local safe = clear(lane, a.x + (b.x - a.x) * t, a.z + (b.z - a.z) * t)
					if safe and not first then first = t
					elseif not safe and first then
						emit((step - 1) / steps)
						first = nil
					end
				end
				emit(1)
			end
		end
	end
	return rails
end

return Routing
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">CookieCrafting</string>
          <string name="Source"><![CDATA[local Toppings = if script then require(script.Parent.RecipeToppings) else require("./RecipeToppings")
local Recipes = if script then require(script.Parent.Recipes) else require("./Recipes")
-- Fixed recipe tiers and cash-bought toppings. These definitions are shared by
-- the server economy, workshop UI, and cookie visuals; no random rolls are used.
local Crafting = {
	RarityOrder = { "Common", "Uncommon", "Rare", "Epic", "Legendary", "Mythic" },
	Rarities = {
		Common = { Name = "Common", Multiplier = 1, Color = { 209, 210, 218 } },
		Uncommon = { Name = "Uncommon", Multiplier = 1.25, Color = { 112, 221, 148 } },
		Rare = { Name = "Rare", Multiplier = 1.75, Color = { 105, 180, 255 } },
		Epic = { Name = "Epic", Multiplier = 2.5, Color = { 196, 134, 255 } },
		Legendary = { Name = "Legendary", Multiplier = 4, Color = { 255, 199, 75 } },
		Mythic = { Name = "Mythic", Multiplier = 6, Color = { 255, 111, 165 } },
	},
	ModifierOrder = { "Glaze", "Sprinkles", "ChocolateDrizzle", "CaramelSwirl", "GoldLeaf" },
	Modifiers = {
		Glaze = { Name = "Glaze", Bonus = 0.20, MinimumCost = 100, CostFactor = 0.25, Color = { 255, 244, 221 } },
		Sprinkles = { Name = "Sprinkles", Bonus = 0.35, MinimumCost = 350, CostFactor = 0.50, Color = { 255, 129, 177 } },
		ChocolateDrizzle = { Name = "Chocolate Drizzle", Bonus = 0.50, MinimumCost = 1000, CostFactor = 0.90, Color = { 83, 43, 29 } },
		CaramelSwirl = { Name = "Caramel Swirl", Bonus = 0.75, MinimumCost = 3000, CostFactor = 1.50, Color = { 225, 153, 59 } },
		GoldLeaf = { Name = "Gold Leaf", Bonus = 1.20, MinimumCost = 12500, CostFactor = 3, Color = { 255, 210, 78 } },
	},
}

function Crafting.rarity(recipe)
	return Crafting.Rarities[recipe.Rarity] or Crafting.Rarities.Common
end

function Crafting.option(recipe, key)
	local index = type(recipe) == "number" and recipe or table.find(Recipes, recipe)
	local slot = key == "Glaze" and 1 or key == "Sprinkles" and 2 or nil
	if not index or not slot then return nil end
	local item = Toppings[index][slot]
	return { Name = item[1], Bonus = item[2], Style = item[3], MinimumCost = slot == 1 and 100 or 350, CostFactor = slot == 1 and 0.25 or 0.5, Color = Recipes[index].Accent }
end
function Crafting.cost(recipe, key)
	local modifier = Crafting.option(recipe, key)
	if not modifier then return nil end
	return modifier.MinimumCost + math.floor(recipe.Cost * modifier.CostFactor)
end

function Crafting.multiplier(flags, recipe)
	local bonus = 0
	for _, key in ipairs(Crafting.ModifierOrder) do
		local definition = recipe and Crafting.option(recipe, key) or (not recipe and Crafting.Modifiers[key] or nil)
		if definition and flags and flags[key] == true then bonus += definition.Bonus end
	end
	return 1 + bonus -- Add topping bonuses, then multiply with rarity and income boosts.
end

function Crafting.encode(flags)
	local mask = 0
	for index, key in ipairs(Crafting.ModifierOrder) do
		if flags and flags[key] == true then mask += 2 ^ (index - 1) end
	end
	return mask
end

function Crafting.decode(mask)
	local flags = {}
	if type(mask) ~= "number" or mask ~= mask or math.abs(mask) == math.huge then return flags end
	mask = math.clamp(math.floor(mask), 0, 2 ^ #Crafting.ModifierOrder - 1)
	for index, key in ipairs(Crafting.ModifierOrder) do
		if bit32.band(mask, 2 ^ (index - 1)) ~= 0 then flags[key] = true end
	end
	return flags
end

function Crafting.summary(flags, recipe)
	local names = {}
	for _, key in ipairs(Crafting.ModifierOrder) do
		local definition = recipe and Crafting.option(recipe, key) or (not recipe and Crafting.Modifiers[key] or nil)
		if definition and flags and flags[key] == true then table.insert(names, definition.Name) end
	end
	return #names == 0 and "Plain" or table.concat(names, " + ")
end

return Crafting
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">LeaderboardRanks</string>
          <string name="Source"><![CDATA[local Ranks = {}

function Ranks.sort(records, key)
	local rows = {}
	for _, record in ipairs(records) do table.insert(rows, record) end
	table.sort(rows, function(a, b)
		if a[key] == b[key] then return a.userId < b.userId end
		return a[key] > b[key]
	end)
	return rows
end

return Ranks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">MapLayout</string>
          <string name="Source"><![CDATA[local Map = { PlayerCount = 8, Width = 900, Length = 1220 }

function Map.plot(slot)
	if type(slot) ~= "number" or slot % 1 ~= 0 or slot < 1 or slot > Map.PlayerCount then return nil end
	local row = math.floor((slot - 1) / 2) + 1
	local z = ({ -144, 144, -420, 420 })[row]
	return { x = slot % 2 == 0 and 98 or -98, z = z, direction = z < 0 and 1 or -1 }
end

return Map
]]></string>
