      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">AdminFlight</string>
          <string name="Source"><![CDATA[local Players, Run = game:GetService("Players"), game:GetService("RunService")
local Flight = {}
local vectorType = "Vector3"
function Flight.start(remotes, isAdmin)
	local self = { active = {} }
	local input = Instance.new("RemoteEvent")
	input.Name, input.Parent = "AdminFlightInput", remotes
	function self:Stop(player)
		local state = self.active[player]
		self.active[player] = nil
		player:SetAttribute("AdminFlying", false)
		if not state then return end
		state.velocity:Destroy(); state.align:Destroy(); state.attachment:Destroy()
		if state.hum.Parent then state.hum.PlatformStand, state.hum.AutoRotate = false, state.autoRotate end
		if state.root.Parent then state.root.AssemblyLinearVelocity = Vector3.zero end
	end
	function self:Set(player, enabled)
		self:Stop(player)
		if not enabled or not isAdmin(player) then return end
		local character = player.Character
		local root, hum = character and character:FindFirstChild("HumanoidRootPart"), character and character:FindFirstChildOfClass("Humanoid")
		if not root or not hum or hum.Health <= 0 then return end
		local attachment, velocity, align = Instance.new("Attachment"), Instance.new("LinearVelocity"), Instance.new("AlignOrientation")
		attachment.Parent = root
		velocity.Attachment0, velocity.MaxForce, velocity.RelativeTo, velocity.VectorVelocity, velocity.Parent = attachment, 1e7, Enum.ActuatorRelativeTo.World, Vector3.zero, root
		align.Mode, align.Attachment0, align.MaxTorque, align.Responsiveness, align.CFrame, align.Parent = Enum.OrientationAlignmentMode.OneAttachment, attachment, 1e7, 15, root.CFrame.Rotation, root
		self.active[player] = { character = character, root = root, hum = hum, autoRotate = hum.AutoRotate, velocity = velocity, align = align, attachment = attachment, last = os.clock(), direction = Vector3.zero }
		hum.PlatformStand, hum.AutoRotate = true, false
		player:SetAttribute("AdminFlying", true)
	end
	input.OnServerEvent:Connect(function(player, direction)
		local state = self.active[player]
		if not state or not isAdmin(player) or typeof(direction) ~= vectorType then return end
		local magnitude = direction.Magnitude
		if magnitude ~= magnitude or magnitude > 1.5 then return end
		if os.clock() - (state.lastInput or 0) < 0.035 then return end
		state.lastInput, state.last, state.direction = os.clock(), os.clock(), magnitude > 1 and direction.Unit or direction
	end)
	Run.Heartbeat:Connect(function()
		for player, state in pairs(self.active) do
			if not isAdmin(player) or player.Character ~= state.character or not state.root.Parent or state.hum.Health <= 0 then self:Stop(player)
			else
				local direction = os.clock() - state.last < 0.5 and state.direction or Vector3.zero
				state.velocity.VectorVelocity = direction * 55
				local flat = Vector3.new(direction.X, 0, direction.Z)
				if flat.Magnitude > 0.1 then state.align.CFrame = CFrame.lookAt(Vector3.zero, flat) end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(player) self:Stop(player) end)
	return self
end
return Flight
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">AdminPermissions</string>
          <string name="Source"><![CDATA[-- Pure permissions. Roblox resolves configured account names on the server;
-- client attributes, display names, and remote arguments never grant a role.
local Permissions = {}
local Actions = { Kick = true, ReturnToSpawn = true, GiveWalletCash = true, GiveBankCash = true,
	SetInvisible = true, SetFlying = true, GoToPlayer = true, BringPlayer = true }

function Permissions.validId(value)
	return type(value) == "number" and value > 0 and value < 2^53 and value % 1 == 0
end

function Permissions.username(value)
	if type(value) ~= "string" then return nil end
	local name = value:match("^%s*(.-)%s*$"):gsub("^@", "")
	if #name < 1 or #name > 20 or not name:match("^[%w_]+$") then return nil end
	return string.lower(name)
end

function Permissions.resolve(config, lookup, ownerId)
	local admins, errors, seen = {}, {}, {}
	if config.AutoExperienceOwner and Permissions.validId(ownerId) then admins[ownerId] = true end
	for _, id in ipairs(config.UserIds or {}) do
		if Permissions.validId(id) then admins[id] = true else table.insert(errors, "Invalid configured admin user ID") end
	end
	for _, value in ipairs(config.Usernames or {}) do
		local name = Permissions.username(value)
		if not name then table.insert(errors, "Invalid configured admin username: " .. tostring(value))
		elseif not seen[name] then
			seen[name] = true
			local ok, id = pcall(lookup, name)
			if ok and Permissions.validId(id) then admins[id] = true
			else table.insert(errors, "Could not resolve admin @" .. name .. "; check the username and rejoin a restarted server") end
		end
	end
	return admins, errors
end

function Permissions.authorize(admins, actorId, action, targetId)
	if admins[actorId] ~= true then return false, "Admin access required." end
	if type(action) ~= "string" or not Actions[action] then return false, "Unknown admin action." end
	if type(targetId) ~= "number" or targetId % 1 ~= 0 or math.abs(targetId) >= 2^53 then return false, "Invalid target account." end
	if action == "Kick" and admins[targetId] == true then return false, "Admins cannot be kicked with these tools." end
	if (action == "SetInvisible" or action == "SetFlying") and actorId ~= targetId then return false, "This action changes your own character only." end
	return true
end

return Permissions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">AdminRewards</string>
          <string name="Source"><![CDATA[local Progression = if script then require(game:GetService("ReplicatedStorage").CookieTycoon.Progression) else require("../shared/Progression")
local Rewards = {}

function Rewards.grant(data, action, amount, maximum)
	local field = action == "GiveWalletCash" and "cash" or action == "GiveBankCash" and "bank" or nil
	if not field then return false, "Unknown cash destination." end
	if type(maximum) ~= "number" or maximum <= 0 or maximum > Progression.MAX_CASH or maximum % 1 ~= 0 then
		return false, "Admin cash grants need a valid configured limit."
	end
	if type(amount) ~= "number" or amount <= 0 or amount > maximum or amount % 1 ~= 0 then
		return false, "Enter a whole amount from 1 to " .. Progression.format(maximum) .. "."
	end
	if amount > Progression.MAX_CASH - data[field] then return false, "That balance does not have room for the whole grant." end
	data[field] += amount
	return true, "Added $" .. Progression.format(amount) .. (field == "cash" and " to the wallet." or " to uncollected earnings.")
end

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">AdminServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Config = require(script.Parent.AdminConfig)
local Permissions = require(script.Parent.AdminPermissions)
local Visibility = require(script.Parent.AdminVisibility)
local Admin = {}

function Admin.start(remotes, context)
	local actionRemote = Instance.new("RemoteEvent")
	actionRemote.Name, actionRemote.Parent = "AdminAction", remotes
	local resultRemote = Instance.new("RemoteEvent")
	resultRemote.Name, resultRemote.Parent = "AdminResult", remotes
	local ownerId = game.CreatorType == Enum.CreatorType.User and game.CreatorId or nil
	local admins = Permissions.resolve({ AutoExperienceOwner = Config.AutoExperienceOwner, UserIds = Config.UserIds }, function() return nil end, ownerId)
	local cooldowns = {}
	local visibility = Visibility.new()
	local flight = require(script.Parent.AdminFlight).start(remotes, function(player) return admins[player.UserId] == true end)
	local function mark(player) player:SetAttribute("IsAdmin", admins[player.UserId] == true) end
	Players.PlayerAdded:Connect(mark)
	Players.PlayerRemoving:Connect(function(player) cooldowns[player] = nil end)
	for _, player in ipairs(Players:GetPlayers()) do mark(player) end
	task.spawn(function()
		local resolved, errors = Permissions.resolve(Config, function(name) return Players:GetUserIdFromNameAsync(name) end, ownerId)
		admins = resolved
		for _, message in ipairs(errors) do warn("Cookie Corner admin setup: " .. message) end
		for _, player in ipairs(Players:GetPlayers()) do mark(player) end
	end)
	actionRemote.OnServerEvent:Connect(function(actor, action, targetId, argument)
		-- Rate-limit every caller before looking up a target, including non-admins.
		local now = os.clock()
		if now < (cooldowns[actor] or 0) then return end
		cooldowns[actor] = now + 1
		local permitted, message = Permissions.authorize(admins, actor.UserId, action, targetId)
		if not permitted then
			resultRemote:FireClient(actor, false, message)
			return
		end
		local target = Players:GetPlayerByUserId(targetId)
		if not target then
			resultRemote:FireClient(actor, false, "That player has left this server.")
			return
		end
		local resultMessage
		if action == "GiveWalletCash" or action == "GiveBankCash" then
			local success, grantMessage = context.GrantCash(target, action, argument, Config.MaxCashGrant)
			if not success then
				resultRemote:FireClient(actor, false, grantMessage)
				return
			end
			resultMessage = "@" .. target.Name .. ": " .. grantMessage
		elseif action == "SetFlying" then
			if type(argument) ~= "boolean" then return end
			flight:Set(actor, argument)
			resultMessage = argument and "Flight enabled. WASD to steer, Space up, Ctrl/Q down; touch buttons also available." or "Flight disabled."
		elseif action == "SetInvisible" then
			if type(argument) ~= "boolean" then return end
			visibility:Set(actor, argument)
			resultMessage = argument and "You are invisible until you turn it off or leave." or "Your normal appearance is restored."
		elseif action == "Kick" then
			target:Kick("You were removed from this server by a Cookie Corner admin.")
			resultMessage = "Removed @" .. target.Name .. " from this server."
		else
			local character = target.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or not humanoid or humanoid.Health <= 0 then
				resultRemote:FireClient(actor, false, "Wait for that player to respawn.")
				return
			end
			if action == "ReturnToSpawn" then
				context.ReturnToSpawn(target)
				resultMessage = "Returned @" .. target.Name .. " to spawn."
			else
				local adminCharacter = actor.Character
				local adminRoot = adminCharacter and adminCharacter:FindFirstChild("HumanoidRootPart")
				local adminHumanoid = adminCharacter and adminCharacter:FindFirstChildOfClass("Humanoid")
				if not adminRoot or not adminHumanoid or adminHumanoid.Health <= 0 then
					resultRemote:FireClient(actor, false, "Wait for your character to respawn.")
					return
				end
				local moving, movingRoot, destination = adminCharacter, adminRoot, root.CFrame
				if action == "BringPlayer" then moving, movingRoot, destination = character, root, adminRoot.CFrame end
				moving:PivotTo(destination * CFrame.new(5, 1, 0))
				movingRoot.AssemblyLinearVelocity, movingRoot.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				resultMessage = action == "BringPlayer" and ("Brought @" .. target.Name .. " to you.") or ("Teleported to @" .. target.Name .. ".")
			end
		end
		print(string.format("[Cookie Corner Admin] @%s (%d): %s @%s (%d) %s", actor.Name, actor.UserId, action, target.Name, target.UserId,
			(action == "GiveWalletCash" or action == "GiveBankCash") and tostring(argument) or ""))
		resultRemote:FireClient(actor, true, resultMessage)
	end)
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">AdminVisibility</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Visibility = {}

local function conceal(object, originals)
	if originals[object] then return end
	local property, value
	if object:IsA("BasePart") or object:IsA("Decal") or object:IsA("Texture") then property, value = "Transparency", 1
	elseif object:IsA("ForceField") then property, value = "Visible", false
	elseif object:IsA("Humanoid") then property, value = "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None
	elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") or object:IsA("Fire")
		or object:IsA("Smoke") or object:IsA("Sparkles") or object:IsA("Highlight")
		or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then property, value = "Enabled", false end
	if property then
		originals[object] = { property = property, value = object[property] }
		object[property] = value
	end
end

local function restore(object, originals)
	local saved = originals[object]
	if saved then
		object[saved.property] = saved.value
		originals[object] = nil
	end
end

local function clearCharacter(state)
	for _, connection in ipairs(state.connections or {}) do connection:Disconnect() end
	for object in pairs(state.originals or {}) do restore(object, state.originals) end
	state.connections, state.originals = {}, {}
end

local function applyCharacter(state, character)
	clearCharacter(state)
	if not state.enabled then return end
	for _, object in ipairs(character:GetDescendants()) do conceal(object, state.originals) end
	table.insert(state.connections, character.DescendantAdded:Connect(function(object) conceal(object, state.originals) end))
	-- Equipped tools/accessories must regain their original appearance when removed.
	table.insert(state.connections, character.DescendantRemoving:Connect(function(object) restore(object, state.originals) end))
end

function Visibility.new()
	local self = { states = {} }
	Players.PlayerRemoving:Connect(function(player)
		local state = self.states[player]
		if state then
			state.respawn:Disconnect()
			state.appearance:Disconnect()
			clearCharacter(state)
			self.states[player] = nil
		end
	end)
	return setmetatable(self, { __index = Visibility })
end

function Visibility:Set(player, enabled)
	local state = self.states[player]
	if not state then
		state = { enabled = false, originals = {}, connections = {} }
		state.respawn = player.CharacterAdded:Connect(function(character) applyCharacter(state, character) end)
		state.appearance = player.CharacterAppearanceLoaded:Connect(function(character)
			if state.enabled and player.Character == character then applyCharacter(state, character) end
		end)
		self.states[player] = state
	end
	state.enabled = enabled
	if player.Character then applyCharacter(state, player.Character) else clearCharacter(state) end
	player:SetAttribute("AdminInvisible", enabled)
end

return Visibility
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">AssetLibrary</string>
          <string name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Recipes = require(ReplicatedStorage.CookieTycoon.Recipes)
local Crafting = require(ReplicatedStorage.CookieTycoon.CookieCrafting)
local TextureIds = require(script.Parent.AssetTextures)
local templates = ServerStorage:WaitForChild("CookieCornerAssets")
local AssetLibrary = {}

local allFaces = { Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
local sideFaces = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
local topFace = { Enum.NormalId.Top }
local rules = {
	BakeryFloor = { Faces = topFace, Tile = 16 },
	WallTile = { Faces = sideFaces, Tile = 8 },
	WoodWarm = { Faces = allFaces, Tile = 8 },
	BrushedMetal = { Faces = allFaces, Tile = 8 },
	ConveyorRubber = { Faces = topFace, Tile = 4 },
	OvenBrick = { Faces = sideFaces, Tile = 8 },
	Parchment = { Faces = topFace, Tile = 5 },
	GoldenChip = { Faces = { Enum.NormalId.Right, Enum.NormalId.Left }, Tile = 4 },
	AwningStripe = { Faces = { Enum.NormalId.Top, Enum.NormalId.Bottom }, Tile = 20 },
	CounterMarble = { Faces = topFace, Tile = 8 },
	MeadowGrass = { Faces = topFace, Tile = 12 },
	PathPavers = { Faces = topFace, Tile = 6 },
}

function AssetLibrary.texture(target, key)
	local configured = TextureIds[key]
	if type(configured) ~= "string" or configured == "" then return end
	local digits = configured:match("^(%d+)$") or configured:match("^rbxassetid://(%d+)$")
	if not digits or tonumber(digits) == 0 then
		warn("Cookie Corner: ignored an invalid image asset ID for " .. key)
		return
	end
	local rule = rules[key]
	if key:match("^Cookie%d%d$") then
		-- Native cylinders point along local X. Right faces upward after rotation.
		rule = { Faces = { Enum.NormalId.Right }, Tile = 3.35 }
	end
	if not rule then return end
	for _, face in ipairs(rule.Faces) do
		local texture = Instance.new("Texture")
		texture.Name = "CookieCorner_" .. key .. "_" .. face.Name
		texture.Texture = "rbxassetid://" .. digits
		texture.Face = face
		texture.StudsPerTileU = rule.Tile
		texture.StudsPerTileV = rule.Tile
		texture.Parent = target
	end
end

function AssetLibrary.clone(category, name, parent, pivot)
	local folder = assert(templates:FindFirstChild(category), "Missing asset category: " .. category)
	local template = assert(folder:FindFirstChild(name), "Missing model: " .. name)
	local object = template:Clone()
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local key = descendant.Name:match("^Texture_(.+)$")
			if key then AssetLibrary.texture(descendant, key) end
		end
	end
	object:PivotTo(pivot)
	object.Parent = parent
	return object
end

function AssetLibrary.prop(name, parent, pivot)
	return AssetLibrary.clone("Props", name, parent, pivot)
end

function AssetLibrary.cookie(index, parent, pivot, flags)
	local object = AssetLibrary.clone("Cookies", Recipes[index].Name, nil, pivot)
	local rarity = Crafting.rarity(Recipes[index])
	object.Name = rarity.Name .. " " .. Recipes[index].Name .. " (" .. Crafting.summary(flags, index) .. ")"
	object:SetAttribute("Rarity", rarity.Name)
	object:SetAttribute("ModifierMask", Crafting.encode(flags))
	local outline = Instance.new("Highlight")
	outline.Name = "RarityOutline"
	outline.Adornee = object
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.FillTransparency = 1
	outline.OutlineColor = Color3.fromRGB(table.unpack(rarity.Color))
	outline.OutlineTransparency = rarity.Name == "Common" and 1 or 0.35
	outline.Parent = object
	local surface = object:FindFirstChild("Vanilla Frosting") and 0.41 or 0.295
	local function topping(name, size, offset, rgb, rotation, shape)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Size = size
		piece.CFrame = pivot * CFrame.new(offset) * (rotation or CFrame.new())
		piece.Color = Color3.fromRGB(table.unpack(rgb))
		piece.Material = Enum.Material.SmoothPlastic
		piece.Shape = shape or Enum.PartType.Block
		piece.Anchored = true
		piece.CanCollide = false
		piece.CanTouch = false
		piece.CanQuery = false
		piece.TopSurface = Enum.SurfaceType.Smooth
		piece.BottomSurface = Enum.SurfaceType.Smooth
		piece.Parent = object
		return piece
	end
	for slot, key in ipairs({ "Glaze", "Sprinkles" }) do
		if not flags or not flags[key] then continue end
		local option = Crafting.option(index, key)
		local shade = option.Color
		if option.Style == "Cream" or option.Style == "Flakes" then shade = { 248, 233, 197 } end
		if option.Style == "Dust" then shade = Recipes[index].Color end
		for n = 1, option.Style == "Dust" and 10 or 5 do
			local angle, radius = n * 2.399 + slot, 0.4 + (n % 4) * 0.25
			local shape, size = Enum.PartType.Ball, Vector3.new(.27, .18, .24)
			if option.Style == "Flakes" or option.Style == "Sprinkles" or option.Style == "Seeds" then shape, size = Enum.PartType.Block, Vector3.new(.1, .06, .33)
			elseif option.Style == "Dust" then size = Vector3.new(.07, .025, .07)
			elseif option.Style == "Cream" then size = Vector3.new(.35, .24, .35)
			elseif option.Style == "Fruit" then size = Vector3.new(.3, .15, .42)
			elseif option.Style == "Chunks" or option.Style == "Crystals" then shape, size = Enum.PartType.Block, Vector3.new(.25, .2, .22)
			elseif option.Style == "Swirl" then shape, size = Enum.PartType.Block, Vector3.new(.1, .07, .65) end
			local tint = option.Style == "Sprinkles" and ({ { 248, 155, 177 }, { 134, 211, 184 }, { 242, 203, 112 } })[n % 3 + 1] or shade
			topping(option.Name, size, Vector3.new(math.cos(angle)*radius, surface + .06 + (slot-1)*.035, math.sin(angle)*radius), tint, CFrame.Angles(0, angle, 0), shape)
		end
	end
	object.Parent = parent
	if parent and (rarity.Name == "Legendary" or rarity.Name == "Mythic") then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Rare Cookie Sparkle"
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(Color3.fromRGB(table.unpack(rarity.Color)))
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Transparency = NumberSequence.new(0.1, 1)
		sparkle.Lifetime = NumberRange.new(0.4, 0.7)
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.SpreadAngle = Vector2.new(120, 120)
		sparkle.LightEmission = 0.5
		sparkle.Rate = 2
		sparkle.Parent = object.PrimaryPart
		sparkle:Emit(3)
	end
	return object
end

function AssetLibrary.anchor(object)
	return object:FindFirstChild("LabelAnchor") or object.PrimaryPart
end

return AssetLibrary
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">AssetTextures</string>
          <string name="Source"><![CDATA[-- Optional: upload assets/textures/*.png using Studio's Asset Manager, then paste
-- each image's numeric asset ID (as a string) into the matching entry below.
-- Empty entries use the model's built-in Roblox materials and colors.
return {
	BakeryFloor = "",
	WallTile = "",
	WoodWarm = "",
	BrushedMetal = "",
	ConveyorRubber = "",
	OvenBrick = "",
	Parchment = "",
	GoldenChip = "",
	AwningStripe = "",
	CounterMarble = "",
	MeadowGrass = "",
	PathPavers = "",
	Cookie01 = "", Cookie02 = "", Cookie03 = "", Cookie04 = "", Cookie05 = "",
	Cookie06 = "", Cookie07 = "", Cookie08 = "", Cookie09 = "", Cookie10 = "",
	Cookie11 = "", Cookie12 = "", Cookie13 = "", Cookie14 = "", Cookie15 = "",
	Cookie16 = "", Cookie17 = "", Cookie18 = "", Cookie19 = "", Cookie20 = "",
	Cookie21 = "", Cookie22 = "", Cookie23 = "", Cookie24 = "", Cookie25 = "",
	Cookie26 = "", Cookie27 = "", Cookie28 = "", Cookie29 = "", Cookie30 = "",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">BakerAvatar</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Avatar = {}
local skin = Color3.fromRGB(245, 205, 140)
local cream = Color3.fromRGB(255, 246, 225)
local mint = Color3.fromRGB(112, 164, 144)

local function fallback()
	-- A standard R6 joint hierarchy keeps the NPC usable if avatar assets are
	-- temporarily unavailable. The normal path below asks Roblox for an R6 rig.
	local model = Instance.new("Model")
	local function body(name, size, pos, color)
		local part = Instance.new("Part")
		part.Name, part.Size, part.Position, part.Color = name, size, pos, color
		part.CanCollide, part.TopSurface, part.BottomSurface = false, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end
	local root = body("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), cream)
	root.Transparency = 1
	local torso = body("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), cream)
	local head = body("Head", Vector3.new(2, 1, 1), Vector3.new(0, 4.5, 0), skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType, mesh.Scale, mesh.Parent = Enum.MeshType.Head, Vector3.new(1.25, 1.25, 1.25), head
	local function joint(name, a, b, c0, c1)
		local motor = Instance.new("Motor6D")
		motor.Name, motor.Part0, motor.Part1, motor.C0, motor.C1 = name, a, b, c0, c1
		motor.Parent = a
	end
	joint("RootJoint", root, torso, CFrame.new(), CFrame.new())
	joint("Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
	for _, side in ipairs({ -1, 1 }) do
		local prefix = side == -1 and "Left" or "Right"
		local arm = body(prefix .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 3, 0), skin)
		local leg = body(prefix .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, 1, 0), mint)
		joint(prefix .. " Shoulder", torso, arm, CFrame.new(side, 0.5, 0), CFrame.new(-side * 0.5, 0.5, 0))
		joint(prefix .. " Hip", torso, leg, CFrame.new(side * 0.5, -1, 0), CFrame.new(0, 1, 0))
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

function Avatar.decorate(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	local head, torso = model:FindFirstChild("Head"), model:FindFirstChild("Torso")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not head or not torso or not humanoid then return false end
	root.Anchored = true
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 0
	for _, piece in ipairs(model:GetDescendants()) do if piece:IsA("BasePart") then piece.CanCollide = false end end
	if not head:FindFirstChildOfClass("Decal") then
		local face = Instance.new("Decal")
		face.Name, face.Texture, face.Face, face.Parent = "face", "rbxasset://textures/face.png", Enum.NormalId.Front, head
	end
	local function accessory(name, size, anchor, offset, color, shape)
		local part = Instance.new("Part")
		part.Name, part.Size, part.CFrame, part.Color = name, size, anchor.CFrame * offset, color
		part.CanCollide, part.Massless = false, true
		part.Shape = shape or Enum.PartType.Block
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = anchor, part, part
		return part
	end
	accessory("Chef Hat Band", Vector3.new(0.25, 1.8, 1.8), head, CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2), cream, Enum.PartType.Cylinder)
	for _, x in ipairs({ -0.45, 0, 0.45 }) do
		accessory("Chef Hat", Vector3.new(1, 0.8, 1), head, CFrame.new(x, 0.95, 0), cream, Enum.PartType.Ball)
	end
	local apron = accessory("Chef Apron", Vector3.new(1.5, 1.7, 0.08), torso, CFrame.new(0, -0.12, -0.55), mint)
	apron.Material = Enum.Material.Fabric
	accessory("Apron Pocket", Vector3.new(0.65, 0.4, 0.08), torso, CFrame.new(0, -0.45, -0.62), cream)
	model.PrimaryPart = root
	return true
end

function Avatar.create(onReady)
	local initial = fallback()
	Avatar.decorate(initial)
	onReady(initial)
	task.spawn(function()
		local description = Instance.new("HumanoidDescription")
		description.HeadColor, description.LeftArmColor, description.RightArmColor = skin, skin, skin
		description.TorsoColor, description.LeftLegColor, description.RightLegColor = cream, mint, mint
		local ok, model = pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6) end)
		description:Destroy()
		if ok and model and Avatar.decorate(model) then onReady(model)
		elseif ok and model then model:Destroy() end
	end)
end

return Avatar
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">BakeryDecorations</string>
          <string name="Source"><![CDATA[local W, Assets = require(script.Parent.WorldWidgets), require(script.Parent.AssetLibrary)
local Polish = require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryPolish)
local Decor = {}
function Decor.create(plot)
	local groups = {}
	for _, key in ipairs(Polish.DecorationOrder) do
		local group = Instance.new("Model")
		group.Name, group.Parent = key .. " Decoration", plot.model
		groups[key] = group
	end
	if plot.shell then plot.shell:Destroy() end
	for _, p in ipairs(plot.model:GetChildren()) do
		if p.Name == "Window Frame" or p.Name == "Pastel Window" or p.Name == "Window Mullion" then p:Destroy() end
		if p.Name == "Planter" then p.Parent = groups.Plants end
		if p.Name:find("String") or p.Name == "Light Cable" or p.Name == "Warm String Bulb" then p.Parent = groups.Lights end
	end
	local plaster, wood, gold, cream = Color3.fromRGB(231, 216, 192), Color3.fromRGB(115, 81, 59), Color3.fromRGB(195, 159, 95), Color3.fromRGB(245, 232, 206)
	local function p(key, name, size, x, y, z, color, material)
		return W.part(groups[key], name, size, W.position(plot, x, y, z), color, material)
	end
	-- Real openings in one wall, with matching frames/panes rather than floating windows.
	p("Walls", "Window Sill Wall", Vector3.new(164, 5, 1.5), 0, 3, -121, plaster, Enum.Material.Brick)
	p("Walls", "Window Header Wall", Vector3.new(164, 5, 1.5), 0, 16, -121, plaster, Enum.Material.Brick)
	for _, x in ipairs({ -73.5, -42, -14, 14, 42, 73.5 }) do p("Walls", "Window Pier", Vector3.new(math.abs(x) == 73.5 and 17 or 10, 8, 1.5), x, 9.5, -121, plaster, Enum.Material.Brick) end
	p("Walls", "Garden Wall", Vector3.new(1.5, 18, 244), -81, 9.5, 0, plaster, Enum.Material.Brick)
	p("Walls", "Road Wall", Vector3.new(1.5, 18, 205), 81, 9.5, -18.5, plaster, Enum.Material.Brick)
	p("Walls", "Entrance End Wall", Vector3.new(1.5, 18, 20), 81, 9.5, 112, plaster, Enum.Material.Brick)
	p("Walls", "Door Header", Vector3.new(1.5, 5, 18), 81, 16, 93, plaster, Enum.Material.Brick)
	for _, x in ipairs({ -56, -28, 0, 28, 56 }) do
		for _, side in ipairs({ -9.2, 9.2 }) do p("Windows", "Window Jamb", Vector3.new(0.6, 8, 2), x + side, 9.5, -121, wood) end
		for _, y in ipairs({ 5.6, 13.4 }) do p("Windows", "Window Frame", Vector3.new(19, 0.6, 2), x, y, -121, wood) end
		local glass = p("Windows", "Fitted Glass", Vector3.new(17.8, 7.4, 0.2), x, 9.5, -121, Color3.fromRGB(178, 216, 220), Enum.Material.Glass)
		glass.Transparency = 0.6
		p("Windows", "Window Mullion", Vector3.new(0.2, 7.5, 0.4), x, 9.5, -120.7, cream)
	end
	local leaf = Instance.new("Model")
	leaf.Name, leaf.Parent = "Hinged Door Leaf", groups.Door
	local hinge = W.position(plot, 81, 0.5, 85)
	leaf.WorldPivot = CFrame.new(hinge)
	for _, z in ipairs({ 85, 101 }) do p("Door", "Door Jamb", Vector3.new(1.8, 13, 0.8), 81, 7, z, wood) end
	p("Door", "Door Frame Header", Vector3.new(1.8, 0.8, 16.8), 81, 13.5, 93, wood)
	local pane = p("Door", "Door Glass", Vector3.new(0.25, 12, 14.4), 81, 7, 93, Color3.fromRGB(179, 222, 219), Enum.Material.Glass)
	pane.Transparency, pane.Parent = 0.55, leaf
	for _, z in ipairs({ 85.7, 100.3 }) do local edge = p("Door", "Door Stile", Vector3.new(0.5, 12.7, 0.5), 81, 7, z, wood); edge.Parent = leaf end
	for _, y in ipairs({ 1, 13 }) do local edge = p("Door", "Door Rail", Vector3.new(0.5, 0.6, 15), 81, y, 93, wood); edge.Parent = leaf end
	local handle = p("Door", "Door Handle", Vector3.new(0.35, 2, 0.3), 80.5, 7, 98.5, gold, Enum.Material.Metal)
	handle.Parent = leaf
	for _, y in ipairs({ 3, 11 }) do p("Door", "Visible Hinge", Vector3.new(0.8, 0.9, 0.9), 81, y, 85.7, gold, Enum.Material.Metal) end
	local value, open, busy = Instance.new("CFrameValue"), false, false
	value.Value, value.Parent = CFrame.new(hinge), groups.Door
	value.Changed:Connect(function(cf) leaf:PivotTo(cf) end)
	W.prompt(handle, "Open / close door", 0, function()
		if busy then return end
		busy, open = true, not open
		local target = CFrame.new(hinge) * CFrame.Angles(0, open and math.rad(95) * (plot.mirrorX or 1) * plot.direction or 0, 0)
		game:GetService("TweenService"):Create(value, TweenInfo.new(0.45), { Value = target }):Play()
		task.delay(0.5, function() busy = false end)
	end)
	for _, side in ipairs({ -1, 1 }) do
		local roof = p("Roof", "Pitched Roof", Vector3.new(61, 0.7, 247), side * 51, 23, 0, wood, Enum.Material.WoodPlanks)
		roof.CFrame *= CFrame.Angles(0, 0, -side * (plot.mirrorX or 1) * 0.14)
	end
	local skylight = p("Roof", "Long Skylight", Vector3.new(43, 0.4, 245), 0, 27, 0, Color3.fromRGB(195, 226, 229), Enum.Material.Glass)
	skylight.Transparency = 0.65
	for _, x in ipairs({ -45, 0, 45 }) do for _, z in ipairs({ -70, 20, 85 }) do
		p("Lights", "Pendant Cable", Vector3.new(0.1, 5, 0.1), x, 22, z, wood)
		local lamp = p("Lights", "Pendant Shade", Vector3.new(3, 0.4, 3), x, 19.5, z, cream, Enum.Material.Neon)
		lamp.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(255, 223, 171), 30, 0.8, lamp
	end end
	for _, z in ipairs({ -90, -35, 20, 75 }) do Assets.prop("CookieTree", groups.Trees, CFrame.new(W.position(plot, -74, 0.5, z))):ScaleTo(0.6) end
	for _, x in ipairs({ -68, 68 }) do Assets.prop("Planter", groups.Plants, CFrame.new(W.position(plot, x, 0.5, -110))):ScaleTo(0.7) end
	for i = 1, 20 do
		local tile = p("Floor", "Herringbone Tile", Vector3.new(8, 0.04, 12), -68 + (i % 4) * 40, 0.62, -105 + math.floor(i / 4) * 40, cream, Enum.Material.WoodPlanks)
		tile.CFrame *= CFrame.Angles(0, i % 2 == 0 and 0.6 or -0.6, 0)
	end
	local plaque = p("Signs", "Bakery Plaque", Vector3.new(0.5, 5, 14), 80.5, 16, 94, gold)
	W.label(plaque, "FRESHLY BAKED", 60)
	for _, z in ipairs({ 105, -105 }) do
		p("Benches", "Cafe Seat", Vector3.new(12, 0.5, 4), -58, 2, z, wood)
		for _, x in ipairs({ -63, -53 }) do p("Benches", "Seat Leg", Vector3.new(0.7, 2, 3), x, 1, z, wood) end
	end
	local bowl = p("Fountain", "Fountain Bowl", Vector3.new(0.8, 12, 12), -60, 1, -70, cream, Enum.Material.Marble)
	bowl.Shape, bowl.CFrame = Enum.PartType.Cylinder, bowl.CFrame * CFrame.Angles(0, 0, math.pi/2)
	local water = p("Fountain", "Fountain Water", Vector3.new(0.2, 10, 10), -60, 1.5, -70, Color3.fromRGB(124, 197, 204), Enum.Material.Glass)
	water.Shape, water.CFrame, water.Transparency = Enum.PartType.Cylinder, water.CFrame * CFrame.Angles(0, 0, math.pi/2), 0.35
	Assets.cookie(1, groups.Fountain, CFrame.new(W.position(plot, -60, 4, -70))):ScaleTo(1.2)
	local case = p("Display", "Glass Cookie Case", Vector3.new(12, 4, 5), 60, 4, -108, Color3.fromRGB(186, 220, 218), Enum.Material.Glass)
	case.Transparency = 0.7
	for i = 1, 4 do Assets.cookie(i, groups.Display, CFrame.new(W.position(plot, 53 + i*2.5, 3, -108))):ScaleTo(0.45) end
	for _, z in ipairs({ -112, 110 }) do
		p("FlowerBeds", "Flower Bed", Vector3.new(20, 0.8, 5), -45, 0.8, z, wood)
		for i = 1, 7 do local flower = p("FlowerBeds", "Flower", Vector3.one, -55 + i*2.5, 1.8, z, Color3.fromHSV(i/9, 0.4, 1)); flower.Shape = Enum.PartType.Ball; flower.CanCollide = false end
	end
	for _, z in ipairs({ -45, 30 }) do Assets.prop("WoodenFence", groups.Fence, CFrame.new(W.position(plot, -77, 0.5, z))) end
	return groups
end
function Decor.refresh(plot, groups)
	for key, model in pairs(groups) do model.Parent = plot.data and plot.data.life.decorations[key] and plot.model or nil end
end
return Decor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">BakeryFeatures</string>
          <string name="Source"><![CDATA[local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Life, Progression = require(Shared.BakeryLife), require(Shared.Progression)
local W, Assets = require(script.Parent.WorldWidgets), require(script.Parent.AssetLibrary)
local Polish = require(Shared.BakeryPolish)
local Decorations = require(script.Parent.BakeryDecorations)
local Cave = require(script.Parent.DoughCave)
local Features = {}
function Features.create(world, plots, action)
	local self = { machines = {}, decorations = {}, buildPads = {}, ores = {}, mine = Vector3.new(-250, 2, 100) }
	local mineModel = Instance.new("Model")
	mineModel.Name, mineModel.Parent = "Cookie Dough Mine", world
	local entrance = W.part(mineModel, "Dough Mine Workshop", Vector3.new(28, 1, 20), self.mine, Color3.fromRGB(136, 102, 69), Enum.Material.WoodPlanks)
	W.label(entrance, "COOKIE DOUGH CAVE\nLeft-click to swing • mine dough", 90)
	W.prompt(entrance, "Rolling pins & dough upgrades", 0, function(player) action(player, "OpenMine") end)
	Cave.create(mineModel)
	for i = 1, 16 do
		local x, z = -285 - ((i - 1) % 4) * 24, 75 + math.floor((i - 1) / 4) * 25
		local maximum = ({ 6, 18, 45 })[(i - 1) % 3 + 1]
		local ore = W.part(mineModel, "Dough Ore", Vector3.new(10, 7, 9), Vector3.new(x, 3, z), Color3.fromRGB(184, 137, 84), Enum.Material.Ground)
		ore.CFrame *= CFrame.Angles(0, i * 0.45, 0)
		ore.Size = Vector3.new(7.5, 5.5, 7)
		local node = { part = ore, hp = maximum, maximum = maximum, reward = math.ceil(maximum / 2), ready = 0, chips = {} }
		node.label = W.label(ore, "Dough ore • " .. maximum .. " HP", 30)
		Cave.health(node)
		ore:SetAttribute("DoughOre", true)
		for facet = 1, 3 do
			local p = Instance.new("WedgePart")
			p.Name, p.Size, p.CFrame, p.Color = "Faceted Dough Rock", Vector3.new(4, 5, 5), ore.CFrame * CFrame.Angles(0, facet * 2.1, 0) * CFrame.new(2.5, -0.3, 0), Color3.fromRGB(172 + facet * 7, 126 + facet * 5, 79)
			p.Anchored, p.CanCollide, p.Material, p.Parent = true, false, Enum.Material.Sandstone, mineModel
			table.insert(node.chips, p)
		end
		for chip = 1, 4 do
			local p = W.part(mineModel, "Ore Chocolate Seam", Vector3.new(0.7, 0.7, 0.7), ore.Position + Vector3.new(math.sin(chip) * 3, 2, math.cos(chip) * 2), Color3.fromRGB(82, 51, 32))
			p.CanCollide = false
			table.insert(node.chips, p)
		end
		table.insert(self.ores, node)
	end
	for _, plot in ipairs(plots) do
		self.machines[plot] = {}
		self.decorations[plot] = Decorations.create(plot)
		local buildPad = W.part(plot.model, "Build Conveyor", Vector3.new(7, 0.2, 7), W.position(plot, 60, 0.8, 64), Color3.fromRGB(117, 192, 170))
		self.buildPads[plot] = { pad = buildPad, label = W.label(buildPad, "Build first conveyor • FREE", 45) }
		W.prompt(buildPad, "Build / expand conveyor", 0, function(player) action(player, "BuildBelt", nil, plot) end)
		for index, key in ipairs(Polish.DecorationOrder) do
			local pad = W.part(plot.model, key .. " Decoration Pad", Vector3.new(5, 0.2, 5), W.position(plot, 30 + ((index - 1) % 5) * 10, 0.8, -55 - math.floor((index - 1) / 5) * 12), Color3.fromRGB(187, 156, 202))
			W.label(pad, Polish.Decorations[key].Name .. "\n$" .. Progression.format(Polish.Decorations[key].Cost), 26)
			W.prompt(pad, "Buy " .. key, 0, function(player) action(player, "Decoration", key, plot) end)
		end
		for _, entry in ipairs({ { "Packager", -18, 115 }, { "Boxer", 18, 110 }, { "FinishingOven", 53, 75 } }) do
			local key, x, z = table.unpack(entry)
			local pad = W.part(plot.model, key .. " Purchase Pad", Vector3.new(6, 0.3, 6), W.position(plot, x, 0.8, z), Color3.fromRGB(119, 194, 161), Enum.Material.Neon)
			local record = { pad = pad, label = W.label(pad, key .. "\n$" .. Progression.format(Life.Machines[key].Cost), 50), key = key, visuals = {} }
			record.prompt = W.prompt(pad, "Buy " .. key, 0, function(player) action(player, "Machine", key, plot) end)
			self.machines[plot][key] = record
			if key == "FinishingOven" then
				local oven = Assets.prop("Oven", plot.model, CFrame.new(W.position(plot, x, 0.5, z - 10)) * CFrame.Angles(0, -(plot.mirrorX or 1) * math.pi / 2, 0))
				oven:ScaleTo(0.8)
				for _, p in ipairs(oven:GetDescendants()) do if p:IsA("BasePart") then table.insert(record.visuals, { part = p, transparency = p.Transparency, collision = p.CanCollide }) end end
			else
				local gateZ = key == "Packager" and Polish.WrapZ or Polish.BoxZ
				local color = key == "Packager" and Color3.fromRGB(112, 181, 172) or Color3.fromRGB(193, 145, 92)
				for _, side in ipairs({ -7.3, 7.3 }) do
					local leg = W.part(plot.model, key .. " Arch Leg", Vector3.new(0.8, 8, 0.8), W.position(plot, side, 4, gateZ), color, Enum.Material.Metal)
					leg.CanCollide = false
					table.insert(record.visuals, { part = leg, transparency = 0, collision = false })
				end
				local head = W.part(plot.model, key .. " Processing Arch", Vector3.new(15.5, 1.3, 1.3), W.position(plot, 0, 8.4, gateZ), color, Enum.Material.Metal)
				head.CanCollide = false
				table.insert(record.visuals, { part = head, transparency = 0, collision = false })
				W.label(head, key, 35)
			end
		end
	end
	return self
end
function Features.step(self)
	for plot, groups in pairs(self.decorations) do
		Decorations.refresh(plot, groups)
		local tier = plot.data and plot.data.life.belt or 0
		local cost = Polish.BeltCosts[tier + 1]
		self.buildPads[plot].label.Text = cost and ("Build line " .. (tier + 1) .. "\n" .. (cost == 0 and "FREE" or "$" .. Progression.format(cost))) or "All conveyor lines built"
	end
	for _, node in ipairs(self.ores) do
		if node.hp <= 0 and os.clock() >= node.ready then
			node.hp, node.part.Transparency, node.part.CanCollide = node.maximum, 0, true
			node.label.Parent.Enabled = true
			node.bar.Size = UDim2.fromScale(1, 1)
			for _, chip in ipairs(node.chips) do chip.Transparency = 0 end
			node.label.Text = "Dough ore • " .. node.hp .. " HP"
		end
	end
	for plot, machines in pairs(self.machines) do
		for key, record in pairs(machines) do
			local owned = plot.data and plot.data.life.machines[key]
			record.label.Text = owned and (key == "FinishingOven" and "Finishing oven\nHold a cookie • 20s • 3x value" or key .. " installed") or key .. "\n$" .. Progression.format(Life.Machines[key].Cost)
			record.pad.Color = owned and Color3.fromRGB(198, 160, 90) or Color3.fromRGB(119, 194, 161)
			record.prompt.ActionText = owned and (key == "FinishingOven" and "Finish held cookie" or "Machine owned") or "Buy " .. key
			if owned and key == "FinishingOven" and plot.data.life.oven.id then record.label.Text = "Finishing cookie\n" .. math.max(0, plot.data.life.oven.ready - os.time()) .. "s remaining • 3x value" end
			for _, visual in ipairs(record.visuals) do
				visual.part.Transparency = owned and visual.transparency or math.max(0.8, visual.transparency)
				visual.part.CanCollide = owned and visual.collision or false
			end
		end
	end
end
return Features
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">BakeryLifeServer</string>
          <string name="Source"><![CDATA[local Players, Http = game:GetService("Players"), game:GetService("HttpService")
local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Life, Recipes, Crafting = require(Shared.BakeryLife), require(Shared.Recipes), require(Shared.CookieCrafting)
local W, Features = require(script.Parent.WorldWidgets), require(script.Parent.BakeryFeatures)
local Tools, Appearance = require(script.Parent.CookieTools), require(script.Parent.CookieAppearance)
local Customers = require(script.Parent.CookieCustomers)
local Packaging = require(script.Parent.CookiePackaging)
local Polish = require(Shared.BakeryPolish)
local Contracts = require(Shared.BakeryContracts)
local Cards, CardCatalog = require(Shared.CardEconomy), require(Shared.CardCatalog)
local TextService = game:GetService("TextService")
local Server = {}
Server.__index = Server
function Server.start(context)
	local self = setmetatable({ context = context, runtime = {}, offers = {}, pickups = setmetatable({}, { __mode = "k" }) }, Server)
	local function remote(name)
		local r = Instance.new("RemoteEvent")
		r.Name, r.Parent = name, context.Remotes
		return r
	end
	self.action, self.stateRemote, self.open = remote("LifeAction"), remote("LifeState"), remote("OpenLife")
	self.packResult = remote("PackResult")
	self.announcement = remote("WorldAnnouncement")
	context.Announce = function(kind) self.announcement:FireAllClients(kind) end
	self.events = require(script.Parent.ValleyEventsServer).start(context)
	self.features = Features.create(context.World, context.Plots, function(...) self:Action(...) end)
	self.customers = Customers.create(context.World, function(player, customer) self:OfferCustomer(player, customer) end)
	context.OnCookie(function(...) self:Cookie(...) end, function(...) self:ProcessCookie(...) end)
	self.action.OnServerEvent:Connect(function(player, action, argument) self:Action(player, action, argument) end)
	Players.PlayerRemoving:Connect(function(player)
		self:CancelTrade(player)
		local runtime = self.runtime[player]
		if runtime then self:CloseBargain(runtime); Appearance.clear(runtime) end
		if runtime and runtime.appearance then runtime.appearance:Disconnect() end
		self.runtime[player] = nil
	end)
	task.spawn(function()
		while context.World.Parent do
			Features.step(self.features)
			for _, player in ipairs(Players:GetPlayers()) do
				local state = context.GetState(player)
				if state and not state.closing then
					if self.offers[player] and not self.offers[player].committing and self.offers[player].expires < os.clock() then self:CancelTrade(player) end
					local runtime = self:Runtime(player)
					runtime.data = state.data
					local savedName = state.data.life.shopName
					if runtime.filteredSource ~= savedName then
						runtime.filteredSource = savedName
						player:SetAttribute("FilteredShopName", nil)
						if savedName ~= "" then task.spawn(function()
							local ok, filtered = pcall(function() return TextService:FilterStringAsync(savedName, player.UserId, Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync() end)
							if ok and player.Parent and runtime.filteredSource == savedName then
								player:SetAttribute("FilteredShopName", filtered)
								if state.plot then self.context.Changed(player, state) end
							end
						end) end
					end
					if player.Character ~= runtime.character then
						runtime.character, runtime.held, runtime.cookieTool = player.Character, nil, nil
						self:TradePrompt(player)
					end
					local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
					if root and not root:FindFirstChild("CookieTradePrompt") then self:TradePrompt(player) end
					if not runtime.bagTool or not runtime.bagTool.Parent then
						if runtime.bagTool then runtime.bagTool:Destroy() end
						runtime.bagTool = Tools.bag(player, function() self.open:FireClient(player, "Bag") end)
					end
					if not runtime.pinTool or not runtime.pinTool.Parent or runtime.pinLevel ~= state.data.life.pin then
						if runtime.pinTool then runtime.pinTool:Destroy() end
						runtime.pinLevel, runtime.pinTool = state.data.life.pin, Tools.pin(player, state.data.life.pin, function() self:Swing(player) end)
					end
					if runtime.cookieTool and (not runtime.cookieTool.Parent or not Life.find(state.data.life, runtime.cookieTool:GetAttribute("InventoryCookieId"))) then self:ClearTool(player) end
					if context.Usable(player) and Life.finishOven(state.data.life, os.time()) then
						self:Changed(player, state)
						context.Notify(player, "Your finishing oven is done! The cookie is worth 3x.")
					end
					if runtime.bargain and (runtime.bargain.expires < os.clock() or not W.near(player, runtime.bargain.customer.root.Position, 16)) then self:CloseBargain(runtime) end
					Appearance.step(player, runtime)
					self:Refresh(player)
				end
			end
			task.wait(0.25)
		end
	end)
	return self
end
function Server:OpenPack(player, packId)
	local state = self.context.Usable(player)
	if not state or not state.plot or not CardCatalog.Packs[packId] then return end
	local runtime, pack = self:Runtime(player), CardCatalog.Packs[packId]
	if runtime.opening or os.clock() - (runtime.lastPack or -math.huge) < 3 then return end
	if state.data.life.cards.crumbs < pack.Cost then self.context.Notify(player, "Earn more Star Crumbs first."); return end
	runtime.opening, runtime.lastPack = true, os.clock()
	local cardId = Cards.roll(packId, math.random(), math.random())
	if state.profile.sessionOnly then
			local ok, message = Cards.open(state.data.life.cards, packId, cardId)
			runtime.opening = false
			if ok then self:Changed(player, state); self.packResult:FireClient(player, cardId, packId) else self.context.Notify(player, message) end
			return
		end
	local receipt = "cp:" .. Http:GenerateGUID(false)
	state.receiptWorkers += 1
	task.spawn(function()
		local ok, reason
		for _ = 1, 6 do
			ok, reason = self.context.Profiles:GrantReceipt(state.profile, receipt, 1, function(data) return Cards.open(data.life.cards, packId, cardId) end)
			if ok or (reason ~= "unavailable" and reason ~= "busy") then break end
			task.wait(1)
		end
		state.receiptWorkers -= 1
		runtime.opening = false
		if player.Parent then
			if ok then self:Changed(player, state); self.packResult:FireClient(player, cardId, packId, state.data.life.cards.owned[tostring(cardId)])
			else self.context.Notify(player, "Pack saving could not finish. Rejoin to recover; any committed card and charge stay together.") end
		elseif ok then self.context.Profiles:Save(state.profile, true) end
	end)
end
function Server:Swing(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root or not self.context.Usable(player) then return end
	local runtime = self:Runtime(player)
	if runtime.pinTool and self.events:Swing(player, runtime.pinTool) then return end
	local nearest, distance = nil, 12
	for _, node in ipairs(self.features.ores) do
		local delta = node.part.Position - root.Position
		if node.hp > 0 and delta.Magnitude < distance and delta:Dot(root.CFrame.LookVector) > -2 then nearest, distance = node, delta.Magnitude end
	end
	if nearest then self:Action(player, "Mine", nearest) end
end
function Server:Runtime(player)
	if not self.runtime[player] then
		local runtime = { player = player }
		runtime.appearance = player.CharacterAppearanceLoaded:Connect(function() Appearance.clear(runtime) end)
		self.runtime[player] = runtime
	end
	return self.runtime[player]
end
function Server:Held(player)
	local runtime = self:Runtime(player)
	return runtime.cookieTool and runtime.cookieTool.Parent == player.Character and runtime.held or nil
end
function Server:Refresh(player)
	local state, runtime = self.context.GetState(player), self:Runtime(player)
	if not state or state.closing then return end
	local b, trade = runtime.bargain, self.offers[player]
	local snapshot = { life = Life.normalize(state.data.life), held = self:Held(player), hasPlot = state.plot ~= nil,
		busy = state.profile.activityLock ~= nil or state.profile.transacting == true }
	snapshot.life.cards.milestone, snapshot.life.cards.daily, snapshot.life.cards.dailyEarned = 0, 0, 0
	if b then snapshot.bargain = { name = b.customer.name, price = b.price, attempts = b.attempts, item = b.item, personality = b.customer.traits.Style, favorite = Recipes[b.customer.traits.Favorite].Name } end
	if trade then snapshot.trade = { id = trade.id, from = trade.a.Name, to = trade.b.Name,
		giveA = Recipes[trade.itemA.recipe].Name .. " • $" .. self.context.Format(Life.value(trade.itemA)),
		giveB = trade.itemB and (Recipes[trade.itemB.recipe].Name .. " • $" .. self.context.Format(Life.value(trade.itemB))) or "Gift (no cookie requested)",
		confirmed = trade.confirmed[player] == true, otherConfirmed = trade.confirmed[player == trade.a and trade.b or trade.a] == true } end
	local signature = Http:JSONEncode(snapshot)
	if signature ~= runtime.lastSnapshot then runtime.lastSnapshot = signature ; self.stateRemote:FireClient(player, snapshot) end
	player:SetAttribute("HeldCookieId", self:Held(player))
	player:SetAttribute("CookieTradeBusy", snapshot.busy)
end
function Server:Changed(player, state)
	state.nextSave = math.min(state.nextSave, os.clock() + 2)
	self.context.Changed(player, state)
	self:Refresh(player)
end
function Server:ClearTool(player)
	local runtime = self:Runtime(player)
	if runtime.cookieTool then runtime.cookieTool:Destroy() end
	runtime.cookieTool, runtime.held = nil, nil
end
function Server:ProcessCookie(plot, model, z)
	local pickup = self.pickups[model]
	if not pickup or not plot.data or model:GetAttribute("Collected") then return end
	if Life.process(pickup.cookie, plot.data.life.machines, z) then
		if pickup.cookie.wrapped then Packaging.wrap(model, model.PrimaryPart) end
		if pickup.cookie.boxed then Packaging.box(model, model.PrimaryPart) end
		local worth = Life.value(pickup.cookie)
		pickup.label.Text = Recipes[pickup.cookie.recipe].Name .. "\n$" .. self.context.Format(worth)
		pickup.prompt.ActionText = "Pick up • $" .. self.context.Format(worth)
		model:SetAttribute("CashValue", worth)
		model:SetAttribute("Packaged", pickup.cookie.wrapped)
		model:SetAttribute("Boxed", pickup.cookie.boxed)
	end
end
function Server:Cookie(plot, model, index, data)
	local cookie = { id = Http:GenerateGUID(false), recipe = index, mask = Crafting.encode(data.modifiers[tostring(index)]),
		quality = data.life.recipeLevels[tostring(index)], wrapped = false, boxed = false, baked = false }
	local pickup = { plot = plot, cookie = cookie }
	self.pickups[model] = pickup
	local root = model.PrimaryPart
	local worth = Life.value(cookie)
	model:SetAttribute("CashValue", worth)
	local text = W.label(root, Recipes[index].Name .. "\n$" .. self.context.Format(worth), 20)
	text.Parent.Size, text.TextSize, text.Parent.MaxDistance = UDim2.fromOffset(156, 36), 12, 18
	pickup.label = text
	text.Parent.StudsOffset = Vector3.new(0, 2, 0)
	pickup.prompt = W.prompt(root, "Pick up • $" .. self.context.Format(worth), 0.2, function(player)
		local state = self.context.Usable(player)
		if not state or plot.owner ~= player or model:GetAttribute("Collected") or model:GetAttribute("InventoryClaimed") then return end
		local ok, message = Life.add(state.data.life, cookie)
		if not ok then self.context.Notify(player, message) ; return end
		model:SetAttribute("InventoryClaimed", true)
		model:Destroy()
		self:Changed(player, state)
		self.context.Notify(player, "Cookie stored! Open Cookie bag to hold, eat, sell, or trade it.")
	end)
end
function Server:CloseBargain(runtime)
	if runtime.bargain and runtime.bargain.customer.reservedBy == runtime.player then
		runtime.bargain.customer.reservedUntil, runtime.bargain.customer.reservedBy = 0, nil
		runtime.bargain.customer.depart = true
	end
	runtime.bargain = nil
end
function Server:OfferCustomer(player, customer)
	local state, runtime = self.context.Usable(player), self:Runtime(player)
	if not state or not self:Held(player) or not Life.available(state.data.life, runtime.held) then self.context.Notify(player, "Hold a cookie from your bag first.") ; return end
	if customer.reservedUntil > os.clock() then self.context.Notify(player, "This customer is already talking to someone.") ; return end
	self:CloseBargain(runtime)
	local item = Life.find(state.data.life, runtime.held)
	local base = math.floor(Life.value(item) * (1 + Polish.active(state.data.life, os.time()).Sell / 100) * Cards.bonuses(state.data.life.cards, state.perks.ThirdCardSlot).Sales)
	local price, budget = Polish.offer(base, item.recipe, customer.traits, math.random())
	customer.reservedUntil, customer.reservedBy = os.clock() + 30, player
	runtime.bargain = { customer = customer, item = item.id, base = base, price = price, budget = budget, attempts = 0, expires = os.clock() + 30 }
	customer.label.Text = customer.name .. "\nLet's talk cookies!"
	self:Refresh(player)
	self.open:FireClient(player, "Customer")
end
function Server:TradePrompt(player)
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	if not root then return end
	local prompt = W.prompt(root, "Want a cookie?", 1, function(sender) self:Invite(sender, player) end)
	prompt.Name, prompt.ObjectText = "CookieTradePrompt", "@" .. player.Name
	prompt:SetAttribute("TargetUserId", player.UserId)
end
function Server:CancelTrade(player)
	local offer = self.offers[player]
	if not offer or offer.committing then return end
	self.offers[offer.a], self.offers[offer.b] = nil, nil
	for _, p in ipairs({ offer.a, offer.b }) do if p.Parent then self:Refresh(p) end end
end
function Server:Invite(a, b)
	local root = b.Character and b.Character:FindFirstChild("HumanoidRootPart")
	if a == b or not root or not W.near(a, root.Position, 12) then return end
	local sa, sb = self.context.Usable(a), self.context.Usable(b)
	if not sa or not sb or self.offers[a] or self.offers[b] then return end
	local ra = self:Runtime(a)
	if not self:Held(a) or not Life.available(sa.data.life, ra.held) then self.context.Notify(a, "Hold the cookie you want to offer first.") ; return end
	local itemB = nil -- Sharing is always a free, one-way gift, regardless of what the recipient holds.
	local offer = { id = Http:GenerateGUID(false), a = a, b = b, itemA = Life.cookie(Life.find(sa.data.life, ra.held)), itemB = itemB and Life.cookie(itemB) or nil,
		confirmed = {}, expires = os.clock() + 45 }
	self.offers[a], self.offers[b] = offer, offer
	self.context.Notify(b, "@" .. a.Name .. " wants to give you a cookie! Accept or decline the free gift.")
	self.context.Notify(a, "Gift offered to @" .. b.Name .. ". No cash or return cookie is requested.")
	for _, p in ipairs({ a, b }) do self:Refresh(p); self.open:FireClient(p, "Gift") end
end
function Server:Confirm(player, id)
	local offer = self.offers[player]
	if not offer or offer.id ~= id or offer.committing then return end
	local root = offer.b.Character and offer.b.Character:FindFirstChild("HumanoidRootPart")
	if not root or offer.expires < os.clock() or not W.near(offer.a, root.Position, 12) then self:CancelTrade(player) ; return end
	local sa, sb = self.context.Usable(offer.a), self.context.Usable(offer.b)
	if not sa or not sb then return end
	if not Life.available(sa.data.life, offer.itemA.id)
		or not Life.sameCookie(Life.find(sa.data.life, offer.itemA.id), offer.itemA)
		or (offer.itemB and (not Life.available(sb.data.life, offer.itemB.id)
			or not Life.sameCookie(Life.find(sb.data.life, offer.itemB.id), offer.itemB))) then self:CancelTrade(player) ; return end
	offer.confirmed[player] = true
	if not offer.confirmed[offer.a] or not offer.confirmed[offer.b] then self:Refresh(offer.a) ; self:Refresh(offer.b) ; return end
	offer.committing = true
	self:ClearTool(offer.a)
	self:ClearTool(offer.b)
	task.spawn(function()
		local ok, message, pending = self.context.Trades:Exchange(offer.id, sa.profile, offer.a.UserId, offer.itemA.id, sb.profile, offer.b.UserId, offer.itemB and offer.itemB.id)
		if pending then
			for _ = 1, 12 do
				local doneA = self.context.Trades:Recover(sa.profile, offer.a.UserId, offer.id)
				local doneB = self.context.Trades:Recover(sb.profile, offer.b.UserId, offer.id)
				if doneA and doneB then
					pending = false
					ok = Life.find(sb.data.life, offer.itemA.id) ~= nil and Life.find(sa.data.life, offer.itemA.id) == nil
					message = ok and "Cookie gift saved! No cash was charged." or "Gift canceled; your cookie was kept."
					break
				end
				task.wait(2)
			end
		end
		if ok then Contracts.record(sa.data, "Gift", 1); sa.nextSave = math.min(sa.nextSave, os.clock() + 2); message = "Cookie gift saved! No cash was charged." end
		self.offers[offer.a], self.offers[offer.b] = nil, nil
		for _, entry in ipairs({ { offer.a, sa }, { offer.b, sb } }) do
			if entry[1].Parent then
				self.context.Notify(entry[1], pending and "Trade recovery is waiting for saving. Rejoin to recover safely." or message)
				self.context.Changed(entry[1], entry[2])
				self:Refresh(entry[1])
			elseif not entry[2].profile.activityLock then self.context.Profiles:Save(entry[2].profile, true) end
		end
		if not ok and not pending and offer.a.Parent then self.context.Notify(offer.a, message) end
	end)
end
function Server:Action(player, action, argument, plot)
	if type(action) ~= "string" then return end
	local runtime = self:Runtime(player)
	if os.clock() - (runtime.lastAction or -math.huge) < 0.15 then return end
	runtime.lastAction = os.clock()
	local state = self.context.Usable(player)
	if not state then return end
	local data, ok, message = state.data, false, nil
	if action == "OpenPack" then self:OpenPack(player, argument); return
	elseif action == "EquipCard" then ok, message = Cards.equip(data.life.cards, argument, state.perks.ThirdCardSlot)
	elseif action == "RenameShop" then
		if type(argument) ~= "string" or #argument > 80 or not state.plot then return end
		argument = argument:match("^%s*(.-)%s*$")
		if #argument < 3 or #argument > 40 or data.cash < 20000000 then self.context.Notify(player, "A shop name needs 3–40 characters and $20 million."); return end
		if os.clock() - (runtime.lastRename or -math.huge) < 5 then return end
		runtime.lastRename = os.clock()
		local success, filtered = pcall(function() return TextService:FilterStringAsync(argument, player.UserId, Enum.TextFilterContext.PublicChat):GetNonChatStringForBroadcastAsync() end)
		if not success or (type(filtered) == "string" and #filtered:gsub("#", "") < 3) or self.context.Usable(player) ~= state or data.cash < 20000000 then self.context.Notify(player, "The name could not be checked. No cash was charged."); return end
		data.cash -= 20000000
		data.life.shopName = filtered
		runtime.filteredSource = filtered
		player:SetAttribute("FilteredShopName", filtered)
		ok, message = true, "Shop renamed!"
	elseif action == "Snapshot" then runtime.lastSnapshot = nil ; self:Refresh(player) ; return
	elseif action == "OpenMine" then self.open:FireClient(player, "Mine") ; return
	elseif action == "Home" then
		if state.plot then self.context.Home(player, state.plot) else self.context.Notify(player, "Claim a bakery first.") end
		return
	elseif action == "Equip" then
		if type(argument) ~= "string" or not Life.available(data.life, argument) then return end
		self:ClearTool(player)
		local item = Life.find(data.life, argument)
		runtime.cookieTool = Tools.cookie(player, item, function(id) runtime.held = id ; self:Refresh(player) end, function() self:Action(player, "Eat", item.id) end)
		self:Refresh(player)
		return
	elseif action == "Eat" then
		if argument ~= self:Held(player) then return end
		ok, message = Life.eat(data.life, argument, os.time(), math.random(1, 1000000))
		if ok then self:ClearTool(player); Contracts.record(data, "Eat", 1) end
	elseif action == "UpgradeRecipe" then ok, message = Life.upgradeRecipe(data, argument)
	elseif action == "Mine" then
		local node = argument
		if type(node) ~= "table" or not table.find(self.features.ores, node) or node.hp <= 0 or not W.near(player, node.part.Position) then return end
		if not runtime.pinTool or runtime.pinTool.Parent ~= player.Character then self.context.Notify(player, "Equip your rolling pin first.") ; return end
		if os.clock() - (runtime.lastMine or 0) < 0.4 then return end
		runtime.lastMine = os.clock()
		local feedback = self.context.Remotes:FindFirstChild("Feedback")
		if feedback then feedback:FireClient(player, "Click") end
		local crumbs = Instance.new("ParticleEmitter")
		crumbs.Texture, crumbs.Color, crumbs.Rate, crumbs.Lifetime = "rbxasset://textures/particles/sparkles_main.dds", ColorSequence.new(node.part.Color), 0, NumberRange.new(0.15, 0.35)
		crumbs.Speed, crumbs.SpreadAngle, crumbs.Size, crumbs.Parent = NumberRange.new(3, 6), Vector2.new(160, 160), NumberSequence.new(0.2, 0), node.part
		crumbs:Emit(6)
		game:GetService("Debris"):AddItem(crumbs, 0.5)
		node.hp = math.max(0, node.hp - Life.PinPower[data.life.pin] - Polish.active(data.life, os.time()).Mine - Cards.bonuses(data.life.cards, state.perks.ThirdCardSlot).Mine)
		node.label.Text = "Dough ore • " .. node.hp .. "/" .. node.maximum .. " HP"
		node.bar.Size = UDim2.fromScale(node.hp / node.maximum, 1)
		if node.hp == 0 then
			Contracts.record(data, "Mine", 1)
			if os.time() >= (runtime.nextOreCrumb or 0) then Cards.award(data.life.cards, 1, state.perks.ThirdCardSlot); runtime.nextOreCrumb = os.time() + 20 end
			data.life.dough = math.min(1e9, data.life.dough + node.reward)
			node.ready, node.part.Transparency, node.part.CanCollide = os.clock() + 10, 1, false
			node.label.Parent.Enabled = false
			for _, chip in ipairs(node.chips) do chip.Transparency = 1 end
			ok, message = true, "+" .. node.reward .. " cookie dough!"
		end
	elseif action == "Pin" or action == "Dough" then
		if not W.near(player, self.features.mine, 22) then self.context.Notify(player, "Visit the dough mine workshop to upgrade.") ; return end
		if action == "Pin" then ok, message = Life.upgradePin(data) else ok, message = Life.upgradeDough(data, argument) end
	elseif action == "BuildBelt" or action == "Decoration" then
		if not state.plot or (plot and state.plot ~= plot) then return end
		local point = action == "BuildBelt" and self.features.buildPads[state.plot].pad.Position or W.position(state.plot, 50, 1, -67)
		if not W.near(player, point, action == "BuildBelt" and 16 or 32) then self.context.Notify(player, "Visit the purchase pads in your bakery."); return end
		if action == "BuildBelt" then ok, message = Polish.buyBelt(data) else ok, message = Polish.buyDecoration(data, argument) end
	elseif action == "Machine" or action == "Bake" then
		local key = action == "Bake" and "FinishingOven" or argument
		if type(key) ~= "string" or not state.plot or (plot and state.plot ~= plot) then return end
		local machine = self.features.machines[state.plot][key]
		if not machine or not W.near(player, machine.pad.Position, 16) then self.context.Notify(player, "Visit that machine's purchase pad beside your conveyor.") ; return end
		if key == "FinishingOven" and data.life.machines[key] then
			ok, message = Life.startOven(data, self:Held(player), os.time())
			if ok then self:ClearTool(player) end
		else ok, message = Life.buyMachine(data, key) end
	elseif action == "Pitch" or action == "Sell" or action == "WalkAway" then
		local b = runtime.bargain
		if not b then return end
		if action == "WalkAway" then self:CloseBargain(runtime) ; self:Refresh(player) ; return end
		if b.customer.reservedBy ~= player or b.expires < os.clock() or not W.near(player, b.customer.root.Position, 12) or b.item ~= self:Held(player) or not Life.available(data.life, b.item) then self:CloseBargain(runtime) ; self:Refresh(player) ; return end
		if action == "Pitch" then
			local accepted, price = Polish.negotiate(b.price, b.budget, b.attempts, b.customer.traits, math.random(), math.random())
			if accepted then b.attempts += 1 ; b.price = price ; message = "They like your pitch!" else b.customer.label.Text = b.customer.name .. "\nToo pushy! I'm leaving." ; self:CloseBargain(runtime) ; message = "The customer got annoyed and walked away." end
		elseif b.price <= Life.MaxCurrency - data.bank then
			Life.remove(data.life, b.item)
			data.bank += b.price
			Contracts.record(data, "Sell", 1)
			ok, message = true, "Sold! $" .. self.context.Format(b.price) .. " added to your collection register."
			self:ClearTool(player)
			self:CloseBargain(runtime)
		else message = "Collect earnings first; your register is full." end
	elseif action == "ConfirmTrade" then self:Confirm(player, argument) ; return
	elseif action == "CancelTrade" then self:CancelTrade(player) ; return
	end
	if ok then self:Changed(player, state) else self:Refresh(player) end
	if message then self.context.Notify(player, message) end
end
return Server
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">ChallengeWorld</string>
          <string name="Source"><![CDATA[-- A standard Roblox character and original treasures. Discovery callbacks originate
-- from alive characters beside the actual server-owned item, never a client ID.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage.CookieTycoon.ChallengeCatalog)
local BakerAvatar = require(script.Parent.BakerAvatar)
local ChallengeWorld = {}
local npcRoot = nil
local cooldowns = setmetatable({}, { __mode = "k" })
local cream = Color3.fromRGB(255, 243, 218)
local cocoa = Color3.fromRGB(83, 56, 43)

local function rgb(value) return Color3.fromRGB(value[1], value[2], value[3]) end

local function piece(parent, name, size, frame, tint, shape, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = frame
	object.Color = tint
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Material = material or Enum.Material.SmoothPlastic
	if shape then object.Shape = shape end
	object.Parent = parent
	return object
end

local function aliveNear(player, target, distance)
	if not target or not target.Parent then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil and humanoid.Health > 0 and root ~= nil and root:IsA("BasePart")
		and (root.Position - target.Position).Magnitude <= distance
end

local function available(player)
	local now = os.clock()
	if now < (cooldowns[player] or 0) then return false end
	cooldowns[player] = now + 0.3
	return true
end

local function interaction(target, action, name, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ChallengePrompt"
	prompt.ActionText = action
	prompt.ObjectText = name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = target
	prompt.Triggered:Connect(function(player)
		if aliveNear(player, target, 12) and available(player) then callback(player) end
	end)
	return prompt
end

local function createNPC(parent, onTalk)
	local current
	BakerAvatar.create(function(model)
		if not parent.Parent then
			model:Destroy()
			return
		end
		model.Name = Catalog.NPCName
		local pos = Catalog.NPCPosition
		model:PivotTo(CFrame.lookAt(Vector3.new(pos[1], pos[2] + 3, pos[3]), Vector3.new(0, pos[2] + 3, 0)))
		model.Parent = parent
		npcRoot = model:FindFirstChild("HumanoidRootPart")
		interaction(npcRoot, "Talk", Catalog.NPCName, onTalk)
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.StudsOffset, gui.MaxDistance = UDim2.fromOffset(180, 44), Vector3.new(0, 3.8, 0), 55
		gui.Parent = npcRoot
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.Font, label.TextSize = Catalog.NPCName .. "\nBakery jobs", Enum.Font.GothamBold, 16
		label.TextColor3, label.TextStrokeTransparency = cream, 0.25
		label.Parent = gui
		if current then current:Destroy() end
		current = model
	end)
	return current
end

local function createTreasure(parent, itemId, questIndex, onFound)
	local item = Catalog.Items[itemId]
	local model = Instance.new("Model")
	model.Name = item.Name
	model:SetAttribute("ChallengeItemId", itemId)
	model:SetAttribute("ChallengeQuestIndex", questIndex)
	model.Parent = parent
	local pos = item.Position
	local base = CFrame.new(pos[1], pos[2], pos[3]) * CFrame.Angles(0, math.rad(18 * questIndex), 0)
	local tint = rgb(item.Color)
	local function add(name, size, x, y, z, shade, shape, rotation, material)
		return piece(model, name, size, base * CFrame.new(x, y, z) * (rotation or CFrame.new()), shade or tint, shape, material)
	end
	local root = add("ItemRoot", Vector3.new(1, 1, 1), 0, 0, 0)
	root.Transparency = 1
	model.PrimaryPart = root
	local vertical = CFrame.Angles(0, 0, math.pi / 2)
	if item.Kind == "Spoon" then
		local handle = add("Polished Spoon Handle", Vector3.new(1.8, 0.18, 0.18), 0, 0, -0.65, tint, Enum.PartType.Cylinder, CFrame.Angles(0, math.pi / 2, 0), Enum.Material.Metal)
		handle.Reflectance = 0.3
		add("Spoon Bowl Base", Vector3.new(0.85, 0.1, 1.15), 0, 0, 0.8, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
		for index = 1, 16 do
			local angle = index * math.pi / 8
			local rim = add("Rounded Spoon Rim", Vector3.new(0.25, 0.14, 0.25), math.cos(angle) * 0.42, 0.07, 0.8 + math.sin(angle) * 0.56, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
			rim.Reflectance = 0.25
		end
	elseif item.Kind == "Cube" then
		add("Sugar Cube", Vector3.new(1.35, 1.35, 1.35), 0, 0, 0, Color3.fromRGB(250, 247, 235), nil, nil, Enum.Material.Sand)
		for index = 1, 28 do
			local x, z = math.sin(index * 19.7) * 0.59, math.cos(index * 11.3) * 0.59
			add("Fine Sugar Grain", Vector3.new(0.1, 0.07, 0.1), x, 0.69, z, cream, nil, CFrame.Angles(0, index, 0))
		end
	elseif item.Kind == "Whisk" then
		add("Rounded Pink Handle", Vector3.new(1.3, 0.34, 0.34), 0, 0, -0.7, tint, Enum.PartType.Cylinder, CFrame.Angles(0, math.pi / 2, 0))
		local silver = Color3.fromRGB(195, 209, 213)
		for loop = 0, 2 do
			local rotation = CFrame.Angles(0, 0, loop * math.pi / 3)
			for index = 1, 16 do
				local a, b = (index - 1) * math.pi / 8, index * math.pi / 8
				local p1 = rotation * Vector3.new(math.sin(a) * 0.44, 0, math.cos(a) * 0.8 + 0.65)
				local p2 = rotation * Vector3.new(math.sin(b) * 0.44, 0, math.cos(b) * 0.8 + 0.65)
				local wire = piece(model, "Curved Whisk Wire", Vector3.new(0.06, 0.06, (p2 - p1).Magnitude), base * CFrame.lookAt((p1 + p2) / 2, p2), silver, nil, Enum.Material.Metal)
				wire.Reflectance = 0.25
			end
		end
	elseif item.Kind == "RollingPin" then
		add("Rolling Pin Body", Vector3.new(2.2, 0.9, 0.9), 0, 0, 0, tint, Enum.PartType.Cylinder, nil, Enum.Material.Wood)
		for _, x in ipairs({ -1.45, 1.45 }) do add("Handle", Vector3.new(0.7, 0.35, 0.35), x, 0, 0, cocoa, Enum.PartType.Cylinder, nil, Enum.Material.Wood) end
	elseif item.Kind == "Tin" then
		add("Tin", Vector3.new(1.3, 1.7, 1.7), 0, 0, 0, tint, Enum.PartType.Cylinder, vertical, Enum.Material.Metal)
		add("Tin Lid", Vector3.new(0.16, 1.9, 1.9), 0, 0.72, 0, cream, Enum.PartType.Cylinder, vertical, Enum.Material.Metal)
		add("Cookie Emblem", Vector3.new(0.1, 0.65, 0.65), 0, 0.84, 0, Color3.fromRGB(202, 155, 98), Enum.PartType.Cylinder, vertical)
	elseif item.Kind == "Star" then
		for index = 0, 4 do
			add("Star Cutter Point", Vector3.new(0.32, 0.25, 1.6), 0, 0, 0, tint, nil, CFrame.Angles(0, math.rad(index * 72), 0), Enum.Material.Metal)
		end
	elseif item.Kind == "Jar" or item.Kind == "Bottle" then
		add("Bottle Body", Vector3.new(1.5, 1.25, 1.25), 0, 0, 0, tint, Enum.PartType.Cylinder, vertical)
		add("Cream Label", Vector3.new(0.8, 0.65, 0.1), 0, -0.05, 0.65, cream)
		add("Lid", Vector3.new(0.25, 0.9, 0.9), 0, 0.85, 0, cocoa, Enum.PartType.Cylinder, vertical)
		if item.Kind == "Jar" then
			for index, shade in ipairs({ tint, Color3.fromRGB(146, 184, 157), Color3.fromRGB(236, 191, 91) }) do
				add("Sprinkle", Vector3.new(0.1, 0.3, 0.1), (index - 2) * 0.24, 0, 0.72, shade, nil, CFrame.Angles(0, 0, index * 0.3))
			end
		end
	elseif item.Kind == "Mitten" then
		add("Oven Mitt", Vector3.new(1.4, 0.45, 2), 0, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Fabric)
		add("Thumb", Vector3.new(0.8, 0.4, 0.8), 0.7, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Fabric)
		add("Cuff", Vector3.new(1.25, 0.35, 0.35), 0, 0, -0.8, cream, nil, nil, Enum.Material.Fabric)
	elseif item.Kind == "Cup" then
		add("Cup", Vector3.new(1.4, 1.5, 1.3), 0, 0, 0)
		for index = 1, 3 do add("Measuring Mark", Vector3.new(index * 0.18 + 0.1, 0.07, 0.07), -0.3, index * 0.32 - 0.7, 0.67, cocoa) end
		add("Handle Top", Vector3.new(0.8, 0.16, 0.3), 1, 0.55, 0, cream)
		add("Handle Side", Vector3.new(0.16, 1.1, 0.3), 1.35, 0, 0, cream)
		add("Handle Bottom", Vector3.new(0.8, 0.16, 0.3), 1, -0.55, 0, cream)
	elseif item.Kind == "Book" then
		add("Book Cover", Vector3.new(2.1, 0.45, 1.65), 0, 0, 0)
		add("Pages", Vector3.new(1.9, 0.3, 1.5), 0, 0.08, 0, cream)
		add("Top Cover", Vector3.new(2.1, 0.08, 1.65), 0, 0.29, 0)
		add("Golden Bookmark", Vector3.new(0.3, 0.08, 1.8), 0.5, 0.35, 0, Color3.fromRGB(241, 193, 96))
	else
		add("Golden Chip", Vector3.new(1.6, 1.3, 1.6), 0, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
		add("Chocolate Tip", Vector3.new(0.7, 0.7, 0.7), 0, 0.65, 0, cocoa, Enum.PartType.Ball)
	end
	local light = Instance.new("PointLight")
	light.Name = "TreasureGlow"
	light.Color = cream
	light.Brightness = 0.15
	light.Range = 4
	light.Parent = root
	interaction(root, "Find", item.Name, function(player) onFound(player, itemId) end)
	return model
end

function ChallengeWorld.IsNearNPC(player)
	return aliveNear(player, npcRoot, 12)
end

function ChallengeWorld.create(parent, onTalk, onFound)
	local folder = Instance.new("Folder")
	folder.Name = "Challenges"
	folder.Parent = parent
	local npc = createNPC(folder, onTalk)
	local items = Instance.new("Folder")
	items.Name = "HiddenItems"
	items.Parent = folder
	for questIndex, quest in ipairs(Catalog.Challenges) do
		for _, itemId in ipairs(quest.Items) do createTreasure(items, itemId, questIndex, onFound) end
	end
	return { model = folder, npc = npc, npcRoot = npcRoot }
end

return ChallengeWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">CommerceServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("CookieTycoon")
local Catalog = require(shared.ShopCatalog)
local Rewards = require(shared.PurchaseRewards)
local Progression = require(shared.Progression)
local Commerce = {}
Commerce.__index = Commerce
local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local PENDING = Enum.ProductPurchaseDecision.NotProcessedYet

function Commerce:_state(player)
	local state = self.context.GetState(player)
	if not state or state.closing or state.profile.closed or state.profile.closing or state.profile.lost then return nil end
	if not state.profile.sessionOnly and os.time() >= state.profile.expiresAt then return nil end
	return state
end

function Commerce:_syncPerks(player, state)
	if self.context.GetState(player) ~= state or state.closing then return end
	player:SetAttribute("DoubleIncomeOwned", state.perks.DoubleIncome == true)
	player:SetAttribute("DoubleSpeedOwned", state.perks.DoubleSpeed == true)
	player:SetAttribute("ThirdCardSlotOwned", state.perks.ThirdCardSlot == true)
	player:SetAttribute("PassesReady", state.passesReady == true)
	state.nextBake = math.min(state.nextBake, os.clock() + Progression.interval(state.data, state.perks))
	self.context.Refresh(player, state)
end

function Commerce:RefreshPasses(player)
	local state = self:_state(player)
	if not state or state.checkingPasses then return end
	state.checkingPasses = true
	local allChecked = true
	-- Keep honoring owned passes even if their buttons are hidden from PassOrder.
	for key, configured in pairs(Catalog.Passes) do
		local offer = Catalog.resolve("Pass", configured.Id)
		if offer then
			local ok, owned
			for attempt = 1, 3 do
				ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
				if ok then break end
				if attempt < 3 then task.wait(attempt) end
				if self:_state(player) ~= state then break end
			end
			if self:_state(player) ~= state then
				state.checkingPasses = false
				return
			end
			if ok then
				-- Preserve a confirmed purchase if a cached ownership read is stale.
				state.perks[key] = state.perks[key] == true or owned == true
			else
				allChecked = false
				warn("Cookie Corner: could not check pass ownership for " .. player.UserId .. " (" .. key .. ").")
			end
		end
	end
	state.checkingPasses = false
	state.passesReady = allChecked
	self:_syncPerks(player, state)
	if not allChecked then
		task.delay(30, function() if self:_state(player) == state then self:RefreshPasses(player) end end)
	end
end

function Commerce:StartPlayer(player)
	local state = self:_state(player)
	if not state then return end
	player:SetAttribute("CommerceReady", not state.profile.sessionOnly)
	player:SetAttribute("PurchasePending", false)
	player:SetAttribute("ShopPromptOpen", false)
	task.spawn(function() self:RefreshPasses(player) end)
end

function Commerce:Prompt(player, kind, key)
	if (kind ~= "Pass" and kind ~= "Product") or type(key) ~= "string" then return end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly or state.profile.transacting or (state.receiptWorkers or 0) > 0 then return end
	if state.shopPrompt or os.clock() - (state.lastShopPrompt or -math.huge) < 3 then return end
	local offer = Catalog.offer(kind, key)
	if not offer then
		self.context.Notify(player, "This item is not available yet.")
		return
	end
	if kind == "Product" and offer.BoostTier and offer.BoostTier ~= state.data.boosts.paidTier + 1 then
		self.context.Notify(player, "Buy the next permanent income stage shown in the shop.")
		return
	end
	state.lastShopPrompt = os.clock()
	-- Set this before any yielding ownership request, preventing overlapping prompts.
	local prompt = { Kind = kind, Id = offer.Id }
	state.shopPrompt = prompt
	player:SetAttribute("ShopPromptOpen", true)
	local function cancel(message)
		if state.shopPrompt == prompt then state.shopPrompt = nil end
		player:SetAttribute("ShopPromptOpen", false)
		if message then self.context.Notify(player, message) end
	end
	if kind == "Pass" then
		local ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
		if self:_state(player) ~= state then
			cancel()
			return
		end
		if not ok then
			cancel("Ownership could not be checked. Please try again shortly.")
			return
		end
		if owned or state.perks[key] then
			state.perks[key] = true
			self:_syncPerks(player, state)
			cancel("You already own " .. offer.Name .. ".")
			return
		end
	else
		if offer.Cash and not Rewards.canFitCash(state.data, offer.Cash, Progression.MAX_CASH) then
			cancel("Spend some cookie cash before buying another bundle.")
			return
		end
		local receiptCount = 0
		for _ in pairs(state.profile.receipts) do receiptCount += 1 end
		if receiptCount >= Catalog.MaxPromptedReceipts then
			cancel("Cash bundles are unavailable for this bakery. Please contact the creator.")
			return
		end
	end
	if self:_state(player) ~= state or state.profile.transacting or (state.receiptWorkers or 0) > 0 then
		cancel()
		return
	end
	local ok = pcall(function()
		if kind == "Pass" then MarketplaceService:PromptGamePassPurchase(player, offer.Id)
		else MarketplaceService:PromptProductPurchase(player, offer.Id) end
	end)
	if not ok then cancel("Roblox could not open the purchase window. Please try again.") end
end

function Commerce:_fulfill(player, state, receipt, product)
	local attempt = 0
	while player.Parent == Players and not self.context.IsClosing() do
		if self:_state(player) ~= state or state.profile.sessionOnly then return PENDING end
		local ok, reason, detail = self.context.Profiles:GrantReceipt(state.profile, receipt.PurchaseId, receipt.ProductId, function(data)
			return Rewards.product(data, product, Progression.MAX_CASH)
		end)
		if ok then
			if self.context.GetState(player) == state and not state.closing then
				state.nextSave = os.clock() + self.context.AutosaveSeconds
				self.context.Refresh(player, state)
				if reason ~= "duplicate" then
					self.context.Notify(player, product.BoostTier and (2 ^ product.BoostTier .. "x permanent cookie income saved! Survives rebirth.")
						or "$" .. Progression.format(product.Cash) .. " cookie cash purchased and saved! Cash resets on rebirth.")
				end
			end
			return GRANTED -- The cash AND receipt ID are now durable in the same record.
		end
		if reason == "busy" then
			task.wait(0.2)
		elseif reason == "unavailable" then
			attempt += 1
			warn("Cookie Corner: purchase save pending for " .. player.UserId .. ": " .. tostring(detail or reason))
			if attempt == 1 then self.context.Notify(player, "Your purchase is waiting for saving to reconnect. Please wait.") end
			task.wait(math.min(10, attempt * 2))
		else
			warn("Cookie Corner: purchase not acknowledged for " .. player.UserId .. ": " .. tostring(reason))
			if reason == "lost" then
				player:Kick("Your purchase is pending on a newer bakery session. Rejoin to load it safely.")
			elseif reason == "capacity" then
				self.context.Notify(player, "Your cash bundle is pending. Spend some cash and rejoin to receive it.")
			end
			return PENDING
		end
	end
	return PENDING
end

function Commerce:ProcessReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then return PENDING end
	-- Roblox does not periodically retry NotProcessedYet. Wait for this join's
	-- profile load and retry transient save failures inside the callback itself.
	while self.context.IsLoading(player) and player.Parent == Players and not self.context.IsClosing() do task.wait(0.1) end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly then return PENDING end
	-- An already durable receipt remains acknowledgeable even after an offer is
	-- retired. New/ungranted receipts still need their original product mapping.
	if state.profile.receipts[receipt.PurchaseId] == receipt.ProductId then return GRANTED end
	local product = Catalog.resolve("Product", receipt.ProductId)
	if not product or not Catalog.validProduct(product) then
		warn("Cookie Corner: unconfigured product receipt " .. tostring(receipt.ProductId) .. "; it remains pending.")
		return PENDING
	end
	state.receiptWorkers = (state.receiptWorkers or 0) + 1
	player:SetAttribute("PurchasePending", true)
	player:SetAttribute("DataStatus", "PurchasePending")
	local ok, decision = pcall(function() return self:_fulfill(player, state, receipt, product) end)
	state.receiptWorkers -= 1
	if self.context.GetState(player) == state and not state.closing then
		local pending = state.profile.transacting or state.receiptWorkers > 0
		player:SetAttribute("PurchasePending", pending)
		player:SetAttribute("DataStatus", pending and "PurchasePending" or ok and "Saved" or "SaveFailed")
	end
	if not ok then
		warn("Cookie Corner receipt handler failed: " .. tostring(decision))
		return PENDING
	end
	return decision
end

function Commerce.start(context, requestPurchase, refreshPasses)
	local self = setmetatable({ context = context }, Commerce)
	-- This is the experience's only ProcessReceipt owner. Never grant products
	-- from PromptProductPurchaseFinished or a client-supplied success message.
	MarketplaceService.ProcessReceipt = function(receipt) return self:ProcessReceipt(receipt) end
	requestPurchase.OnServerEvent:Connect(function(player, kind, key) self:Prompt(player, kind, key) end)
	refreshPasses.OnServerEvent:Connect(function(player)
		local state = self:_state(player)
		if not state or os.clock() - (state.lastPassRefresh or -math.huge) < 10 then return end
		state.lastPassRefresh = os.clock()
		task.spawn(function() self:RefreshPasses(player) end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, wasPurchased)
		local state = self:_state(player)
		if not state then return end
		if state.shopPrompt and state.shopPrompt.Kind == "Pass" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
		local pass, key = Catalog.resolve("Pass", id)
		if wasPurchased and pass then
			-- This event is server-side: Roblox supplies the confirmed final outcome.
			state.perks[key] = true
			self:_syncPerks(player, state)
			context.Notify(player, pass.Name .. " unlocked! It stays through every rebirth.")
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, id)
		local player = Players:GetPlayerByUserId(userId)
		local state = player and self:_state(player)
		if state and state.shopPrompt and state.shopPrompt.Kind == "Product" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
	end)
	return self
end

return Commerce
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="43">
        <Properties>
          <string name="Name">ConveyorWorld</string>
          <string name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local Routing = require(ReplicatedStorage.CookieTycoon.ConveyorRouting)
local Conveyor = {}
local paths = Routing.paths()
local boundaryRails = Routing.rails(paths)
local surfaces = Routing.surfaces(paths)
local activePlots = {}
pcall(function() PhysicsService:RegisterCollisionGroup("CookieBodies") end)
PhysicsService:CollisionGroupSetCollidable("CookieBodies", "CookieBodies", false)

local function part(parent, name, size, frame, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.CFrame, object.Color = name, size, frame, tint
	object.Anchored = true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function line(parent, name, a, b, width, tint)
	local object = part(parent, name, Vector3.new(width, 0.06, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), tint)
	object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
	return object
end

local function text(target, value)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(600, 200)
	surface.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(63, 43, 31)
	label.Text = value
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = surface
end

local function decoration(object)
	object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
	return object
end

local function belt(plot, parent, size, frame, direction)
	local surface = part(parent, "Moving Belt", size, frame, Color3.fromRGB(53, 63, 69))
	surface.CustomPhysicalProperties = PhysicalProperties.new(1, 1, 0, 100, 1)
	surface.CanTouch = false
	surface:SetAttribute("Direction", direction)
	surface.AssemblyLinearVelocity = direction * Layout.CookieSpeed
	table.insert(plot.beltSurfaces, surface)
	return surface
end

local function rail(parent, a, b, joints)
	local center = (a + b) / 2
	local frame = CFrame.lookAt(center, b)
	local wall = part(parent, "Smooth Outer Rail", Vector3.new(Layout.RailThickness, Layout.RailHeight, (b - a).Magnitude + 0.05), frame, Color3.fromRGB(151, 169, 173))
	wall.Material = Enum.Material.Metal
	wall.CanTouch = false
	-- Low friction and rounded joints let a cookie slide past boundary contact.
	wall.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 1)
	for _, point in ipairs({ a, b }) do
		local key = string.format("%.3f/%.3f", point.X, point.Z)
		if joints[key] then continue end
		joints[key] = true
		local cap = part(parent, "Rounded Rail Joint", Vector3.new(Layout.RailHeight, Layout.RailThickness, Layout.RailThickness),
			CFrame.new(point) * CFrame.Angles(0, 0, math.pi / 2), wall.Color)
		cap.Shape, cap.Material, cap.CustomPhysicalProperties = Enum.PartType.Cylinder, wall.Material, wall.CustomPhysicalProperties
		cap.CanTouch = false
	end
	local trim = decoration(part(parent, "Rail Top Trim", Vector3.new(Layout.RailThickness + 0.08, 0.08, (b - a).Magnitude),
		frame + Vector3.new(0, Layout.RailHeight / 2, 0), Color3.fromRGB(199, 211, 211)))
	trim.Material = Enum.Material.Metal
end

function Conveyor.create(plot, position)
	plot.beltSurfaces = {}
	local model = Instance.new("Model")
	model.Name = "Merging Cookie Conveyors"
	model.Parent = plot.model
	plot.beltSpeed = Layout.CookieSpeed
	activePlots[plot] = true
	for _, section in ipairs(surfaces) do
		local center = position(plot, section.x, Layout.BeltTop - 0.3, section.z)
		local direction = Vector3.new(section.dx, 0, section.dz * plot.direction)
		if section.round then
			-- Flat infill closes both edges of every curve without a raised lip.
			local join = belt(plot, model, Vector3.new(0.6, section.width, section.width),
				CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), direction)
			join.Shape = Enum.PartType.Cylinder
		else
			belt(plot, model, Vector3.new(section.width, 0.6, section.length), CFrame.lookAt(center, center + direction), direction)
		end
	end
	for _, path in ipairs(paths) do
		for distance = 4, path[#path].s - 1, 10 do
			local point = Routing.pointAt(path, distance)
			-- One set of arrows on the shared outlet, all derived from flow.
			if point.z >= Layout.MainStartZ and path ~= paths[2] then continue end
			local center = position(plot, point.x, Layout.BeltTop + 0.035, point.z)
			local direction = Vector3.new(point.dx, 0, point.dz * plot.direction)
			local side = direction:Cross(Vector3.yAxis)
			local tip = center + direction * 0.8
			local back = center - direction * 0.5
			line(model, "Forward Arrow", tip, back + side * 0.5, 0.15, Color3.fromRGB(245, 204, 124))
			line(model, "Forward Arrow", tip, back - side * 0.5, 0.15, Color3.fromRGB(245, 204, 124))
		end
		for distance = 8, path[#path].s - 2, 18 do
			local point = Routing.pointAt(path, distance)
			local center = position(plot, point.x, (Layout.BeltTop - 0.8) / 2, point.z)
			decoration(part(model, "Recessed Conveyor Support", Vector3.new(6.2, Layout.BeltTop - 0.8, 0.7),
				CFrame.new(center), Color3.fromRGB(112, 133, 142)))
		end
	end
	local joints = {}
	for _, edge in ipairs(boundaryRails) do
		local y = Layout.BeltTop + Layout.RailHeight / 2 - 0.1
		rail(model, position(plot, edge.a.x, y, edge.a.z), position(plot, edge.b.x, y, edge.b.z), joints)
	end
	local center = position(plot, 0, 0, Layout.BoxZ)
	local wood = Color3.fromRGB(182, 133, 80)
	local box = Instance.new("Model")
	box.Name = "Cookie Collection Box"
	box.Parent = plot.model
	part(box, "Box Bottom", Vector3.new(12, 0.6, 14), CFrame.new(center + Vector3.new(0, 0.6, 0)), wood)
	for _, x in ipairs({ -6, 6 }) do
		part(box, "Box Side", Vector3.new(0.5, 3, 14), CFrame.new(center + Vector3.new(x, 2.2, 0)), wood)
	end
	for _, z in ipairs({ -7, 7 }) do
		local face = part(box, "Box End", Vector3.new(12, 3, 0.5), CFrame.new(center + Vector3.new(0, 2.2, z)), wood)
		text(face, "COOKIE DELIVERY")
	end
	local catch = part(box, "Cookie Catcher", Vector3.new(11, 1.8, 12), CFrame.new(center + Vector3.new(0, 1.6, 0)), wood)
	catch.Transparency, catch.CanCollide = 1, false
	catch.Touched:Connect(function(hit)
		local cookie = hit:FindFirstAncestorOfClass("Model")
		if cookie and plot.visuals[cookie] and not cookie:GetAttribute("Collected") then
			cookie:SetAttribute("Collected", true)
			-- Economy credit is computed once on the server's production clock;
			-- physics delivery never grants extra money from a touch event.
			Debris:AddItem(cookie, 0.7)
		end
	end)
	plot.conveyor = model
	plot.conveyorParts = {}
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			local localPos = p.Position - plot.origin
			local x, z = localPos.X, localPos.Z * plot.direction
			local tier = z > 110 and 1 or (x > 9 and 1 or (x < -9 and 3 or 2))
			table.insert(plot.conveyorParts, { part = p, tier = tier, transparency = p.Transparency, collision = p.CanCollide, query = p.CanQuery })
		end
	end
	plot.deliveryBox = box
end

function Conveyor.update(plot, interval)
	local tier = plot.data and plot.data.life.belt or 0
	for _, item in ipairs(plot.conveyorParts or {}) do
		local visible = tier >= item.tier
		item.part.Transparency, item.part.CanCollide, item.part.CanQuery = visible and item.transparency or 1, visible and item.collision or false, visible and item.query or false
	end
	if plot.deliveryBox then plot.deliveryBox.Parent = tier > 0 and plot.model or nil end
	plot.beltSpeed = Layout.speed(interval)
	for _, surface in ipairs(plot.beltSurfaces) do
		surface.AssemblyLinearVelocity = surface:GetAttribute("Direction") * plot.beltSpeed
	end
end

function Conveyor.makePhysical(model)
	local pivot = model:GetPivot()
	local hull = Instance.new("Part")
	hull.Name = "Cookie Collision Body"
	hull.Shape = Enum.PartType.Cylinder
	hull.Size = Vector3.new(0.52, Layout.CookieRadius * 2, Layout.CookieRadius * 2)
	hull.CFrame = pivot * CFrame.Angles(0, 0, math.pi / 2)
	hull.Transparency = 1
	hull.CanCollide, hull.CanTouch, hull.CanQuery = true, true, true
	hull.CollisionGroup = "CookieBodies"
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.35, 0.35, 0, 10, 1)
	hull.Parent = model
	for _, piece in ipairs(model:GetDescendants()) do
		if piece:IsA("BasePart") and piece ~= hull then
			piece.CanCollide, piece.CanTouch, piece.Massless = false, false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = hull, piece, hull
			piece.Anchored = false
		end
	end
	model.PrimaryPart = hull
	hull.Anchored = false
	hull:SetNetworkOwner(nil)
	local attachment = Instance.new("Attachment")
	attachment.Parent = hull
	local upright = Instance.new("AlignOrientation")
	upright.Name, upright.Mode = "Keep Cookie Flat", Enum.OrientationAlignmentMode.OneAttachment
	upright.Attachment0, upright.CFrame = attachment, hull.CFrame.Rotation
	upright.MaxTorque, upright.MaxAngularVelocity, upright.Responsiveness = 10000, 20, 25
	upright.Parent = hull
	Debris:AddItem(model, 30)
	return hull
end

function Conveyor.track(plot, model, hull, lane)
	plot.visuals[model] = { hull = hull, lane = lane, progress = 0 }
end

-- Physical assemblies remain collidable and unanchored. Gentle server-side
-- steering supplies reliable drive through merges instead of relying on two
-- competing contact velocities to choose the cookie's next direction.
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.05 then return end
	local alpha = 1 - math.exp(-12 * math.min(elapsed, 0.2))
	elapsed = 0
	for plot in pairs(activePlots) do
		if not plot.model.Parent then
			activePlots[plot] = nil
			continue
		end
		for model, state in pairs(plot.visuals) do
			if not model.Parent then
				plot.visuals[model] = nil
				continue
			end
			if type(state) ~= "table" or model:GetAttribute("Collected") then continue end
			local hull = state.hull
			if not hull.Parent then
				model:Destroy()
				plot.visuals[model] = nil
				continue
			end
			local p = hull.Position - plot.origin
			if Conveyor.OnProcess then Conveyor.OnProcess(plot, model, p.Z * plot.direction) end
			if p.Y < Layout.BeltTop - 0.1 or p.Y > Layout.BeltTop + 1.1 then continue end
			local drive = Routing.drive(paths[state.lane], p.X * (plot.mirrorX or 1), p.Z * plot.direction, state.progress, plot.beltSpeed)
			if drive then
				state.progress = drive.s
				local current = hull.AssemblyLinearVelocity
				local target = Vector3.new(drive.vx * (plot.mirrorX or 1), current.Y, drive.vz * plot.direction)
				hull.AssemblyLinearVelocity = current:Lerp(target, alpha)
			end
		end
	end
end)

return Conveyor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">CookieAppearance</string>
          <string name="Source"><![CDATA[local Life = require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryLife)
local Recipes = require(game:GetService("ReplicatedStorage").CookieTycoon.Recipes)
local Polish = require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryPolish)
local Appearance = {}
function Appearance.clear(state)
	for part, color in pairs(state.foodColors or {}) do if part.Parent then part.Color = color end end
	for _, gui in ipairs(state.foodPatterns or {}) do gui:Destroy() end
	state.foodColors, state.foodPatterns, state.foodKey = {}, {}, nil
end
function Appearance.step(player, state)
	local char = player.Character
	local hum, root = char and char:FindFirstChildOfClass("Humanoid"), char and char:FindFirstChild("HumanoidRootPart")
	if not hum or not root then return end
	local buff = state.data.life.buff
	local active = (buff.expires or 0) > os.time()
	local key = active and (tostring(char) .. ":" .. buff.seed .. ":" .. buff.expires) or nil
	if state.foodCharacter ~= char then Appearance.clear(state) ; state.foodCharacter = char end
	if state.foodKey ~= key then
		Appearance.clear(state)
		state.foodKey = key
		if active then
			local recipe = Recipes[buff.recipe]
			local random = Random.new(buff.seed)
			local tint = Color3.fromRGB(table.unpack(recipe.Color)):Lerp(Color3.fromHSV(random:NextNumber(), 0.35, 1), 0.18)
			for _, part in ipairs(char:GetChildren()) do
				if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
					state.foodColors[part] = part.Color
					part.Color = tint
					for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
						local gui = Instance.new("SurfaceGui")
						gui.Name, gui.Face, gui.CanvasSize, gui.LightInfluence, gui.Parent = "Cookie Skin Chips", face, Vector2.new(64, 64), 1, part
						table.insert(state.foodPatterns, gui)
						for _ = 1, 7 do
							local dot = Instance.new("Frame")
							dot.Size, dot.Position, dot.BackgroundColor3, dot.BorderSizePixel, dot.Parent = UDim2.fromOffset(7, 7), UDim2.fromOffset(random:NextInteger(1, 55), random:NextInteger(1, 55)), Color3.fromRGB(table.unpack(recipe.Accent)), 0, gui
							local corner = Instance.new("UICorner")
							corner.CornerRadius, corner.Parent = UDim.new(1, 0), dot
						end
					end
				end
			end
		end
	end
	local effect = Polish.active(state.data.life, os.time())
	if state.buffHumanoid ~= hum then
		state.buffHumanoid, state.originalJumpHeight, state.originalJumpPower = hum, hum.JumpHeight, hum.JumpPower
	end
	hum.JumpHeight, hum.JumpPower = state.originalJumpHeight + effect.Jump, state.originalJumpPower + effect.Jump * 3
	if active and hum.Health > 0 then hum.Health = math.min(hum.MaxHealth, hum.Health + effect.Regen * math.min(0.5, os.clock() - (state.regenAt or os.clock()))) end
	state.regenAt = os.clock()
	player:SetAttribute("CookieBuffName", active and effect.Name or "")
	local road = math.abs(root.Position.X) < 13 and math.abs(root.Position.Z) < 575 and root.Position.Y < 8
	hum.WalkSpeed = (road and 34 or 16) + Life.speed(state.data.life, os.time())
	player:SetAttribute("OnFastRoad", road)
end
return Appearance
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">CookieCustomers</string>
          <string name="Source"><![CDATA[local Avatar = require(script.Parent.BakerAvatar)
local W = require(script.Parent.WorldWidgets)
local Polish = require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryPolish)
local Style = require(script.Parent.CustomerStyle)
local Customers = {}
local physics = game:GetService("PhysicsService")
pcall(function() physics:RegisterCollisionGroup("CookieCustomers") end)
physics:CollisionGroupSetCollidable("CookieCustomers", "CookieCustomers", false)
function Customers.create(world, offer)
	local result, random = {}, Random.new()
	for index, name in ipairs({ "Coco", "Hazel", "Maple", "Chip", "Ginger", "Almond" }) do
		local customer = { id = index, name = name, reservedUntil = 0, traits = Polish.customer(random:NextNumber(), random:NextNumber(), random:NextNumber()) }
		table.insert(result, customer)
		Avatar.create(function(model)
			local previous = customer.model
			local position = customer.root and customer.root.Position or Vector3.new((index % 2 == 0 and -6 or 6), 3, (index - 3) * 90)
			model.Name, model.Parent = "Customer " .. name, world
			model:PivotTo(CFrame.new(position))
			local hum, root = model:FindFirstChildOfClass("Humanoid"), model:FindFirstChild("HumanoidRootPart")
			for _, part in ipairs(model:GetDescendants()) do
				if part:IsA("BasePart") then
					part.Anchored = false
					part.CollisionGroup = "CookieCustomers"
					part.CanCollide = part.Name == "Torso"
				end
			end
			for _, part in ipairs(model:GetChildren()) do if part.Name:find("Chef") or part.Name:find("Apron") then part:Destroy() end end
			hum.WalkSpeed = 8
			Style.apply(model, random)
			model:PivotTo(CFrame.new(position))
			model:SetAttribute("Personality", customer.traits.Style)
			model:SetAttribute("FavoriteCookie", customer.traits.Favorite)
			model:SetAttribute("Patience", customer.traits.Patience)
			root:SetNetworkOwner(nil)
			customer.model, customer.root, customer.humanoid = model, root, hum
			customer.joints = {}
			for _, joint in ipairs(model:GetDescendants()) do
				if joint:IsA("Motor6D") and (joint.Name:find("Hip") or joint.Name:find("Shoulder")) then table.insert(customer.joints, { joint = joint, original = joint.C0, sign = joint.Name:find("Left") and 1 or -1 }) end
			end
			customer.label = W.label(root, name .. " • " .. customer.traits.Style .. "\nCookie customer", 40)
			W.prompt(root, "Offer held cookie", 0.2, function(player) offer(player, customer) end)
			if previous then previous:Destroy() end
		end)
		task.spawn(function()
			local target, deadline
			while world.Parent do
				if customer.root and customer.model.Parent then
					if customer.reservedUntil > os.clock() then customer.humanoid:MoveTo(customer.root.Position)
					elseif customer.depart or not target or (customer.root.Position - target).Magnitude < 5 or os.clock() >= deadline then
						if customer.depart then
							customer.traits = Polish.customer(random:NextNumber(), random:NextNumber(), random:NextNumber())
							customer.model:SetAttribute("Personality", customer.traits.Style)
							customer.model:SetAttribute("FavoriteCookie", customer.traits.Favorite)
							customer.model:SetAttribute("Patience", customer.traits.Patience)
						end
						customer.depart = false
						target, deadline = Vector3.new((index % 2 == 0 and -6 or 6), 1, math.random(-480, 480)), os.clock() + 12
						customer.humanoid:MoveTo(target)
						customer.label.Text = name .. " • " .. customer.traits.Style .. "\nCookie customer"
					end
					local swing = customer.root.AssemblyLinearVelocity.Magnitude > 1 and math.sin(os.clock() * 8) * 0.3 or 0
					for _, entry in ipairs(customer.joints) do if entry.joint.Parent then entry.joint.C0 = entry.original * CFrame.Angles(swing * entry.sign, 0, 0) end end
				end
				task.wait(0.1)
			end
		end)
	end
	return result
end
return Customers
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">CookiePackaging</string>
          <string name="Source"><![CDATA[local Packaging = {}
local function piece(model, root, name, size, offset, color, transparency)
	local p = Instance.new("Part")
	p.Name, p.Size, p.CFrame, p.Color = name, size, CFrame.new(root.Position + offset), color
	p.Transparency, p.CanCollide, p.CanTouch, p.CanQuery, p.Massless, p.Parent = transparency or 0, false, false, false, true, model
	local weld = Instance.new("WeldConstraint")
	weld.Part0, weld.Part1, weld.Parent = root, p, p
	return p
end
function Packaging.wrap(model, root, scale)
	if model:FindFirstChild("Cookie Wrapper") then return end
	local s = scale or 1
	local p = piece(model, root, "Cookie Wrapper", Vector3.new(4.1, 0.7, 4.1) * s, Vector3.zero, Color3.fromRGB(220, 243, 241), 0.72)
	p.Material = Enum.Material.Glass
end
function Packaging.box(model, root, scale)
	if model:FindFirstChild("Cookie Box Base") then return end
	local s, color = scale or 1, Color3.fromRGB(192, 150, 94)
	piece(model, root, "Cookie Box Base", Vector3.new(4.8, 0.12, 4.8) * s, Vector3.new(0, -0.3, 0) * s, color)
	for _, x in ipairs({ -2.35, 2.35 }) do piece(model, root, "Cookie Box Wall", Vector3.new(0.12, 0.8, 4.8) * s, Vector3.new(x, 0.1, 0) * s, color) end
	for _, z in ipairs({ -2.35, 2.35 }) do piece(model, root, "Cookie Box Wall", Vector3.new(4.8, 0.8, 0.12) * s, Vector3.new(0, 0.1, z) * s, color) end
end
return Packaging
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">CookieTools</string>
          <string name="Source"><![CDATA[local Assets = require(script.Parent.AssetLibrary)
local Packaging = require(script.Parent.CookiePackaging)
local Life = require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryLife)
local Tools = {}
local pinStyles = {
	{ Length = 3.2, Diameter = .72, Body = Color3.fromRGB(204, 158, 99), Material = Enum.Material.Wood, Grip = Color3.fromRGB(111, 69, 40), Trim = Color3.fromRGB(154, 99, 54) },
	{ Length = 3.4, Diameter = .84, Body = Color3.fromRGB(114, 67, 39), Material = Enum.Material.Wood, Grip = Color3.fromRGB(73, 45, 32), Trim = Color3.fromRGB(212, 127, 75) },
	{ Length = 3.5, Diameter = .94, Body = Color3.fromRGB(182, 202, 211), Material = Enum.Material.Metal, Grip = Color3.fromRGB(48, 66, 78), Trim = Color3.fromRGB(88, 119, 139) },
	{ Length = 3.6, Diameter = 1.02, Body = Color3.fromRGB(241, 227, 198), Material = Enum.Material.Marble, Grip = Color3.fromRGB(75, 107, 89), Trim = Color3.fromRGB(242, 189, 74) },
	{ Length = 3.8, Diameter = 1.12, Body = Color3.fromRGB(79, 58, 148), Material = Enum.Material.Glass, Grip = Color3.fromRGB(39, 41, 83), Trim = Color3.fromRGB(115, 235, 250) },
}

local function pinModel(tool, level)
	local style = pinStyles[level]
	local handle
	local function piece(name, size, cf, tint, material, shape)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color = name, size, cf, tint
		p.Shape, p.Material = shape or Enum.PartType.Cylinder, material or Enum.Material.Metal
		p.CanCollide, p.CanTouch, p.CanQuery, p.Massless = false, false, false, true
		p.TopSurface, p.BottomSurface, p.Parent = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth, tool
		if handle then
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = handle, p, p
		end
		return p
	end
	-- The actual held handle sits at the end, so the barrel extends out of the
	-- player's hand. All decorative parts share one non-colliding welded assembly.
	handle = piece("Handle", Vector3.new(.9, .32, .32), CFrame.new(), style.Grip, level == 3 and Enum.Material.DiamondPlate or Enum.Material.Wood)
	local centerX = -.55 - style.Length / 2
	local farX = -style.Length - 1.1
	piece("Turned End Grip", Vector3.new(.9, .32, .32), CFrame.new(farX, 0, 0), style.Grip, handle.Material)
	piece(Life.PinNames[level] .. " Barrel", Vector3.new(style.Length, style.Diameter, style.Diameter), CFrame.new(centerX, 0, 0), style.Body, style.Material)
	for _, x in ipairs({ -.53, -style.Length - .57 }) do
		piece("Barrel End Cap", Vector3.new(.15, style.Diameter * .9, style.Diameter * .9), CFrame.new(x, 0, 0), style.Trim, level == 1 and Enum.Material.Wood or Enum.Material.Metal)
	end
	for _, x in ipairs({ 0, farX }) do
		for band = -1, 1 do
			piece("Turned Grip Ring", Vector3.new(.06, .36, .36), CFrame.new(x + band * .22, 0, 0), style.Trim, level >= 4 and Enum.Material.Metal or handle.Material)
		end
		piece("Grip Pommel", Vector3.new(.18, .42, .42), CFrame.new(x + (x == 0 and .49 or -.49), 0, 0), style.Trim, level == 5 and Enum.Material.Neon or Enum.Material.Metal)
	end
	if level == 1 then
		-- Warm wood grain and thin turned grooves keep the starter handmade.
		for _, offset in ipairs({ -.95, .95 }) do
			piece("Maple Turning Groove", Vector3.new(.045, .735, .735), CFrame.new(centerX + offset, 0, 0), style.Trim, Enum.Material.Wood)
		end
	elseif level == 2 then
		for _, offset in ipairs({ -1.25, 0, 1.25 }) do
			piece("Hammered Copper Band", Vector3.new(.2, .9, .9), CFrame.new(centerX + offset, 0, 0), style.Trim, Enum.Material.CorrodedMetal)
		end
	elseif level == 3 then
		for _, offset in ipairs({ -1.35, 1.35 }) do
			piece("Steel Reinforcement Collar", Vector3.new(.3, 1.06, 1.06), CFrame.new(centerX + offset, 0, 0), style.Trim, Enum.Material.DiamondPlate)
		end
		for index = 1, 8 do
			local angle = index / 8 * math.pi * 2
			piece("Steel Barrel Flute", Vector3.new(2.3, .07, .07), CFrame.new(centerX, math.cos(angle) * .47, math.sin(angle) * .47), Color3.fromRGB(110, 140, 157), Enum.Material.Metal, Enum.PartType.Block)
		end
	elseif level == 4 then
		for _, offset in ipairs({ -1.4, -1.15, 1.15, 1.4 }) do
			piece("Gilded Marble Band", Vector3.new(.09, 1.08, 1.08), CFrame.new(centerX + offset, 0, 0), style.Trim)
		end
		for index = 1, 6 do
			local angle = index / 6 * math.pi * 2
			local crest = piece("Golden Cookie Crest", Vector3.new(.4, .08, .4), CFrame.new(centerX, math.cos(angle) * .53, math.sin(angle) * .53) * CFrame.Angles(angle, 0, 0), style.Trim, Enum.Material.Metal, Enum.PartType.Block)
			crest.CFrame *= CFrame.Angles(0, math.pi / 4, 0)
		end
	else
		for index = 1, 8 do
			local angle = index / 8 * math.pi * 2
			piece("Starforged Crystal Facet", Vector3.new(3.45, .14, .4), CFrame.new(centerX, math.cos(angle) * .52, math.sin(angle) * .52) * CFrame.Angles(angle, 0, 0), index % 2 == 0 and Color3.fromRGB(148, 116, 224) or style.Body, Enum.Material.Glass, Enum.PartType.Block)
		end
		for _, offset in ipairs({ -1.65, 0, 1.65 }) do
			piece("Starforged Luminous Seal", Vector3.new(.07, 1.18, 1.18), CFrame.new(centerX + offset, 0, 0), style.Trim, Enum.Material.Neon)
		end
	end
	return handle
end

function Tools.pin(player, level, onSwing)
	local tool = Instance.new("Tool")
	tool.Name, tool.CanBeDropped = Life.PinNames[level] .. " Rolling Pin", false
	tool.ToolTip = "Tier " .. level .. "/5 • Left-click to mine or swing in Cookie Hill"
	tool:SetAttribute("RollingPinTier", level)
	pinModel(tool, level)
	tool.Grip = CFrame.Angles(0, 0, math.pi / 2)
	local idle, swinging = tool.Grip, false
	tool.Activated:Connect(function()
		if swinging or tool.Parent ~= player.Character then return end
		swinging = true
		local tween = game:GetService("TweenService")
		tween:Create(tool, TweenInfo.new(0.1), { Grip = idle * CFrame.Angles(-1.1, 0, 0) }):Play()
		task.delay(0.1, function()
			if tool.Parent == player.Character then
				tween:Create(tool, TweenInfo.new(0.12), { Grip = idle * CFrame.Angles(0.9, 0, 0) }):Play()
				onSwing()
			end
		end)
		task.delay(0.3, function() if tool.Parent then tween:Create(tool, TweenInfo.new(0.12), { Grip = idle }):Play() end end)
		task.delay(0.5, function() swinging = false end)
	end)
	tool.Parent = player:FindFirstChildOfClass("Backpack")
	return tool
end
function Tools.bag(player, onOpen)
	local tool = Instance.new("Tool")
	tool.Name, tool.ToolTip, tool.RequiresHandle, tool.CanBeDropped = "Cookie Bag", "Open your cookie inventory", false, false
	tool:SetAttribute("CookieBag", true)
	tool.Equipped:Connect(function()
		onOpen()
		task.defer(function()
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if hum and tool.Parent == player.Character then hum:UnequipTools() end
		end)
	end)
	tool.Parent = player:FindFirstChildOfClass("Backpack")
	return tool
end
function Tools.cookie(player, cookie, onHeld, onEat)
	local tool = Instance.new("Tool")
	tool.Name, tool.CanBeDropped = "Cookie: " .. require(game:GetService("ReplicatedStorage").CookieTycoon.Recipes)[cookie.recipe].Name, false
	tool:SetAttribute("InventoryCookieId", cookie.id)
	local handle = Instance.new("Part")
	handle.Name, handle.Size, handle.Transparency, handle.CanCollide, handle.Massless, handle.Parent = "Handle", Vector3.new(0.3, 0.3, 0.3), 1, false, true, tool
	local flags = require(game:GetService("ReplicatedStorage").CookieTycoon.CookieCrafting).decode(cookie.mask)
	local model = Assets.cookie(cookie.recipe, tool, CFrame.new(), flags)
	model:ScaleTo(0.6)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			part.Anchored, part.CanCollide, part.CanTouch, part.Massless = false, false, false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = handle, part, handle
		end
	end
	if cookie.wrapped then Packaging.wrap(model, handle, 0.6) end
	if cookie.boxed then Packaging.box(model, handle, 0.6) end
	tool.Equipped:Connect(function() onHeld(cookie.id) end)
	tool.Unequipped:Connect(function() onHeld(nil) end)
	tool.Activated:Connect(onEat)
	tool.Parent = player:FindFirstChildOfClass("Backpack")
	local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if humanoid then humanoid:EquipTool(tool) end
	return tool
end
return Tools
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">CookieTrades</string>
          <string name="Source"><![CDATA[-- Durable two-profile exchange. The immutable journal decides ownership; both
-- profiles retain a recovery reference before the journal can commit.
local Life = if script then require(game:GetService("ReplicatedStorage").CookieTycoon.BakeryLife) else require("../shared/BakeryLife")
local Trades = {}
Trades.__index = Trades
function Trades.new(store, profiles, wait)
	return setmetatable({ store = store, profiles = profiles, wait = wait }, Trades)
end
function Trades:_journal(id, transform)
	for attempt = 1, 3 do
		local ok, result = pcall(function() return self.store:UpdateAsync("Trade_" .. id, transform) end)
		if ok then return result end
		if attempt < 3 then self.wait(attempt) end
	end
	return nil
end
function Trades.apply(data, record, userId)
	if userId ~= record.a and userId ~= record.b then return false, "invalid_participant" end
	if data.life.pendingTrade ~= "" and data.life.pendingTrade ~= record.id then return false, "conflict" end
	if record.state == "Committed" then
		local outgoing, incoming
		if userId == record.a then outgoing, incoming = record.giveA, record.giveB
		elseif userId == record.b then outgoing, incoming = record.giveB, record.giveA
		else return false, "invalid_participant" end
		if outgoing and not Life.find(data.life, outgoing.id) then return false, "missing_cookie" end
		if incoming and not Life.cookie(incoming) then return false, "invalid_cookie" end
		if incoming and Life.find(data.life, incoming.id) then return false, "duplicate_cookie" end
		local finalCount = #data.life.inventory - (outgoing and 1 or 0) + (incoming and 1 or 0)
		if finalCount > Life.capacity(data.life) then return false, "capacity" end
		if outgoing then Life.remove(data.life, outgoing.id) end
		if incoming then table.insert(data.life.inventory, Life.cookie(incoming)) end
	elseif record.state ~= "Aborted" then return false, "undecided" end
	data.life.pendingTrade = ""
	return true
end
function Trades:_grant(profile, key, grant, token)
	for _ = 1, 5 do
		local ok, reason = self.profiles:GrantReceipt(profile, key, 1, grant, token)
		if ok then return true end
		if reason ~= "unavailable" and reason ~= "busy" then return false end
		self.wait(0.5)
	end
	return false
end
function Trades:Recover(profile, userId, forcedId)
	local id = forcedId or profile.data.life.pendingTrade
	if not id or id == "" then return true end
	profile.activityLock = id
	local record = self:_journal(id, function(current)
		if not current then return nil end
		if current.state == "Prepared" then current.state = "Aborted" end
		return current
	end)
	if not record or (record.a ~= userId and record.b ~= userId) then return false end
	local prepareKey = "ct:p:" .. id .. ":" .. userId
	if profile.pendingReceipt and profile.pendingReceipt.Id == prepareKey then
		if not self:_grant(profile, prepareKey, function(data) data.life.pendingTrade = id ; return true end, id) then return false end
	end
	local ok = self:_grant(profile, "ct:a:" .. id .. ":" .. userId, function(data) return Trades.apply(data, record, userId) end, id)
	if ok then profile.activityLock = nil end
	return ok
end
function Trades:Exchange(id, a, aId, aCookieId, b, bId, bCookieId)
	if a.sessionOnly or b.sessionOnly then return false, "Cookie trading needs persistent saves in a published game.", false end
	for _, profile in ipairs({ a, b }) do
		if profile.sessionOnly or profile.closed or profile.closing or profile.lost or profile.saving or profile.transacting
			or profile.activityLock or profile.data.life.pendingTrade ~= "" then return false, "Player saving is busy; try again.", false end
	end
	if aId == bId or not Life.available(a.data.life, aCookieId)
		or (bCookieId and not Life.available(b.data.life, bCookieId)) then return false, "Cookie offer changed.", false end
	if not bCookieId and #b.data.life.inventory >= Life.capacity(b.data.life) then return false, "Their cookie bag is full.", false end
	local record = { id = id, state = "Prepared", a = aId, b = bId,
		giveA = Life.cookie(Life.find(a.data.life, aCookieId)), giveB = bCookieId and Life.cookie(Life.find(b.data.life, bCookieId)) or nil }
	a.activityLock, b.activityLock = id, id
	local created = self:_journal(id, function(current) return current or record end)
	if not created then
		a.activityLock, b.activityLock = nil, nil -- No profile was modified or prepared.
		return false, "Trade saving is unavailable. Nothing was exchanged.", false
	end
	if created.state ~= "Prepared" or created.a ~= aId or created.b ~= bId
		or not created.giveA or created.giveA.id ~= record.giveA.id
		or (created.giveB and created.giveB.id or nil) ~= (record.giveB and record.giveB.id or nil) then
		a.activityLock, b.activityLock = nil, nil
		return false, "Trade reference conflict. Nothing was exchanged.", false
	end
	local prepared = true
	for _, side in ipairs({ { a, aId }, { b, bId } }) do
		if not self:_grant(side[1], "ct:p:" .. id .. ":" .. side[2], function(data) data.life.pendingTrade = id ; return true end, id) then prepared = false ; break end
	end
	local decided = self:_journal(id, function(current)
		if not current then return nil end
		if current.state == "Prepared" then current.state = prepared and "Committed" or "Aborted" end
		return current
	end)
	if not decided then return false, "Trade recovery pending. Your cookies are protected; please wait.", true end
	local recoveredA, recoveredB = self:Recover(a, aId, id), self:Recover(b, bId, id)
	if not recoveredA or not recoveredB then return false, "Trade recovery pending. Please wait or rejoin to recover.", true end
	return decided.state == "Committed", decided.state == "Committed" and "Cookie exchange saved!" or "Trade canceled; both offers were kept.", false
end
return Trades
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="49">
        <Properties>
          <string name="Name">CustomerStyle</string>
          <string name="Source"><![CDATA[-- Original accessories on standard Roblox rigs; no external catalog dependencies.
local Style = {}
function Style.apply(model, random)
	local skin = ({ Color3.fromRGB(239, 196, 154), Color3.fromRGB(161, 105, 72), Color3.fromRGB(111, 72, 52), Color3.fromRGB(250, 218, 183) })[random:NextInteger(1, 4)]
	local shirt, trousers = Color3.fromHSV(random:NextNumber(), 0.35, 0.7), Color3.fromHSV(random:NextNumber(), 0.18, 0.3)
	for _, part in ipairs(model:GetChildren()) do
		if part:IsA("BasePart") and part.Name ~= "HumanoidRootPart" then
			part.Color = part.Name:find("Leg") and trousers or (part.Name == "Torso" and shirt or skin)
		end
	end
	local function accessory(name, anchor, size, offset, color, shape, material)
		local p = Instance.new("Part")
		p.Name, p.Size, p.CFrame, p.Color, p.Shape, p.Material = name, size, anchor.CFrame * offset, color, shape or Enum.PartType.Block, material or Enum.Material.SmoothPlastic
		p.CanCollide, p.CanTouch, p.Massless, p.Parent = false, false, true, model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = anchor, p, p
		return p
	end
	local head, torso = model.Head, model.Torso
	local hair = Color3.fromHSV(random:NextNumber(0.04, 0.12), random:NextNumber(0.2, 0.7), random:NextNumber(0.15, 0.5))
	local kind = random:NextInteger(1, 4)
	local cap = accessory("Hair Cap", head, Vector3.new(2.05, 0.6, 1.08), CFrame.new(0, 0.45, 0), hair, Enum.PartType.Ball)
	if kind == 1 then
		accessory("Cap Brim", head, Vector3.new(2.1, 0.12, 0.8), CFrame.new(0, 0.55, -0.7), shirt)
		cap.Color = shirt
	elseif kind == 2 then
		for _, x in ipairs({ -0.8, 0.8 }) do accessory("Side Hair", head, Vector3.new(0.35, 1.2, 0.8), CFrame.new(x, 0, 0.1), hair, Enum.PartType.Ball) end
	elseif kind == 3 then
		for i = 1, 3 do accessory("Swept Hair", head, Vector3.new(0.6, 0.35, 0.5), CFrame.new((i - 2) * 0.5, 0.63, -0.35) * CFrame.Angles(0, 0, 0.2), hair, Enum.PartType.Ball) end
	end
	if random:NextNumber() < 0.45 then
		for _, x in ipairs({ -0.43, 0.43 }) do
			local glass = accessory("Glasses", head, Vector3.new(0.65, 0.35, 0.09), CFrame.new(x, 0.12, -0.57), Color3.fromRGB(54, 62, 68), nil, Enum.Material.Glass)
			glass.Transparency = 0.35
		end
		accessory("Glasses Bridge", head, Vector3.new(0.3, 0.06, 0.1), CFrame.new(0, 0.12, -0.6), Color3.fromRGB(68, 57, 46))
	end
	accessory("Jacket Collar", torso, Vector3.new(1.6, 0.18, 0.12), CFrame.new(0, 0.8, -0.55), Color3.fromRGB(239, 232, 213))
	for i = 1, 3 do accessory("Jacket Button", torso, Vector3.new(0.12, 0.12, 0.08), CFrame.new(0, 0.5 - i * 0.4, -0.56), Color3.fromRGB(217, 191, 119), Enum.PartType.Ball) end
	for _, side in ipairs({ "Left", "Right" }) do accessory("Shoe", model[side .. " Leg"], Vector3.new(1.04, 0.3, 1.15), CFrame.new(0, -0.85, -0.04), Color3.fromRGB(65, 48, 42)) end
	model:ScaleTo(random:NextNumber(0.9, 1.1))
end
return Style
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="50">
        <Properties>
          <string name="Name">DoughCave</string>
          <string name="Source"><![CDATA[local W = require(script.Parent.WorldWidgets)
local Cave = {}
function Cave.create(parent)
	local stone, dark = Color3.fromRGB(89, 79, 73), Color3.fromRGB(57, 51, 50)
	local function rock(name, size, pos, angle)
		local p = Instance.new("WedgePart")
		p.Name, p.Size, p.CFrame, p.Color, p.Material = name, size, CFrame.new(pos) * CFrame.Angles(0, angle or 0, 0), stone, Enum.Material.Slate
		p.Anchored, p.Parent = true, parent
		return p
	end
	W.part(parent, "Cave Floor", Vector3.new(135, 1, 166), Vector3.new(-320, 0, 108), dark, Enum.Material.Rock)
	W.part(parent, "Cave Ceiling", Vector3.new(135, 8, 166), Vector3.new(-320, 26, 108), stone, Enum.Material.Slate)
	W.part(parent, "Cave Back Wall", Vector3.new(9, 32, 166), Vector3.new(-387, 13, 108), stone, Enum.Material.Rock)
	for _, z in ipairs({ 25, 191 }) do
		W.part(parent, "Cave Side Wall", Vector3.new(135, 32, 9), Vector3.new(-320, 13, z), stone, Enum.Material.Rock)
		for i = 1, 7 do rock("Faceted Cave Buttress", Vector3.new(17, 24 + i % 3 * 4, 16), Vector3.new(-260 - i * 17, 12, z + (z < 100 and 7 or -7)), i * 0.8) end
	end
	for _, z in ipairs({ 55, 153 }) do W.part(parent, "Cave Entrance Pillar", Vector3.new(12, 31, 67), Vector3.new(-251, 14, z), stone, Enum.Material.Rock) end
	W.part(parent, "Cave Entrance Lintel", Vector3.new(16, 12, 42), Vector3.new(-250, 24, 104), dark, Enum.Material.Slate)
	for _, z in ipairs({ 85, 123 }) do
		W.part(parent, "Mine Timber Upright", Vector3.new(3, 21, 3), Vector3.new(-244, 10.5, z), Color3.fromRGB(119, 80, 47), Enum.Material.Wood)
	end
	W.part(parent, "Mine Timber Header", Vector3.new(4, 3, 44), Vector3.new(-244, 21, 104), Color3.fromRGB(119, 80, 47), Enum.Material.Wood)
	for index = 1, 10 do
		local x, z = -268 - (index % 5) * 24, index <= 5 and 40 or 175
		rock("Hanging Cave Crystal", Vector3.new(3, 8, 3), Vector3.new(x, 20, z), index)
		local lamp = W.part(parent, "Amber Cave Lantern", Vector3.new(1, 1.6, 1), Vector3.new(x, 12, z), Color3.fromRGB(255, 207, 126), Enum.Material.Neon)
		lamp.CanCollide = false
		local light = Instance.new("PointLight")
		light.Color, light.Brightness, light.Range, light.Parent = lamp.Color, 1.5, 32, lamp
	end
	for index = 1, 8 do
		local x = -274 - index * 12
		rock("Rocky Cave Roof", Vector3.new(20, 16, 174), Vector3.new(x, 30, 108), index % 2 * math.pi)
	end
end
function Cave.health(node)
	local gui = node.label.Parent
	gui.StudsOffsetWorldSpace, gui.StudsOffset, gui.AlwaysOnTop = Vector3.new(0, 6, 0), Vector3.zero, true
	gui.Size, gui.MaxDistance = UDim2.fromOffset(160, 52), 30
	node.label.Size, node.label.BackgroundTransparency, node.label.TextSize = UDim2.new(1, 0, 0, 28), 1, 13
	local track = Instance.new("Frame")
	track.Position, track.Size, track.BackgroundColor3, track.BorderSizePixel, track.Parent = UDim2.fromOffset(5, 31), UDim2.new(1, -10, 0, 10), Color3.fromRGB(45, 35, 29), 0, gui
	local bar = Instance.new("Frame")
	bar.Size, bar.BackgroundColor3, bar.BorderSizePixel, bar.Parent = UDim2.fromScale(1, 1), Color3.fromRGB(242, 196, 103), 0, track
	for _, element in ipairs({ track, bar }) do local corner = Instance.new("UICorner"); corner.CornerRadius, corner.Parent = UDim.new(1, 0), element end
	node.bar = bar
end
return Cave
]]></string>
        </Properties>
