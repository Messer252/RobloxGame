      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <string name="Source"><![CDATA[-- Create these passes/products for YOUR experience in Creator Dashboard.
-- Replace 0 with the numeric ID. A zero, invalid, or duplicated ID stays disabled.
-- Prices come from Roblox on the client; do not hardcode Robux prices here.
local Boosts = if script then require(script.Parent.Boosts) else require("./Boosts")
local Catalog = {
	PassOrder = { "DoubleIncome", "DoubleSpeed" },
	Passes = {
		DoubleIncome = { Id = 0, Name = "2x Cookie Income", Description = "Double cookie earnings forever. Stacks with Golden Batter and rebirth bonuses." },
		DoubleSpeed = { Id = 0, Name = "2x Baking Speed", Description = "Bake twice as fast forever, including with fully upgraded ovens." },
	},
	ProductOrder = { "CashSmall", "CashMedium", "CashLarge" },
	Products = {
		CashSmall = { Id = 0, Name = "Pocket of Cookie Cash", Cash = 10000 },
		CashMedium = { Id = 0, Name = "Jar of Cookie Cash", Cash = 100000 },
		CashLarge = { Id = 0, Name = "Crate of Cookie Cash", Cash = 1000000 },
	},
	-- Keep retired products in Products with their original ID and reward; only
	-- remove their key from ProductOrder. Unresolved receipts must still be honored.
	MaxPromptedReceipts = 10000,
}

-- Each stage needs its own developer product because Roblox prices are set
-- per product, not dynamically per player. Extend MaxPaidTier with new IDs to
-- add more stages; never repurpose the IDs of existing paid entitlements.
local IncomeProductIds = {
	[1] = 0, -- 2x, 20 Robux
	[2] = 0, -- 4x, 40 Robux
	[3] = 0, -- 8x, 80 Robux
	[4] = 0, -- 16x, 160 Robux
	[5] = 0, -- 32x, 320 Robux
	[6] = 0, -- 64x, 640 Robux
	[7] = 0, -- 128x, 1280 Robux
	[8] = 0, -- 256x, 2560 Robux
	[9] = 0, -- 512x, 5120 Robux
	[10] = 0, -- 1024x, 10240 Robux
	[11] = 0, -- 2048x, 20480 Robux
	[12] = 0, -- 4096x, 40960 Robux
}
for tier = 1, Boosts.MaxPaidTier do
	local key = "IncomeTier" .. tier
	Catalog.Products[key] = { Id = IncomeProductIds[tier] or 0, Name = 2 ^ tier .. "x Permanent Income", BoostTier = tier, SuggestedRobux = 20 * 2 ^ (tier - 1) }
	table.insert(Catalog.ProductOrder, key)
end

function Catalog.validId(value)
	return type(value) == "number" and value > 0 and value < 2 ^ 53 and value == math.floor(value)
end

function Catalog.resolve(kind, id)
	if not Catalog.validId(id) then return nil end
	local entries = kind == "Pass" and Catalog.Passes or kind == "Product" and Catalog.Products or nil
	if not entries then return nil end
	local found, foundKey
	for key, entry in pairs(entries) do
		if entry.Id == id then
			if found then return nil end -- Ambiguous IDs must never award the wrong item.
			found, foundKey = entry, key
		end
	end
	return found, foundKey
end

function Catalog.offer(kind, key)
	local entries = kind == "Pass" and Catalog.Passes or kind == "Product" and Catalog.Products or nil
	local order = kind == "Pass" and Catalog.PassOrder or kind == "Product" and Catalog.ProductOrder or {}
	local listed = false
	for _, listedKey in ipairs(order) do if listedKey == key then listed = true end end
	if not listed or not entries or type(key) ~= "string" then return nil end
	local entry = entries[key]
	if not entry or Catalog.resolve(kind, entry.Id) ~= entry then return nil end
	if kind == "Product" and not Catalog.validProduct(entry) then return nil end
	return entry
end

function Catalog.validProduct(entry)
	if entry.BoostTier ~= nil then
		return entry.Cash == nil and type(entry.BoostTier) == "number" and entry.BoostTier % 1 == 0
			and entry.BoostTier >= 1 and entry.BoostTier <= Boosts.MaxPaidTier
	end
	return Catalog.validId(entry.Cash) and entry.Cash <= 1e15
end

return Catalog
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="19">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="20">
      <Properties>
        <string name="Name">Tycoon</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local shared = ReplicatedStorage:WaitForChild("CookieTycoon")
local Progression = require(shared.Progression)
local Recipes = require(shared.Recipes)
local Crafting = require(shared.CookieCrafting)
local Challenges = require(shared.Challenges)
local Boosts = require(shared.Boosts)
local AudioPreferences = require(shared.AudioPreferences)
local ProfileStore = require(script.ProfileStore)
local Settings = require(script.Settings)
local World = require(script.World)
local ChallengeWorld = require(script.ChallengeWorld)
local ObbyWorld = require(script.ObbyWorld)
local PlazaExtras = require(script.PlazaExtras)
local CommerceServer = require(script.CommerceServer)
local AdminServer = require(script.AdminServer)
local AdminRewards = require(script.AdminRewards)

local remotes = Instance.new("Folder")
remotes.Name = "Remotes"
remotes.Parent = shared
local requestAction = Instance.new("RemoteEvent")
requestAction.Name = "RequestAction"
requestAction.Parent = remotes
local openShop = Instance.new("RemoteEvent")
openShop.Name = "OpenShop"
openShop.Parent = remotes
local requestPurchase = Instance.new("RemoteEvent")
requestPurchase.Name = "RequestPurchase"
requestPurchase.Parent = remotes
local refreshPasses = Instance.new("RemoteEvent")
refreshPasses.Name = "RefreshPasses"
refreshPasses.Parent = remotes
local feedback = Instance.new("RemoteEvent")
feedback.Name = "Feedback"
feedback.Parent = remotes

local storeOk, store = pcall(function() return DataStoreService:GetDataStore(Settings.DataStoreName) end)
if not storeOk then
	local initializationError = store
	store = { UpdateAsync = function() error(initializationError) end }
end
local profiles = ProfileStore.new(store, {
	clock = os.time, wait = task.wait, copy = Progression.normalize, lease = Settings.SessionLeaseSeconds,
})
local sessions = {}
local pendingLoads = {}
local shuttingDown = false


local function notify(player, message)
	player:SetAttribute("Notice", message)
	player:SetAttribute("NoticeId", (player:GetAttribute("NoticeId") or 0) + 1)
end

local function sync(player, state)
	local data = state.data
	player.leaderstats.Cash.Value = data.cash
	player.leaderstats.Rebirths.Value = data.rebirths
	player.leaderstats.GoldenChips.Value = data.chips
	player:SetAttribute("Bank", data.bank)
	player:SetAttribute("RecipeCount", data.unlocked)
	player:SetAttribute("OvenLevel", data.level)
	player:SetAttribute("Rebirths", data.rebirths)
	player:SetAttribute("GoldenChips", data.chips)
	player:SetAttribute("MusicEnabled", data.audio.music)
	player:SetAttribute("EffectsEnabled", data.audio.effects)
	player:SetAttribute("MusicVolume", data.audio.musicVolume)
	player:SetAttribute("EffectsVolume", data.audio.effectsVolume)
	player:SetAttribute("ChallengeIndex", data.challenges.index)
	player:SetAttribute("ChallengeActive", data.challenges.active)
	player:SetAttribute("ChallengeFound", Challenges.encode(data.challenges))
	player:SetAttribute("ChallengeComplete", Challenges.isComplete(data.challenges))
	player:SetAttribute("PaidBoostTier", data.boosts.paidTier)
	player:SetAttribute("ObbyBonus", data.boosts.obbyBonus)
	player:SetAttribute("ObbyExpires", data.boosts.obbyExpires)
	for key, level in pairs(data.permanent) do player:SetAttribute(key .. "Level", level) end
	for index = 1, #Recipes do
		player:SetAttribute("RecipeModifiers_" .. index, Crafting.encode(data.modifiers[tostring(index)]))
	end
end

local function usable(player)
	local state = sessions[player]
	if not state or state.closing or state.profile.lost or state.profile.closed then return nil end
	if state.profile.transacting or (state.receiptWorkers or 0) > 0 then return nil end
	if not state.profile.sessionOnly and os.time() >= state.profile.expiresAt then return nil end
	return state
end

local function saveState(player, state, release)
	if state.profile.sessionOnly then return true end
	if not release and (state.profile.saving or state.profile.closing or state.profile.transacting or (state.receiptWorkers or 0) > 0) then return false end
	if not state.closing then player:SetAttribute("DataStatus", "Saving") end
	local ok, reason, detail = profiles:Save(state.profile, release)
	if not state.closing then
		local purchasePending = state.profile.transacting or (state.receiptWorkers or 0) > 0
		player:SetAttribute("DataStatus", purchasePending and "PurchasePending" or ok and "Saved" or "SaveFailed")
		state.nextSave = os.clock() + (ok and Settings.AutosaveSeconds or 10)
	end
	if not ok and reason ~= "busy" then
		warn("Cookie Corner save failed for " .. player.UserId .. ": " .. tostring(reason) .. " " .. tostring(detail or ""))
		if reason == "lost" then
			player:SetAttribute("DataReady", false)
			player:Kick("Your bakery was opened in another server. Rejoin to safely load your latest save.")
		end
	end
	return ok
end

local commerce = CommerceServer.start({
	Profiles = profiles,
	AutosaveSeconds = Settings.AutosaveSeconds,
	GetState = function(player) return sessions[player] end,
	IsLoading = function(player) return pendingLoads[player] == true end,
	IsClosing = function() return shuttingDown end,
	Notify = notify,
	Refresh = function(player, state)
		sync(player, state)
		if state.plot then World.refresh(state.plot, state.data, state.perks) end
	end,
}, requestPurchase, refreshPasses)

AdminServer.start(remotes, {
	ReturnToSpawn = function(player)
		local state = sessions[player]
		if state and state.plot and state.plot.owner == player then
			World.spawnPlayer(player, state.plot)
		elseif player.Character then
			player.Character:PivotTo(CFrame.new(0, 5, -9))
			local root = player.Character:FindFirstChild("HumanoidRootPart")
			if root then root.AssemblyLinearVelocity, root.AssemblyAngularVelocity = Vector3.zero, Vector3.zero end
		end
	end,
	GrantCash = function(player, action, amount, maximum)
		local state = usable(player)
		if not state or state.profile.saving then return false, "Player data is loading or busy. Try again shortly." end
		local success, message = AdminRewards.grant(state.data, action, amount, maximum)
		if success then
			sync(player, state)
			if state.plot then World.updateBank(state.plot, state.data) end
			state.nextSave = math.min(state.nextSave, os.clock() + 2)
			notify(player, "Admin gift: " .. message)
		end
		return success, message
	end,
})

local allowedActions = { Collect = true, BuyRecipe = true, BuyModifier = true, UpgradeOven = true, UpgradePermanent = true, Rebirth = true, SetAudioPreferences = true, ChallengeAction = true }
local function onAction(player, action, argument, sourcePlot)
	if type(action) ~= "string" or not allowedActions[action] then return end
	local state = usable(player)
	if not state then return end
	if action == "ChallengeAction" then
		local now = os.clock()
		if now - (state.lastChallengeAction or -math.huge) < 0.5 then return end
		state.lastChallengeAction = now
		if not ChallengeWorld.IsNearNPC(player) then
			notify(player, "Visit Baker Biscuit in the plaza to start or finish a hunt.")
			return
		end
		local success, message, reward = Challenges.interact(state.data, Progression.MAX_CASH)
		if success then
			sync(player, state)
			if state.plot then World.updateBank(state.plot, state.data) end
			state.nextSave = math.min(state.nextSave, now + 2)
			feedback:FireClient(player, (reward or 0) > 0 and "Collect" or "Claim")
		end
		if message then notify(player, message) end
		return
	end
	if action == "SetAudioPreferences" then
		local preferences = AudioPreferences.update(state.data.audio, argument)
		if not preferences then return end
		local now = os.clock()
		if now - (state.lastAudioPreference or -math.huge) < 0.2 then return end
		state.lastAudioPreference = now
		state.data.audio = preferences
		player:SetAttribute("MusicEnabled", preferences.music)
		player:SetAttribute("EffectsEnabled", preferences.effects)
		player:SetAttribute("MusicVolume", preferences.musicVolume)
		player:SetAttribute("EffectsVolume", preferences.effectsVolume)
		-- Debounce settings changes; they are included in normal/final saves too.
		state.nextSave = math.min(state.nextSave, now + 5)
		return
	end
	if not state.plot or state.plot.owner ~= player then return end
	-- Prompts carry their source plot; menu actions intentionally work anywhere.
	if sourcePlot and sourcePlot ~= state.plot then return end
	local now = os.clock()
	if now - state.lastAction < 0.2 then return end
	state.lastAction = now
	local data = state.data
	local success, message
	if action == "Collect" then
		local amount = Progression.collect(data)
		success, message = amount > 0, "Collected $" .. Progression.format(amount) .. "."
	elseif action == "BuyRecipe" then
		if argument ~= nil and argument ~= data.unlocked + 1 then return end
		success, message = Progression.buyRecipe(data)
	elseif action == "UpgradeOven" then
		success, message = Progression.upgradeOven(data)
	elseif action == "UpgradePermanent" then
		if type(argument) ~= "string" or not Progression.Permanent[argument] then return end
		success, message = Progression.buyPermanent(data, argument)
	elseif action == "BuyModifier" then
		if type(argument) ~= "table" then return end
		success, message = Progression.buyModifier(data, argument.Recipe, argument.Modifier)
	elseif action == "Rebirth" then
		-- A confirmation for an old rebirth count cannot submit a newer rebirth.
		if argument ~= data.rebirths then return end
		success, message = Progression.rebirth(data)
		if success then state.nextBake = now + Progression.interval(data, state.perks) end
	end
	if success then
		feedback:FireClient(player, action)
		state.nextBake = math.min(state.nextBake, now + Progression.interval(data, state.perks))
		sync(player, state)
		if action == "Collect" then World.updateBank(state.plot, data) else World.refresh(state.plot, data, state.perks) end
		if action == "Rebirth" or action == "UpgradePermanent" or action == "BuyModifier" then
			-- Save the entire reset/reward transaction together, without one write per click.
			state.nextSave = math.min(state.nextSave, now + 2)
		end
	end
	if not success and message then feedback:FireClient(player, "Error") end
	if message then notify(player, message) end
	return success == true
end

World.create(function(player, plot)
	local state = usable(player)
	if not state then return end
	if state.plot then
		notify(player, "You already own a bakery. Use your Bakery menu.")
		return
	end
	if plot.owner then return end
	plot.owner = player
	state.plot = plot
	state.nextBake = os.clock() + Progression.interval(state.data, state.perks)
	player:SetAttribute("HasBakery", true)
	World.refresh(plot, state.data, state.perks)
	task.spawn(World.spawnPlayer, player, plot)
	feedback:FireClient(player, "Claim")
	notify(player, "Bakery claimed! Your saved recipes and upgrades are restored.")
end, onAction, function(player, plot)
	local state = usable(player)
	if state and state.plot == plot and plot.owner == player then openShop:FireClient(player, "Bakery") end
end, function(player, plot)
	local state = usable(player)
	if state and state.plot == plot and plot.owner == player then openShop:FireClient(player, "Workshop") end
end)

ChallengeWorld.create(workspace:WaitForChild("CookieTycoonWorld"), function(player)
	if usable(player) then openShop:FireClient(player, "Challenges") end
end, function(player, itemId)
	local state = usable(player)
	if not state then return end
	local success, message = Challenges.find(state.data, itemId)
	if not success then return end
	sync(player, state)
	state.nextSave = math.min(state.nextSave, os.clock() + 2)
	feedback:FireClient(player, "BuyModifier")
	notify(player, message)
end)

ObbyWorld.create(workspace.CookieTycoonWorld, function(player, difficulty)
	local state = sessions[player]
	if not state or state.closing then return end
	-- Queue a server-validated finish while a purchase is saving. Mutating the
	-- profile during a receipt transaction could discard either reward.
	local pending = state.pendingObby
	if not pending or Boosts.ObbyBonuses[difficulty] >= Boosts.ObbyBonuses[pending.difficulty] then
		state.pendingObby = { difficulty = difficulty, completed = os.time() }
	end
end, notify)

PlazaExtras.create(workspace.CookieTycoonWorld, function(player) return sessions[player] end)

requestAction.OnServerEvent:Connect(function(player, action, argument)
	onAction(player, action, argument, nil)
end)

local function addPlayer(player)
	if pendingLoads[player] or sessions[player] then return end
	pendingLoads[player] = true
	player:SetAttribute("DataReady", false)
	player:SetAttribute("DataStatus", "Loading")
	player:SetAttribute("HasBakery", false)
	player:SetAttribute("NearChallengeNPC", false)
	local stats = Instance.new("Folder")
	stats.Name = "leaderstats"
	stats.Parent = player
	for _, name in ipairs({ "Cash", "Rebirths", "GoldenChips" }) do
		local value = Instance.new(name == "Cash" and "NumberValue" or "IntValue")
		value.Name = name
		value.Parent = stats
	end
	local profile, reason, detail = profiles:Load(player.UserId, HttpService:GenerateGUID(false))
	if not profile and reason == "unavailable" and RunService:IsStudio() and Settings.AllowStudioSessionOnly then
		profile = { data = Progression.newData(), sessionOnly = true, expiresAt = math.huge }
		warn("Cookie Corner: Studio session-only mode; this player's progress WILL NOT SAVE.")
	end
	if player.Parent ~= Players or shuttingDown then
		if profile and not profile.sessionOnly then
			local ok = profiles:Save(profile, true)
			if not ok then warn("Cookie Corner: could not release a profile that loaded after departure.") end
		end
		pendingLoads[player] = nil
		return
	end
	if not profile then
		pendingLoads[player] = nil
		warn("Cookie Corner load failed for " .. player.UserId .. ": " .. tostring(reason) .. " " .. tostring(detail or ""))
		local message = "Your bakery could not load. Your saved progress has not been replaced. Please rejoin in a moment."
		if reason == "locked" then message = "Your bakery is still open in another server. Wait a moment, then rejoin." end
		if reason == "unsupported" then message = "Your save needs a compatible game version. Please contact the game creator." end
		player:Kick(message)
		return
	end
	local state = {
		profile = profile, data = profile.data, plot = nil, closing = false,
		perks = { DoubleIncome = false, DoubleSpeed = false }, receiptWorkers = 0,
		nextBake = 0, nextVisual = 0, lastAction = -math.huge,
		nextSave = os.clock() + Settings.AutosaveSeconds + math.random() * 5,
	}
	sessions[player] = state
	state.characterConnection = player.CharacterAdded:Connect(function()
		if not state.closing and state.plot then task.spawn(World.spawnPlayer, player, state.plot) end
	end)
	pendingLoads[player] = nil
	sync(player, state)
	player:SetAttribute("DataStatus", profile.sessionOnly and "SessionOnly" or "Saved")
	player:SetAttribute("DataReady", true)
	commerce:StartPlayer(player)
	notify(player, profile.sessionOnly and "STUDIO SESSION ONLY: progress will not save." or "Progress loaded. Claim any free bakery to continue!")
end

local function closePlayer(player)
	local state = sessions[player]
	if not state or state.closing then return end
	state.closing = true
	if state.characterConnection then state.characterConnection:Disconnect() end
	player:SetAttribute("DataReady", false)
	if state.plot then
		local plot = state.plot
		World.releasePlayer(player, plot)
		state.plot = nil
		plot.owner = nil
		World.refresh(plot, nil)
	end
	saveState(player, state, true)
	sessions[player] = nil
end

Players.PlayerAdded:Connect(addPlayer)
Players.PlayerRemoving:Connect(closePlayer)
for _, player in ipairs(Players:GetPlayers()) do task.spawn(addPlayer, player) end

task.spawn(function()
	local nextNPCCheck = 0
	while not shuttingDown do
		local now = os.clock()
		local checkNPC = now >= nextNPCCheck
		if checkNPC then nextNPCCheck = now + 0.5 end
		for player, state in pairs(sessions) do
			if checkNPC and not state.closing then player:SetAttribute("NearChallengeNPC", ChallengeWorld.IsNearNPC(player)) end
			if usable(player) and state.pendingObby then
				local pending = state.pendingObby
				state.pendingObby = nil
				if os.time() < pending.completed + Boosts.Duration then
					local success, message = Boosts.awardObby(state.data, pending.difficulty, pending.completed)
					if success then
						sync(player, state)
						state.nextSave = math.min(state.nextSave, now + 2)
						feedback:FireClient(player, "UpgradePermanent")
					end
					if message then notify(player, message) end
				end
			end
			if usable(player) and state.plot and now >= state.nextBake then
				local interval = Progression.interval(state.data, state.perks)
				local batches = math.min(5, math.floor((now - state.nextBake) / interval) + 1)
				state.nextBake = now + interval
				state.data.bank = math.min(Progression.MAX_CASH, state.data.bank + Progression.batchValue(state.data, state.perks) * batches)
				World.updateBank(state.plot, state.data)
				sync(player, state)
				if now >= state.nextVisual then
					state.nextVisual = now + 1.6
					World.animate(state.plot, state.data, state.perks)
				end
			end
		end
		task.wait(0.1)
	end
end)

task.spawn(function()
	while not shuttingDown do
		for player, state in pairs(sessions) do
			if not state.closing and not state.profile.sessionOnly then
				if os.time() >= state.profile.expiresAt then
					player:SetAttribute("DataReady", false)
					player:Kick("Saving could not reconnect safely. Please rejoin to load your last saved bakery.")
				elseif os.clock() >= state.nextSave and not state.profile.saving and not state.profile.transacting and state.receiptWorkers == 0 then
					state.nextSave = os.clock() + Settings.AutosaveSeconds
					task.spawn(saveState, player, state, false)
				end
			end
		end
		task.wait(1)
	end
end)

game:BindToClose(function()
	shuttingDown = true
	for player in pairs(sessions) do task.spawn(closePlayer, player) end
	local deadline = os.clock() + 25
	while (next(sessions) or next(pendingLoads)) and os.clock() < deadline do task.wait(0.1) end
	if next(sessions) or next(pendingLoads) then warn("Cookie Corner: shutdown ended before every save request completed.") end
end)
]]></string>
      </Properties>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">AdminConfig</string>
          <string name="Source"><![CDATA[-- Edit this ModuleScript in ServerScriptService > Tycoon > AdminConfig.
-- Use Roblox ACCOUNT usernames, not display names. Publish and restart servers.
return {
	AutoExperienceOwner = true, -- Personal experiences only; never grants a group ID.
	Usernames = {
		"unbenator",
		-- "FriendUsername",
	},
	-- Optional permanent account IDs: these keep working after username changes.
	UserIds = {
		-- 123456789,
	},
	MaxCashGrant = 1000000000, -- Maximum per admin action; integer cookie cash.
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">AdminPermissions</string>
          <string name="Source"><![CDATA[-- Pure permissions. Roblox resolves configured account names on the server;
-- client attributes, display names, and remote arguments never grant a role.
local Permissions = {}
local Actions = { Kick = true, ReturnToSpawn = true, GiveWalletCash = true, GiveBankCash = true,
	SetInvisible = true, GoToPlayer = true, BringPlayer = true }

function Permissions.validId(value)
	return type(value) == "number" and value > 0 and value < 2^53 and value % 1 == 0
end

function Permissions.username(value)
	if type(value) ~= "string" then return nil end
	local name = value:match("^%s*(.-)%s*$"):gsub("^@", "")
	if #name < 1 or #name > 20 or not name:match("^[%w_]+$") then return nil end
	return string.lower(name)
end

function Permissions.resolve(config, lookup, ownerId)
	local admins, errors, seen = {}, {}, {}
	if config.AutoExperienceOwner and Permissions.validId(ownerId) then admins[ownerId] = true end
	for _, id in ipairs(config.UserIds or {}) do
		if Permissions.validId(id) then admins[id] = true else table.insert(errors, "Invalid configured admin user ID") end
	end
	for _, value in ipairs(config.Usernames or {}) do
		local name = Permissions.username(value)
		if not name then table.insert(errors, "Invalid configured admin username: " .. tostring(value))
		elseif not seen[name] then
			seen[name] = true
			local ok, id = pcall(lookup, name)
			if ok and Permissions.validId(id) then admins[id] = true
			else table.insert(errors, "Could not resolve admin @" .. name .. "; check the username and rejoin a restarted server") end
		end
	end
	return admins, errors
end

function Permissions.authorize(admins, actorId, action, targetId)
	if admins[actorId] ~= true then return false, "Admin access required." end
	if type(action) ~= "string" or not Actions[action] then return false, "Unknown admin action." end
	if type(targetId) ~= "number" or targetId % 1 ~= 0 or math.abs(targetId) >= 2^53 then return false, "Invalid target account." end
	if action == "Kick" and admins[targetId] == true then return false, "Admins cannot be kicked with these tools." end
	if action == "SetInvisible" and actorId ~= targetId then return false, "Invisibility changes your own character only." end
	return true
end

return Permissions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">AdminRewards</string>
          <string name="Source"><![CDATA[local Progression = if script then require(game:GetService("ReplicatedStorage").CookieTycoon.Progression) else require("../shared/Progression")
local Rewards = {}

function Rewards.grant(data, action, amount, maximum)
	local field = action == "GiveWalletCash" and "cash" or action == "GiveBankCash" and "bank" or nil
	if not field then return false, "Unknown cash destination." end
	if type(maximum) ~= "number" or maximum <= 0 or maximum > Progression.MAX_CASH or maximum % 1 ~= 0 then
		return false, "Admin cash grants need a valid configured limit."
	end
	if type(amount) ~= "number" or amount <= 0 or amount > maximum or amount % 1 ~= 0 then
		return false, "Enter a whole amount from 1 to " .. Progression.format(maximum) .. "."
	end
	if amount > Progression.MAX_CASH - data[field] then return false, "That balance does not have room for the whole grant." end
	data[field] += amount
	return true, "Added $" .. Progression.format(amount) .. (field == "cash" and " to the wallet." or " to uncollected earnings.")
end

return Rewards
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">AdminServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Config = require(script.Parent.AdminConfig)
local Permissions = require(script.Parent.AdminPermissions)
local Visibility = require(script.Parent.AdminVisibility)
local Admin = {}

function Admin.start(remotes, context)
	local actionRemote = Instance.new("RemoteEvent")
	actionRemote.Name, actionRemote.Parent = "AdminAction", remotes
	local resultRemote = Instance.new("RemoteEvent")
	resultRemote.Name, resultRemote.Parent = "AdminResult", remotes
	local ownerId = game.CreatorType == Enum.CreatorType.User and game.CreatorId or nil
	local admins = Permissions.resolve({ AutoExperienceOwner = Config.AutoExperienceOwner, UserIds = Config.UserIds }, function() return nil end, ownerId)
	local cooldowns = {}
	local visibility = Visibility.new()
	local function mark(player) player:SetAttribute("IsAdmin", admins[player.UserId] == true) end
	Players.PlayerAdded:Connect(mark)
	Players.PlayerRemoving:Connect(function(player) cooldowns[player] = nil end)
	for _, player in ipairs(Players:GetPlayers()) do mark(player) end
	task.spawn(function()
		local resolved, errors = Permissions.resolve(Config, function(name) return Players:GetUserIdFromNameAsync(name) end, ownerId)
		admins = resolved
		for _, message in ipairs(errors) do warn("Cookie Corner admin setup: " .. message) end
		for _, player in ipairs(Players:GetPlayers()) do mark(player) end
	end)
	actionRemote.OnServerEvent:Connect(function(actor, action, targetId, argument)
		-- Rate-limit every caller before looking up a target, including non-admins.
		local now = os.clock()
		if now < (cooldowns[actor] or 0) then return end
		cooldowns[actor] = now + 1
		local permitted, message = Permissions.authorize(admins, actor.UserId, action, targetId)
		if not permitted then
			resultRemote:FireClient(actor, false, message)
			return
		end
		local target = Players:GetPlayerByUserId(targetId)
		if not target then
			resultRemote:FireClient(actor, false, "That player has left this server.")
			return
		end
		local resultMessage
		if action == "GiveWalletCash" or action == "GiveBankCash" then
			local success, grantMessage = context.GrantCash(target, action, argument, Config.MaxCashGrant)
			if not success then
				resultRemote:FireClient(actor, false, grantMessage)
				return
			end
			resultMessage = "@" .. target.Name .. ": " .. grantMessage
		elseif action == "SetInvisible" then
			if type(argument) ~= "boolean" then return end
			visibility:Set(actor, argument)
			resultMessage = argument and "You are invisible until you turn it off or leave." or "Your normal appearance is restored."
		elseif action == "Kick" then
			target:Kick("You were removed from this server by a Cookie Corner admin.")
			resultMessage = "Removed @" .. target.Name .. " from this server."
		else
			local character = target.Character
			local humanoid = character and character:FindFirstChildOfClass("Humanoid")
			local root = character and character:FindFirstChild("HumanoidRootPart")
			if not root or not humanoid or humanoid.Health <= 0 then
				resultRemote:FireClient(actor, false, "Wait for that player to respawn.")
				return
			end
			if action == "ReturnToSpawn" then
				context.ReturnToSpawn(target)
				resultMessage = "Returned @" .. target.Name .. " to spawn."
			else
				local adminCharacter = actor.Character
				local adminRoot = adminCharacter and adminCharacter:FindFirstChild("HumanoidRootPart")
				local adminHumanoid = adminCharacter and adminCharacter:FindFirstChildOfClass("Humanoid")
				if not adminRoot or not adminHumanoid or adminHumanoid.Health <= 0 then
					resultRemote:FireClient(actor, false, "Wait for your character to respawn.")
					return
				end
				local moving, movingRoot, destination = adminCharacter, adminRoot, root.CFrame
				if action == "BringPlayer" then moving, movingRoot, destination = character, root, adminRoot.CFrame end
				moving:PivotTo(destination * CFrame.new(5, 1, 0))
				movingRoot.AssemblyLinearVelocity, movingRoot.AssemblyAngularVelocity = Vector3.zero, Vector3.zero
				resultMessage = action == "BringPlayer" and ("Brought @" .. target.Name .. " to you.") or ("Teleported to @" .. target.Name .. ".")
			end
		end
		print(string.format("[Cookie Corner Admin] @%s (%d): %s @%s (%d) %s", actor.Name, actor.UserId, action, target.Name, target.UserId,
			(action == "GiveWalletCash" or action == "GiveBankCash") and tostring(argument) or ""))
		resultRemote:FireClient(actor, true, resultMessage)
	end)
end

return Admin
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">AdminVisibility</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Visibility = {}

local function conceal(object, originals)
	if originals[object] then return end
	local property, value
	if object:IsA("BasePart") or object:IsA("Decal") or object:IsA("Texture") then property, value = "Transparency", 1
	elseif object:IsA("ForceField") then property, value = "Visible", false
	elseif object:IsA("Humanoid") then property, value = "DisplayDistanceType", Enum.HumanoidDisplayDistanceType.None
	elseif object:IsA("ParticleEmitter") or object:IsA("Trail") or object:IsA("Beam") or object:IsA("Fire")
		or object:IsA("Smoke") or object:IsA("Sparkles") or object:IsA("Highlight")
		or object:IsA("BillboardGui") or object:IsA("SurfaceGui") then property, value = "Enabled", false end
	if property then
		originals[object] = { property = property, value = object[property] }
		object[property] = value
	end
end

local function restore(object, originals)
	local saved = originals[object]
	if saved then
		object[saved.property] = saved.value
		originals[object] = nil
	end
end

local function clearCharacter(state)
	for _, connection in ipairs(state.connections or {}) do connection:Disconnect() end
	for object in pairs(state.originals or {}) do restore(object, state.originals) end
	state.connections, state.originals = {}, {}
end

local function applyCharacter(state, character)
	clearCharacter(state)
	if not state.enabled then return end
	for _, object in ipairs(character:GetDescendants()) do conceal(object, state.originals) end
	table.insert(state.connections, character.DescendantAdded:Connect(function(object) conceal(object, state.originals) end))
	-- Equipped tools/accessories must regain their original appearance when removed.
	table.insert(state.connections, character.DescendantRemoving:Connect(function(object) restore(object, state.originals) end))
end

function Visibility.new()
	local self = { states = {} }
	Players.PlayerRemoving:Connect(function(player)
		local state = self.states[player]
		if state then
			state.respawn:Disconnect()
			state.appearance:Disconnect()
			clearCharacter(state)
			self.states[player] = nil
		end
	end)
	return setmetatable(self, { __index = Visibility })
end

function Visibility:Set(player, enabled)
	local state = self.states[player]
	if not state then
		state = { enabled = false, originals = {}, connections = {} }
		state.respawn = player.CharacterAdded:Connect(function(character) applyCharacter(state, character) end)
		state.appearance = player.CharacterAppearanceLoaded:Connect(function(character)
			if state.enabled and player.Character == character then applyCharacter(state, character) end
		end)
		self.states[player] = state
	end
	state.enabled = enabled
	if player.Character then applyCharacter(state, player.Character) else clearCharacter(state) end
	player:SetAttribute("AdminInvisible", enabled)
end

return Visibility
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">AssetLibrary</string>
          <string name="Source"><![CDATA[local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Recipes = require(ReplicatedStorage.CookieTycoon.Recipes)
local Crafting = require(ReplicatedStorage.CookieTycoon.CookieCrafting)
local TextureIds = require(script.Parent.AssetTextures)
local templates = ServerStorage:WaitForChild("CookieCornerAssets")
local AssetLibrary = {}

local allFaces = { Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
local sideFaces = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
local topFace = { Enum.NormalId.Top }
local rules = {
	BakeryFloor = { Faces = topFace, Tile = 16 },
	WallTile = { Faces = sideFaces, Tile = 8 },
	WoodWarm = { Faces = allFaces, Tile = 8 },
	BrushedMetal = { Faces = allFaces, Tile = 8 },
	ConveyorRubber = { Faces = topFace, Tile = 4 },
	OvenBrick = { Faces = sideFaces, Tile = 8 },
	Parchment = { Faces = topFace, Tile = 5 },
	GoldenChip = { Faces = { Enum.NormalId.Right, Enum.NormalId.Left }, Tile = 4 },
	AwningStripe = { Faces = { Enum.NormalId.Top, Enum.NormalId.Bottom }, Tile = 20 },
	CounterMarble = { Faces = topFace, Tile = 8 },
	MeadowGrass = { Faces = topFace, Tile = 12 },
	PathPavers = { Faces = topFace, Tile = 6 },
}

function AssetLibrary.texture(target, key)
	local configured = TextureIds[key]
	if type(configured) ~= "string" or configured == "" then return end
	local digits = configured:match("^(%d+)$") or configured:match("^rbxassetid://(%d+)$")
	if not digits or tonumber(digits) == 0 then
		warn("Cookie Corner: ignored an invalid image asset ID for " .. key)
		return
	end
	local rule = rules[key]
	if key:match("^Cookie%d%d$") then
		-- Native cylinders point along local X. Right faces upward after rotation.
		rule = { Faces = { Enum.NormalId.Right }, Tile = 3.35 }
	end
	if not rule then return end
	for _, face in ipairs(rule.Faces) do
		local texture = Instance.new("Texture")
		texture.Name = "CookieCorner_" .. key .. "_" .. face.Name
		texture.Texture = "rbxassetid://" .. digits
		texture.Face = face
		texture.StudsPerTileU = rule.Tile
		texture.StudsPerTileV = rule.Tile
		texture.Parent = target
	end
end

function AssetLibrary.clone(category, name, parent, pivot)
	local folder = assert(templates:FindFirstChild(category), "Missing asset category: " .. category)
	local template = assert(folder:FindFirstChild(name), "Missing model: " .. name)
	local object = template:Clone()
	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("BasePart") then
			local key = descendant.Name:match("^Texture_(.+)$")
			if key then AssetLibrary.texture(descendant, key) end
		end
	end
	object:PivotTo(pivot)
	object.Parent = parent
	return object
end

function AssetLibrary.prop(name, parent, pivot)
	return AssetLibrary.clone("Props", name, parent, pivot)
end

function AssetLibrary.cookie(index, parent, pivot, flags)
	local object = AssetLibrary.clone("Cookies", Recipes[index].Name, nil, pivot)
	local rarity = Crafting.rarity(Recipes[index])
	object.Name = rarity.Name .. " " .. Recipes[index].Name .. " (" .. Crafting.summary(flags) .. ")"
	object:SetAttribute("Rarity", rarity.Name)
	object:SetAttribute("ModifierMask", Crafting.encode(flags))
	local outline = Instance.new("Highlight")
	outline.Name = "RarityOutline"
	outline.Adornee = object
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.FillTransparency = 1
	outline.OutlineColor = Color3.fromRGB(table.unpack(rarity.Color))
	outline.OutlineTransparency = rarity.Name == "Common" and 0.45 or 0.1
	outline.Parent = object
	local surface = object:FindFirstChild("Vanilla Frosting") and 0.41 or 0.295
	local function topping(name, size, offset, rgb, rotation, shape)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Size = size
		piece.CFrame = pivot * CFrame.new(offset) * (rotation or CFrame.new())
		piece.Color = Color3.fromRGB(table.unpack(rgb))
		piece.Material = Enum.Material.SmoothPlastic
		piece.Shape = shape or Enum.PartType.Block
		piece.Anchored = true
		piece.CanCollide = false
		piece.CanTouch = false
		piece.CanQuery = false
		piece.TopSurface = Enum.SurfaceType.Smooth
		piece.BottomSurface = Enum.SurfaceType.Smooth
		piece.Parent = object
		return piece
	end
	if flags and flags.Glaze then
		local glaze = topping("Glaze", Vector3.new(0.08, 3.05, 3.05), Vector3.new(0, surface + 0.045, 0),
			Crafting.Modifiers.Glaze.Color, CFrame.Angles(0, 0, math.pi / 2), Enum.PartType.Cylinder)
		glaze.Transparency = 0.25
		for _, x in ipairs({ -1.4, 1.4 }) do
			topping("Glaze Drip", Vector3.new(0.24, 0.3, 0.25), Vector3.new(x, surface - 0.05, 0.3),
				Crafting.Modifiers.Glaze.Color, nil, Enum.PartType.Ball)
		end
		surface += 0.085
	end
	if flags and flags.Sprinkles then
		local colors = { { 255, 101, 152 }, { 91, 220, 205 }, { 255, 218, 82 }, { 164, 133, 255 } }
		for number = 1, 6 do
			local angle = number * 2.399963
			local radius = 0.3 + number * 0.15
			topping("Added Sprinkles", Vector3.new(0.12, 0.09, 0.38), Vector3.new(math.cos(angle) * radius, surface + 0.05, math.sin(angle) * radius),
				colors[(number - 1) % #colors + 1], CFrame.Angles(0, angle, 0))
		end
	end
	if flags and flags.ChocolateDrizzle then
		for number = -1, 1 do
			topping("Chocolate Drizzle", Vector3.new(0.13, 0.09, 2.45), Vector3.new(number * 0.6, surface + 0.065, 0),
				Crafting.Modifiers.ChocolateDrizzle.Color, CFrame.Angles(0, -0.35, 0))
		end
	end
	if flags and flags.CaramelSwirl then
		for number = 1, 6 do
			local angle = number * math.pi / 3
			local radius = 0.4 + number * 0.1
			topping("Caramel Swirl", Vector3.new(0.65, 0.08, 0.15), Vector3.new(math.cos(angle) * radius, surface + 0.09, math.sin(angle) * radius),
				Crafting.Modifiers.CaramelSwirl.Color, CFrame.Angles(0, -angle + math.pi / 2, 0))
		end
	end
	if flags and flags.GoldLeaf then
		for number = 1, 3 do
			local angle = number * math.pi * 2 / 3
			local leaf = topping("Gold Leaf", Vector3.new(0.4, 0.06, 0.28), Vector3.new(math.cos(angle) * 0.8, surface + 0.13, math.sin(angle) * 0.8),
				Crafting.Modifiers.GoldLeaf.Color, CFrame.Angles(0, angle, 0))
			leaf.Material = Enum.Material.Metal
		end
	end
	object.Parent = parent
	if parent and (rarity.Name == "Legendary" or rarity.Name == "Mythic") then
		local sparkle = Instance.new("ParticleEmitter")
		sparkle.Name = "Rare Cookie Sparkle"
		sparkle.Texture = "rbxasset://textures/particles/sparkles_main.dds"
		sparkle.Color = ColorSequence.new(Color3.fromRGB(table.unpack(rarity.Color)))
		sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.2), NumberSequenceKeypoint.new(1, 0) })
		sparkle.Transparency = NumberSequence.new(0.1, 1)
		sparkle.Lifetime = NumberRange.new(0.4, 0.7)
		sparkle.Speed = NumberRange.new(0.5, 1.5)
		sparkle.SpreadAngle = Vector2.new(120, 120)
		sparkle.LightEmission = 0.5
		sparkle.Rate = 2
		sparkle.Parent = object.PrimaryPart
		sparkle:Emit(3)
	end
	return object
end

function AssetLibrary.anchor(object)
	return object:FindFirstChild("LabelAnchor") or object.PrimaryPart
end

return AssetLibrary
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">AssetTextures</string>
          <string name="Source"><![CDATA[-- Optional: upload assets/textures/*.png using Studio's Asset Manager, then paste
-- each image's numeric asset ID (as a string) into the matching entry below.
-- Empty entries use the model's built-in Roblox materials and colors.
return {
	BakeryFloor = "",
	WallTile = "",
	WoodWarm = "",
	BrushedMetal = "",
	ConveyorRubber = "",
	OvenBrick = "",
	Parchment = "",
	GoldenChip = "",
	AwningStripe = "",
	CounterMarble = "",
	MeadowGrass = "",
	PathPavers = "",
	Cookie01 = "", Cookie02 = "", Cookie03 = "", Cookie04 = "", Cookie05 = "",
	Cookie06 = "", Cookie07 = "", Cookie08 = "", Cookie09 = "", Cookie10 = "",
	Cookie11 = "", Cookie12 = "", Cookie13 = "", Cookie14 = "", Cookie15 = "",
	Cookie16 = "", Cookie17 = "", Cookie18 = "", Cookie19 = "", Cookie20 = "",
	Cookie21 = "", Cookie22 = "", Cookie23 = "", Cookie24 = "", Cookie25 = "",
	Cookie26 = "", Cookie27 = "", Cookie28 = "", Cookie29 = "", Cookie30 = "",
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">BakerAvatar</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Avatar = {}
local skin = Color3.fromRGB(245, 205, 140)
local cream = Color3.fromRGB(255, 246, 225)
local mint = Color3.fromRGB(112, 164, 144)

local function fallback()
	-- A standard R6 joint hierarchy keeps the NPC usable if avatar assets are
	-- temporarily unavailable. The normal path below asks Roblox for an R6 rig.
	local model = Instance.new("Model")
	local function body(name, size, pos, color)
		local part = Instance.new("Part")
		part.Name, part.Size, part.Position, part.Color = name, size, pos, color
		part.CanCollide, part.TopSurface, part.BottomSurface = false, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
		part.Parent = model
		return part
	end
	local root = body("HumanoidRootPart", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), cream)
	root.Transparency = 1
	local torso = body("Torso", Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), cream)
	local head = body("Head", Vector3.new(2, 1, 1), Vector3.new(0, 4.5, 0), skin)
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType, mesh.Scale, mesh.Parent = Enum.MeshType.Head, Vector3.new(1.25, 1.25, 1.25), head
	local function joint(name, a, b, c0, c1)
		local motor = Instance.new("Motor6D")
		motor.Name, motor.Part0, motor.Part1, motor.C0, motor.C1 = name, a, b, c0, c1
		motor.Parent = a
	end
	joint("RootJoint", root, torso, CFrame.new(), CFrame.new())
	joint("Neck", torso, head, CFrame.new(0, 1, 0), CFrame.new(0, -0.5, 0))
	for _, side in ipairs({ -1, 1 }) do
		local prefix = side == -1 and "Left" or "Right"
		local arm = body(prefix .. " Arm", Vector3.new(1, 2, 1), Vector3.new(side * 1.5, 3, 0), skin)
		local leg = body(prefix .. " Leg", Vector3.new(1, 2, 1), Vector3.new(side * 0.5, 1, 0), mint)
		joint(prefix .. " Shoulder", torso, arm, CFrame.new(side, 0.5, 0), CFrame.new(-side * 0.5, 0.5, 0))
		joint(prefix .. " Hip", torso, leg, CFrame.new(side * 0.5, -1, 0), CFrame.new(0, 1, 0))
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.Parent = model
	model.PrimaryPart = root
	return model
end

function Avatar.decorate(model)
	local root = model:FindFirstChild("HumanoidRootPart")
	local head, torso = model:FindFirstChild("Head"), model:FindFirstChild("Torso")
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	if not root or not head or not torso or not humanoid then return false end
	root.Anchored = true
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.WalkSpeed = 0
	for _, piece in ipairs(model:GetDescendants()) do if piece:IsA("BasePart") then piece.CanCollide = false end end
	if not head:FindFirstChildOfClass("Decal") then
		local face = Instance.new("Decal")
		face.Name, face.Texture, face.Face, face.Parent = "face", "rbxasset://textures/face.png", Enum.NormalId.Front, head
	end
	local function accessory(name, size, anchor, offset, color, shape)
		local part = Instance.new("Part")
		part.Name, part.Size, part.CFrame, part.Color = name, size, anchor.CFrame * offset, color
		part.CanCollide, part.Massless = false, true
		part.Shape = shape or Enum.PartType.Block
		part.Parent = model
		local weld = Instance.new("WeldConstraint")
		weld.Part0, weld.Part1, weld.Parent = anchor, part, part
		return part
	end
	accessory("Chef Hat Band", Vector3.new(0.25, 1.8, 1.8), head, CFrame.new(0, 0.6, 0) * CFrame.Angles(0, 0, math.pi / 2), cream, Enum.PartType.Cylinder)
	for _, x in ipairs({ -0.45, 0, 0.45 }) do
		accessory("Chef Hat", Vector3.new(1, 0.8, 1), head, CFrame.new(x, 0.95, 0), cream, Enum.PartType.Ball)
	end
	local apron = accessory("Chef Apron", Vector3.new(1.5, 1.7, 0.08), torso, CFrame.new(0, -0.12, -0.55), mint)
	apron.Material = Enum.Material.Fabric
	accessory("Apron Pocket", Vector3.new(0.65, 0.4, 0.08), torso, CFrame.new(0, -0.45, -0.62), cream)
	model.PrimaryPart = root
	return true
end

function Avatar.create(onReady)
	local initial = fallback()
	Avatar.decorate(initial)
	onReady(initial)
	task.spawn(function()
		local description = Instance.new("HumanoidDescription")
		description.HeadColor, description.LeftArmColor, description.RightArmColor = skin, skin, skin
		description.TorsoColor, description.LeftLegColor, description.RightLegColor = cream, mint, mint
		local ok, model = pcall(function() return Players:CreateHumanoidModelFromDescriptionAsync(description, Enum.HumanoidRigType.R6) end)
		description:Destroy()
		if ok and model and Avatar.decorate(model) then onReady(model)
		elseif ok and model then model:Destroy() end
	end)
end

return Avatar
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">ChallengeWorld</string>
          <string name="Source"><![CDATA[-- A standard Roblox character and original treasures. Discovery callbacks originate
-- from alive characters beside the actual server-owned item, never a client ID.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage.CookieTycoon.ChallengeCatalog)
local BakerAvatar = require(script.Parent.BakerAvatar)
local ChallengeWorld = {}
local npcRoot = nil
local cooldowns = setmetatable({}, { __mode = "k" })
local cream = Color3.fromRGB(255, 243, 218)
local cocoa = Color3.fromRGB(83, 56, 43)

local function rgb(value) return Color3.fromRGB(value[1], value[2], value[3]) end

local function piece(parent, name, size, frame, tint, shape, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = frame
	object.Color = tint
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Material = material or Enum.Material.SmoothPlastic
	if shape then object.Shape = shape end
	object.Parent = parent
	return object
end

local function aliveNear(player, target, distance)
	if not target or not target.Parent then return false end
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return humanoid ~= nil and humanoid.Health > 0 and root ~= nil and root:IsA("BasePart")
		and (root.Position - target.Position).Magnitude <= distance
end

local function available(player)
	local now = os.clock()
	if now < (cooldowns[player] or 0) then return false end
	cooldowns[player] = now + 0.3
	return true
end

local function interaction(target, action, name, callback)
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "ChallengePrompt"
	prompt.ActionText = action
	prompt.ObjectText = name
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 8
	prompt.RequiresLineOfSight = false
	prompt.Parent = target
	prompt.Triggered:Connect(function(player)
		if aliveNear(player, target, 12) and available(player) then callback(player) end
	end)
	return prompt
end

local function createNPC(parent, onTalk)
	local current
	BakerAvatar.create(function(model)
		if not parent.Parent then
			model:Destroy()
			return
		end
		model.Name = Catalog.NPCName
		local pos = Catalog.NPCPosition
		model:PivotTo(CFrame.lookAt(Vector3.new(pos[1], pos[2] + 3, pos[3]), Vector3.new(0, pos[2] + 3, 0)))
		model.Parent = parent
		npcRoot = model:FindFirstChild("HumanoidRootPart")
		interaction(npcRoot, "Talk", Catalog.NPCName, onTalk)
		local gui = Instance.new("BillboardGui")
		gui.Size, gui.StudsOffset, gui.MaxDistance = UDim2.fromOffset(180, 44), Vector3.new(0, 3.8, 0), 55
		gui.Parent = npcRoot
		local label = Instance.new("TextLabel")
		label.Size, label.BackgroundTransparency = UDim2.fromScale(1, 1), 1
		label.Text, label.Font, label.TextSize = Catalog.NPCName .. "\nTreasure hunts", Enum.Font.GothamBold, 16
		label.TextColor3, label.TextStrokeTransparency = cream, 0.25
		label.Parent = gui
		if current then current:Destroy() end
		current = model
	end)
	return current
end

local function createTreasure(parent, itemId, questIndex, onFound)
	local item = Catalog.Items[itemId]
	local model = Instance.new("Model")
	model.Name = item.Name
	model:SetAttribute("ChallengeItemId", itemId)
	model:SetAttribute("ChallengeQuestIndex", questIndex)
	model.Parent = parent
	local pos = item.Position
	local base = CFrame.new(pos[1], pos[2], pos[3]) * CFrame.Angles(0, math.rad(18 * questIndex), 0)
	local tint = rgb(item.Color)
	local function add(name, size, x, y, z, shade, shape, rotation, material)
		return piece(model, name, size, base * CFrame.new(x, y, z) * (rotation or CFrame.new()), shade or tint, shape, material)
	end
	local root = add("ItemRoot", Vector3.new(1, 1, 1), 0, 0, 0)
	root.Transparency = 1
	model.PrimaryPart = root
	local vertical = CFrame.Angles(0, 0, math.pi / 2)
	if item.Kind == "Spoon" then
		local handle = add("Polished Spoon Handle", Vector3.new(1.8, 0.18, 0.18), 0, 0, -0.65, tint, Enum.PartType.Cylinder, CFrame.Angles(0, math.pi / 2, 0), Enum.Material.Metal)
		handle.Reflectance = 0.3
		add("Spoon Bowl Base", Vector3.new(0.85, 0.1, 1.15), 0, 0, 0.8, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
		for index = 1, 16 do
			local angle = index * math.pi / 8
			local rim = add("Rounded Spoon Rim", Vector3.new(0.25, 0.14, 0.25), math.cos(angle) * 0.42, 0.07, 0.8 + math.sin(angle) * 0.56, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
			rim.Reflectance = 0.25
		end
	elseif item.Kind == "Cube" then
		add("Sugar Cube", Vector3.new(1.35, 1.35, 1.35), 0, 0, 0, Color3.fromRGB(250, 247, 235), nil, nil, Enum.Material.Sand)
		for index = 1, 28 do
			local x, z = math.sin(index * 19.7) * 0.59, math.cos(index * 11.3) * 0.59
			add("Fine Sugar Grain", Vector3.new(0.1, 0.07, 0.1), x, 0.69, z, cream, nil, CFrame.Angles(0, index, 0))
		end
	elseif item.Kind == "Whisk" then
		add("Rounded Pink Handle", Vector3.new(1.3, 0.34, 0.34), 0, 0, -0.7, tint, Enum.PartType.Cylinder, CFrame.Angles(0, math.pi / 2, 0))
		local silver = Color3.fromRGB(195, 209, 213)
		for loop = 0, 2 do
			local rotation = CFrame.Angles(0, 0, loop * math.pi / 3)
			for index = 1, 16 do
				local a, b = (index - 1) * math.pi / 8, index * math.pi / 8
				local p1 = rotation * Vector3.new(math.sin(a) * 0.44, 0, math.cos(a) * 0.8 + 0.65)
				local p2 = rotation * Vector3.new(math.sin(b) * 0.44, 0, math.cos(b) * 0.8 + 0.65)
				local wire = piece(model, "Curved Whisk Wire", Vector3.new(0.06, 0.06, (p2 - p1).Magnitude), base * CFrame.lookAt((p1 + p2) / 2, p2), silver, nil, Enum.Material.Metal)
				wire.Reflectance = 0.25
			end
		end
	elseif item.Kind == "RollingPin" then
		add("Rolling Pin Body", Vector3.new(2.2, 0.9, 0.9), 0, 0, 0, tint, Enum.PartType.Cylinder, nil, Enum.Material.Wood)
		for _, x in ipairs({ -1.45, 1.45 }) do add("Handle", Vector3.new(0.7, 0.35, 0.35), x, 0, 0, cocoa, Enum.PartType.Cylinder, nil, Enum.Material.Wood) end
	elseif item.Kind == "Tin" then
		add("Tin", Vector3.new(1.3, 1.7, 1.7), 0, 0, 0, tint, Enum.PartType.Cylinder, vertical, Enum.Material.Metal)
		add("Tin Lid", Vector3.new(0.16, 1.9, 1.9), 0, 0.72, 0, cream, Enum.PartType.Cylinder, vertical, Enum.Material.Metal)
		add("Cookie Emblem", Vector3.new(0.1, 0.65, 0.65), 0, 0.84, 0, Color3.fromRGB(202, 155, 98), Enum.PartType.Cylinder, vertical)
	elseif item.Kind == "Star" then
		for index = 0, 4 do
			add("Star Cutter Point", Vector3.new(0.32, 0.25, 1.6), 0, 0, 0, tint, nil, CFrame.Angles(0, math.rad(index * 72), 0), Enum.Material.Metal)
		end
	elseif item.Kind == "Jar" or item.Kind == "Bottle" then
		add("Bottle Body", Vector3.new(1.5, 1.25, 1.25), 0, 0, 0, tint, Enum.PartType.Cylinder, vertical)
		add("Cream Label", Vector3.new(0.8, 0.65, 0.1), 0, -0.05, 0.65, cream)
		add("Lid", Vector3.new(0.25, 0.9, 0.9), 0, 0.85, 0, cocoa, Enum.PartType.Cylinder, vertical)
		if item.Kind == "Jar" then
			for index, shade in ipairs({ tint, Color3.fromRGB(146, 184, 157), Color3.fromRGB(236, 191, 91) }) do
				add("Sprinkle", Vector3.new(0.1, 0.3, 0.1), (index - 2) * 0.24, 0, 0.72, shade, nil, CFrame.Angles(0, 0, index * 0.3))
			end
		end
	elseif item.Kind == "Mitten" then
		add("Oven Mitt", Vector3.new(1.4, 0.45, 2), 0, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Fabric)
		add("Thumb", Vector3.new(0.8, 0.4, 0.8), 0.7, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Fabric)
		add("Cuff", Vector3.new(1.25, 0.35, 0.35), 0, 0, -0.8, cream, nil, nil, Enum.Material.Fabric)
	elseif item.Kind == "Cup" then
		add("Cup", Vector3.new(1.4, 1.5, 1.3), 0, 0, 0)
		for index = 1, 3 do add("Measuring Mark", Vector3.new(index * 0.18 + 0.1, 0.07, 0.07), -0.3, index * 0.32 - 0.7, 0.67, cocoa) end
		add("Handle Top", Vector3.new(0.8, 0.16, 0.3), 1, 0.55, 0, cream)
		add("Handle Side", Vector3.new(0.16, 1.1, 0.3), 1.35, 0, 0, cream)
		add("Handle Bottom", Vector3.new(0.8, 0.16, 0.3), 1, -0.55, 0, cream)
	elseif item.Kind == "Book" then
		add("Book Cover", Vector3.new(2.1, 0.45, 1.65), 0, 0, 0)
		add("Pages", Vector3.new(1.9, 0.3, 1.5), 0, 0.08, 0, cream)
		add("Top Cover", Vector3.new(2.1, 0.08, 1.65), 0, 0.29, 0)
		add("Golden Bookmark", Vector3.new(0.3, 0.08, 1.8), 0.5, 0.35, 0, Color3.fromRGB(241, 193, 96))
	else
		add("Golden Chip", Vector3.new(1.6, 1.3, 1.6), 0, 0, 0, tint, Enum.PartType.Ball, nil, Enum.Material.Metal)
		add("Chocolate Tip", Vector3.new(0.7, 0.7, 0.7), 0, 0.65, 0, cocoa, Enum.PartType.Ball)
	end
	local light = Instance.new("PointLight")
	light.Name = "TreasureGlow"
	light.Color = cream
	light.Brightness = 0.15
	light.Range = 4
	light.Parent = root
	interaction(root, "Find", item.Name, function(player) onFound(player, itemId) end)
	return model
end

function ChallengeWorld.IsNearNPC(player)
	return aliveNear(player, npcRoot, 12)
end

function ChallengeWorld.create(parent, onTalk, onFound)
	local folder = Instance.new("Folder")
	folder.Name = "Challenges"
	folder.Parent = parent
	local npc = createNPC(folder, onTalk)
	local items = Instance.new("Folder")
	items.Name = "HiddenItems"
	items.Parent = folder
	for questIndex, quest in ipairs(Catalog.Challenges) do
		for _, itemId in ipairs(quest.Items) do createTreasure(items, itemId, questIndex, onFound) end
	end
	return { model = folder, npc = npc, npcRoot = npcRoot }
end

return ChallengeWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">CommerceServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local shared = ReplicatedStorage:WaitForChild("CookieTycoon")
local Catalog = require(shared.ShopCatalog)
local Rewards = require(shared.PurchaseRewards)
local Progression = require(shared.Progression)
local Commerce = {}
Commerce.__index = Commerce
local GRANTED = Enum.ProductPurchaseDecision.PurchaseGranted
local PENDING = Enum.ProductPurchaseDecision.NotProcessedYet

function Commerce:_state(player)
	local state = self.context.GetState(player)
	if not state or state.closing or state.profile.closed or state.profile.closing or state.profile.lost then return nil end
	if not state.profile.sessionOnly and os.time() >= state.profile.expiresAt then return nil end
	return state
end

function Commerce:_syncPerks(player, state)
	if self.context.GetState(player) ~= state or state.closing then return end
	player:SetAttribute("DoubleIncomeOwned", state.perks.DoubleIncome == true)
	player:SetAttribute("DoubleSpeedOwned", state.perks.DoubleSpeed == true)
	player:SetAttribute("PassesReady", state.passesReady == true)
	state.nextBake = math.min(state.nextBake, os.clock() + Progression.interval(state.data, state.perks))
	self.context.Refresh(player, state)
end

function Commerce:RefreshPasses(player)
	local state = self:_state(player)
	if not state or state.checkingPasses then return end
	state.checkingPasses = true
	local allChecked = true
	-- Keep honoring owned passes even if their buttons are hidden from PassOrder.
	for key, configured in pairs(Catalog.Passes) do
		local offer = Catalog.resolve("Pass", configured.Id)
		if offer then
			local ok, owned
			for attempt = 1, 3 do
				ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
				if ok then break end
				if attempt < 3 then task.wait(attempt) end
				if self:_state(player) ~= state then break end
			end
			if self:_state(player) ~= state then
				state.checkingPasses = false
				return
			end
			if ok then
				-- Preserve a confirmed purchase if a cached ownership read is stale.
				state.perks[key] = state.perks[key] == true or owned == true
			else
				allChecked = false
				warn("Cookie Corner: could not check pass ownership for " .. player.UserId .. " (" .. key .. ").")
			end
		end
	end
	state.checkingPasses = false
	state.passesReady = allChecked
	self:_syncPerks(player, state)
	if not allChecked then
		task.delay(30, function() if self:_state(player) == state then self:RefreshPasses(player) end end)
	end
end

function Commerce:StartPlayer(player)
	local state = self:_state(player)
	if not state then return end
	player:SetAttribute("CommerceReady", not state.profile.sessionOnly)
	player:SetAttribute("PurchasePending", false)
	player:SetAttribute("ShopPromptOpen", false)
	task.spawn(function() self:RefreshPasses(player) end)
end

function Commerce:Prompt(player, kind, key)
	if (kind ~= "Pass" and kind ~= "Product") or type(key) ~= "string" then return end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly or state.profile.transacting or (state.receiptWorkers or 0) > 0 then return end
	if state.shopPrompt or os.clock() - (state.lastShopPrompt or -math.huge) < 3 then return end
	local offer = Catalog.offer(kind, key)
	if not offer then
		self.context.Notify(player, "This item is not available yet.")
		return
	end
	if kind == "Product" and offer.BoostTier and offer.BoostTier ~= state.data.boosts.paidTier + 1 then
		self.context.Notify(player, "Buy the next permanent income stage shown in the shop.")
		return
	end
	state.lastShopPrompt = os.clock()
	-- Set this before any yielding ownership request, preventing overlapping prompts.
	local prompt = { Kind = kind, Id = offer.Id }
	state.shopPrompt = prompt
	player:SetAttribute("ShopPromptOpen", true)
	local function cancel(message)
		if state.shopPrompt == prompt then state.shopPrompt = nil end
		player:SetAttribute("ShopPromptOpen", false)
		if message then self.context.Notify(player, message) end
	end
	if kind == "Pass" then
		local ok, owned = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, offer.Id) end)
		if self:_state(player) ~= state then
			cancel()
			return
		end
		if not ok then
			cancel("Ownership could not be checked. Please try again shortly.")
			return
		end
		if owned or state.perks[key] then
			state.perks[key] = true
			self:_syncPerks(player, state)
			cancel("You already own " .. offer.Name .. ".")
			return
		end
	else
		if offer.Cash and not Rewards.canFitCash(state.data, offer.Cash, Progression.MAX_CASH) then
			cancel("Spend some cookie cash before buying another bundle.")
			return
		end
		local receiptCount = 0
		for _ in pairs(state.profile.receipts) do receiptCount += 1 end
		if receiptCount >= Catalog.MaxPromptedReceipts then
			cancel("Cash bundles are unavailable for this bakery. Please contact the creator.")
			return
		end
	end
	if self:_state(player) ~= state or state.profile.transacting or (state.receiptWorkers or 0) > 0 then
		cancel()
		return
	end
	local ok = pcall(function()
		if kind == "Pass" then MarketplaceService:PromptGamePassPurchase(player, offer.Id)
		else MarketplaceService:PromptProductPurchase(player, offer.Id) end
	end)
	if not ok then cancel("Roblox could not open the purchase window. Please try again.") end
end

function Commerce:_fulfill(player, state, receipt, product)
	local attempt = 0
	while player.Parent == Players and not self.context.IsClosing() do
		if self:_state(player) ~= state or state.profile.sessionOnly then return PENDING end
		local ok, reason, detail = self.context.Profiles:GrantReceipt(state.profile, receipt.PurchaseId, receipt.ProductId, function(data)
			return Rewards.product(data, product, Progression.MAX_CASH)
		end)
		if ok then
			if self.context.GetState(player) == state and not state.closing then
				state.nextSave = os.clock() + self.context.AutosaveSeconds
				self.context.Refresh(player, state)
				if reason ~= "duplicate" then
					self.context.Notify(player, product.BoostTier and (2 ^ product.BoostTier .. "x permanent cookie income saved! Survives rebirth.")
						or "$" .. Progression.format(product.Cash) .. " cookie cash purchased and saved! Cash resets on rebirth.")
				end
			end
			return GRANTED -- The cash AND receipt ID are now durable in the same record.
		end
		if reason == "busy" then
			task.wait(0.2)
		elseif reason == "unavailable" then
			attempt += 1
			warn("Cookie Corner: purchase save pending for " .. player.UserId .. ": " .. tostring(detail or reason))
			if attempt == 1 then self.context.Notify(player, "Your purchase is waiting for saving to reconnect. Please wait.") end
			task.wait(math.min(10, attempt * 2))
		else
			warn("Cookie Corner: purchase not acknowledged for " .. player.UserId .. ": " .. tostring(reason))
			if reason == "lost" then
				player:Kick("Your purchase is pending on a newer bakery session. Rejoin to load it safely.")
			elseif reason == "capacity" then
				self.context.Notify(player, "Your cash bundle is pending. Spend some cash and rejoin to receive it.")
			end
			return PENDING
		end
	end
	return PENDING
end

function Commerce:ProcessReceipt(receipt)
	local player = Players:GetPlayerByUserId(receipt.PlayerId)
	if not player then return PENDING end
	-- Roblox does not periodically retry NotProcessedYet. Wait for this join's
	-- profile load and retry transient save failures inside the callback itself.
	while self.context.IsLoading(player) and player.Parent == Players and not self.context.IsClosing() do task.wait(0.1) end
	local state = self:_state(player)
	if not state or state.profile.sessionOnly then return PENDING end
	-- An already durable receipt remains acknowledgeable even after an offer is
	-- retired. New/ungranted receipts still need their original product mapping.
	if state.profile.receipts[receipt.PurchaseId] == receipt.ProductId then return GRANTED end
	local product = Catalog.resolve("Product", receipt.ProductId)
	if not product or not Catalog.validProduct(product) then
		warn("Cookie Corner: unconfigured product receipt " .. tostring(receipt.ProductId) .. "; it remains pending.")
		return PENDING
	end
	state.receiptWorkers = (state.receiptWorkers or 0) + 1
	player:SetAttribute("PurchasePending", true)
	player:SetAttribute("DataStatus", "PurchasePending")
	local ok, decision = pcall(function() return self:_fulfill(player, state, receipt, product) end)
	state.receiptWorkers -= 1
	if self.context.GetState(player) == state and not state.closing then
		local pending = state.profile.transacting or state.receiptWorkers > 0
		player:SetAttribute("PurchasePending", pending)
		player:SetAttribute("DataStatus", pending and "PurchasePending" or ok and "Saved" or "SaveFailed")
	end
	if not ok then
		warn("Cookie Corner receipt handler failed: " .. tostring(decision))
		return PENDING
	end
	return decision
end

function Commerce.start(context, requestPurchase, refreshPasses)
	local self = setmetatable({ context = context }, Commerce)
	-- This is the experience's only ProcessReceipt owner. Never grant products
	-- from PromptProductPurchaseFinished or a client-supplied success message.
	MarketplaceService.ProcessReceipt = function(receipt) return self:ProcessReceipt(receipt) end
	requestPurchase.OnServerEvent:Connect(function(player, kind, key) self:Prompt(player, kind, key) end)
	refreshPasses.OnServerEvent:Connect(function(player)
		local state = self:_state(player)
		if not state or os.clock() - (state.lastPassRefresh or -math.huge) < 10 then return end
		state.lastPassRefresh = os.clock()
		task.spawn(function() self:RefreshPasses(player) end)
	end)
	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, wasPurchased)
		local state = self:_state(player)
		if not state then return end
		if state.shopPrompt and state.shopPrompt.Kind == "Pass" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
		local pass, key = Catalog.resolve("Pass", id)
		if wasPurchased and pass then
			-- This event is server-side: Roblox supplies the confirmed final outcome.
			state.perks[key] = true
			self:_syncPerks(player, state)
			context.Notify(player, pass.Name .. " unlocked! It stays through every rebirth.")
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, id)
		local player = Players:GetPlayerByUserId(userId)
		local state = player and self:_state(player)
		if state and state.shopPrompt and state.shopPrompt.Kind == "Product" and state.shopPrompt.Id == id then
			state.shopPrompt = nil
			player:SetAttribute("ShopPromptOpen", false)
		end
	end)
	return self
end

return Commerce
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">ConveyorWorld</string>
          <string name="Source"><![CDATA[local PhysicsService = game:GetService("PhysicsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local RunService = game:GetService("RunService")
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local Routing = require(ReplicatedStorage.CookieTycoon.ConveyorRouting)
local Conveyor = {}
local paths = Routing.paths()
local boundaryRails = Routing.rails(paths)
local surfaces = Routing.surfaces(paths)
local activePlots = {}
pcall(function() PhysicsService:RegisterCollisionGroup("CookieBodies") end)
PhysicsService:CollisionGroupSetCollidable("CookieBodies", "CookieBodies", false)

local function part(parent, name, size, frame, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.CFrame, object.Color = name, size, frame, tint
	object.Anchored = true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function line(parent, name, a, b, width, tint)
	local object = part(parent, name, Vector3.new(width, 0.06, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), tint)
	object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
	return object
end

local function text(target, value)
	local surface = Instance.new("SurfaceGui")
	surface.Face = Enum.NormalId.Front
	surface.CanvasSize = Vector2.new(600, 200)
	surface.Parent = target
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.TextColor3 = Color3.fromRGB(63, 43, 31)
	label.Text = value
	label.TextScaled = true
	label.Font = Enum.Font.GothamBold
	label.Parent = surface
end

local function decoration(object)
	object.CanCollide, object.CanTouch, object.CanQuery = false, false, false
	return object
end

local function belt(plot, parent, size, frame, direction)
	local surface = part(parent, "Moving Belt", size, frame, Color3.fromRGB(53, 63, 69))
	surface.CustomPhysicalProperties = PhysicalProperties.new(1, 1, 0, 100, 1)
	surface.CanTouch = false
	surface:SetAttribute("Direction", direction)
	surface.AssemblyLinearVelocity = direction * Layout.CookieSpeed
	table.insert(plot.beltSurfaces, surface)
	return surface
end

local function rail(parent, a, b, joints)
	local center = (a + b) / 2
	local frame = CFrame.lookAt(center, b)
	local wall = part(parent, "Smooth Outer Rail", Vector3.new(Layout.RailThickness, Layout.RailHeight, (b - a).Magnitude + 0.05), frame, Color3.fromRGB(151, 169, 173))
	wall.Material = Enum.Material.Metal
	wall.CanTouch = false
	-- Low friction and rounded joints let a cookie slide past boundary contact.
	wall.CustomPhysicalProperties = PhysicalProperties.new(1, 0, 0, 100, 1)
	for _, point in ipairs({ a, b }) do
		local key = string.format("%.3f/%.3f", point.X, point.Z)
		if joints[key] then continue end
		joints[key] = true
		local cap = part(parent, "Rounded Rail Joint", Vector3.new(Layout.RailHeight, Layout.RailThickness, Layout.RailThickness),
			CFrame.new(point) * CFrame.Angles(0, 0, math.pi / 2), wall.Color)
		cap.Shape, cap.Material, cap.CustomPhysicalProperties = Enum.PartType.Cylinder, wall.Material, wall.CustomPhysicalProperties
		cap.CanTouch = false
	end
	local trim = decoration(part(parent, "Rail Top Trim", Vector3.new(Layout.RailThickness + 0.08, 0.08, (b - a).Magnitude),
		frame + Vector3.new(0, Layout.RailHeight / 2, 0), Color3.fromRGB(199, 211, 211)))
	trim.Material = Enum.Material.Metal
end

function Conveyor.create(plot, position)
	plot.beltSurfaces = {}
	local model = Instance.new("Model")
	model.Name = "Merging Cookie Conveyors"
	model.Parent = plot.model
	plot.beltSpeed = Layout.CookieSpeed
	activePlots[plot] = true
	for _, section in ipairs(surfaces) do
		local center = position(plot, section.x, Layout.BeltTop - 0.3, section.z)
		local direction = Vector3.new(section.dx, 0, section.dz * plot.direction)
		if section.round then
			-- Flat infill closes both edges of every curve without a raised lip.
			local join = belt(plot, model, Vector3.new(0.6, section.width, section.width),
				CFrame.new(center) * CFrame.Angles(0, 0, math.pi / 2), direction)
			join.Shape = Enum.PartType.Cylinder
		else
			belt(plot, model, Vector3.new(section.width, 0.6, section.length), CFrame.lookAt(center, center + direction), direction)
		end
	end
	for _, path in ipairs(paths) do
		for distance = 4, path[#path].s - 1, 10 do
			local point = Routing.pointAt(path, distance)
			-- One set of arrows on the shared outlet, all derived from flow.
			if point.z >= Layout.MainStartZ and path ~= paths[2] then continue end
			local center = position(plot, point.x, Layout.BeltTop + 0.035, point.z)
			local direction = Vector3.new(point.dx, 0, point.dz * plot.direction)
			local side = direction:Cross(Vector3.yAxis)
			local tip = center + direction * 0.8
			local back = center - direction * 0.5
			line(model, "Forward Arrow", tip, back + side * 0.5, 0.15, Color3.fromRGB(245, 204, 124))
			line(model, "Forward Arrow", tip, back - side * 0.5, 0.15, Color3.fromRGB(245, 204, 124))
		end
		for distance = 8, path[#path].s - 2, 18 do
			local point = Routing.pointAt(path, distance)
			local center = position(plot, point.x, (Layout.BeltTop - 0.8) / 2, point.z)
			decoration(part(model, "Recessed Conveyor Support", Vector3.new(6.2, Layout.BeltTop - 0.8, 0.7),
				CFrame.new(center), Color3.fromRGB(112, 133, 142)))
		end
	end
	local joints = {}
	for _, edge in ipairs(boundaryRails) do
		local y = Layout.BeltTop + Layout.RailHeight / 2 - 0.1
		rail(model, position(plot, edge.a.x, y, edge.a.z), position(plot, edge.b.x, y, edge.b.z), joints)
	end
	local center = position(plot, 0, 0, Layout.BoxZ)
	local wood = Color3.fromRGB(182, 133, 80)
	local box = Instance.new("Model")
	box.Name = "Cookie Collection Box"
	box.Parent = plot.model
	part(box, "Box Bottom", Vector3.new(12, 0.6, 14), CFrame.new(center + Vector3.new(0, 0.6, 0)), wood)
	for _, x in ipairs({ -6, 6 }) do
		part(box, "Box Side", Vector3.new(0.5, 3, 14), CFrame.new(center + Vector3.new(x, 2.2, 0)), wood)
	end
	for _, z in ipairs({ -7, 7 }) do
		local face = part(box, "Box End", Vector3.new(12, 3, 0.5), CFrame.new(center + Vector3.new(0, 2.2, z)), wood)
		text(face, "COOKIE DELIVERY")
	end
	local catch = part(box, "Cookie Catcher", Vector3.new(11, 1.8, 12), CFrame.new(center + Vector3.new(0, 1.6, 0)), wood)
	catch.Transparency, catch.CanCollide = 1, false
	catch.Touched:Connect(function(hit)
		local cookie = hit:FindFirstAncestorOfClass("Model")
		if cookie and plot.visuals[cookie] and not cookie:GetAttribute("Collected") then
			cookie:SetAttribute("Collected", true)
			-- Economy credit is computed once on the server's production clock;
			-- physics delivery never grants extra money from a touch event.
			Debris:AddItem(cookie, 0.7)
		end
	end)
	plot.conveyor = model
end

function Conveyor.update(plot, interval)
	plot.beltSpeed = Layout.speed(interval)
	for _, surface in ipairs(plot.beltSurfaces) do
		surface.AssemblyLinearVelocity = surface:GetAttribute("Direction") * plot.beltSpeed
	end
end

function Conveyor.makePhysical(model)
	local pivot = model:GetPivot()
	local hull = Instance.new("Part")
	hull.Name = "Cookie Collision Body"
	hull.Shape = Enum.PartType.Cylinder
	hull.Size = Vector3.new(0.52, Layout.CookieRadius * 2, Layout.CookieRadius * 2)
	hull.CFrame = pivot * CFrame.Angles(0, 0, math.pi / 2)
	hull.Transparency = 1
	hull.CanCollide, hull.CanTouch, hull.CanQuery = true, true, true
	hull.CollisionGroup = "CookieBodies"
	hull.CustomPhysicalProperties = PhysicalProperties.new(0.35, 0.35, 0, 10, 1)
	hull.Parent = model
	for _, piece in ipairs(model:GetDescendants()) do
		if piece:IsA("BasePart") and piece ~= hull then
			piece.CanCollide, piece.CanTouch, piece.Massless = false, false, true
			local weld = Instance.new("WeldConstraint")
			weld.Part0, weld.Part1, weld.Parent = hull, piece, hull
			piece.Anchored = false
		end
	end
	model.PrimaryPart = hull
	hull.Anchored = false
	hull:SetNetworkOwner(nil)
	local attachment = Instance.new("Attachment")
	attachment.Parent = hull
	local upright = Instance.new("AlignOrientation")
	upright.Name, upright.Mode = "Keep Cookie Flat", Enum.OrientationAlignmentMode.OneAttachment
	upright.Attachment0, upright.CFrame = attachment, hull.CFrame.Rotation
	upright.MaxTorque, upright.MaxAngularVelocity, upright.Responsiveness = 10000, 20, 25
	upright.Parent = hull
	Debris:AddItem(model, 30)
	return hull
end

function Conveyor.track(plot, model, hull, lane)
	plot.visuals[model] = { hull = hull, lane = lane, progress = 0 }
end

-- Physical assemblies remain collidable and unanchored. Gentle server-side
-- steering supplies reliable drive through merges instead of relying on two
-- competing contact velocities to choose the cookie's next direction.
local elapsed = 0
RunService.Heartbeat:Connect(function(dt)
	elapsed += dt
	if elapsed < 0.05 then return end
	local alpha = 1 - math.exp(-12 * math.min(elapsed, 0.2))
	elapsed = 0
	for plot in pairs(activePlots) do
		if not plot.model.Parent then
			activePlots[plot] = nil
			continue
		end
		for model, state in pairs(plot.visuals) do
			if not model.Parent then
				plot.visuals[model] = nil
				continue
			end
			if type(state) ~= "table" or model:GetAttribute("Collected") then continue end
			local hull = state.hull
			if not hull.Parent then
				model:Destroy()
				plot.visuals[model] = nil
				continue
			end
			local p = hull.Position - plot.origin
			if p.Y < Layout.BeltTop - 0.1 or p.Y > Layout.BeltTop + 1.1 then continue end
			local drive = Routing.drive(paths[state.lane], p.X, p.Z * plot.direction, state.progress, plot.beltSpeed)
			if drive then
				state.progress = drive.s
				local current = hull.AssemblyLinearVelocity
				local target = Vector3.new(drive.vx, current.Y, drive.vz * plot.direction)
				hull.AssemblyLinearVelocity = current:Lerp(target, alpha)
			end
		end
	end
end)

return Conveyor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">ObbyWorld</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage.CookieTycoon.ObbyCatalog)
local Progress = require(ReplicatedStorage.CookieTycoon.ObbyProgress)
local ObbyWorld = {}

local function platform(parent, name, position, width, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.Position = name, Vector3.new(width, 1, width), position
	object.Color, object.Anchored = tint, true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function sign(target, value)
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.StudsOffset, gui.MaxDistance = UDim2.fromOffset(220, 65), Vector3.new(0, 4, 0), 75
	gui.Parent = target
	local text = Instance.new("TextLabel")
	text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 0.15
	text.BackgroundColor3, text.TextColor3 = Color3.fromRGB(62, 45, 40), Color3.fromRGB(255, 238, 204)
	text.Text, text.TextSize, text.Font = value, 16, Enum.Font.GothamBold
	text.Parent = gui
end

local function feet(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then return nil end
	local height = humanoid.HipHeight + root.Size.Y / 2
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		height += leg and leg.Size.Y or 2
	end
	return root, humanoid, root.Position - Vector3.new(0, height, 0)
end

local function onTop(point, surface)
	local p = surface.CFrame:PointToObjectSpace(point)
	return math.abs(p.X) <= surface.Size.X / 2 + 0.15 and math.abs(p.Z) <= surface.Size.Z / 2 + 0.15
		and math.abs(p.Y - surface.Size.Y / 2) <= 1
end

function ObbyWorld.create(parent, onComplete, notify)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Cookie Obbys", parent
	local courses, runs, resets = {}, {}, {}
	for _, definition in ipairs(Catalog) do
		local model = Instance.new("Model")
		model.Name, model.Parent = definition.Id .. " Obby", folder
		local tint = Color3.fromRGB(table.unpack(definition.Color))
		local start = platform(model, "Start", Vector3.new(230, 0.4, definition.Z), 10, tint)
		sign(start, definition.Id .. " Obby\n+" .. math.floor(definition.Bonus * 100) .. "% income • 5 minutes")
		local floor = platform(model, "Soft Reset Floor", Vector3.new(325, 0.05, definition.Z), 1, Color3.fromRGB(209, 172, 150))
		floor.Size = Vector3.new(185, 0.2, 55)
		local path = {}
		for index = 1, definition.Count do
			local p = Catalog.platform(definition, index)
			local step = platform(model, "Checkpoint " .. index, Vector3.new(p.x, p.y, p.z), definition.Width, tint)
			table.insert(path, step)
			if index == definition.Count then
				sign(step, "FINISH\n" .. definition.Id .. " • Cash boost")
				local back = Instance.new("ProximityPrompt")
				back.ActionText, back.ObjectText, back.HoldDuration = "Return to plaza", definition.Id .. " finish", 0
				back.MaxActivationDistance, back.RequiresLineOfSight, back.Parent = 8, false, step
				back.Triggered:Connect(function(player)
					local root, _, point = feet(player)
					if root and onTop(point, step) and not runs[player] then
						runs[player] = nil
						player.Character:PivotTo(CFrame.new(0, 5, -9))
						root.AssemblyLinearVelocity = Vector3.zero
					end
				end)
			end
		end
		table.insert(courses, { definition = definition, start = start, floor = floor, path = path })
	end
	Players.PlayerRemoving:Connect(function(player) runs[player], resets[player] = nil, nil end)
	task.spawn(function()
		while folder.Parent do
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local root, humanoid, point = feet(player)
				local run = runs[player]
				if run and (not root or run.character ~= player.Character) then runs[player], run = nil, nil end
				if root and humanoid.FloorMaterial ~= Enum.Material.Air then
					for _, course in ipairs(courses) do
						local definition = course.definition
						if onTop(point, course.start) and (not run or run.course ~= definition.Id) then
							run = Progress.start(definition, now)
							run.character = player.Character
							runs[player] = run
							notify(player, definition.Id .. " obby started. Land on each platform!")
						elseif run and run.course == definition.Id then
							local nextStep = course.path[run.stage + 1]
							if nextStep and onTop(point, nextStep) then
								local advanced, complete = Progress.advance(run, definition, run.stage + 1, now)
								if advanced and complete then
									runs[player], run = nil, nil
									onComplete(player, definition.Id)
								end
							elseif not onTop(point, course.start) and onTop(point, course.floor) and now >= (resets[player] or 0) then
								resets[player] = now + 1
								runs[player], run = nil, nil
								player.Character:PivotTo(CFrame.new(course.start.Position + Vector3.new(0, 4, 0)))
								root.AssemblyLinearVelocity = Vector3.zero
								notify(player, "Try again! Your current cash boost is safe.")
							end
						end
					end
				end
			end
			task.wait(0.08)
		end
	end)
	return folder
end

return ObbyWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="33">
        <Properties>
          <string name="Name">PlazaExtras</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local Ranks = require(game:GetService("ReplicatedStorage").CookieTycoon.LeaderboardRanks)
local Progression = require(game:GetService("ReplicatedStorage").CookieTycoon.Progression)
local Extras = {}

local function part(parent, name, size, frame, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.CFrame, object.Color = name, size, frame, tint
	object.Anchored = true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function writing(target, text, size)
	local surface = Instance.new("SurfaceGui")
	surface.Face, surface.CanvasSize, surface.Parent = Enum.NormalId.Front, Vector2.new(700, 650), target
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1, 1), 1, text
	label.TextColor3, label.Font, label.TextSize = Color3.fromRGB(255, 235, 199), Enum.Font.GothamBold, size or 32
	label.Parent = surface
	return label
end

function Extras.create(parent, getState)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Plaza Extras", parent
	local boards = {}
	for index, key in ipairs({ "cash", "rebirths" }) do
		local x = index == 1 and -53 or 53
		local frame = CFrame.lookAt(Vector3.new(x, 7, -5), Vector3.new(0, 7, 0))
		part(folder, "Leaderboard Post", Vector3.new(0.8, 10, 0.8), CFrame.new(x, 4, -5), Color3.fromRGB(92, 61, 46))
		local board = part(folder, "Most " .. key, Vector3.new(17, 15, 0.6), frame, Color3.fromRGB(68, 49, 43))
		boards[key] = writing(board, "Loading rankings...", 31)
	end
	local center = CFrame.lookAt(Vector3.new(25, 1.9, -16), Vector3.new(0, 1.9, 0))
	local cardboard = Color3.fromRGB(185, 143, 94)
	local box = part(folder, "Zach's Box", Vector3.new(5, 3.5, 4), center, cardboard)
	local label = writing(box, "Zach's Box", 68)
	label.TextColor3 = Color3.fromRGB(62, 44, 30)
	part(folder, "Packing Tape", Vector3.new(0.75, 0.03, 4.02), center * CFrame.new(0, 1.77, 0), Color3.fromRGB(223, 193, 139))
	for _, side in ipairs({ -1, 1 }) do
		part(folder, "Cardboard Fold", Vector3.new(0.04, 3.3, 0.04), center * CFrame.new(side * 2.3, 0, -2.02), Color3.fromRGB(125, 89, 55))
	end
	task.spawn(function()
		while folder.Parent do
			local records = {}
			for _, player in ipairs(Players:GetPlayers()) do
				local state = getState(player)
				if state and not state.closing then
					table.insert(records, { name = player.DisplayName, userId = player.UserId, cash = state.data.cash, rebirths = state.data.rebirths })
				end
			end
			for key, labelObject in pairs(boards) do
				local lines = { key == "cash" and "MOST CASH" or "MOST REBIRTHS", "THIS SERVER", "" }
				for rank, record in ipairs(Ranks.sort(records, key)) do
					table.insert(lines, rank .. ". " .. record.name .. "  " .. (key == "cash" and "$" or "") .. Progression.format(record[key]))
				end
				if #records == 0 then table.insert(lines, "Claim a bakery and join the ranks!") end
				labelObject.Text = table.concat(lines, "\n")
			end
			task.wait(2)
		end
	end)
end

return Extras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Presentation = {}

local cream = Color3.fromRGB(255, 239, 210)
local cocoa = Color3.fromRGB(89, 58, 48)
local gold = Color3.fromRGB(255, 211, 129)
local themes = {
	Color3.fromRGB(126, 192, 171), Color3.fromRGB(225, 146, 157),
	Color3.fromRGB(171, 157, 211), Color3.fromRGB(228, 186, 116),
}

local function part(parent, name, size, frame, tint, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = frame
	object.Color = tint
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function light(target, brightness, range)
	local object = Instance.new("PointLight")
	object.Color = Color3.fromRGB(255, 218, 157)
	object.Brightness = brightness
	object.Range = range
	object.Shadows = false
	object.Parent = target
	return object
end

function Presentation.lighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4
	Lighting.Ambient = Color3.fromRGB(130, 112, 112)
	Lighting.OutdoorAmbient = Color3.fromRGB(162, 151, 135)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 239, 217)
	Lighting.EnvironmentDiffuseScale = 0.65
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ExposureCompensation = 0.05
	-- LightingStyle replaced the older, restricted Technology property.
	pcall(function() Lighting.LightingStyle = Enum.LightingStyle.Soft end)
	for _, name in ipairs({ "CookieAtmosphere", "CookieBloom", "CookieColor", "CookieSun" }) do
		local previous = Lighting:FindFirstChild(name)
		if previous then previous:Destroy() end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CookieAtmosphere"
	atmosphere.Density = 0.2
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(255, 239, 220)
	atmosphere.Decay = Color3.fromRGB(194, 174, 159)
	atmosphere.Haze = 1.1
	atmosphere.Glare = 0.08
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CookieBloom"
	bloom.Intensity = 0.16
	bloom.Size = 24
	bloom.Threshold = 1.65
	bloom.Parent = Lighting
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "CookieColor"
	correction.Brightness = 0.015
	correction.Contrast = 0.08
	correction.Saturation = 0.1
	correction.TintColor = Color3.fromRGB(255, 249, 240)
	correction.Parent = Lighting
	local sun = Instance.new("SunRaysEffect")
	sun.Name = "CookieSun"
	sun.Intensity = 0.025
	sun.Spread = 0.8
	sun.Parent = Lighting
end

function Presentation.world(world)
	for _, object in ipairs(world:GetDescendants()) do
		if object:IsA("BasePart") and object.Name == "Lamp" then light(object, 0.6, 20) end
	end
	for _, x in ipairs({ -14.6, 14.6 }) do
		part(world, "Cream Path Border", Vector3.new(0.7, 0.25, 1140), CFrame.new(x, 0.15, 0), cream, Enum.Material.Concrete)
	end
	for _, x in ipairs({ -485, 485 }) do
		for index = -2, 2 do
			local hill = part(world, "Pastel Meadow Hill", Vector3.new(105, 70, 118), CFrame.new(x, -19, index * 285),
				Color3.fromRGB(139 + (index % 2) * 9, 177, 132), Enum.Material.Grass)
			hill.Shape = Enum.PartType.Ball
		end
	end
	for _, x in ipairs({ -34, 34 }) do
		local seat = part(world, "Plaza Bench", Vector3.new(12, 0.6, 4), CFrame.new(x, 2.1, 0), cocoa, Enum.Material.WoodPlanks)
		seat.CanCollide = true
		for _, offset in ipairs({ -4, 4 }) do
			part(world, "Bench Leg", Vector3.new(0.6, 2, 3), CFrame.new(x + offset, 1, 0), cocoa, Enum.Material.Metal)
		end
		part(world, "Bench Back", Vector3.new(12, 2.7, 0.5), CFrame.new(x, 3.5, 1.8), cream, Enum.Material.WoodPlanks)
	end
	local base = part(world, "Cookie Monument Plinth", Vector3.new(0.7, 10, 10),
		CFrame.new(0, 0.7, 19) * CFrame.Angles(0, 0, math.pi / 2), cream, Enum.Material.Marble)
	base.Shape = Enum.PartType.Cylinder
	part(world, "Monument Pedestal", Vector3.new(5, 3.4, 5), CFrame.new(0, 2.6, 19), cocoa, Enum.Material.Wood)
end

function Presentation.plot(plot, slot)
	local theme = themes[(slot - 1) % #themes + 1]
	plot.theme = theme
	for _, object in ipairs(plot.model:GetDescendants()) do
		if not object:IsA("BasePart") then continue end
		if object.Name == "Texture_WallTile" then object.Color = cream:Lerp(theme, 0.16) end
		if object.Name == "Canopy Stripe" and object.Color.R < 0.85 then object.Color = theme end
		if object.Name == "Texture_BakeryFloor" then
			object.Color = Color3.fromRGB(240, 221, 195)
			object.Material = Enum.Material.SmoothPlastic
		end
	end
	local function frame(x, y, z)
		return CFrame.new(plot.origin + Vector3.new(x, y, z * plot.direction))
			* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
	end
	for column = 0, 3 do
		for row = 0, 5 do
			if (column + row) % 2 == 0 then
				part(plot.model, "Vanilla Floor Tile", Vector3.new(39.8, 0.035, 39.8), frame(-60 + column * 40, 0.525, -100 + row * 40),
					Color3.fromRGB(255, 243, 223))
			end
		end
	end
	part(plot.model, "Bakery Walkway", Vector3.new(7, 0.035, 232), frame(-24, 0.565, 0), theme:Lerp(cream, 0.55))
	for _, x in ipairs({ -60, -30, 0, 30, 60 }) do
		part(plot.model, "Window Frame", Vector3.new(22, 7.6, 0.28), frame(x, 7.1, -119.9), cocoa)
		local window = part(plot.model, "Pastel Window", Vector3.new(20.7, 6.3, 0.3), frame(x, 7.1, -119.65),
			Color3.fromRGB(190, 220, 219), Enum.Material.Glass)
		window.Transparency = 0.15
		part(plot.model, "Window Mullion", Vector3.new(0.3, 6.5, 0.35), frame(x, 7.1, -119.4), cream)
	end
	for _, z in ipairs({ -80, 40, 112 }) do
		for _, x in ipairs({ -77, 77 }) do
			part(plot.model, "String Light Post", Vector3.new(0.5, 16, 0.5), frame(x, 8, z), cocoa, Enum.Material.Wood)
		end
		local previous
		for index = 0, 10 do
			local x = -77 + index * 15.4
			local y = 16 - math.sin(index / 10 * math.pi) * 1.8
			local anchor = frame(x, y, z).Position
			if previous then
				local length = (anchor - previous).Magnitude
				part(plot.model, "Light Cable", Vector3.new(0.07, 0.07, length),
					CFrame.lookAt((anchor + previous) / 2, anchor), cocoa)
			end
			previous = anchor
			if index == 0 or index == 10 then continue end
			local bulb = part(plot.model, "Warm String Bulb", Vector3.new(0.65, 0.85, 0.65), frame(x, y - 0.35, z), gold, Enum.Material.Neon)
			bulb.Shape = Enum.PartType.Ball
			bulb.CastShadow = false
			if index == 3 or index == 7 then light(bulb, 0.3, 27) end
		end
	end
end

function Presentation.oven(oven)
	local chimney = oven:FindFirstChild("Chimney")
	if not chimney then return nil end
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, chimney.Size.Y / 2, 0)
	attachment.Parent = chimney
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Bakery Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(Color3.fromRGB(255, 247, 228))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1.9) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.82), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(1.5, 2)
	steam.Speed = NumberRange.new(1.2, 1.7)
	steam.Rate = 0.7
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Acceleration = Vector3.new(0.25, 0.5, 0)
	steam.Enabled = false
	steam.Parent = attachment
	return steam
end

return Presentation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[-- DataStore adapter with no engine dependencies, allowing failure/concurrency tests.
-- All writes check the session token inside UpdateAsync; stale servers cannot overwrite.
local ProfileStore = {}
ProfileStore.__index = ProfileStore
-- Version 5 retains paid multipliers and timed bonuses; older code must not
-- discard a paid entitlement. Existing versions migrate without a new store.
ProfileStore.CURRENT_VERSION = 5

local function validRecord(current)
	if type(current) ~= "table" or type(current.Version) ~= "number" or current.Version % 1 ~= 0
		or current.Version < 1 or current.Version > ProfileStore.CURRENT_VERSION or type(current.Data) ~= "table" then return false end
	if current.Receipts ~= nil and type(current.Receipts) ~= "table" then return false end
	if current.Version >= 2 and current.Receipts == nil then return false end
	for id, productId in pairs(current.Receipts or {}) do
		if type(id) ~= "string" or #id == 0 or #id > 200 or type(productId) ~= "number"
			or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then return false end
	end
	return true
end

local function receiptsCopy(receipts)
	local result = {}
	for id, productId in pairs(receipts or {}) do result[id] = productId end
	return result
end

function ProfileStore.new(store, options)
	return setmetatable({
		store = store,
		clock = options.clock,
		wait = options.wait,
		copy = options.copy,
		lease = options.lease or 180,
	}, ProfileStore)
end

function ProfileStore:_update(key, transform)
	local lastError
	for attempt = 1, 3 do
		local success, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
		if success then return true, result end
		lastError = result
		if attempt < 3 then self.wait(attempt) end
	end
	return false, lastError
end

function ProfileStore:Load(userId, token)
	local key = "Player_" .. tostring(userId)
	local reason
	local ok, result = self:_update(key, function(current)
		reason = nil
		if current ~= nil then
			if not validRecord(current) then
				reason = "unsupported"
				return nil
			end
			local session = current.Session
			if session ~= nil then
				if type(session) ~= "table" or type(session.Id) ~= "string" or type(session.ExpiresAt) ~= "number" then
					reason = "unsupported"
					return nil
				end
				if session.Id ~= token and session.ExpiresAt > self.clock() then
					reason = "locked"
					return nil
				end
			end
		end
		return {
			Version = ProfileStore.CURRENT_VERSION,
			Data = self.copy(current and current.Data),
			Receipts = receiptsCopy(current and current.Receipts),
			Session = { Id = token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	if not ok then return nil, "unavailable", result end
	if not result or reason then return nil, reason or "unavailable" end
	return {
		key = key, token = token, data = self.copy(result.Data),
		receipts = receiptsCopy(result.Receipts), transacting = false,
		expiresAt = result.Session.ExpiresAt, saving = false, closing = false, closed = false, lost = false,
	}
end

function ProfileStore:Save(profile, release)
	if profile.closed or profile.lost then return false, "lost" end
	if release then
		profile.closing = true
		while profile.saving do self.wait(0.1) end
		if profile.closed or profile.lost then return false, "lost" end
	elseif profile.saving or profile.closing then
		return false, "busy"
	end
	-- An ambiguous receipt write may already have committed. Never overwrite its
	-- reward with the old local snapshot, including during departure/shutdown.
	if profile.transacting then return false, "receipt_pending" end
	profile.saving = true
	-- Snapshot after waiting, so a final release includes the newest gameplay state.
	local snapshot = self.copy(profile.data)
	local ok, result = self:_update(profile.key, function(current)
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			return nil
		end
		return {
			Version = ProfileStore.CURRENT_VERSION, Data = snapshot, Receipts = receiptsCopy(current.Receipts),
			Session = if release then nil else { Id = profile.token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then return false, "unavailable", result end
	if not result then
		profile.lost = true
		return false, "lost"
	end
	if release then profile.closed = true else profile.expiresAt = result.Session.ExpiresAt end
	return true
end

function ProfileStore:GrantReceipt(profile, receiptId, productId, grant)
	if type(receiptId) ~= "string" or #receiptId == 0 or #receiptId > 200
		or type(productId) ~= "number" or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then
		return false, "invalid"
	end
	if profile.receipts and profile.receipts[receiptId] then
		return profile.receipts[receiptId] == productId, "duplicate"
	end
	if profile.closed or profile.closing or profile.lost or profile.sessionOnly then return false, "unavailable_profile" end
	if profile.saving then return false, "busy" end
	if profile.pendingReceipt and (profile.pendingReceipt.Id ~= receiptId or profile.pendingReceipt.ProductId ~= productId) then
		return false, "busy"
	end
	if not profile.pendingReceipt then
		profile.pendingReceipt = { Id = receiptId, ProductId = productId, Snapshot = self.copy(profile.data) }
	end
	profile.transacting = true
	profile.saving = true
	local reason
	local ok, result = self:_update(profile.key, function(current)
		reason = nil
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			reason = "lost"
			return nil
		end
		local ledger = receiptsCopy(current.Receipts)
		local data
		if ledger[receiptId] then
			if ledger[receiptId] ~= productId then
				reason = "conflict"
				return nil
			end
			data = current.Data -- A prior attempt may have committed despite a network error.
		else
			-- UpdateAsync can call this transform multiple times. Always start from
			-- the same frozen snapshot, never from a previously rewarded copy.
			data = self.copy(profile.pendingReceipt.Snapshot)
			local granted, failure = grant(data)
			if not granted then
				reason = failure or "invalid_reward"
				return nil
			end
			ledger[receiptId] = productId
		end
		return {
			Version = ProfileStore.CURRENT_VERSION, Data = data, Receipts = ledger,
			Session = { Id = profile.token, ExpiresAt = self.clock() + self.lease }, UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then
		-- Keep the economy frozen until retry/rejoin reconciles the uncertain write.
		return false, "unavailable", result
	end
	if not result then
		profile.pendingReceipt = nil
		profile.transacting = false
		if reason == "lost" then profile.lost = true end
		return false, reason or "unavailable"
	end
	-- Preserve the table identity used by the running tycoon state.
	table.clear(profile.data)
	for key, value in pairs(self.copy(result.Data)) do profile.data[key] = value end
	profile.receipts = receiptsCopy(result.Receipts)
	profile.expiresAt = result.Session.ExpiresAt
	profile.pendingReceipt = nil
	profile.transacting = false
	return true, "granted"
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[return {
	-- Use a separate published test experience for persistence testing.
	DataStoreName = "CookieCorner_PlayerData_v1",
	AutosaveSeconds = 45,
	SessionLeaseSeconds = 180,
	-- Explicit opt-in for offline Studio play only. Always ignored on live servers.
	-- Session-only play never reads/writes a fallback profile to the real DataStore.
	AllowStudioSessionOnly = false,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">StepPads</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local StepPads = {}
StepPads.__index = StepPads

local function feet(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or humanoid.FloorMaterial == Enum.Material.Air then return nil end
	local height = humanoid.HipHeight + root.Size.Y / 2
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		height += leg and leg.Size.Y or 2
	end
	return { character = character, position = root.Position - Vector3.new(0, height, 0) }
end

function StepPads.new(world)
	local self = setmetatable({ world = world, pads = {}, cooldowns = {}, running = true }, StepPads)
	world.Destroying:Connect(function() self.running = false end)
	task.spawn(function()
		while self.running and world.Parent do
			self:Update(os.clock())
			task.wait(0.08)
		end
	end)
	return self
end

function StepPads:Register(surface, options)
	table.insert(self.pads, { surface = surface, options = options })
end

function StepPads:ResetOwner(player)
	self.cooldowns[player] = nil
	for _, entry in ipairs(self.pads) do
		if entry.owner == player then entry.owner, entry.character, entry.state = nil, nil, nil end
	end
end

function StepPads:Update(now)
	local characters = {}
	for _, entry in ipairs(self.pads) do
		local player = entry.options.Owner()
		if not player or not player.Parent or not entry.surface:IsDescendantOf(self.world) then
			entry.owner, entry.character, entry.state = nil, nil, nil
			continue
		end
		if characters[player] == nil then characters[player] = feet(player) or false end
		local character = characters[player]
		if entry.owner ~= player or entry.character ~= (character and character.character) then
			entry.state = nil
			entry.owner, entry.character = player, character and character.character
		end
		local inside = false
		if character then
			local point = entry.surface.CFrame:PointToObjectSpace(character.position)
			inside = Layout.insidePad(point.X, point.Y, point.Z, entry.surface.Size.X, entry.surface.Size.Z)
		end
		local available = inside and now >= (self.cooldowns[player] or 0) and entry.options.Available(player)
		local fire
		entry.state, fire = Layout.step(entry.state, now, inside, available)
		if fire then
			self.cooldowns[player] = now + Layout.StepCooldown
			-- The normal action handler still checks session ownership, current price,
			-- and progression before changing any money. No client touch event is trusted.
			local ok, result = pcall(entry.options.Activate, player)
			entry.state = Layout.resolveStep(entry.state, ok and result == true)
			if not ok then warn("Cookie Corner step pad failed: " .. tostring(result)) end
		end
	end
end

return StepPads
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Recipes = require(ReplicatedStorage.CookieTycoon.Recipes)
local Progression = require(ReplicatedStorage.CookieTycoon.Progression)
local Crafting = require(ReplicatedStorage.CookieTycoon.CookieCrafting)
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local Map = require(ReplicatedStorage.CookieTycoon.MapLayout)
local Conveyor = require(script.Parent.ConveyorWorld)
local Assets = require(script.Parent.AssetLibrary)
local Presentation = require(script.Parent.Presentation)
local StepPads = require(script.Parent.StepPads)
local World = {}

local function color(rgb) return Color3.fromRGB(rgb[1], rgb[2], rgb[3]) end

local function part(name, size, position, tint, parent)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Color = tint
	object.Anchored = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function label(target, text, distance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(190, 46)
	gui.StudsOffset = Vector3.new(0, 3.1, 0)
	gui.MaxDistance = distance or 30
	gui.LightInfluence = 0
	gui.Parent = target
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundColor3 = Color3.fromRGB(64, 44, 39)
	textLabel.BackgroundTransparency = 0.12
	textLabel.Text = text
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 1
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = textLabel
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 7)
	padding.PaddingRight = UDim.new(0, 7)
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = textLabel
	return textLabel
end

local function prompt(target, action, callback, objectText)
	local interaction = Instance.new("ProximityPrompt")
	interaction.ActionText = action
	interaction.ObjectText = objectText or target.Name
	interaction.HoldDuration = 0
	interaction.MaxActivationDistance = 12
	interaction.RequiresLineOfSight = false
	interaction.Parent = target
	interaction.Triggered:Connect(function(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and (root.Position - target.Position).Magnitude <= 16 then callback(player) end
	end)
	return interaction
end

local function position(plot, x, y, z)
	return plot.origin + Vector3.new(x, y, z * plot.direction)
end

local function frame(plot, x, y, z)
	return CFrame.new(position(plot, x, y, z))
		* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
end

local function prop(plot, name, x, z, y)
	return Assets.prop(name, plot.model, frame(plot, x, y or 0.5, z))
end

local function detail(plot, name, size, x, y, z, tint, parent)
	local object = part(name, size, position(plot, x, y, z), tint, parent or plot.model)
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	return object
end

local function clearCookies(plot)
	for model in pairs(plot.visuals) do
		model:Destroy()
		plot.visuals[model] = nil
	end
end


function World.updateBank(plot, data)
	plot.bankText.Text = "Collect $" .. Progression.format(data and data.bank or 0)
end

function World.refresh(plot, data, perks)
	local reset = plot.lastUnlocked and (not data or data.unlocked < plot.lastUnlocked)
	plot.data = data
	Conveyor.update(plot, data and Progression.interval(data, perks) or 3)
	plot.lastUnlocked = data and data.unlocked or 0
	if reset then clearCookies(plot) end
	plot.sign.Text = plot.owner and (plot.owner.DisplayName .. "'s Bakery") or "Unclaimed Bakery"
	plot.claimPrompt.Enabled = plot.owner == nil
	plot.claimSurface.Color = plot.owner and plot.theme or Color3.fromRGB(129, 219, 175)
	plot.claimSurface.Material = plot.owner and Enum.Material.SmoothPlastic or Enum.Material.Neon
	World.updateBank(plot, data)
	plot.upgradePad.Color = data and data.level < Progression.MAX_OVEN_LEVEL and Color3.fromRGB(183, 160, 229) or Color3.fromRGB(118, 114, 121)
	plot.upgradeText.Text = not data and "Baking speed" or data.level == Progression.MAX_OVEN_LEVEL and "Speed MAX"
		or "Faster baking\n$" .. Progression.format(Progression.ovenCost(data))
	plot.shopPrompt.Enabled = data ~= nil
	plot.workshopPrompt.Enabled = data ~= nil
	for index, station in ipairs(plot.stations) do
		local unlocked = data ~= nil and index <= data.unlocked
		local nextRecipe = data ~= nil and index == data.unlocked + 1
		local visible = unlocked or nextRecipe or (not data and index == 1)
		station.model.Parent = visible and plot.model or nil
		station.purchaseModel.Parent = nextRecipe and station.model or nil
		local rarity = Crafting.rarity(Recipes[index])
		station.pad.Color = nextRecipe and Color3.fromRGB(255, 214, 139) or plot.theme
		station.text.Text = Recipes[index].Name .. "\n$" .. Progression.format(Recipes[index].Cost)
		station.ovenText.Parent.Enabled = unlocked or not data and index == 1
		station.ovenText.Text = Recipes[index].Name
		station.ovenText.TextColor3 = color(rarity.Color)
		if station.steam then station.steam.Enabled = unlocked end
		station.oven.Color = unlocked and color(rarity.Color) or Color3.fromRGB(106, 112, 119)
		station.window.Color = unlocked and Color3.fromRGB(246, 151, 61) or Color3.fromRGB(48, 59, 66)
		station.window.Material = unlocked and Enum.Material.Neon or Enum.Material.Glass
	end
	local nextStation = data and plot.stations[data.unlocked + 1]
	plot.nextMarker.Adornee = nextStation and nextStation.purchaseModel or nil
	plot.nextMarker.Enabled = nextStation ~= nil
end

function World.spawnPlayer(player, plot)
	if not plot or plot.owner ~= player then return end
	-- The disabled plot spawn is a marker, outside the random neutral spawn pool.
	-- CharacterAdded calls this scripted relocation after each plaza respawn.
	local character = player.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not root or player.Character ~= character or plot.owner ~= player or not player.Parent then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local destination = position(plot, Layout.SpawnX, 4.1, Layout.SpawnZ)
	local nextOven = position(plot, Layout.PadX, 4.1, Layout.station(2).z)
	character:PivotTo(CFrame.lookAt(destination, nextOven))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

function World.releasePlayer(player, plot)
	if player.RespawnLocation == plot.spawn then player.RespawnLocation = nil end
	plot.stepPads:ResetOwner(player)
	clearCookies(plot)
end

function World.create(onClaim, onAction, onShop, onWorkshop)
	Presentation.lighting()
	local world = Instance.new("Folder")
	world.Name = "CookieTycoonWorld"
	world.Parent = workspace
	local stepPads = StepPads.new(world)
	local plots = {}
	local meadow = part("Meadow", Vector3.new(Map.Width, 1, Map.Length), Vector3.new(0, -1, 0), Color3.fromRGB(111, 166, 111), world)
	meadow.Material = Enum.Material.Grass
	Assets.texture(meadow, "MeadowGrass")
	for segment = -14, 14 do
		Assets.prop("PathSegment", world, CFrame.new(0, 0, segment * 40))
	end
	Assets.prop("SpawnPlaza", world, CFrame.new(0, 0.2, 0))
	for _, x in ipairs({ -191, 191 }) do
		for _, z in ipairs({ -510, -360, -225, -85, 85, 225, 360, 510 }) do
			Assets.prop("CookieTree", world, CFrame.new(x, 0, z))
		end
	end
	for _, x in ipairs({ -10, 10 }) do
		for _, z in ipairs({ -510, -360, -220, -70, 70, 220, 360, 510 }) do
			Assets.prop("Lamppost", world, CFrame.new(x, 0.15, z))
		end
	end
	Presentation.world(world)
	local sculpture = Assets.cookie(1, world, CFrame.new(0, 7.6, 19) * CFrame.Angles(math.rad(75), 0, 0))
	sculpture.Name = "Cookie Corner Monument"
	sculpture:ScaleTo(2.9)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Plaza Spawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = world
	label(spawn, "COOKIE CORNER\nClaim a bakery to start", 80)
	for slot = 1, Map.PlayerCount do
		local placement = Map.plot(slot)
		local model = Instance.new("Model")
		model.Name = "Bakery" .. slot
		model.Parent = world
		local plot = {
			model = model, stations = {}, owner = nil, data = nil, visualCursor = 0, visuals = {}, stepPads = stepPads,
			origin = Vector3.new(placement.x, 0, placement.z),
			direction = placement.direction,
		}
		local marker = Instance.new("Highlight")
		marker.Name = "Next Recipe"
		marker.DepthMode = Enum.HighlightDepthMode.Occluded
		marker.FillColor = Color3.fromRGB(255, 211, 129)
		marker.FillTransparency = 0.85
		marker.OutlineColor = Color3.fromRGB(255, 228, 168)
		marker.Enabled = false
		marker.Parent = model
		plot.nextMarker = marker
		table.insert(plots, plot)
		prop(plot, "BakeryFloor", 0, 0, 0)
		prop(plot, "BakeryShell", 0, 0, 0)
		prop(plot, "BakeryAwning", 0, 113)
		Conveyor.create(plot, position)
		local counter = prop(plot, "PrepCounter", -49, -45)
		local worktop = counter:FindFirstChild("Texture_CounterMarble")
		label(worktop, "Cookie toppings", 35)
		plot.workshopPrompt = prompt(worktop, "Open toppings", function(player) onWorkshop(player, plot) end, "Cookie Workshop")
		prop(plot, "IngredientBins", 24, -115)
		prop(plot, "DoughMixer", 42, -115)
		prop(plot, "CoolingRack", 59, -115)
		prop(plot, "Planter", -75, 102)
		prop(plot, "Planter", 75, 102)
		prop(plot, "WoodenFence", -64, 120)
		prop(plot, "WoodenFence", 64, 120)
		local sign = prop(plot, "BakerySign", 0, 120)
		plot.sign = label(Assets.anchor(sign), "Unclaimed Bakery", 85)
		local claim = prop(plot, "ClaimPad", -63, 109)
		plot.claimSurface = claim:FindFirstChild("Claim Surface")
		plot.claimPrompt = prompt(Assets.anchor(claim), "Claim free bakery", function(player) onClaim(player, plot) end, "Cookie Bakery")
		label(Assets.anchor(claim), "Claim bakery", 45)
		local personalSpawn = Instance.new("SpawnLocation")
		personalSpawn.Name = "Bakery Spawn"
		personalSpawn.Size = Vector3.new(5, 0.15, 5)
		personalSpawn.CFrame = frame(plot, Layout.SpawnX, 0.66, Layout.SpawnZ)
		personalSpawn.Anchored = true
		personalSpawn.Enabled = false
		personalSpawn.Transparency = 0.65
		personalSpawn.CanCollide = false
		personalSpawn.CanTouch = false
		personalSpawn.Duration = 0
		personalSpawn.Parent = model
		plot.spawn = personalSpawn
		local collect = prop(plot, "CollectionRegister", 19, 128)
		plot.bankText = label(Assets.anchor(collect), "Collect $0", 45)
		prompt(Assets.anchor(collect), "Collect cash", function(player) onAction(player, "Collect", nil, plot) end, "Bakery Register")
		local upgrade = prop(plot, "UpgradeConsole", -60, Layout.FirstStationZ + 6)
		local speedPadModel = prop(plot, "ClaimPad", -60, Layout.FirstStationZ - 2)
		speedPadModel:ScaleTo(0.6)
		plot.upgradePad = speedPadModel:FindFirstChild("Claim Surface")
		plot.upgradeText = label(Assets.anchor(upgrade), "Baking speed", 35)
		stepPads:Register(plot.upgradePad, {
			Owner = function() return plot.owner end,
			Available = function(player)
				local data = plot.data
				return plot.owner == player and data ~= nil and data.level < Progression.MAX_OVEN_LEVEL and data.cash >= Progression.ovenCost(data)
			end,
			Activate = function(player) return onAction(player, "UpgradeOven", nil, plot) end,
		})
		local shop = prop(plot, "RebirthPedestal", 63, 109)
		label(Assets.anchor(shop), "Golden Chips", 40)
		plot.shopPrompt = prompt(Assets.anchor(shop), "Open upgrades", function(player) onShop(player, plot) end, "Golden Chip Shop")
		for index, recipe in ipairs(Recipes) do
			local geometry = Layout.station(index)
			local stationModel = Instance.new("Model")
			stationModel.Name = string.format("%02d %s", index, recipe.Name)
			stationModel.Parent = model
			local ovenModel = prop(plot, "Oven", geometry.x, geometry.z)
			ovenModel:ScaleTo(geometry.scale)
			-- Original oven doors face +Z; these ovens feed sideways onto the belt.
			ovenModel:PivotTo(CFrame.new(position(plot, geometry.x, 2.3, geometry.z)) * CFrame.Angles(0, math.pi / 2, 0))
			ovenModel.Parent = stationModel
			local bench = detail(plot, "Oven Counter", Vector3.new(6, 1.8, 6.6), geometry.x, 1.4, geometry.z, Color3.fromRGB(127, 100, 83), stationModel)
			bench.CanCollide = true
			local oven = ovenModel:FindFirstChild("RecipeBadge")
			local chute = detail(plot, "Cookie Feed Tray", Vector3.new(1.1, 0.2, 2.8), geometry.laneX - 5.05, Layout.BeltTop - 0.3, geometry.z,
				Color3.fromRGB(126, 143, 150), stationModel)
			chute.Material = Enum.Material.Metal
			local buyModel = prop(plot, "ClaimPad", geometry.padX, geometry.z, 0.55)
			buyModel.Name = "Buy " .. recipe.Name
			buyModel:ScaleTo(0.55)
			buyModel.Parent = stationModel
			local buy = buyModel:FindFirstChild("Claim Surface")
			local station = {
				model = stationModel, ovenModel = ovenModel, oven = oven, window = ovenModel:FindFirstChild("Window"),
				x = geometry.x, z = geometry.z, laneX = geometry.laneX, pad = buy, purchaseModel = buyModel,
				text = label(buy, recipe.Name, 26), ovenText = label(oven, recipe.Name, 24), steam = Presentation.oven(ovenModel),
			}
			station.ovenText.Parent.StudsOffset = Vector3.new(0, 1.5, 0)
			station.ovenText.Parent.Size = UDim2.fromOffset(160, 26)
			stepPads:Register(buy, {
				Owner = function() return plot.owner end,
				Available = function(player)
					local data = plot.data
					return plot.owner == player and data ~= nil and index == data.unlocked + 1 and data.cash >= recipe.Cost
				end,
				Activate = function(player) return onAction(player, "BuyRecipe", index, plot) end,
			})
			table.insert(plot.stations, station)
		end
		Presentation.plot(plot, slot)
		World.refresh(plot, nil)
	end
	return plots
end

function World.animate(plot, data, perks)
	local active = 0
	for model in pairs(plot.visuals) do
		if model.Parent then active += 1 else plot.visuals[model] = nil end
	end
	local count = math.min(2, data.unlocked, Layout.MaxVisualCookies - active)
	for number = 1, count do
		plot.visualCursor = plot.visualCursor % data.unlocked + 1
		local index = plot.visualCursor
		local station = plot.stations[index]
		local start = position(plot, station.laneX + (number - 1) * 0.25, Layout.CookieY, station.z)
		local model = Assets.cookie(index, plot.model, CFrame.new(start), data.modifiers[tostring(index)])
		model.Name = "Physical " .. model.Name
		plot.visuals[model] = true
		model:SetAttribute("CashValue", Progression.recipeValue(data, index, perks))
		local hull = Conveyor.makePhysical(model)
		Conveyor.track(plot, model, hull, math.floor((index - 1) / 10) + 1)
		hull.AssemblyLinearVelocity = Vector3.new(0, 0, Layout.speed(Progression.interval(data, perks)) * plot.direction)
	end
end

return World
]]></string>
