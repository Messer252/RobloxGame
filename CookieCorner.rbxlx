      <Item class="ModuleScript" referent="51">
        <Properties>
          <string name="Name">GlobalRankings</string>
          <string name="Source"><![CDATA[-- Durable ranking index and read cache. Engine-free so outages and offline
-- saves can be tested without contacting Roblox services.
local ProfileStore = if script then require(script.Parent.ProfileStore) else require("./ProfileStore")
local Rankings = {}
Rankings.__index = Rankings
local keys = { "cash", "rebirths" }
local function userId(value)
	local id = tonumber(value)
	return id and id > 0 and id < 2^53 and id % 1 == 0 and id or nil
end
local function score(value)
	return type(value) == "number" and value == value and value >= 0 and value < 2^53 and math.floor(value) or nil
end
function Rankings.new(stores, readProfile, lookupName, clock)
	return setmetatable({ stores = stores, readProfile = readProfile, lookupName = lookupName, clock = clock,
		pending = {}, versions = {}, completed = {}, nextWrite = {}, names = {}, rows = {}, status = {} }, Rankings)
end
function Rankings:Queue(id)
	id = userId(id)
	if not id then return nil end
	self.versions[id] = (self.versions[id] or 0) + 1
	self.pending[id] = self.versions[id]
	return self.versions[id]
end
function Rankings:_complete(id, version, now)
	self.completed[id] = version
	if self.pending[id] == version then self.pending[id] = nil end
	self.nextWrite[id] = now + 30
end
function Rankings:FlushOne()
	local now, id, version = self.clock()
	for candidate, generation in pairs(self.pending) do
		if now >= (self.nextWrite[candidate] or 0) then id, version = candidate, generation; break end
	end
	if not id then return false end
	self.nextWrite[id] = now + 5
	-- Always read committed profile data, never unsaved wallet state or client
	-- input. This also lets the one-time backfill index offline players.
	local ok, saved = pcall(self.readProfile, id)
	if not ok then return false, "read_failed" end
	if saved ~= nil then
		if type(saved) ~= "table" or type(saved.Version) ~= "number" or saved.Version % 1 ~= 0 or saved.Version < 1 or saved.Version > ProfileStore.CURRENT_VERSION or type(saved.Data) ~= "table" then
			self:_complete(id, version, now)
			return true, "unsupported_profile"
		end
		local values = { cash = score(saved.Data.cash), rebirths = score(saved.Data.rebirths) }
		if values.cash == nil or values.rebirths == nil then self:_complete(id, version, now); return true, "invalid_scores" end
		for _, key in ipairs(keys) do
			local written = pcall(function() self.stores[key]:SetAsync(tostring(id), values[key]) end)
			if not written then return false, "write_failed" end
		end
		-- A departing server can still be finishing an index write while another
		-- server saves a newer wallet. Re-read after writing and repair that race,
		-- including decreases, instead of leaving an offline player stale forever.
		local checked, latest = pcall(self.readProfile, id)
		if not checked then return false, "read_failed" end
		if type(latest) ~= "table" or type(latest.Data) ~= "table" or latest.Data.cash ~= saved.Data.cash or latest.Data.rebirths ~= saved.Data.rebirths then
			self:Queue(id)
			return false, "changed_during_write"
		end
	end
	self:_complete(id, version, now)
	return true
end
function Rankings:_name(id)
	local now, cached = self.clock(), self.names[id]
	if cached and cached.expires > now then return cached.value end
	local ok, name = pcall(self.lookupName, id)
	ok = ok and type(name) == "string" and name ~= ""
	if not ok then
		name = cached and cached.value or ("User " .. id)
	end
	self.names[id] = { value = name, expires = now + (ok and 3600 or 60) }
	return name
end
function Rankings:Refresh(key)
	if not self.stores[key] then return false end
	local ok, entries = pcall(function() return self.stores[key]:GetSortedAsync(false, 8):GetCurrentPage() end)
	if not ok then
		self.status[key] = self.rows[key] and "Cached • reconnecting" or "Global rankings unavailable"
		return false
	end
	local rows = {}
	for _, entry in ipairs(entries) do
		local id, value = userId(entry.key), score(entry.value)
		if id and value then table.insert(rows, { userId = id, name = self:_name(id), [key] = value }) end
	end
	table.sort(rows, function(a, b) return a[key] == b[key] and a.userId < b.userId or a[key] > b[key] end)
	self.rows[key], self.status[key] = rows, "Saved rankings • refresh every 60s"
	return true
end
function Rankings:Get(key)
	return self.rows[key] or {}, self.status[key] or "Loading global rankings…"
end
function Rankings:Backfill(profileStore, cursor, lease, wait, closing)
	local ok, pages = pcall(function() return profileStore:ListKeysAsync("Player_", 20, cursor, true) end)
	if not ok then return false end
	while not closing() do
		local goals = {}
		for _, key in ipairs(pages:GetCurrentPage()) do
			local id = tonumber(key.KeyName:match("^Player_(%d+)$"))
			if id then goals[id] = self:Queue(id) end
		end
		local renew = self.clock() + 45
		while not closing() do
			local complete = true
			for id, version in pairs(goals) do if (self.completed[id] or 0) < version then complete = false end end
			if complete then break end
			if self.clock() >= renew then
				if not lease(nil, false) then return false end
				renew = self.clock() + 45
			end
			wait(1)
		end
		if closing() then return false end
		if pages.IsFinished then return lease(nil, true) end
		-- Cursor points to the NEXT page. Persist it after indexing this page,
		-- before advancing, so a restart cannot skip unindexed offline profiles.
		if not lease(pages.Cursor, false) then return false end
		local advanced = pcall(function() pages:AdvanceToNextPageAsync() end)
		if not advanced then return false end
	end
	return false
end
return Rankings
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="52">
        <Properties>
          <string name="Name">LeaderboardServer</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local Http = game:GetService("HttpService")
local Rankings = require(script.Parent.GlobalRankings)
local Server = {}
Server.__index = Server

local function unavailable()
	error("Global leaderboard storage is unavailable")
end
function Server.start(profileStore, settings)
	local stores = {}
	for key, suffix in pairs({cash = "Cash", rebirths = "Rebirths"}) do
		local ok, store = pcall(function() return DataStoreService:GetOrderedDataStore(settings.DataStoreName .. "_Global" .. suffix .. "_v1") end)
		stores[key] = ok and store or {SetAsync = unavailable, GetSortedAsync = unavailable}
	end
	local options = Instance.new("DataStoreGetOptions")
	options.UseCache = false
	local self = setmetatable({ closing = false, backfillDone = false }, Server)
	self.index = Rankings.new(stores, function(id) return profileStore:GetAsync("Player_" .. id, options) end,
		function(id) return Players:GetNameFromUserIdAsync(id) end, os.clock)
	task.spawn(function()
		while not self.closing do
			self.writing = true
			local success, _, reason = pcall(function() return self.index:FlushOne() end)
			self.writing = false
			if not success then reason = "index_worker_failed" end
			if reason and os.clock() >= (self.nextWarning or 0) then
				self.nextWarning = os.clock() + 60
				warn("Cookie Corner: global ranking " .. ((reason == "unsupported_profile" or reason == "invalid_scores") and "skipped an incompatible save: " or "update pending: ") .. reason)
			end
			-- At most 30 ordered writes/minute while importing old saves.
			task.wait(4)
		end
	end)
	task.spawn(function()
		while not self.closing do
			self.index:Refresh("cash")
			self.index:Refresh("rebirths")
			task.wait(60)
		end
	end)
	task.spawn(function()
		while not self.closing and not self.backfillDone do
			self:Backfill(profileStore, settings)
			if not self.backfillDone then task.wait(60) end
		end
	end)
	return self
end
function Server:Queue(id) return self.index:Queue(id) end
function Server:Get(key) return self.index:Get(key) end
function Server:Shutdown(deadline)
	self.closing = true
	while self.writing and os.clock() < deadline do task.wait(.1) end
	if self.writing then return end
	-- Final profile saves take priority; use any remaining shutdown time to
	-- publish their final rankings, bypassing only the ordinary write cooldown.
	for id in pairs(self.index.pending) do self.index.nextWrite[id] = 0 end
	while next(self.index.pending) and os.clock() < deadline do
		self.index:FlushOne()
		task.wait(.1)
	end
end

-- One server imports old offline profiles at a time. A saved cursor and lease
-- resume interrupted work without scanning every profile on every server join.
function Server:Backfill(profileStore, settings)
	local token = Http:GenerateGUID(false)
	local ok, migration = pcall(function() return DataStoreService:GetDataStore(settings.DataStoreName .. "_GlobalBackfill_v1") end)
	if not ok then return end
	local function lease(cursor, done, claim)
		local succeeded, result = pcall(function()
			return migration:UpdateAsync("Import", function(current)
				current = current or {}
				if current.Done then return current end
				if current.Owner ~= token and (not claim or (current.Expires or 0) > os.time()) then return nil end
				return {Owner = token, Expires = os.time() + 180, Cursor = cursor or current.Cursor or "", Done = done == true}
			end)
		end)
		return succeeded and result or nil
	end
	local claim = lease(nil, false, true)
	if not claim then return end
	if claim.Done then self.backfillDone = true; return end
	self.backfillDone = self.index:Backfill(profileStore, claim.Cursor, function(cursor, done)
		local renewed = lease(cursor, done, false)
		return renewed ~= nil and renewed.Owner == token
	end, task.wait, function() return self.closing end)
end
return Server
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="53">
        <Properties>
          <string name="Name">NaturalTerrain</string>
          <string name="Source"><![CDATA[local Shape = require(game:GetService("ReplicatedStorage").CookieTycoon.TerrainShape)
local Natural = {}
function Natural.create()
	local terrain = workspace.Terrain
	terrain:SetMaterialColor(Enum.Material.Grass, Color3.fromRGB(106, 143, 76))
	terrain:SetMaterialColor(Enum.Material.Rock, Color3.fromRGB(122, 131, 136))
	terrain:SetMaterialColor(Enum.Material.Snow, Color3.fromRGB(229, 237, 239))
	local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
	clouds.Cover, clouds.Density, clouds.Color, clouds.Parent = 0.48, 0.35, Color3.fromRGB(247, 249, 251), terrain
	task.spawn(function()
		-- Bounded chunks keep peak memory low; yield so joining players can load.
		for chunkX = -1056, 1024, 32 do
			for chunkZ = -1248, 1216, 32 do
				local heights, surfaces, highest = {}, {}, 0
				for x = 1, 8 do
					heights[x], surfaces[x] = {}, {}
					for z = 1, 8 do
						local wx, wz = chunkX + (x - 0.5) * 4, chunkZ + (z - 0.5) * 4
						local h = Shape.height(wx, wz)
						heights[x][z] = h
						surfaces[x][z] = Shape.grassAllowed(wx, wz) and Enum.Material.Grass or Enum.Material.Ground
						-- Dirt walking trails through the outer forest.
						if math.abs(wx) > 210 and math.abs(wx) < 420 and math.abs(wx - (wx < 0 and -205 or 205) - math.sin(wz / 70) * 12) < 5 then surfaces[x][z] = Enum.Material.Ground end
						highest = math.max(highest, h)
					end
				end
				local top = math.ceil((highest + 4) / 4) * 4
				local ny = (top + 20) / 4
				local materials, occupancy = {}, {}
				for x = 1, 8 do
					materials[x], occupancy[x] = {}, {}
					for y = 1, ny do
						materials[x][y], occupancy[x][y] = {}, {}
						for z = 1, 8 do
							local wx, wz, bottom = chunkX + (x - 0.5) * 4, chunkZ + (z - 0.5) * 4, -20 + (y - 1) * 4
							local h, material = heights[x][z], surfaces[x][z]
							if Shape.lake(wx, wz) then
								h = 0; material = bottom > -12 and Enum.Material.Water or Enum.Material.Rock
							elseif h > 58 and h - bottom < 9 then material = Shape.snow(wx, wz, h) and Enum.Material.Snow or Enum.Material.Rock
							elseif h - bottom > 8 then material = Enum.Material.Rock end
							materials[x][y][z], occupancy[x][y][z] = material, math.clamp((h - bottom) / 4, 0, 1)
						end
					end
				end
				terrain:WriteVoxels(Region3.new(Vector3.new(chunkX, -20, chunkZ), Vector3.new(chunkX + 32, top, chunkZ + 32)), 4, materials, occupancy)
			end
			 task.wait()
		end
	end)
end
return Natural
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="54">
        <Properties>
          <string name="Name">ObbyWorld</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Catalog = require(ReplicatedStorage.CookieTycoon.ObbyCatalog)
local Progress = require(ReplicatedStorage.CookieTycoon.ObbyProgress)
local ObbyWorld = {}

local function platform(parent, name, position, width, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.Position = name, Vector3.new(width, 1, width), position
	object.Color, object.Anchored = tint, true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function sign(target, value)
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.StudsOffset, gui.MaxDistance = UDim2.fromOffset(220, 65), Vector3.new(0, 4, 0), 75
	gui.Parent = target
	local text = Instance.new("TextLabel")
	text.Size, text.BackgroundTransparency = UDim2.fromScale(1, 1), 0.15
	text.BackgroundColor3, text.TextColor3 = Color3.fromRGB(62, 45, 40), Color3.fromRGB(255, 238, 204)
	text.Text, text.TextSize, text.Font = value, 16, Enum.Font.GothamBold
	text.Parent = gui
end

local function standing(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 or root.AssemblyLinearVelocity.Y > 5 then return nil end
	local params = RaycastParams.new()
	params.FilterType, params.FilterDescendantsInstances = Enum.RaycastFilterType.Exclude, { character }
	local height = humanoid.HipHeight + root.Size.Y / 2 + (humanoid.RigType == Enum.HumanoidRigType.R6 and 2 or 0)
	for _, offset in ipairs({ Vector3.zero, Vector3.new(0.7, 0, 0), Vector3.new(-0.7, 0, 0), Vector3.new(0, 0, 0.7), Vector3.new(0, 0, -0.7) }) do
		local hit = workspace:Raycast(root.Position + offset, Vector3.new(0, -height - 0.9, 0), params)
		if hit and root.Position.Y - hit.Position.Y >= height - 1 then return hit.Instance, root end
	end
	return nil
end

function ObbyWorld.create(parent, onComplete, notify)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Cookie Obbys", parent
	local courses, runs, resets, completed = {}, {}, {}, {}
	for _, definition in ipairs(Catalog) do
		local model = Instance.new("Model")
		model.Name, model.Parent = definition.Id .. " Obby", folder
		local tint = Color3.fromRGB(table.unpack(definition.Color))
		local start = platform(model, "Start", Vector3.new(230, 0.4, definition.Z), 10, tint)
		sign(start, definition.Id .. " Obby\n+" .. math.floor(definition.Bonus * 100) .. "% income • 5 minutes")
		local floor = platform(model, "Soft Reset Floor", Vector3.new(325, 0.05, definition.Z), 1, Color3.fromRGB(209, 172, 150))
		floor.Size = Vector3.new(185, 0.2, 55)
		local path = {}
		for index = 1, definition.Count do
			local p = Catalog.platform(definition, index)
			local step = platform(model, "Checkpoint " .. index, Vector3.new(p.x, p.y, p.z), definition.Width, tint)
			step.Material = Enum.Material.Slate
			local trim = platform(model, "Checkpoint Trim", step.Position - Vector3.new(0, 0.35, 0), definition.Width + 0.25, Color3.fromRGB(87, 67, 53))
			trim.Size, trim.CanCollide, trim.CanQuery = Vector3.new(definition.Width + 0.25, 0.2, definition.Width + 0.25), false, false
			table.insert(path, step)
			if index == definition.Count then
				sign(step, "FINISH\n" .. definition.Id .. " • Cash boost")
				local back = Instance.new("ProximityPrompt")
				back.ActionText, back.ObjectText, back.HoldDuration = "Return to plaza", definition.Id .. " finish", 0
				back.MaxActivationDistance, back.RequiresLineOfSight, back.Parent = 8, false, step
				back.ActionText = "Claim boost / return"
				back.Triggered:Connect(function(player)
					local surface, root = standing(player)
					if surface ~= step or completed[player] ~= definition.Id then
						notify(player, "Land on every checkpoint, then wait for your finish reward.")
						return
					end
					completed[player] = nil
					player.Character:PivotTo(CFrame.new(0, 5, -9))
					root.AssemblyLinearVelocity = Vector3.zero
				end)
			end
		end
		table.insert(courses, { definition = definition, start = start, floor = floor, path = path })
	end
	Players.PlayerRemoving:Connect(function(player) runs[player], resets[player], completed[player] = nil, nil, nil end)
	task.spawn(function()
		while folder.Parent do
			local now = os.clock()
			for _, player in ipairs(Players:GetPlayers()) do
				local surface, root = standing(player)
				local run = runs[player]
				if run and run.character ~= player.Character then runs[player], run = nil, nil end
				if surface then
					for _, course in ipairs(courses) do
						local definition = course.definition
						if surface == course.start and (not run or run.course ~= definition.Id or run.stage > 0) then
							run = Progress.start(definition, now)
							run.character = player.Character
							runs[player], completed[player] = run, nil
							notify(player, definition.Id .. " started. Land on each platform in order.")
						elseif run and run.course == definition.Id then
							if run.stage < definition.Count and surface == course.path[run.stage + 1] then
								Progress.advance(run, definition, run.stage + 1, now)
							end
							if run.stage == definition.Count and not run.awarded then
								if onComplete(player, definition.Id) == true then
									run.awarded = true
									completed[player], runs[player], run = definition.Id, nil, nil
									notify(player, definition.Id .. " complete! Check the HUD boost timer.")
								end
							elseif surface == course.floor and now >= (resets[player] or 0) then
								resets[player], runs[player], run = now + 1, nil, nil
								player.Character:PivotTo(CFrame.new(course.start.Position + Vector3.new(0, 4, 0)))
								root.AssemblyLinearVelocity = Vector3.zero
								notify(player, "Try again! Your current boost stays active.")
							end
						end
					end
				end
			end
			task.wait(0.04)
		end
	end)
	return folder
end
return ObbyWorld
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="55">
        <Properties>
          <string name="Name">OvenDesign</string>
          <string name="Source"><![CDATA[local Recipes = require(game:GetService("ReplicatedStorage").CookieTycoon.Recipes)
local Assets = require(script.Parent.AssetLibrary)
local Design = {}
function Design.create(index, parent, frame)
	local recipe = Recipes[index]
	local base, accent = Color3.fromRGB(table.unpack(recipe.Color)), Color3.fromRGB(table.unpack(recipe.Accent))
	local model = Instance.new("Model")
	model.Name, model.Parent = recipe.Name .. " Signature Oven", parent
	local family = (index - 1) % 5
	local function p(name, size, x, y, z, color, material, shape)
		local part = Instance.new("Part")
		part.Name, part.Size, part.CFrame, part.Color, part.Material = name, size, frame * CFrame.new(x, y, z), color, material or Enum.Material.Metal
		part.Anchored, part.CanCollide, part.CanTouch, part.Parent = true, true, false, model
		if shape then part.Shape = shape end
		return part
	end
	local body = p("Enamel Oven Body", Vector3.new(4.6, 3.7, 4.5), 0, 0, 0, base:Lerp(Color3.new(1, 1, 1), 0.23), family == 3 and Enum.Material.Brick or Enum.Material.Metal)
	model.PrimaryPart = body
	p("Stone Baking Plinth", Vector3.new(5.3, 0.4, 5), 0, -1.95, 0, accent, Enum.Material.Slate)
	p("Brass Door Frame", Vector3.new(3.7, 2.5, 0.24), 0, -0.15, 2.34, Color3.fromRGB(202, 170, 108))
	p("Window", Vector3.new(3.2, 1.75, 0.1), 0, -0.3, 2.5, Color3.fromRGB(255, 167, 73), Enum.Material.Neon)
	p("Oven Door Handle", Vector3.new(2.5, 0.18, 0.2), 0, 0.85, 2.65, accent)
	for _, x in ipairs({ -1.8, 1.8 }) do
		p("Rounded Casing Edge", Vector3.new(0.35, 3.7, 0.35), x, 0, 2.2, accent)
		p("Dial", Vector3.new(0.38, 0.38, 0.12), x, 1.4, 2.38, Color3.fromRGB(237, 219, 175), Enum.Material.Metal, Enum.PartType.Ball)
	end
	local roof = p("Recipe Canopy", Vector3.new(5.1, 0.5 + family * 0.12, 4.9), 0, 2.0, 0, accent)
	if family == 1 then roof.Shape = Enum.PartType.Ball; roof.Size = Vector3.new(5, 1.5, 4.9) end
	if family == 2 then
		for _, x in ipairs({ -1.8, 0, 1.8 }) do p("Patisserie Crown", Vector3.new(0.5, 0.9, 0.5), x, 2.8, 0, base, Enum.Material.Glass, Enum.PartType.Ball) end
	elseif family == 3 then
		p("Artisan Chimney", Vector3.new(1.1, 1.8, 1.1), -1.2, 3.0, -1.2, accent, Enum.Material.Brick)
	elseif family == 4 then
		for _, x in ipairs({ -1.7, 1.7 }) do p("Crystal Trim", Vector3.new(0.3, 4.3, 0.3), x, 0.3, -2.2, base, Enum.Material.Neon) end
	end
	p("Chimney", Vector3.new(0.7, 0.7, 0.7), 1.4, 2.7, -1.5, Color3.fromRGB(85, 89, 90))
	local badge = p("RecipeBadge", Vector3.new(1.1, 0.35, 1.1), 0, 2.65, 0, base, Enum.Material.SmoothPlastic)
	badge.Transparency = 1
	local cookie = Assets.cookie(index, model, frame * CFrame.new(0, 3.0, 0))
	cookie:ScaleTo(0.45)
	for _, part in ipairs(cookie:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide, part.CanQuery = false, false end end
	return model
end
return Design
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="56">
        <Properties>
          <string name="Name">PlazaExtras</string>
          <string name="Source"><![CDATA[local Progression = require(game:GetService("ReplicatedStorage").CookieTycoon.Progression)
local Extras = {}

local function part(parent, name, size, frame, tint)
	local object = Instance.new("Part")
	object.Name, object.Size, object.CFrame, object.Color = name, size, frame, tint
	object.Anchored = true
	object.TopSurface, object.BottomSurface = Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function writing(target, text, size)
	local surface = Instance.new("SurfaceGui")
	surface.Face, surface.CanvasSize, surface.Parent = Enum.NormalId.Front, Vector2.new(700, 650), target
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundTransparency, label.Text = UDim2.fromScale(1, 1), 1, text
	label.TextColor3, label.Font, label.TextSize = Color3.fromRGB(255, 235, 199), Enum.Font.GothamBold, size or 32
	label.Parent = surface
	return label
end

local function ranking(board, key)
	local gui = Instance.new("SurfaceGui")
	gui.Face, gui.CanvasSize, gui.LightInfluence, gui.Parent = Enum.NormalId.Front, Vector2.new(700, 650), 0, board
	local background = Instance.new("Frame")
	background.Size, background.BackgroundColor3, background.BorderSizePixel, background.Parent = UDim2.fromScale(1, 1), Color3.fromRGB(35, 52, 53), 0, gui
	local function text(value, x, y, width, height, size, color)
		local t = Instance.new("TextLabel")
		t.Text, t.Position, t.Size, t.TextSize = value, UDim2.fromOffset(x, y), UDim2.fromOffset(width, height), size
		t.Font, t.TextColor3, t.BackgroundTransparency, t.TextXAlignment, t.Parent = Enum.Font.GothamBold, color or Color3.fromRGB(247, 234, 209), 1, Enum.TextXAlignment.Left, background
		return t
	end
	text(key == "cash" and "BAKERY FORTUNES" or "GOLDEN LEGENDS", 34, 20, 640, 58, 39, Color3.fromRGB(242, 203, 128))
	text(key == "cash" and "MOST SAVED WALLET CASH • ALL SERVERS" or "MOST REBIRTHS • ALL SERVERS", 36, 83, 630, 30, 20)
	local rows = {}
	for i = 1, 8 do
		local y = 133 + (i - 1) * 55
		local strip = Instance.new("Frame")
		strip.Position, strip.Size, strip.BorderSizePixel, strip.BackgroundColor3, strip.BackgroundTransparency, strip.Parent = UDim2.fromOffset(24, y), UDim2.fromOffset(652, 49), 0, Color3.fromRGB(255, 244, 219), i % 2 == 0 and 0.96 or 0.91, background
		text(string.format("%02d", i), 37, y, 55, 49, 27, i <= 3 and Color3.fromRGB(242, 203, 128) or Color3.fromRGB(164, 195, 187))
		local name = text("—", 104, y, 330, 49, 24)
		name.TextTruncate = Enum.TextTruncate.AtEnd
		local amount = text("", 438, y, 220, 49, 27, Color3.fromRGB(164, 222, 191))
		amount.TextXAlignment = Enum.TextXAlignment.Right
		table.insert(rows, { name = name, amount = amount })
	end
	local status = text("Loading global rankings…", 36, 600, 640, 28, 18, Color3.fromRGB(155, 185, 179))
	return { rows = rows, status = status }
end

function Extras.create(parent, rankings)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Plaza Extras", parent
	local boards = {}
	for index, key in ipairs({ "cash", "rebirths" }) do
		local x = index == 1 and -53 or 53
		local frame = CFrame.lookAt(Vector3.new(x, 7, -5), Vector3.new(0, 7, 0))
		for _, side in ipairs({ -6.8, 6.8 }) do
			part(folder, "Leaderboard Post", Vector3.new(0.8, 12, 0.8), frame * CFrame.new(side, -3.5, 0.4), Color3.fromRGB(92, 61, 46))
		end
		part(folder, "Leaderboard Brass Frame", Vector3.new(17.7, 15.7, 0.65), frame * CFrame.new(0, 0, 0.15), Color3.fromRGB(189, 149, 88))
		part(folder, "Leaderboard Stone Footing", Vector3.new(19, 0.7, 4), CFrame.new(x, 0.2, -5), Color3.fromRGB(141, 146, 137))
		local board = part(folder, "Most " .. key, Vector3.new(17, 15, 0.6), frame, Color3.fromRGB(68, 49, 43))
		boards[key] = ranking(board, key)
	end
	local center = CFrame.lookAt(Vector3.new(25, 1.9, -16), Vector3.new(0, 1.9, 0))
	local cardboard = Color3.fromRGB(185, 143, 94)
	local box = part(folder, "Zach's Box", Vector3.new(5, 3.5, 4), center, cardboard)
	local label = writing(box, "Zach's Box", 68)
	label.TextColor3 = Color3.fromRGB(62, 44, 30)
	part(folder, "Packing Tape", Vector3.new(0.75, 0.03, 4.02), center * CFrame.new(0, 1.77, 0), Color3.fromRGB(223, 193, 139))
	for _, side in ipairs({ -1, 1 }) do
		part(folder, "Cardboard Fold", Vector3.new(0.04, 3.3, 0.04), center * CFrame.new(side * 2.3, 0, -2.02), Color3.fromRGB(125, 89, 55))
	end
	task.spawn(function()
		while folder.Parent do
			for key, board in pairs(boards) do
				local ordered, status = rankings:Get(key)
				board.status.Text = status
				for index, row in ipairs(board.rows) do
					local record = ordered[index]
					row.name.Text = record and record.name or "—"
					row.amount.Text = record and ((key == "cash" and "$" or "") .. Progression.format(record[key])) or ""
				end
			end
			task.wait(2)
		end
	end)
end

return Extras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="57">
        <Properties>
          <string name="Name">PlotMirror</string>
          <string name="Source"><![CDATA[local Mirror = {}
function Mirror.apply(plot)
	for _, object in ipairs(plot.model:GetDescendants()) do
		if object:IsA("BasePart") then
			local cf = object.CFrame
			local p, r, u, back = cf.Position - plot.origin, cf.RightVector, cf.UpVector, -cf.LookVector
			object.CFrame = CFrame.fromMatrix(plot.origin + Vector3.new(-p.X, p.Y, p.Z),
				Vector3.new(r.X, -r.Y, -r.Z), Vector3.new(-u.X, u.Y, u.Z), Vector3.new(-back.X, back.Y, back.Z))
			local direction = object:GetAttribute("Direction")
			if direction then
				direction = Vector3.new(-direction.X, direction.Y, direction.Z)
				object:SetAttribute("Direction", direction)
				object.AssemblyLinearVelocity = direction * plot.beltSpeed
			end
		end
	end
	plot.mirrorX = -1
end
return Mirror
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="58">
        <Properties>
          <string name="Name">Presentation</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Presentation = {}

local cream = Color3.fromRGB(255, 239, 210)
local cocoa = Color3.fromRGB(89, 58, 48)
local gold = Color3.fromRGB(255, 211, 129)
local themes = {
	Color3.fromRGB(126, 192, 171), Color3.fromRGB(225, 146, 157),
	Color3.fromRGB(171, 157, 211), Color3.fromRGB(228, 186, 116),
}

local function part(parent, name, size, frame, tint, material)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.CFrame = frame
	object.Color = tint
	object.Material = material or Enum.Material.SmoothPlastic
	object.Anchored = true
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function light(target, brightness, range)
	local object = Instance.new("PointLight")
	object.Color = Color3.fromRGB(255, 218, 157)
	object.Brightness = brightness
	object.Range = range
	object.Shadows = false
	object.Parent = target
	return object
end

function Presentation.lighting()
	Lighting.ClockTime = 15.5
	Lighting.Brightness = 2.2
	Lighting.GlobalShadows = true
	Lighting.ShadowSoftness = 0.4
	Lighting.Ambient = Color3.fromRGB(130, 112, 112)
	Lighting.OutdoorAmbient = Color3.fromRGB(162, 151, 135)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 239, 217)
	Lighting.EnvironmentDiffuseScale = 0.65
	Lighting.EnvironmentSpecularScale = 0.4
	Lighting.ExposureCompensation = 0.05
	-- LightingStyle replaced the older, restricted Technology property.
	pcall(function() Lighting.LightingStyle = Enum.LightingStyle.Soft end)
	for _, name in ipairs({ "CookieAtmosphere", "CookieBloom", "CookieColor", "CookieSun" }) do
		local previous = Lighting:FindFirstChild(name)
		if previous then previous:Destroy() end
	end
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Name = "CookieAtmosphere"
	atmosphere.Density = 0.24
	atmosphere.Offset = 0.15
	atmosphere.Color = Color3.fromRGB(207, 226, 239)
	atmosphere.Decay = Color3.fromRGB(112, 147, 171)
	atmosphere.Haze = 1.5
	atmosphere.Glare = 0.08
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Name = "CookieBloom"
	bloom.Intensity = 0.16
	bloom.Size = 24
	bloom.Threshold = 1.65
	bloom.Parent = Lighting
	local correction = Instance.new("ColorCorrectionEffect")
	correction.Name = "CookieColor"
	correction.Brightness = 0.015
	correction.Contrast = 0.08
	correction.Saturation = 0.1
	correction.TintColor = Color3.fromRGB(253, 253, 248)
	correction.Parent = Lighting
	local sun = Instance.new("SunRaysEffect")
	sun.Name = "CookieSun"
	sun.Intensity = 0.025
	sun.Spread = 0.8
	sun.Parent = Lighting
end

function Presentation.world(world)
	for _, object in ipairs(world:GetDescendants()) do
		if object:IsA("BasePart") and object.Name == "Lamp" then light(object, 0.6, 20) end
	end
	for _, x in ipairs({ -14.6, 14.6 }) do
		part(world, "Cream Path Border", Vector3.new(0.7, 0.25, 1140), CFrame.new(x, 0.15, 0), cream, Enum.Material.Concrete)
	end
	for _, x in ipairs({ -34, 34 }) do
		local seat = part(world, "Plaza Bench", Vector3.new(12, 0.6, 4), CFrame.new(x, 2.1, 0), cocoa, Enum.Material.WoodPlanks)
		seat.CanCollide = true
		for _, offset in ipairs({ -4, 4 }) do
			part(world, "Bench Leg", Vector3.new(0.6, 2, 3), CFrame.new(x + offset, 1, 0), cocoa, Enum.Material.Metal)
		end
		part(world, "Bench Back", Vector3.new(12, 2.7, 0.5), CFrame.new(x, 3.5, 1.8), cream, Enum.Material.WoodPlanks)
	end
	local base = part(world, "Cookie Monument Plinth", Vector3.new(0.7, 10, 10),
		CFrame.new(0, 0.7, 19) * CFrame.Angles(0, 0, math.pi / 2), cream, Enum.Material.Marble)
	base.Shape = Enum.PartType.Cylinder
	part(world, "Monument Pedestal", Vector3.new(5, 3.4, 5), CFrame.new(0, 2.6, 19), cocoa, Enum.Material.Wood)
end

function Presentation.plot(plot, slot)
	local theme = themes[(slot - 1) % #themes + 1]
	plot.theme = theme
	for _, object in ipairs(plot.model:GetDescendants()) do
		if not object:IsA("BasePart") then continue end
		if object.Name == "Texture_WallTile" then object.Color = cream:Lerp(theme, 0.16) end
		if object.Name == "Canopy Stripe" and object.Color.R < 0.85 then object.Color = theme end
		if object.Name == "Texture_BakeryFloor" then
			object.Color = Color3.fromRGB(240, 221, 195)
			object.Material = Enum.Material.SmoothPlastic
		end
	end
	local function frame(x, y, z)
		return CFrame.new(plot.origin + Vector3.new(x * (plot.mirrorX or 1), y, z * plot.direction))
			* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
	end
	for column = 0, 3 do
		for row = 0, 5 do
			if (column + row) % 2 == 0 then
				part(plot.model, "Vanilla Floor Tile", Vector3.new(39.8, 0.035, 39.8), frame(-60 + column * 40, 0.525, -100 + row * 40),
					Color3.fromRGB(255, 243, 223))
			end
		end
	end
	part(plot.model, "Bakery Walkway", Vector3.new(7, 0.035, 232), frame(-24, 0.565, 0), theme:Lerp(cream, 0.55))
	for _, x in ipairs({ -60, -30, 0, 30, 60 }) do
		part(plot.model, "Window Frame", Vector3.new(22, 7.6, 0.28), frame(x, 7.1, -119.9), cocoa)
		local window = part(plot.model, "Pastel Window", Vector3.new(20.7, 6.3, 0.3), frame(x, 7.1, -119.65),
			Color3.fromRGB(190, 220, 219), Enum.Material.Glass)
		window.Transparency = 0.15
		part(plot.model, "Window Mullion", Vector3.new(0.3, 6.5, 0.35), frame(x, 7.1, -119.4), cream)
	end
	for _, z in ipairs({ -80, 40, 112 }) do
		for _, x in ipairs({ -77, 77 }) do
			part(plot.model, "String Light Post", Vector3.new(0.5, 16, 0.5), frame(x, 8, z), cocoa, Enum.Material.Wood)
		end
		local previous
		for index = 0, 10 do
			local x = -77 + index * 15.4
			local y = 16 - math.sin(index / 10 * math.pi) * 1.8
			local anchor = frame(x, y, z).Position
			if previous then
				local length = (anchor - previous).Magnitude
				part(plot.model, "Light Cable", Vector3.new(0.07, 0.07, length),
					CFrame.lookAt((anchor + previous) / 2, anchor), cocoa)
			end
			previous = anchor
			if index == 0 or index == 10 then continue end
			local bulb = part(plot.model, "Warm String Bulb", Vector3.new(0.65, 0.85, 0.65), frame(x, y - 0.35, z), gold, Enum.Material.Neon)
			bulb.Shape = Enum.PartType.Ball
			bulb.CastShadow = false
			if index == 3 or index == 7 then light(bulb, 0.3, 27) end
		end
	end
end

function Presentation.oven(oven)
	local chimney = oven:FindFirstChild("Chimney")
	if not chimney then return nil end
	local attachment = Instance.new("Attachment")
	attachment.Position = Vector3.new(0, chimney.Size.Y / 2, 0)
	attachment.Parent = chimney
	local steam = Instance.new("ParticleEmitter")
	steam.Name = "Bakery Steam"
	steam.Texture = "rbxasset://textures/particles/smoke_main.dds"
	steam.Color = ColorSequence.new(Color3.fromRGB(255, 247, 228))
	steam.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.45), NumberSequenceKeypoint.new(1, 1.9) })
	steam.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.25, 0.82), NumberSequenceKeypoint.new(1, 1) })
	steam.Lifetime = NumberRange.new(1.5, 2)
	steam.Speed = NumberRange.new(1.2, 1.7)
	steam.Rate = 0.7
	steam.SpreadAngle = Vector2.new(12, 12)
	steam.RotSpeed = NumberRange.new(-20, 20)
	steam.Acceleration = Vector3.new(0.25, 0.5, 0)
	steam.Enabled = false
	steam.Parent = attachment
	return steam
end

return Presentation
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="59">
        <Properties>
          <string name="Name">ProfileStore</string>
          <string name="Source"><![CDATA[-- DataStore adapter with no engine dependencies, allowing failure/concurrency tests.
-- All writes check the session token inside UpdateAsync; stale servers cannot overwrite.
local ProfileStore = {}
ProfileStore.__index = ProfileStore
-- Version 8 adds persistent cards and Star Crumbs while retaining existing
-- ownership, paid receipt, gift recovery, and job progress records.
ProfileStore.CURRENT_VERSION = 8

local function validRecord(current)
	if type(current) ~= "table" or type(current.Version) ~= "number" or current.Version % 1 ~= 0
		or current.Version < 1 or current.Version > ProfileStore.CURRENT_VERSION or type(current.Data) ~= "table" then return false end
	if current.Receipts ~= nil and type(current.Receipts) ~= "table" then return false end
	if current.Version >= 2 and current.Receipts == nil then return false end
	for id, productId in pairs(current.Receipts or {}) do
		if type(id) ~= "string" or #id == 0 or #id > 200 or type(productId) ~= "number"
			or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then return false end
	end
	return true
end

local function receiptsCopy(receipts)
	local result = {}
	for id, productId in pairs(receipts or {}) do result[id] = productId end
	return result
end

function ProfileStore.new(store, options)
	return setmetatable({
		store = store,
		clock = options.clock,
		wait = options.wait,
		copy = options.copy,
		lease = options.lease or 180,
	}, ProfileStore)
end

function ProfileStore:_update(key, transform)
	local lastError
	for attempt = 1, 3 do
		local success, result = pcall(function() return self.store:UpdateAsync(key, transform) end)
		if success then return true, result end
		lastError = result
		if attempt < 3 then self.wait(attempt) end
	end
	return false, lastError
end

function ProfileStore:Load(userId, token)
	local key = "Player_" .. tostring(userId)
	local reason
	local ok, result = self:_update(key, function(current)
		reason = nil
		if current ~= nil then
			if not validRecord(current) then
				reason = "unsupported"
				return nil
			end
			local session = current.Session
			if session ~= nil then
				if type(session) ~= "table" or type(session.Id) ~= "string" or type(session.ExpiresAt) ~= "number" then
					reason = "unsupported"
					return nil
				end
				if session.Id ~= token and session.ExpiresAt > self.clock() then
					reason = "locked"
					return nil
				end
			end
		end
		return {
			Version = ProfileStore.CURRENT_VERSION,
			Data = self.copy(current and current.Data),
			Receipts = receiptsCopy(current and current.Receipts),
			Session = { Id = token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	if not ok then return nil, "unavailable", result end
	if not result or reason then return nil, reason or "unavailable" end
	return {
		key = key, token = token, data = self.copy(result.Data),
		receipts = receiptsCopy(result.Receipts), transacting = false,
		expiresAt = result.Session.ExpiresAt, saving = false, closing = false, closed = false, lost = false,
	}
end

function ProfileStore:Save(profile, release)
	if profile.closed or profile.lost then return false, "lost" end
	if profile.activityLock then return false, "activity_pending" end
	if release then
		profile.closing = true
		while profile.saving do self.wait(0.1) end
		if profile.closed or profile.lost then return false, "lost" end
	elseif profile.saving or profile.closing then
		return false, "busy"
	end
	-- An ambiguous receipt write may already have committed. Never overwrite its
	-- reward with the old local snapshot, including during departure/shutdown.
	if profile.transacting then return false, "receipt_pending" end
	profile.saving = true
	-- Snapshot after waiting, so a final release includes the newest gameplay state.
	local snapshot = self.copy(profile.data)
	local ok, result = self:_update(profile.key, function(current)
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			return nil
		end
		return {
			Version = ProfileStore.CURRENT_VERSION, Data = snapshot, Receipts = receiptsCopy(current.Receipts),
			Session = if release then nil else { Id = profile.token, ExpiresAt = self.clock() + self.lease },
			UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then return false, "unavailable", result end
	if not result then
		profile.lost = true
		return false, "lost"
	end
	if release then profile.closed = true else profile.expiresAt = result.Session.ExpiresAt end
	return true
end

function ProfileStore:GrantReceipt(profile, receiptId, productId, grant, activityToken)
	if profile.activityLock and profile.activityLock ~= activityToken then return false, "busy" end
	if type(receiptId) ~= "string" or #receiptId == 0 or #receiptId > 200
		or type(productId) ~= "number" or productId <= 0 or productId >= 2 ^ 53 or productId ~= math.floor(productId) then
		return false, "invalid"
	end
	if profile.receipts and profile.receipts[receiptId] then
		return profile.receipts[receiptId] == productId, "duplicate"
	end
	if profile.closed or profile.closing or profile.lost or profile.sessionOnly then return false, "unavailable_profile" end
	if profile.saving then return false, "busy" end
	if profile.pendingReceipt and (profile.pendingReceipt.Id ~= receiptId or profile.pendingReceipt.ProductId ~= productId) then
		return false, "busy"
	end
	if not profile.pendingReceipt then
		profile.pendingReceipt = { Id = receiptId, ProductId = productId, Snapshot = self.copy(profile.data) }
	end
	profile.transacting = true
	profile.saving = true
	local reason
	local ok, result = self:_update(profile.key, function(current)
		reason = nil
		if not validRecord(current) or type(current.Session) ~= "table" or current.Session.Id ~= profile.token then
			reason = "lost"
			return nil
		end
		local ledger = receiptsCopy(current.Receipts)
		local data
		if ledger[receiptId] then
			if ledger[receiptId] ~= productId then
				reason = "conflict"
				return nil
			end
			data = current.Data -- A prior attempt may have committed despite a network error.
		else
			-- UpdateAsync can call this transform multiple times. Always start from
			-- the same frozen snapshot, never from a previously rewarded copy.
			data = self.copy(profile.pendingReceipt.Snapshot)
			local granted, failure = grant(data)
			if not granted then
				reason = failure or "invalid_reward"
				return nil
			end
			ledger[receiptId] = productId
		end
		return {
			Version = ProfileStore.CURRENT_VERSION, Data = data, Receipts = ledger,
			Session = { Id = profile.token, ExpiresAt = self.clock() + self.lease }, UpdatedAt = self.clock(),
		}
	end)
	profile.saving = false
	if not ok then
		-- Keep the economy frozen until retry/rejoin reconciles the uncertain write.
		return false, "unavailable", result
	end
	if not result then
		profile.pendingReceipt = nil
		profile.transacting = false
		if reason == "lost" then profile.lost = true end
		return false, reason or "unavailable"
	end
	-- Preserve the table identity used by the running tycoon state.
	table.clear(profile.data)
	for key, value in pairs(self.copy(result.Data)) do profile.data[key] = value end
	profile.receipts = receiptsCopy(result.Receipts)
	profile.expiresAt = result.Session.ExpiresAt
	profile.pendingReceipt = nil
	profile.transacting = false
	return true, "granted"
end

return ProfileStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="60">
        <Properties>
          <string name="Name">Settings</string>
          <string name="Source"><![CDATA[return {
	-- Use a separate published test experience for persistence testing.
	DataStoreName = "CookieCorner_PlayerData_v1",
	AutosaveSeconds = 45,
	SessionLeaseSeconds = 180,
	-- Explicit opt-in for offline Studio play only. Always ignored on live servers.
	-- Session-only play never reads/writes a fallback profile to the real DataStore.
	AllowStudioSessionOnly = false,
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="61">
        <Properties>
          <string name="Name">StepPads</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local StepPads = {}
StepPads.__index = StepPads

local function feet(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not root or humanoid.FloorMaterial == Enum.Material.Air then return nil end
	local height = humanoid.HipHeight + root.Size.Y / 2
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		height += leg and leg.Size.Y or 2
	end
	return { character = character, position = root.Position - Vector3.new(0, height, 0) }
end

function StepPads.new(world)
	local self = setmetatable({ world = world, pads = {}, cooldowns = {}, running = true }, StepPads)
	world.Destroying:Connect(function() self.running = false end)
	task.spawn(function()
		while self.running and world.Parent do
			self:Update(os.clock())
			task.wait(0.08)
		end
	end)
	return self
end

function StepPads:Register(surface, options)
	table.insert(self.pads, { surface = surface, options = options })
end

function StepPads:ResetOwner(player)
	self.cooldowns[player] = nil
	for _, entry in ipairs(self.pads) do
		if entry.owner == player then entry.owner, entry.character, entry.state = nil, nil, nil end
	end
end

function StepPads:Update(now)
	local characters = {}
	for _, entry in ipairs(self.pads) do
		local player = entry.options.Owner()
		if not player or not player.Parent or not entry.surface:IsDescendantOf(self.world) then
			entry.owner, entry.character, entry.state = nil, nil, nil
			continue
		end
		if characters[player] == nil then characters[player] = feet(player) or false end
		local character = characters[player]
		if entry.owner ~= player or entry.character ~= (character and character.character) then
			entry.state = nil
			entry.owner, entry.character = player, character and character.character
		end
		local inside = false
		if character then
			local point = entry.surface.CFrame:PointToObjectSpace(character.position)
			inside = Layout.insidePad(point.X, point.Y, point.Z, entry.surface.Size.X, entry.surface.Size.Z)
		end
		local available = inside and now >= (self.cooldowns[player] or 0) and entry.options.Available(player)
		local fire
		entry.state, fire = Layout.step(entry.state, now, inside, available)
		if fire then
			self.cooldowns[player] = now + Layout.StepCooldown
			-- The normal action handler still checks session ownership, current price,
			-- and progression before changing any money. No client touch event is trusted.
			local ok, result = pcall(entry.options.Activate, player)
			entry.state = Layout.resolveStep(entry.state, ok and result == true)
			if not ok then warn("Cookie Corner step pad failed: " .. tostring(result)) end
		end
	end
end

return StepPads
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="62">
        <Properties>
          <string name="Name">ValleyEventsServer</string>
          <string name="Source"><![CDATA[local Players, Tween, Debris = game:GetService("Players"), game:GetService("TweenService"), game:GetService("Debris")
local Shared = game:GetService("ReplicatedStorage").CookieTycoon
local Rules, Cards, Polish, Life = require(Shared.ValleyEvents), require(Shared.CardEconomy), require(Shared.BakeryPolish), require(Shared.BakeryLife)
local W, Assets = require(script.Parent.WorldWidgets), require(script.Parent.AssetLibrary)
local Events = {}
Events.__index = Events
local gold, cocoa = Color3.fromRGB(255, 205, 97), Color3.fromRGB(77, 47, 37)
local rewardText = Rules.HillReward .. " Star Crumbs / " .. Rules.PayoutSeconds .. "s"
local idleText = "COOKIE HILL • PVP ZONE\nHold alone " .. Rules.CaptureSeconds .. "s • " .. rewardText

local function decoration(part)
	part.CanCollide, part.CanTouch, part.CanQuery = false, false, false
	return part
end

local function buildHill(self, folder)
	local center = Vector3.new(Rules.HillX, 0, Rules.HillZ)
	local function piece(name, size, offset, tint, material)
		return W.part(folder, name, size, center + offset, tint, material)
	end
	local function disc(name, radius, y, thickness, tint, material)
		local p = piece(name, Vector3.new(thickness, radius * 2, radius * 2), Vector3.new(0, y, 0), tint, material)
		p.Shape, p.CFrame = Enum.PartType.Cylinder, p.CFrame * CFrame.Angles(0, 0, math.pi / 2)
		return p
	end
	disc("Hill Slate Foundation", 29, 6.25, .9, Color3.fromRGB(87, 103, 107), Enum.Material.Slate)
	disc("Hill Brass Plinth", 26.5, 7.15, .9, gold, Enum.Material.Metal)
	disc("KOTH Cookie Hill", Rules.HillRadius, 8, .6, Color3.fromRGB(206, 153, 91), Enum.Material.Sandstone)
	-- The illuminated ring follows the server's actual PvP radius. All trim is
	-- non-colliding, leaving an open fighting floor without snags or railings.
	self.hillTrim = {}
	for index = 1, 64 do
		local angle = index / 64 * math.pi * 2
		local offset = Vector3.new(math.cos(angle) * Rules.HillRadius, 8.4, math.sin(angle) * Rules.HillRadius)
		local rim = decoration(piece("PvP Boundary Light", Vector3.new(2.4, .16, .45), offset, gold, Enum.Material.Neon))
		rim.CFrame = CFrame.lookAt(rim.Position, center + Vector3.new(0, 8.4, 0))
		table.insert(self.hillTrim, rim)
	end
	for index = 1, 14 do
		local angle, radius = index * 2.39996, 5 + (index % 4) * 4
		local chip = decoration(piece("Arena Chocolate Inlay", Vector3.new(2.3, .08, 1.7), Vector3.new(math.cos(angle) * radius, 8.34, math.sin(angle) * radius), cocoa, Enum.Material.SmoothPlastic))
		chip.CFrame *= CFrame.Angles(0, angle, 0)
	end
	-- Wide steps face the bakeries. Solid risers follow the natural hill slope.
	for step = 1, 8 do
		piece("Hill Entrance Step", Vector3.new(4.2, step + 1, 14), Vector3.new(58 - step * 4, (step - 1) / 2, 0), Color3.fromRGB(143, 157, 153), Enum.Material.Slate)
		decoration(piece("Step Brass Edge", Vector3.new(.2, .06, 14), Vector3.new(60 - step * 4, step + .04, 0), gold, Enum.Material.Metal))
	end
	for _, side in ipairs({-1, 1}) do
		piece("Entrance Stone Foot", Vector3.new(4, 1.5, 4), Vector3.new(41, 5, side * 10), cocoa, Enum.Material.Slate)
		piece("Entrance Pillar", Vector3.new(1.4, 15, 1.4), Vector3.new(41, 12.5, side * 10), cocoa, Enum.Material.Wood)
		local lantern = decoration(piece("Hill Entrance Lantern", Vector3.new(2, 2, 2), Vector3.new(41, 20.8, side * 10), gold, Enum.Material.Neon))
		local light = Instance.new("PointLight")
		light.Color, light.Brightness, light.Range, light.Parent = gold, 1.5, 24, lantern
	end
	local arch = piece("Cookie Hill Entrance Arch", Vector3.new(2, 2.2, 24), Vector3.new(41, 20, 0), cocoa, Enum.Material.Wood)
	local entryText = W.label(arch, "COOKIE HILL\nFight inside the gold ring • Hold alone to earn", 100)
	entryText.Parent.Size, entryText.Parent.StudsOffset = UDim2.fromOffset(310, 55), Vector3.new(0, 4, 0)
	entryText.TextColor3 = gold
	for index = 1, 4 do
		local angle = math.pi / 4 + (index - 1) * math.pi / 2
		local offset = Vector3.new(math.cos(angle) * 33, 0, math.sin(angle) * 33)
		piece("Arena Banner Foot", Vector3.new(3, 1, 3), offset + Vector3.new(0, 6.5, 0), cocoa, Enum.Material.Slate)
		piece("Arena Banner Pole", Vector3.new(.45, 17, .45), offset + Vector3.new(0, 15, 0), gold, Enum.Material.Metal)
		local banner = decoration(piece("Gold Arena Banner", Vector3.new(4.5, 7, .18), offset + Vector3.new(2, 19, 0), Color3.fromRGB(154, 79, 52), Enum.Material.Fabric))
		decoration(piece("Banner Gold Emblem", Vector3.new(1.5, 1.5, .22), banner.Position - center + Vector3.new(0, .5, .1), gold, Enum.Material.Metal))
	end
	-- A tall cookie trophy and warm beacon make the hill visible over the forest.
	local pole = piece("Hill Flagpole", Vector3.new(.7, 27, .7), Vector3.new(-27, 20, 0), gold, Enum.Material.Metal)
	self.flag = decoration(piece("Hill Flag", Vector3.new(9, 5, .18), Vector3.new(-22.5, 28, 0), gold, Enum.Material.Fabric))
	local trophy = decoration(piece("Champion Cookie Trophy", Vector3.new(.9, 9, 9), Vector3.new(-27, 36, 0), Color3.fromRGB(219, 161, 89), Enum.Material.Sandstone))
	trophy.Shape, trophy.CFrame = Enum.PartType.Cylinder, trophy.CFrame * CFrame.Angles(0, math.pi / 2, 0)
	for index = 1, 9 do
		local angle, radius = index * 2.39996, 1 + (index % 3) * 1.15
		local chip = decoration(piece("Trophy Chocolate Chip", Vector3.new(.8, .9, .25), Vector3.new(-27 + math.cos(angle) * radius, 36 + math.sin(angle) * radius, .55), cocoa))
		chip.CFrame *= CFrame.Angles(0, 0, angle)
	end
	decoration(piece("Champion Crown Band", Vector3.new(6, .65, 1.2), Vector3.new(-27, 41, 0), gold, Enum.Material.Metal))
	for index = -1, 1 do
		decoration(piece("Champion Crown Point", Vector3.new(1.2, index == 0 and 2.8 or 2, 1.2), Vector3.new(-27 + index * 2.2, 42, 0), gold, Enum.Material.Metal))
	end
	local beacon = decoration(piece("Hill Golden Beacon", Vector3.new(.5, 32, .5), Vector3.new(-27, 59, 0), gold, Enum.Material.Neon))
	beacon.Transparency, beacon.CastShadow = .65, false
	self.hillText = W.label(pole, idleText, 420)
	self.hillText.Parent.Size, self.hillText.Parent.StudsOffset = UDim2.fromOffset(360, 78), Vector3.new(0, 27, 0)
	self.hillText.TextSize, self.hillText.TextColor3 = 18, gold
	local corner = Instance.new("UICorner")
	corner.CornerRadius, corner.Parent = UDim.new(0, 12), self.hillText
end

function Events.start(context)
	local self = setmetatable({ context = context, nextMeteor = os.clock() + Rules.meteorDelay(math.random()), cooldowns = {}, born = {} }, Events)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Star Crumb Events", context.World
	self.folder = folder
	buildHill(self, folder)
	local function mark(player)
		self.born[player] = os.clock()
		player.CharacterAdded:Connect(function() self.born[player] = os.clock() end)
	end
	Players.PlayerAdded:Connect(mark)
	Players.PlayerRemoving:Connect(function(player) self.born[player], self.cooldowns[player] = nil, nil end)
	for _, player in ipairs(Players:GetPlayers()) do mark(player) end
	task.spawn(function()
		while folder.Parent do self:Step(); task.wait(.25) end
	end)
	return self
end
function Events:Eligible(player)
	local character = player.Character
	local root, hum = character and character:FindFirstChild("HumanoidRootPart"), character and character:FindFirstChildOfClass("Humanoid")
	if not root or not hum or hum.Health <= 0 or player:GetAttribute("AdminFlying") or player:GetAttribute("AdminInvisible") or os.clock() - (self.born[player] or os.clock()) < 5 then return nil end
	local state = self.context.GetState(player)
	if not state or state.closing or state.profile.lost or state.profile.closed then return nil end
	return root, hum
end
function Events:Announce(kind)
	self.context.Announce(kind)
end
function Events:SpawnMeteor()
	local spots = { Vector3.new(270, 3, -490), Vector3.new(-265, 3, -500), Vector3.new(285, 3, 510), Vector3.new(-280, 3, 270) }
	local target = spots[math.random(#spots)]
	local model = Assets.cookie(4, self.folder, CFrame.new(target + Vector3.new(0, 250, 0)))
	model.Name = "Cookie Meteor • Star Crumbs"
	model:ScaleTo(4)
	local core = model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)
	local value = Instance.new("CFrameValue")
	value.Value = model:GetPivot()
	value.Changed:Connect(function(cf) if model.Parent then model:PivotTo(cf) end end)
	value.Parent = model
	local fire = Instance.new("Fire")
	fire.Size, fire.Heat, fire.Parent = 18, 15, core
	local light = Instance.new("PointLight")
	light.Color, light.Range, light.Brightness, light.Parent = Color3.fromRGB(255, 165, 78), 35, 2, core
	local meteor = { model = model, core = core, hp = 180, hits = {}, paid = {}, expires = os.clock() + 300, landed = false }
	meteor.label = W.label(core, "COOKIE METEOR\nStrike with your rolling pin • 180 HP", 100)
	meteor.label.Parent.StudsOffset, meteor.label.Parent.Size = Vector3.new(0, 12, 0), UDim2.fromOffset(300, 65)
	self.meteor = meteor
	self:Announce("Incoming")
	Tween:Create(value, TweenInfo.new(3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Value = CFrame.new(target) }):Play()
	task.delay(3, function()
		if self.meteor ~= meteor or not model.Parent then return end
		meteor.landed = true
		self:Announce("Impact")
		local ring = decoration(W.part(self.folder, "Meteor Impact Shockwave", Vector3.new(.15, 8, 8), target - Vector3.new(0, 1.8, 0), gold, Enum.Material.Neon))
		ring.Shape, ring.CFrame, ring.Transparency = Enum.PartType.Cylinder, ring.CFrame * CFrame.Angles(0, 0, math.pi / 2), .25
		Tween:Create(ring, TweenInfo.new(.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Size = Vector3.new(.1, 64, 64), Transparency = 1 }):Play()
		Debris:AddItem(ring, 1)
	end)
end
function Events:Swing(player, pinTool)
	local root = self:Eligible(player)
	if not root or pinTool.Parent ~= player.Character then return false end
	local now = os.clock()
	if now - (self.cooldowns[player] or -math.huge) < .5 then return true end
	self.cooldowns[player] = now
	local state = self.context.Usable(player)
	local meteor = self.meteor
	if meteor and meteor.landed and meteor.hp > 0 and (meteor.core.Position - root.Position).Magnitude <= 16 then
		local damage = math.min(20, Life.PinPower[state.data.life.pin] + Polish.active(state.data.life, os.time()).Mine + Cards.bonuses(state.data.life.cards, state.perks.ThirdCardSlot).Mine)
		meteor.hp = math.max(0, meteor.hp - damage)
		meteor.hits[player.UserId] = (meteor.hits[player.UserId] or 0) + 1
		meteor.label.Text = "COOKIE METEOR • " .. meteor.hp .. "/180 HP\n3+ hits earns a personal crumb reward"
		if meteor.hp == 0 then meteor.expires = now + 45; meteor.label.Text = "Meteor cracked! Rewards are being saved." end
		return true
	end
	if not Rules.onHill(root.Position.X, root.Position.Y, root.Position.Z) then return false end
	for _, other in ipairs(Players:GetPlayers()) do
		if other == player then continue end
		local target, targetHum = self:Eligible(other)
		if target and Rules.onHill(target.Position.X, target.Position.Y, target.Position.Z) then
			local delta = target.Position - root.Position
			if delta.Magnitude <= 9 and delta:Dot(root.CFrame.LookVector) > 0 then
				local otherState = self.context.GetState(other)
				local attack, defense = Polish.active(state.data.life, os.time()), Polish.active(otherState.data.life, os.time())
				targetHum:TakeDamage(Rules.damage(state.data.life.pin, attack.Damage, defense.Defense))
				local flat = Vector3.new(delta.X, 0, delta.Z)
				if flat.Magnitude > .1 then target:ApplyImpulse((flat.Unit * 18 + Vector3.yAxis * 4) * target.AssemblyMass) end
				return true
			end
		end
	end
	return true
end
function Events:Step()
	local now, occupants = os.clock(), {}
	for _, player in ipairs(Players:GetPlayers()) do
		local root = self:Eligible(player)
		local inside = root and Rules.onHill(root.Position.X, root.Position.Y, root.Position.Z) or false
		player:SetAttribute("InCookiePVP", inside)
		player:SetAttribute("NextMeteorSeconds", math.max(0, math.floor(self.nextMeteor - now)))
		if inside then table.insert(occupants, player) end
	end
	if #occupants == 1 then
		local owner = occupants[1]
		if self.candidate ~= owner then self.candidate, self.capture, self.owner = owner, now, nil end
		if not self.owner and now - self.capture >= Rules.CaptureSeconds then self.owner, self.nextPayout = owner, now + Rules.PayoutSeconds end
		self.hillText.Text = self.owner and ("@" .. owner.Name .. " owns COOKIE HILL\n" .. rewardText .. " • PVP ON") or ("@" .. owner.Name .. " capturing\n" .. math.max(0, math.ceil(Rules.CaptureSeconds - (now-self.capture))) .. "s • PVP ON")
		if self.owner and now >= self.nextPayout then
			self.nextPayout = now + Rules.PayoutSeconds
			local state = self.context.Usable(owner)
			if state then Cards.award(state.data.life.cards, Rules.HillReward, state.perks.ThirdCardSlot); self.context.Changed(owner, state) end
		end
	else
		self.candidate, self.owner = nil, nil
		self.hillText.Text = #occupants > 1 and "COOKIE HILL CONTESTED\nNo rewards until one baker remains • PVP ON" or idleText
	end
	local hillColor = #occupants > 1 and Color3.fromRGB(255, 113, 94) or self.owner and Color3.fromRGB(124, 235, 169) or gold
	if self.hillColor ~= hillColor then
		self.hillColor, self.flag.Color, self.hillText.TextColor3 = hillColor, hillColor, hillColor
		for _, rim in ipairs(self.hillTrim) do rim.Color = hillColor end
	end
	if not self.meteor and now >= self.nextMeteor then self:SpawnMeteor(); self.nextMeteor = now + Rules.meteorDelay(math.random()) end
	local meteor = self.meteor
	if meteor then
		if meteor.hp == 0 then
			for _, player in ipairs(Players:GetPlayers()) do
				if (meteor.hits[player.UserId] or 0) >= 3 and not meteor.paid[player.UserId] then
					local state = self.context.Usable(player)
					if state then
						meteor.paid[player.UserId] = true
						local reward = Cards.award(state.data.life.cards, Rules.meteorReward(math.random()), state.perks.ThirdCardSlot)
						self.context.Changed(player, state); self.context.Notify(player, "Meteor reward: +" .. reward .. " Star Crumbs!")
					end
				end
			end
		end
		if now >= meteor.expires then Debris:AddItem(meteor.model, 0); self.meteor = nil end
	end
end
return Events
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="63">
        <Properties>
          <string name="Name">ValleyWorld</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local Natural = require(script.Parent.NaturalTerrain)
local Shape = require(game:GetService("ReplicatedStorage").CookieTycoon.TerrainShape)
local Valley = {}
local function part(parent, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color, p.Material = name, size, position, color, material or Enum.Material.SmoothPlastic
	p.Anchored, p.TopSurface, p.BottomSurface, p.Parent = true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth, parent
	return p
end
function Valley.create(parent)
	local folder = Instance.new("Folder")
	folder.Name, folder.Parent = "Cookie Mountain Valley", parent
	for _, object in ipairs(Lighting:GetChildren()) do if object:IsA("Sky") then object:Destroy() end end
	local sky = Instance.new("Sky")
	sky.Name, sky.CelestialBodiesShown, sky.StarCount, sky.Parent = "Mountain Valley Sky", false, 3000, Lighting
	local random = Random.new(23057)
	for _, z in ipairs({ -297, 297 }) do
		part(folder, "Fast Road", Vector3.new(24, 0.12, 546), Vector3.new(0, 0.5, z), Color3.fromRGB(72, 76, 77), Enum.Material.Asphalt)
	end
	for z = -550, 550, 20 do
		if math.abs(z) > 25 then
			local stripe = part(folder, "Road Speed Stripe", Vector3.new(0.4, 0.04, 7), Vector3.new(0, 0.58, z), Color3.fromRGB(246, 205, 111))
			stripe.CanCollide = false
		end
	end
	Natural.create()

	for index = 1, 175 do
		local x = (index % 2 == 0 and -1 or 1) * random:NextNumber(225, 425)
		local z = random:NextNumber(-570, 570)
		local lake = x < -205 and z > -450 and z < -295
		local mine = x < -210 and math.abs(z - 120) < 75
		local obby = x > 215 and (math.abs(z) < 45 or math.abs(z - 180) < 45 or math.abs(z + 180) < 45)
		if lake or mine or obby or math.abs(z) < 22 or (x + 285)^2 + (z - 400)^2 < 3600 then continue end
		local height = random:NextNumber(12, 23)
		local pos = Vector3.new(x, math.max(0, Shape.height(x, z)), z)
		part(folder, "Cookie Tree Trunk", Vector3.new(2.2, height, 2.2), pos + Vector3.new(0, height / 2, 0), Color3.fromRGB(100, 68, 43), Enum.Material.Wood)
		local crown = part(folder, "Cookie Forest Canopy", Vector3.new(17, 15, 17), pos + Vector3.new(0, height, 0), Color3.fromRGB(random:NextInteger(69, 104), random:NextInteger(126, 158), 85), Enum.Material.Grass)
		crown.Shape, crown.CanCollide = Enum.PartType.Ball, false
		for fruit = 1, 3 do
			local angle = fruit / 3 * math.pi * 2
			local center = pos + Vector3.new(math.cos(angle) * 7, height - 3, math.sin(angle) * 7)
			local cookie = part(folder, "Tree Cookie", Vector3.new(0.5, 3.4, 3.4), center, Color3.fromRGB(201, 148, 82))
			cookie.Shape, cookie.CanCollide = Enum.PartType.Cylinder, false
			for chip = 1, 5 do
				local c = part(folder, "Chocolate Chip", Vector3.new(0.2, 0.45, 0.45), center + Vector3.new(0.3, math.sin(chip * 2) * 1.1, math.cos(chip * 2) * 1.1), Color3.fromRGB(69, 43, 30))
				c.Shape, c.CanCollide = Enum.PartType.Ball, false
			end
		end
	end
	workspace.Terrain:FillBlock(CFrame.new(-285, -14, -370), Vector3.new(140, 4, 110), Enum.Material.Rock)
	workspace.Terrain:FillBlock(CFrame.new(-285, -6, -370), Vector3.new(140, 12, 110), Enum.Material.Water)
	workspace.Terrain.WaterColor, workspace.Terrain.WaterTransparency = Color3.fromRGB(63, 158, 178), 0.3
	workspace.Terrain.WaterReflectance, workspace.Terrain.WaterWaveSize = 0.35, 0.12
	for index = 1, 18 do
		local a = index / 18 * math.pi * 2
		local rock = part(folder, "Lake Shore", Vector3.new(16, 5, 13), Vector3.new(-285 + math.cos(a) * 72, -1, -370 + math.sin(a) * 57), Color3.fromRGB(128, 138, 131), Enum.Material.Slate)
		rock.Shape = Enum.PartType.Ball
	end
	-- Layered slate cliff, a river lip, and two falling ribbons rather than a sphere.
	for layer = 0, 3 do
		local cliff = part(folder, "Waterfall Slate Terrace", Vector3.new(36 - layer * 4, 11, 35 - layer * 3), Vector3.new(-358, 5 + layer * 10, -390), Color3.fromRGB(98 + layer * 6, 114 + layer * 5, 112 + layer * 5), Enum.Material.Slate)
		cliff.CFrame *= CFrame.Angles(0, (layer % 2 == 0 and 1 or -1) * 0.09, 0)
	end
	part(folder, "Waterfall Riverbed", Vector3.new(12, 1, 29), Vector3.new(-351, 42, -400), Color3.fromRGB(109, 121, 113), Enum.Material.Slate)
	local river = part(folder, "Waterfall Source Stream", Vector3.new(10, 0.4, 27), Vector3.new(-351, 42.7, -400), Color3.fromRGB(115, 203, 214), Enum.Material.Glass)
	river.CanCollide, river.Transparency = false, 0.35
	local water = part(folder, "Waterfall Mist Anchor", Vector3.one, Vector3.new(-339, 1, -369), Color3.fromRGB(210, 242, 239))
	water.Transparency, water.CanCollide = 1, false
	for strip = 1, 5 do
		local previous
		for i, pos in ipairs({ Vector3.new(-351 + (strip - 3) * 1.8, 42.7, -386), Vector3.new(-343 + (strip - 3) * 1.9, 22, -377), Vector3.new(-337 + (strip - 3) * 2, 0.7, -368) }) do
			local anchor = Instance.new("Attachment")
			anchor.Position, anchor.Parent = pos - water.Position, water
			if previous then
				local beam = Instance.new("Beam")
				beam.Attachment0, beam.Attachment1, beam.Width0, beam.Width1 = previous, anchor, 2.4, 2.9
				beam.Color, beam.Transparency, beam.FaceCamera = ColorSequence.new(Color3.fromRGB(177, 231, 236)), NumberSequence.new(0.2), true
				beam.Texture, beam.TextureSpeed, beam.TextureLength = "rbxasset://textures/particles/smoke_main.dds", 3.5, 7
				beam.Segments, beam.CurveSize0, beam.CurveSize1, beam.Parent = 12, i == 2 and 7 or 3, 2, water
			end
			previous = anchor
		end
	end
	local spray = Instance.new("ParticleEmitter")
	spray.Texture, spray.Rate, spray.Lifetime, spray.Speed = "rbxasset://textures/particles/smoke_main.dds", 24, NumberRange.new(0.7, 1.8), NumberRange.new(2, 5)
	spray.Size, spray.Transparency, spray.Color = NumberSequence.new(3, 6), NumberSequence.new(0.65, 1), ColorSequence.new(Color3.fromRGB(221, 247, 247))
	spray.SpreadAngle, spray.Parent = Vector2.new(65, 65), water
	for i = 1, 7 do
		local foam = part(folder, "Waterfall Foam", Vector3.new(0.08, 3 + i * 0.7, 3 + i * 0.7), Vector3.new(-337 + math.sin(i) * 5, 0.35, -366 + math.cos(i) * 3), Color3.fromRGB(224, 247, 245))
		foam.Shape, foam.CFrame, foam.Transparency, foam.CanCollide = Enum.PartType.Cylinder, foam.CFrame * CFrame.Angles(0, 0, math.pi / 2), 0.45, false
	end
	for index = 0, 18 do
		part(folder, "Lake Footbridge Plank", Vector3.new(7.4, 0.5, 8), Vector3.new(-355 + index * 7.5, 2.5 + math.sin(index / 18 * math.pi) * 3, -337), Color3.fromRGB(137, 99, 64), Enum.Material.WoodPlanks)
	end
	for i = 1, 140 do
		local x = (i % 2 == 0 and -1 or 1) * random:NextNumber(220, 410)
		local z = random:NextNumber(-570, 570)
		if Shape.lake(x, z) or (x < 0 and z > 0 and z < 215) or (x > 0 and (math.abs(z) < 50 or math.abs(z-180) < 50 or math.abs(z+180) < 50)) then continue end
		local y = math.max(0, Shape.height(x, z))
		local stem = part(folder, "Wildflower Stem", Vector3.new(0.09, 0.65, 0.09), Vector3.new(x, y + 0.35, z), Color3.fromRGB(81, 125, 63))
		stem.CanCollide = false
		local petal = part(folder, "Meadow Wildflower", Vector3.new(0.55, 0.15, 0.55), Vector3.new(x, y + 0.7, z), ({ Color3.fromRGB(246, 231, 188), Color3.fromRGB(237, 166, 154), Color3.fromRGB(180, 180, 229) })[i % 3 + 1])
		petal.Shape, petal.CanCollide = Enum.PartType.Ball, false
	end
	local epoch = os.clock()
	task.spawn(function()
		while folder.Parent do
			local hour = (9 + (os.clock() - epoch) * 24 / 1200) % 24
			local daylight = math.clamp(math.sin((hour - 6) / 12 * math.pi) * 1.6, 0, 1)
			Lighting.ClockTime, Lighting.Brightness = hour, 0.9 + daylight * 1.5
			Lighting.Ambient = Color3.fromRGB(57, 69, 92):Lerp(Color3.fromRGB(131, 139, 149), daylight)
			Lighting.OutdoorAmbient = Color3.fromRGB(66, 83, 113):Lerp(Color3.fromRGB(157, 171, 183), daylight)
			Lighting.ExposureCompensation = 0.05 + (1 - daylight) * 0.08
			task.wait(0.5)
		end
	end)
	return folder
end
return Valley
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="64">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Recipes = require(ReplicatedStorage.CookieTycoon.Recipes)
local Progression = require(ReplicatedStorage.CookieTycoon.Progression)
local Crafting = require(ReplicatedStorage.CookieTycoon.CookieCrafting)
local Layout = require(ReplicatedStorage.CookieTycoon.ConveyorLayout)
local Map = require(ReplicatedStorage.CookieTycoon.MapLayout)
local Conveyor = require(script.Parent.ConveyorWorld)
local Assets = require(script.Parent.AssetLibrary)
local Presentation = require(script.Parent.Presentation)
local StepPads = require(script.Parent.StepPads)
local Mirror = require(script.Parent.PlotMirror)
local Valley = require(script.Parent.ValleyWorld)
local OvenDesign = require(script.Parent.OvenDesign)
local World = {}

local function color(rgb) return Color3.fromRGB(rgb[1], rgb[2], rgb[3]) end

local function part(name, size, position, tint, parent)
	local object = Instance.new("Part")
	object.Name = name
	object.Size = size
	object.Position = position
	object.Color = tint
	object.Anchored = true
	object.TopSurface = Enum.SurfaceType.Smooth
	object.BottomSurface = Enum.SurfaceType.Smooth
	object.Parent = parent
	return object
end

local function label(target, text, distance)
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(190, 46)
	gui.StudsOffset = Vector3.new(0, 3.1, 0)
	gui.MaxDistance = distance or 30
	gui.LightInfluence = 0
	gui.Parent = target
	local textLabel = Instance.new("TextLabel")
	textLabel.Size = UDim2.fromScale(1, 1)
	textLabel.BackgroundColor3 = Color3.fromRGB(64, 44, 39)
	textLabel.BackgroundTransparency = 0.12
	textLabel.Text = text
	textLabel.TextColor3 = Color3.new(1, 1, 1)
	textLabel.TextStrokeTransparency = 1
	textLabel.TextScaled = true
	textLabel.Font = Enum.Font.GothamBold
	textLabel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 10)
	corner.Parent = textLabel
	local padding = Instance.new("UIPadding")
	padding.PaddingLeft = UDim.new(0, 7)
	padding.PaddingRight = UDim.new(0, 7)
	padding.PaddingTop = UDim.new(0, 4)
	padding.PaddingBottom = UDim.new(0, 4)
	padding.Parent = textLabel
	return textLabel
end

local function prompt(target, action, callback, objectText)
	local interaction = Instance.new("ProximityPrompt")
	interaction.ActionText = action
	interaction.ObjectText = objectText or target.Name
	interaction.HoldDuration = 0
	interaction.MaxActivationDistance = 12
	interaction.RequiresLineOfSight = false
	interaction.Parent = target
	interaction.Triggered:Connect(function(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart")
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if root and humanoid and humanoid.Health > 0 and (root.Position - target.Position).Magnitude <= 16 then callback(player) end
	end)
	return interaction
end

local function position(plot, x, y, z)
	return plot.origin + Vector3.new(x * (plot.mirrorX or 1), y, z * plot.direction)
end

local function frame(plot, x, y, z)
	return CFrame.new(position(plot, x, y, z))
		* CFrame.Angles(0, plot.direction == 1 and 0 or math.pi, 0)
end

local function prop(plot, name, x, z, y)
	return Assets.prop(name, plot.model, frame(plot, x, y or 0.5, z))
end

local function detail(plot, name, size, x, y, z, tint, parent)
	local object = part(name, size, position(plot, x, y, z), tint, parent or plot.model)
	object.CanCollide = false
	object.CanTouch = false
	object.CanQuery = false
	return object
end

local function clearCookies(plot)
	for model in pairs(plot.visuals) do
		model:Destroy()
		plot.visuals[model] = nil
	end
end


function World.updateBank(plot, data)
	plot.bankText.Text = "Collect $" .. Progression.format(data and data.bank or 0)
end

function World.refresh(plot, data, perks)
	local reset = plot.lastUnlocked and (not data or data.unlocked < plot.lastUnlocked)
	plot.data = data
	Conveyor.update(plot, data and Progression.interval(data, perks) or 3)
	plot.lastUnlocked = data and data.unlocked or 0
	if reset then clearCookies(plot) end
	plot.sign.Text = plot.owner and ((plot.owner:GetAttribute("FilteredShopName") or "Cookie Bakery") .. "\n@" .. plot.owner.Name) or "Unclaimed Bakery"
	plot.sign.Parent:SetAttribute("OwnerUserId", plot.owner and plot.owner.UserId or 0)
	plot.claimPrompt.Enabled = plot.owner == nil
	plot.claimPrompt.ObjectText = plot.owner and ("@" .. plot.owner.Name .. "'s bakery") or "Unclaimed bakery"
	plot.claimText.Text = plot.owner and ("@" .. plot.owner.Name .. "'s bakery") or "Claim bakery"
	plot.claimSurface.Color = plot.owner and plot.theme or Color3.fromRGB(129, 219, 175)
	plot.claimSurface.Material = plot.owner and Enum.Material.SmoothPlastic or Enum.Material.Neon
	World.updateBank(plot, data)
	plot.upgradePad.Color = data and data.level < Progression.MAX_OVEN_LEVEL and Color3.fromRGB(183, 160, 229) or Color3.fromRGB(118, 114, 121)
	plot.upgradeText.Text = not data and "Baking speed" or data.level == Progression.MAX_OVEN_LEVEL and "Speed MAX"
		or "Faster baking\n$" .. Progression.format(Progression.ovenCost(data))
	plot.shopPrompt.Enabled = data ~= nil
	plot.workshopPrompt.Enabled = data ~= nil
	for index, station in ipairs(plot.stations) do
		local unlocked = data ~= nil and index <= data.unlocked
		local nextRecipe = data ~= nil and index == data.unlocked + 1
		local visible = unlocked or nextRecipe or (not data and index == 1)
		station.model.Parent = visible and plot.model or nil
		station.purchaseModel.Parent = nextRecipe and station.model or nil
		local rarity = Crafting.rarity(Recipes[index])
		station.pad.Color = nextRecipe and Color3.fromRGB(255, 214, 139) or plot.theme
		station.text.Text = Recipes[index].Name .. "\n$" .. Progression.format(Recipes[index].Cost)
		station.ovenText.Parent.Enabled = unlocked or not data and index == 1
		station.ovenText.Text = Recipes[index].Name
		station.ovenText.TextColor3 = color(rarity.Color)
		if station.steam then station.steam.Enabled = unlocked end
		station.oven.Color = unlocked and color(rarity.Color) or Color3.fromRGB(106, 112, 119)
		station.window.Color = unlocked and Color3.fromRGB(246, 151, 61) or Color3.fromRGB(48, 59, 66)
		station.window.Material = unlocked and Enum.Material.Neon or Enum.Material.Glass
	end
	local nextStation = data and plot.stations[data.unlocked + 1]
	plot.nextMarker.Adornee = nextStation and nextStation.purchaseModel or nil
	plot.nextMarker.Enabled = nextStation ~= nil
end

function World.spawnPlayer(player, plot)
	if not plot or plot.owner ~= player then return end
	-- The disabled plot spawn is a marker, outside the random neutral spawn pool.
	-- CharacterAdded calls this scripted relocation after each plaza respawn.
	local character = player.Character
	if not character then return end
	local root = character:FindFirstChild("HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)
	if not root or player.Character ~= character or plot.owner ~= player or not player.Parent then return end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then return end
	local destination = position(plot, Layout.SpawnX, 4.1, Layout.SpawnZ)
	local nextOven = position(plot, Layout.PadX, 4.1, Layout.station(2).z)
	character:PivotTo(CFrame.lookAt(destination, nextOven))
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
end

function World.releasePlayer(player, plot)
	if player.RespawnLocation == plot.spawn then player.RespawnLocation = nil end
	plot.stepPads:ResetOwner(player)
	clearCookies(plot)
end

function World.create(onClaim, onAction, onShop, onWorkshop)
	Presentation.lighting()
	local world = Instance.new("Folder")
	world.Name = "CookieTycoonWorld"
	world.Parent = workspace
	local stepPads = StepPads.new(world)
	local plots = {}
	-- Four ground slabs leave an actual opening for the swimmable terrain lake.
	for _, region in ipairs({ { -450, -355, -610, 610 }, { -215, 450, -610, 610 }, { -355, -215, -610, -425 }, { -355, -215, -315, 610 } }) do
		local meadow = part("Meadow", Vector3.new(region[2] - region[1], 1, region[4] - region[3]), Vector3.new((region[1] + region[2]) / 2, -1, (region[3] + region[4]) / 2), Color3.fromRGB(111, 166, 111), world)
		meadow.Material = Enum.Material.Grass
		Assets.texture(meadow, "MeadowGrass")
	end
	for segment = -14, 14 do
		Assets.prop("PathSegment", world, CFrame.new(0, 0, segment * 40))
	end
	Assets.prop("SpawnPlaza", world, CFrame.new(0, 0.2, 0))
	for _, x in ipairs({ -191, 191 }) do
		for _, z in ipairs({ -510, -360, -225, -85, 85, 225, 360, 510 }) do
			Assets.prop("CookieTree", world, CFrame.new(x, 0, z))
		end
	end
	for _, x in ipairs({ -10, 10 }) do
		for _, z in ipairs({ -510, -360, -220, -70, 70, 220, 360, 510 }) do
			Assets.prop("Lamppost", world, CFrame.new(x, 0.15, z))
		end
	end
	Presentation.world(world)
	Valley.create(world)
	local sculpture = Assets.cookie(1, world, CFrame.new(0, 7.6, 19) * CFrame.Angles(math.rad(75), 0, 0))
	sculpture.Name = "Cookie Corner Monument"
	sculpture:ScaleTo(2.9)
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Plaza Spawn"
	spawn.Size = Vector3.new(12, 1, 12)
	spawn.Position = Vector3.new(0, 1, 0)
	spawn.Anchored = true
	spawn.Neutral = true
	spawn.Transparency = 1
	spawn.CanCollide = false
	spawn.Duration = 0
	spawn.Parent = world
	label(spawn, "COOKIE CORNER\nClaim a bakery to start", 80)
	for slot = 1, Map.PlayerCount do
		local placement = Map.plot(slot)
		local model = Instance.new("Model")
		model.Name = "Bakery" .. slot
		model.Parent = world
		local plot = {
			model = model, stations = {}, owner = nil, data = nil, visualCursor = 0, visuals = {}, stepPads = stepPads,
			origin = Vector3.new(placement.x, 0, placement.z),
			direction = placement.direction,
		}
		local marker = Instance.new("Highlight")
		marker.Name = "Next Recipe"
		marker.DepthMode = Enum.HighlightDepthMode.Occluded
		marker.FillColor = Color3.fromRGB(255, 211, 129)
		marker.FillTransparency = 0.85
		marker.OutlineColor = Color3.fromRGB(255, 228, 168)
		marker.Enabled = false
		marker.Parent = model
		plot.nextMarker = marker
		table.insert(plots, plot)
		prop(plot, "BakeryFloor", 0, 0, 0)
		plot.shell = prop(plot, "BakeryShell", 0, 0, 0)
		prop(plot, "BakeryAwning", 0, 113)
		Conveyor.create(plot, position)
		local counter = prop(plot, "PrepCounter", -49, -45)
		local worktop = counter:FindFirstChild("Texture_CounterMarble")
		label(worktop, "Cookie toppings", 35)
		plot.workshopPrompt = prompt(worktop, "Open toppings", function(player) onWorkshop(player, plot) end, "Cookie Workshop")
		prop(plot, "IngredientBins", 24, -115)
		prop(plot, "DoughMixer", 42, -115)
		prop(plot, "CoolingRack", 59, -115)
		prop(plot, "Planter", -75, 102)
		prop(plot, "Planter", 75, 102)
		prop(plot, "WoodenFence", -64, 120)
		prop(plot, "WoodenFence", 64, 120)
		local sign = prop(plot, "BakerySign", 0, 120)
		plot.sign = label(Assets.anchor(sign), "Unclaimed Bakery", 180)
		local signGui = plot.sign.Parent
		signGui.Name, signGui.Enabled = "BakeryOwnerSign", false
		signGui.Size, signGui.StudsOffset = UDim2.fromOffset(260, 58), Vector3.new(0, 9, 0)
		signGui.AlwaysOnTop = false
		plot.sign.BackgroundTransparency = .25
		local textLimit = Instance.new("UITextSizeConstraint")
		textLimit.MinTextSize, textLimit.MaxTextSize, textLimit.Parent = 12, 21, plot.sign
		game:GetService("CollectionService"):AddTag(signGui, "BakeryOwnerSign")
		local claim = prop(plot, "ClaimPad", 77, 94)
		plot.claimSurface = claim:FindFirstChild("Claim Surface")
		plot.claimPrompt = prompt(Assets.anchor(claim), "Claim free bakery", function(player) onClaim(player, plot) end, "Cookie Bakery")
		plot.claimText = label(Assets.anchor(claim), "Claim bakery", 65)
		local personalSpawn = Instance.new("SpawnLocation")
		personalSpawn.Name = "Bakery Spawn"
		personalSpawn.Size = Vector3.new(5, 0.15, 5)
		personalSpawn.CFrame = frame(plot, Layout.SpawnX, 0.66, Layout.SpawnZ)
		personalSpawn.Anchored = true
		personalSpawn.Enabled = false
		personalSpawn.Transparency = 0.65
		personalSpawn.CanCollide = false
		personalSpawn.CanTouch = false
		personalSpawn.Duration = 0
		personalSpawn.Parent = model
		plot.spawn = personalSpawn
		local collect = prop(plot, "CollectionRegister", 64, 100)
		plot.bankText = label(Assets.anchor(collect), "Collect $0", 45)
		prompt(Assets.anchor(collect), "Collect cash", function(player) onAction(player, "Collect", nil, plot) end, "Bakery Register")
		local collectionPad = detail(plot, "Cash Collection Pad", Vector3.new(8, 0.15, 8), 64, 0.65, 91, Color3.fromRGB(233, 194, 92))
		label(collectionPad, "COLLECT CASH", 35)
		stepPads:Register(collectionPad, { Owner = function() return plot.owner end,
			Available = function(player) return plot.owner == player and plot.data ~= nil and plot.data.bank > 0 and plot.data.cash < Progression.MAX_CASH end,
			Activate = function(player) return onAction(player, "Collect", nil, plot) end })
		local upgrade = prop(plot, "UpgradeConsole", 55, Layout.FirstStationZ + 10)
		local speedPadModel = prop(plot, "ClaimPad", 55, Layout.FirstStationZ + 2)
		speedPadModel:ScaleTo(0.6)
		plot.upgradePad = speedPadModel:FindFirstChild("Claim Surface")
		plot.upgradeText = label(Assets.anchor(upgrade), "Baking speed", 35)
		stepPads:Register(plot.upgradePad, {
			Owner = function() return plot.owner end,
			Available = function(player)
				local data = plot.data
				return plot.owner == player and data ~= nil and data.level < Progression.MAX_OVEN_LEVEL and data.cash >= Progression.ovenCost(data)
			end,
			Activate = function(player) return onAction(player, "UpgradeOven", nil, plot) end,
		})
		local shop = prop(plot, "RebirthPedestal", 63, 109)
		label(Assets.anchor(shop), "Golden Chips", 40)
		plot.shopPrompt = prompt(Assets.anchor(shop), "Open upgrades", function(player) onShop(player, plot) end, "Golden Chip Shop")
		for index, recipe in ipairs(Recipes) do
			local geometry = Layout.station(index)
			local stationModel = Instance.new("Model")
			stationModel.Name = string.format("%02d %s", index, recipe.Name)
			stationModel.Parent = model
			local ovenModel = OvenDesign.create(index, stationModel,
				CFrame.new(position(plot, geometry.x, 3.7, geometry.z)) * CFrame.Angles(0, -math.pi / 2, 0))
			ovenModel.Parent = stationModel
			local bench = detail(plot, "Oven Counter", Vector3.new(6, 1.8, 6.6), geometry.x, 1.4, geometry.z, Color3.fromRGB(127, 100, 83), stationModel)
			bench.CanCollide = true
			local oven = ovenModel:FindFirstChild("RecipeBadge")
			local chute = detail(plot, "Cookie Feed Tray", Vector3.new(1.1, 0.2, 2.8), geometry.laneX + 5.05, Layout.BeltTop - 0.3, geometry.z,
				Color3.fromRGB(126, 143, 150), stationModel)
			chute.Material = Enum.Material.Metal
			local buyModel = prop(plot, "ClaimPad", geometry.padX, geometry.z, 0.55)
			buyModel.Name = "Buy " .. recipe.Name
			buyModel:ScaleTo(0.55)
			buyModel.Parent = stationModel
			local buy = buyModel:FindFirstChild("Claim Surface")
			local station = {
				model = stationModel, ovenModel = ovenModel, oven = oven, window = ovenModel:FindFirstChild("Window"),
				x = geometry.x, z = geometry.z, laneX = geometry.laneX, pad = buy, purchaseModel = buyModel,
				text = label(buy, recipe.Name, 26), ovenText = label(oven, recipe.Name, 24), steam = Presentation.oven(ovenModel),
			}
			station.ovenText.Parent.StudsOffset = Vector3.new(0, 1.5, 0)
			station.ovenText.Parent.Size = UDim2.fromOffset(160, 26)
			stepPads:Register(buy, {
				Owner = function() return plot.owner end,
				Available = function(player)
					local data = plot.data
					return plot.owner == player and data ~= nil and index == data.unlocked + 1 and data.cash >= recipe.Cost
				end,
				Activate = function(player) return onAction(player, "BuyRecipe", index, plot) end,
			})
			table.insert(plot.stations, station)
		end
		Presentation.plot(plot, slot)
		if placement.x > 0 then Mirror.apply(plot) end
		World.refresh(plot, nil)
	end
	return plots
end

function World.animate(plot, data, perks)
	local active = 0
	for model in pairs(plot.visuals) do
		if model.Parent then active += 1 else plot.visuals[model] = nil end
	end
	local count = math.min(2, data.unlocked, Layout.MaxVisualCookies - active)
	if data.life.belt == 0 then return end
	for number = 1, count do
		plot.visualCursor = plot.visualCursor % data.unlocked + 1
		local index = plot.visualCursor
		local station = plot.stations[index]
		local start = position(plot, station.laneX + (number - 1) * 0.25, Layout.CookieY, station.z)
		local model = Assets.cookie(index, plot.model, CFrame.new(start), data.modifiers[tostring(index)])
		model.Name = "Physical " .. model.Name
		plot.visuals[model] = true
		model:SetAttribute("CashValue", Progression.recipeValue(data, index, perks))
		local hull = Conveyor.makePhysical(model)
		Conveyor.track(plot, model, hull, math.floor((index - 1) / 10) + 1)
		if World.OnCookie then World.OnCookie(plot, model, index, data) end
		hull.AssemblyLinearVelocity = Vector3.new(0, 0, Layout.speed(Progression.interval(data, perks)) * plot.direction)
	end
end

return World
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="65">
        <Properties>
          <string name="Name">WorldWidgets</string>
          <string name="Source"><![CDATA[local W = {}
function W.part(parent, name, size, position, color, material)
	local p = Instance.new("Part")
	p.Name, p.Size, p.Position, p.Color = name, size, position, color
	p.Material, p.Anchored, p.TopSurface, p.BottomSurface = material or Enum.Material.SmoothPlastic, true, Enum.SurfaceType.Smooth, Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end
function W.label(target, text, distance)
	local gui = Instance.new("BillboardGui")
	gui.Size, gui.StudsOffset, gui.MaxDistance, gui.Parent = UDim2.fromOffset(190, 45), Vector3.new(0, 3, 0), distance or 40, target
	local label = Instance.new("TextLabel")
	label.Size, label.BackgroundColor3, label.BackgroundTransparency = UDim2.fromScale(1, 1), Color3.fromRGB(54, 39, 32), 0.12
	label.TextColor3, label.TextWrapped, label.Font, label.TextSize, label.Text, label.Parent = Color3.fromRGB(255, 235, 202), true, Enum.Font.GothamBold, 14, text, gui
	return label
end
function W.near(player, point, distance)
	local char = player.Character
	local root, hum = char and char:FindFirstChild("HumanoidRootPart"), char and char:FindFirstChildOfClass("Humanoid")
	return root ~= nil and hum ~= nil and hum.Health > 0 and (root.Position - point).Magnitude <= (distance or 12)
end
function W.prompt(target, text, hold, callback)
	local p = Instance.new("ProximityPrompt")
	p.ActionText, p.ObjectText, p.HoldDuration, p.MaxActivationDistance, p.RequiresLineOfSight = text, target.Name, hold or 0, 9, false
	p.Parent = target
	p.Triggered:Connect(function(player) if W.near(player, target.Position) then callback(player) end end)
	return p
end
function W.position(plot, x, y, z)
	return plot.origin + Vector3.new(x * (plot.mirrorX or 1), y, z * plot.direction)
end
return W
]]></string>
