{
  "name": "CookieFactoryTycoon",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "CookieTycoon": {
        "$path": "src/shared"
      }
    },
    "ServerStorage": {
      "$className": "ServerStorage",
      "CookieCornerAssets": {
        "$path": "assets/models/CookieCornerAssets.rbxmx"
      }
    },
    "ServerScriptService": {
      "Tycoon": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": { "EnableMouseLockOption": false },
      "StarterPlayerScripts": {
        "TycoonUI": {
          "$path": "src/client"
        }
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "Terrain": {
        "$className": "Terrain",
        "$properties": {
          "Decoration": true
        }
      }
    }
  }
}
